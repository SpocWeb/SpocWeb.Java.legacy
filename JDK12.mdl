|     * @param     title   the title of the dialog.
|     * @param     mode   the mode of the dialog.
|     * @see       java.awt.FileDialog#LOAD
|     * @see       java.awt.FileDialog#SAVE
|     
					
					parameters 	(list Parameters
					    (object Parameter "parent"
						type       	"Frame")
					    (object Parameter "title"
						type       	"String")
