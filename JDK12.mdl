						documentation 	
|
|     * Invoked when a window has been closed as the result
|     * of calling dispose on the window.
|     
						
						parameters 	(list Parameters
						    (object Parameter "e"
							type       	"WindowEvent"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
