				    (object ClassAttribute "fields[]"
					attributes 	(list Attribute_Set)
					quid       	"3968B5F60062"
					documentation 	
|
|     * The field values for the currently set time for this calendar.
|     * This is an array of <code>FIELD_COUNT</code> integers, with index values
|     * <code>ERA</code> through <code>DST_OFFSET</code>.
|     * @serial
|     
					
					type       	"int"
					exportControl 	"Protected")
				    (object ClassAttribute "isSet[]"
					attributes 	(list Attribute_Set)
					quid       	"3968B5F60063"
					documentation 	
|
|     * The flags which tell if a specified time field for the calendar is set.
|     * A new object has no fields set.  After the first call to a method
|     * which generates the fields, they all remain set after that.
|     * This is an array of <code>FIELD_COUNT</code> booleans, with index values
|     * <code>ERA</code> through <code>DST_OFFSET</code>.
|     * @serial
|     
					
					type       	"boolean"
					exportControl 	"Protected")
				    (object ClassAttribute "stamp[]"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Transient"
						value      	TRUE))
					quid       	"3968B5F60064"
					documentation 	
|
|     * Pseudo-time-stamps which specify when each field was set. There
|     * are two special values, UNSET and INTERNALLY_SET. Values from
|     * MINIMUM_USER_SET to Integer.MAX_VALUE are legal user set values.
|     
					
					type       	"int"
					exportControl 	"Implementation")
				    (object ClassAttribute "time"
					attributes 	(list Attribute_Set)
					quid       	"3968B5F60065"
					documentation 	
|
|     * The currently set time for this calendar, expressed in milliseconds after
|     * January 1, 1970, 0:00:00 GMT.
|     * @see #isTimeSet
|     * @serial
|     
					
					type       	"long"
					exportControl 	"Protected")
				    (object ClassAttribute "isTimeSet"
					attributes 	(list Attribute_Set)
					quid       	"3968B5F60066"
					documentation 	
|
|     * True if then the value of <code>time</code> is valid.
|     * The time is made invalid by a change to an item of <code>field[]</code>.
|     * @see #time
|     * @serial
|     
					
					type       	"boolean"
					exportControl 	"Protected")
				    (object ClassAttribute "areFieldsSet"
					attributes 	(list Attribute_Set)
					quid       	"3968B5F60067"
					documentation 	
|
|     * True if <code>fields[]</code> are in sync with the currently set time.
|     * If false, then the next attempt to get the value of a field will
|     * force a recomputation of all fields from the current value of
|     * <code>time</code>.
|     * @serial
|     
					
					type       	"boolean"
					exportControl 	"Protected")
				    (object ClassAttribute "areAllFieldsSet"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Transient"
						value      	TRUE))
					quid       	"3968B5F60068"
					documentation 	
|
|     * True if all fields have been set.
|     * @serial
|     
					
					type       	"boolean"
					exportControl 	"Implementation")
				    (object ClassAttribute "lenient"
					attributes 	(list Attribute_Set)
					quid       	"3968B5F6006A"
					documentation 	
|
|     * True if this calendar allows out-of-range field values during computation
|     * of <code>time</code> from <code>fields[]</code>.
|     * @see #setLenient
|     * @serial
|     
					
					type       	"boolean"
					initv      	"true")
				    (object ClassAttribute "firstDayOfWeek"
					attributes 	(list Attribute_Set)
					quid       	"3968B5F60078"
					documentation 	
|
|     * The first day of the week, with possible values <code>SUNDAY</code>,
|     * <code>MONDAY</code>, etc.  This is a locale-dependent value.
|     * @serial
|     
					
					type       	"int")
				    (object ClassAttribute "minimalDaysInFirstWeek"
					attributes 	(list Attribute_Set)
					quid       	"3968B5F60079"
					documentation 	
|
|     * The number of days required for the first week in a month or year,
|     * with possible values from 1 to 7.  This is a locale-dependent value.
|     * @serial
|     
					
					type       	"int")
				    (object ClassAttribute "UNSET"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5F6008B"
					type       	"int"
					initv      	"0"
					exportControl 	"Implementation"
					static     	TRUE)
				    (object ClassAttribute "INTERNALLY_SET"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5F6008C"
					type       	"int"
					initv      	"1"
					exportControl 	"Implementation"
					static     	TRUE)
				    (object ClassAttribute "MINIMUM_USER_STAMP"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5F6008D"
					type       	"int"
					initv      	"2"
					exportControl 	"Implementation"
					static     	TRUE)
				    (object ClassAttribute "nextStamp"
					attributes 	(list Attribute_Set)
					quid       	"3968B5F6008E"
					documentation 	
|
|     * The next available value for <code>stamp[]</code>, an internal array.
|     * This actually should not be written out to the stream, and will probably
|     * be removed from the stream in the near future.  In the meantime,
|     * a value of <code>MINIMUM_USER_STAMP</code> should be used.
|     * @serial
|     
					
					type       	"int"
					initv      	"MINIMUM_USER_STAMP")
				    (object ClassAttribute "currentSerialVersion"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5F60092"
					type       	"int"
					initv      	"1"
					exportControl 	"Implementation"
					static     	TRUE)
				    (object ClassAttribute "serialVersionOnStream"
					attributes 	(list Attribute_Set)
					quid       	"3968B5F60093"
					documentation 	
|
|     * The version of the serialized data on the stream.  Possible values:
|     * <dl>
|     * <dt><b>0</b> or not present on stream</dt>
|     * <dd>
|     * JDK 1.1.5 or earlier.
|     * </dd>
|     * <dt><b>1</b></dt>
|     * <dd>
|     * JDK 1.1.6 or later.  Writes a correct 'time' value
|     * as well as compatible values for other fields.  This is a
|     * transitional format.
|     * </dd>
|     * </dl>
|     * When streaming out this class, the most recent format
|     * and the highest allowable <code>serialVersionOnStream</code>
|     * is written.
|     * @serial
|     * @since JDK1.1.6
|     
					
					type       	"int"
					initv      	"currentSerialVersion")
				    (object ClassAttribute "serialVersionUID"
