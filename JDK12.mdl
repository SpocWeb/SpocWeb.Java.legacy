						quid       	"3968B58F0162"
						documentation 	
|
|     * Constructs a ContainerEvent object.
|     * 
|     * @param source the Component object (container) that originated the event
|     * @param id     an integer indicating the type of event
|     * @param child  the component that was added or removed
|     
						
						parameters 	(list Parameters
						    (object Parameter "source"
							type       	"Component")
						    (object Parameter "id"
							type       	"int")
						    (object Parameter "child"
							type       	"Component"))
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getContainer"
						attributes 	(list Attribute_Set)
						quid       	"3968B58F0169"
						documentation 	
|
|     * Returns the originator of the event.
|     *
|     * @return the Container object that originated the event
|     
						
						result     	"Container"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getChild"
						attributes 	(list Attribute_Set)
						quid       	"3968B58F016A"
						documentation 	
|
|     * Returns the component that was affected by the event.
|     *
|     * @return the Component object that was added or removed
|     
						
						result     	"Component"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "paramString"
						attributes 	(list Attribute_Set)
						quid       	"3968B58F016B"
						documentation 	
|
|     * Returns a parameter string identifying this event.
|     * This method is useful for event-logging and for debugging.
|     *
|     * @return a string identifying the event and its attributes
|     
						
						result     	"String"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0))
