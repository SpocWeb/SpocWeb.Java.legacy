						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B58F0203"
						documentation 	
|
|     * Invoked when a window is changed from a normal to a
|     * minimized state. For many platforms, a minimized window 
|     * is displayed as the icon specified in the window's 
|     * iconImage property.
