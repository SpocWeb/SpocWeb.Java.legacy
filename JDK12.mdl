					quidu      	"3968B5C30389"
					language   	"Java")
				    (object Class "ActivationInstantiator"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"GenerateFinalizer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
