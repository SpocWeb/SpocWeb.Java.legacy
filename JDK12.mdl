|     
						
						parameters 	(list Parameters
						    (object Parameter "x"
							type       	"int")
						    (object Parameter "y"
							type       	"int")
						    (object Parameter "w"
							type       	"int")
						    (object Parameter "h"
							type       	"int")
						    (object Parameter "model"
							type       	"ColorModel")
						    (object Parameter "pixels[]"
							type       	"byte")
						    (object Parameter "off"
