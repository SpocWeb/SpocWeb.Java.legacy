				module     	"Component View::java::beans::PropertyChangeSupport"
				quidu      	"3968B56602CC"
				language   	"Java")
			    (object Class "EventSetDescriptor"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"GenerateFinalizer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateStaticInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateInstanceInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateDefaultConstructor"
					value      	FALSE))
				quid       	"3968B59D024C"
				documentation 	
|
| * An EventSetDescriptor describes a group of events that a given Java
| * bean fires.
| * <P>
| * The given group of events are all delivered as method calls on a single
| * event listener interface, and an event listener object can be registered
| * via a call on a registration method supplied by the event source.
| 
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B59D0257"
					supplier   	"Logical View::java::beans::FeatureDescriptor"))
				operations 	(list Operations
				    (object Operation "EventSetDescriptor"
					attributes 	(list Attribute_Set)
					quid       	"3968B59D0283"
					documentation 	
|
|     * This constructor creates an EventSetDescriptor assuming that you are
|     * following the most simple standard design pattern where a named
|     * event "fred" is (1) delivered as a call on the single method of
|     * interface FredListener, (2) has a single argument of type FredEvent,
|     * and (3) where the FredListener may be registered with a call on an
|     * addFredListener method of the source component and removed with a
|     * call on a removeFredListener method.
|     *
|     * @param sourceClass  The class firing the event.
|     * @param eventSetName  The programmatic name of the event.  E.g. "fred".
|     *		Note that this should normally start with a lower-case character.
|     * @param listenerType  The target interface that events
|     *		will get delivered to.
|     * @param listenerMethodName  The method that will get called when the event gets
|     *		delivered to its target listener interface.
|     * @exception IntrospectionException if an exception occurs during
|     *              introspection.
|     
					
					parameters 	(list Parameters
					    (object Parameter "sourceClass"
						type       	"Class")
					    (object Parameter "eventSetName"
						type       	"String")
					    (object Parameter "listenerType"
						type       	"Class")
					    (object Parameter "listenerMethodName"
						type       	"String"))
					exceptions 	"IntrospectionException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "EventSetDescriptor"
					attributes 	(list Attribute_Set)
					quid       	"3968B59D028B"
					documentation 	
|
|     * This constructor creates an EventSetDescriptor from scratch using
|     * string names.
|     *
|     * @param sourceClass  The class firing the event.
|     * @param eventSetName The programmatic name of the event set.
|     *		Note that this should normally start with a lower-case character.
|     * @param listenerType  The Class of the target interface that events
|     *		will get delivered to.
|     * @param listenerMethodNames The names of the methods that will get called 
|     *		when the event gets delivered to its target listener interface.
|     * @param addListenerMethodName  The name of the method on the event source
|     *		that can be used to register an event listener object.
|     * @param removeListenerMethodName  The name of the method on the event source
|     *		that can be used to de-register an event listener object.
|     * @exception IntrospectionException if an exception occurs during
|     *              introspection.
|     
					
					parameters 	(list Parameters
					    (object Parameter "sourceClass"
						type       	"Class")
					    (object Parameter "eventSetName"
