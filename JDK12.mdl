					    (object Parameter "id"
						type       	"int")
					    (object Parameter "load"
						type       	"boolean")
					    (object Parameter "verify"
						type       	"boolean"))
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Private"
					uid        	0)
				    (object Operation "removeImage"
