				language   	"Java")
			    (object Class "AlgorithmParameterGeneratorSpi"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"GenerateFinalizer"
					value      	FALSE)
				    (object Attribute
