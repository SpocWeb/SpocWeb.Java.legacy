					type       	"int"
					initv      	"2")
				    (object ClassAttribute "serialVersionUID"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B59F00C3"
					documentation 	
|
|     * Serialization version ID, so we're compatible with JDK 1.1
