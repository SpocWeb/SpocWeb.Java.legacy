|     * and size (width, height) specified by rect, a
|     * new SampleModel, and a new initialized DataBuffer.
|     
						
						parameters 	(list Parameters
						    (object Parameter "rect"
							type       	"Rectangle"))
						result     	"WritableRaster"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "createCompatibleWritableRaster"
						attributes 	(list Attribute_Set)
						quid       	"3968B58601E9"
						documentation 	
|
|     * Create a compatible WritableRaster with the specified
|     * location (minX, minY) and size (width, height), a
|     * new SampleModel, and a new initialized DataBuffer.
|     
						
						parameters 	(list Parameters
						    (object Parameter "x"
							type       	"int")
						    (object Parameter "y"
							type       	"int")
						    (object Parameter "w"
							type       	"int")
						    (object Parameter "h"
							type       	"int"))
						result     	"WritableRaster"
