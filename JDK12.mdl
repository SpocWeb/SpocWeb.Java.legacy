				quid       	"3968B5750278"
				documentation 	
|
| * A class to encapsulate symbolic colors representing the color
| * of GUI objects on a system.  For systems which support the dynamic
| * update of the system colors (when the user changes the colors)
| * the actual RGB values of these symbolic colors will also change
| * dynamically.  In order to compare the "current" RGB value of a SystemColor
| * object with a non-symbolic Color object, getRGB() should be used
| * rather than equals().
| *
| * @version 	1.15, 08/31/98
| * @author 	Carl Quinn
| * @author      Amy Fowler
| 
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B5750279"
					supplier   	"Logical View::java::awt::Color"))
				realized_interfaces 	(list realize_rel_list
				    (object Realize_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B5750281"
					supplier   	"Logical View::java::io::Serializable"))
				operations 	(list Operations
				    (object Operation "updateSystemColors"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE))
					quid       	"3968B5750318"
					documentation 	
|
|     * called from <init> & toolkit to update the above systemColors cache
|     
					
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Private"
					uid        	0)
				    (object Operation "SystemColor"
					attributes 	(list Attribute_Set)
					quid       	"3968B5750319"
					documentation 	
|
|     * Create a symbolic color that represents an indexed entry into system
|     * color cache. Used by above static system colors.
|     
					
					parameters 	(list Parameters
					    (object Parameter "index"
						type       	"byte"))
					concurrency 	"Sequential"
					opExportControl 	"Private"
					uid        	0)
				    (object Operation "getRGB"
					attributes 	(list Attribute_Set)
					quid       	"3968B575031B"
					documentation 	
|
|     * Gets the "current" RGB value representing the symbolic color.
|     * (Bits 24-31 are 0xff, 16-23 are red, 8-15 are green, 0-7 are blue).
|     * @see java.awt.image.ColorModel#getRGBdefault
|     * @see java.awt.Color#getBlue(int)
|     * @see java.awt.Color#getGreen(int)
|     * @see java.awt.Color#getRed(int)
|     
					
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "createContext"
					attributes 	(list Attribute_Set)
					quid       	"3968B575031C"
					documentation 	
|
|     * Create and return a PaintContext used to generate a solid color
|     * pattern.  This enables a Color object to be used as an argument to
|     * any method requiring an object implementing the Paint interface.
|     * @see Paint
|     * @see PaintContext
|     * @see Graphics2D#setPaint
|     
					
					parameters 	(list Parameters
					    (object Parameter "cm"
						type       	"ColorModel")
					    (object Parameter "r"
						type       	"Rectangle")
					    (object Parameter "r2d"
						type       	"Rectangle2D")
