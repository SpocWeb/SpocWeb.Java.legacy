|     * results of the union of <code>src1</code> and  
|     * <code>src2</code>
|     * @since JDK1.2
|     
						
						parameters 	(list Parameters
						    (object Parameter "src1"
							type       	"Rectangle2D")
						    (object Parameter "src2"
							type       	"Rectangle2D")
