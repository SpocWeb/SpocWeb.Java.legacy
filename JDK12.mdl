					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B56A00C6"
					documentation 	
|
|     * Gets this graphics context's current color.
|     * @return    this graphics context's current color.
|     * @see       java.awt.Color
|     * @see       java.awt.Graphics#setColor
|     
					
					result     	"Color"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setColor"
