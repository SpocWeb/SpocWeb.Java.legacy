					documentation 	
|
|     * Compare a given date in the year to a rule. Return 1, 0, or -1, depending
|     * on whether the date is after, equal to, or before the rule date. The
|     * millis are compared directly against the ruleMillis, so any
|     * standard-daylight adjustments must be handled by the caller.
|     *
|     * @return  1 if the date is after the rule date, -1 if the date is before
|     *          the rule date, or 0 if the date is equal to the rule date.
|     
					
					parameters 	(list Parameters
					    (object Parameter "month"
						type       	"int")
					    (object Parameter "monthLen"
						type       	"int")
					    (object Parameter "dayOfMonth"
						type       	"int")
					    (object Parameter "dayOfWeek"
						type       	"int")
					    (object Parameter "millis"
						type       	"int")
					    (object Parameter "ruleMode"
						type       	"int")
					    (object Parameter "ruleMonth"
						type       	"int")
					    (object Parameter "ruleDayOfWeek"
						type       	"int")
					    (object Parameter "ruleDay"
						type       	"int")
					    (object Parameter "ruleMillis"
						type       	"int"))
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Private"
					uid        	0)
				    (object Operation "getRawOffset"
					attributes 	(list Attribute_Set)
					quid       	"3968B5FA015E"
					documentation 	
|
|     * Overrides TimeZone
|     * Gets the GMT offset for this time zone.
|     
					
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setRawOffset"
					attributes 	(list Attribute_Set)
					quid       	"3968B5FA015F"
					documentation 	
|
|     * Overrides TimeZone
|     * Sets the base time zone offset to GMT.
|     * This is the offset to add *to* UTC to get local time.
|     * Please see TimeZone.setRawOffset for descriptions on the parameter.
|     
					
					parameters 	(list Parameters
					    (object Parameter "offsetMillis"
						type       	"int"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setDSTSavings"
					attributes 	(list Attribute_Set)
					quid       	"3968B5FA0161"
					documentation 	
|
|     * Sets the amount of time in ms that the clock is advanced during DST.
|     * @param millisSavedDuringDST the number of milliseconds the time is
|     * advanced with respect to standard time when the daylight savings rules
|     * are in effect. A positive number, typically one hour (3600000).
|     
					
					parameters 	(list Parameters
					    (object Parameter "millisSavedDuringDST"
						type       	"int"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
