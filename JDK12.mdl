					    (object Operation "getType"
						attributes 	(list Attribute_Set)
						quid       	"3968B5B7009E"
						documentation 	
|
|     * Returns a <code>Class</code> object that identifies the declared type for
|     * the field represented by this <code>Field</code> object.
|     
						
						result     	"Class"
						concurrency 	"Sequential"
