				    (object Operation "addPoint"
					attributes 	(list Attribute_Set)
					quid       	"3968B57403A1"
					documentation 	
|
|     * Appends the specified coordinates to this <code>Polygon</code>. 
|     * <p>
|     * If an operation that calculates the bounding box of this     
|     * <code>Polygon</code> has already been performed, such as  
|     * <code>getBounds</code> or <code>contains</code>, then this 
|     * method updates the bounding box. 
|     * @param       x,&nbsp;y   the specified coordinates
|     * @see         java.awt.Polygon#getBounds
|     * @see         java.awt.Polygon#contains
|     
					
					parameters 	(list Parameters
					    (object Parameter "x"
						type       	"int")
					    (object Parameter "y"
						type       	"int"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getBounds"
					attributes 	(list Attribute_Set)
					quid       	"3968B57403A4"
					documentation 	
|
|     * Gets the bounding box of this <code>Polygon</code>. 
|     * The bounding box is the smallest {@link Rectangle} whose
|     * sides are parallel to the x and y axes of the 
|     * coordinate space, and can completely contain the <code>Polygon</code>.
|     * @return a <code>Rectangle</code> that defines the bounds of this 
|     * <code>Polygon</code>.
|     * @since       JDK1.1
|     
					
					result     	"Rectangle"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getBoundingBox"
					attributes 	(list Attribute_Set)
					quid       	"3968B57403A5"
					documentation 	
|
|     * @deprecated As of JDK version 1.1,
|     * replaced by <code>getBounds()</code>.
|     
					
					result     	"Rectangle"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "contains"
					attributes 	(list Attribute_Set)
					quid       	"3968B57403A6"
					documentation 	
|
|     * Determines whether the specified {@link Point} is inside this 
|     * <code>Polygon</code>.  Uses an even-odd insideness rule (also known
|     * as an alternating rule).
|     * @param p the specified <code>Point</code> to be tested
|     * @return <code>true</code> if the <code>Polygon</code> contains the
|     * 			<code>Point</code>; <code>false</code> otherwise.
|     
					
					parameters 	(list Parameters
					    (object Parameter "p"
						type       	"Point"))
					result     	"boolean"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "contains"
					attributes 	(list Attribute_Set)
					quid       	"3968B57403A8"
					documentation 	
|
|     * Determines whether the specified coordinates are contained in this 
|     * <code>Polygon</code>.   
|     * <p>
|     * (The <code>contains</code> method is based on code by 
|     * Hanpeter van Vliet [hvvliet@inter.nl.net].) 
|     * @param x,&nbsp;y  the specified coordinates to be tested
|     * @return  <code>true</code> if this <code>Polygon</code> contains
|     * 			the specified coordinates, (<i>x</i>,&nbsp;<i>y</i>);  
|     * 			<code>false</code> otherwise.
|     * @since      JDK1.1
|     
					
					parameters 	(list Parameters
					    (object Parameter "x"
						type       	"int")
					    (object Parameter "y"
						type       	"int"))
					result     	"boolean"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "inside"
					attributes 	(list Attribute_Set)
					quid       	"3968B57403AB"
					documentation 	
|
|     * @deprecated As of JDK version 1.1,
|     * replaced by <code>contains(int, int)</code>.
|     
					
					parameters 	(list Parameters
					    (object Parameter "x"
						type       	"int")
					    (object Parameter "y"
						type       	"int"))
					result     	"boolean"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getBounds2D"
					attributes 	(list Attribute_Set)
					quid       	"3968B57403AE"
					documentation 	
|
|     * Returns the high precision bounding box of the {@link Shape}.
|     * @return a {@link Rectangle2D} that precisely
|     *		bounds the <code>Shape</code>.
|     
					
					result     	"Rectangle2D"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "contains"
					attributes 	(list Attribute_Set)
					quid       	"3968B57403AF"
					documentation 	
|
|     * Tests if the specified coordinates are inside the boundary of the 
|     * <code>Shape</code>.
|     * @param x,&nbsp;y the specified coordinates
|     * @return <code>true</code> if the <code>Shape</code> contains the
|     * specified coordinates; <code>false</code> otherwise.
|     
					
					parameters 	(list Parameters
					    (object Parameter "x"
						type       	"double")
					    (object Parameter "y"
						type       	"double"))
					result     	"boolean"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getCrossings"
					attributes 	(list Attribute_Set)
					quid       	"3968B57403B2"
					parameters 	(list Parameters
					    (object Parameter "xlo"
						type       	"double")
					    (object Parameter "ylo"
						type       	"double")
					    (object Parameter "xhi"
						type       	"double")
					    (object Parameter "yhi"
						type       	"double"))
					result     	"Crossings"
