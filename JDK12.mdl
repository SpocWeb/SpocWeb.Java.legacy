						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateDefaultConstructor"
						value      	FALSE))
					quid       	"3968B5CC0347"
					documentation 	
|
| * <p>Abstract class for managing a variety of identity certificates.
| * An identity certificate is a binding of a principal to a public key which
| * is vouched for by another principal.  (A principal represents
| * an entity such as an individual user, a group, or a corporation.)
| *<p>
| * This class is an abstraction for certificates that have different
| * formats but important common uses.  For example, different types of
| * certificates, such as X.509 and PGP, share general certificate
| * functionality (like encoding and verifying) and
| * some types of information (like a public key).
| * <p>
| * X.509, PGP, and SDSI certificates can all be implemented by
| * subclassing the Certificate class, even though they contain different
| * sets of information, and they store and retrieve the information in
| * different ways.
| *
| * @see X509Certificate
| * @see CertificateFactory
| *
| * @author Hemma Prafullchandra
| * @version 1.14 98/12/03
| 
					
					operations 	(list Operations
					    (object Operation "Certificate"
						attributes 	(list Attribute_Set)
						quid       	"3968B5D50156"
						documentation 	
|
|     * Creates a certificate of the specified type.
|     *
|     * @param type the standard name of the certificate type.
|     * See Appendix A in the <a href=
|     * "../../../../guide/security/CryptoSpec.html#AppA">
|     * Java Cryptography Architecture API Specification &amp; Reference </a>
|     * for information about standard certificate types.
|     
						
						parameters 	(list Parameters
						    (object Parameter "type"
							type       	"String"))
						concurrency 	"Sequential"
						opExportControl 	"Protected"
						uid        	0)
					    (object Operation "getType"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B5D50158"
						documentation 	
|
|     * Returns the type of this certificate.
|     *
|     * @return the type of this certificate.
|     
						
						result     	"String"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "equals"
						attributes 	(list Attribute_Set)
						quid       	"3968B5D50159"
						documentation 	
|
|     * Compares this certificate for equality with the specified
|     * object. If the <code>other</code> object is an
|     * <code>instanceof</code> <code>Certificate</code>, then
|     * its encoded form is retrieved and compared with the
|     * encoded form of this certificate.
|     *
|     * @param other the object to test for equality with this certificate.
|     * @return true iff the encoded forms of the two certificates
|     * match, false otherwise.
|     
						
						parameters 	(list Parameters
						    (object Parameter "other"
							type       	"Object"))
						result     	"boolean"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "hashCode"
						attributes 	(list Attribute_Set)
						quid       	"3968B5D5015B"
						documentation 	
|
|     * Returns a hashcode value for this certificate from its
|     * encoded form.
|     *
|     * @return the hashcode value.
|     
						
						result     	"int"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getEncoded"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B5D5015D"
						documentation 	
|
|     * Returns the encoded form of this certificate. It is
|     * assumed that each certificate type would have only a single
|     * form of encoding; for example, X.509 certificates would
|     * be encoded as ASN.1 DER.
|     *
|     * @exception CertificateEncodingException if an encoding error occurs.
|     
						
						result     	"byte[]"
						exceptions 	"CertificateEncodingException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "verify"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B5D5015E"
						documentation 	
|
|     * Verifies that this certificate was signed using the
|     * private key that corresponds to the specified public key.
|     *
|     * @param key the PublicKey used to carry out the verification.
|     *
|     * @exception NoSuchAlgorithmException on unsupported signature
|     * algorithms.
|     * @exception InvalidKeyException on incorrect key.
|     * @exception NoSuchProviderException if there's no default provider.
|     * @exception SignatureException on signature errors.
|     * @exception CertificateException on encoding errors.
|     
						
						parameters 	(list Parameters
						    (object Parameter "key"
							type       	"PublicKey"))
						result     	"void"
						exceptions 	"CertificateException,NoSuchAlgorithmException,InvalidKeyException,NoSuchProviderException,SignatureException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "verify"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B5D50160"
						documentation 	
|
|
|     * Verifies that this certificate was signed using the
|     * private key that corresponds to the specified public key.
|     * This method uses the signature verification engine
|     * supplied by the specified provider.
|     *
|     * @param key the PublicKey used to carry out the verification.
|     * @param sigProvider the name of the signature provider.
|     *
|     * @exception NoSuchAlgorithmException on unsupported signature
|     * algorithms.
|     * @exception InvalidKeyException on incorrect key.
|     * @exception NoSuchProviderException on incorrect provider.
|     * @exception SignatureException on signature errors.
|     * @exception CertificateException on encoding errors.
|     
						
						parameters 	(list Parameters
						    (object Parameter "key"
							type       	"PublicKey")
						    (object Parameter "sigProvider"
							type       	"String"))
						result     	"void"
						exceptions 	"CertificateException,NoSuchAlgorithmException,InvalidKeyException,NoSuchProviderException,SignatureException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "toString"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B5D50163"
						documentation 	
|
|     * Returns a string representation of this certificate.
|     *
|     * @return a string representation of this certificate.
|     
						
						result     	"String"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getPublicKey"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B5D50164"
						documentation 	
|
|     * Gets the public key from this certificate.
|     *
|     * @return the public key.
|     
						
						result     	"PublicKey"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0))
