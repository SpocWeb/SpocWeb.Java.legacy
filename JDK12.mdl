					module     	"Component View::java::util::zip::ZipConstants"
					quidu      	"3968B5FF0031"
					language   	"Java")
				    (object Class "DeflaterOutputStream"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"GenerateFinalizer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateStaticInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateInstanceInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateDefaultConstructor"
						value      	FALSE))
					quid       	"3968B5FF008B"
					documentation 	
|
| * This class implements an output stream filter for compressing data in
| * the "deflate" compression format. It is also used as the basis for other
| * types of compression filters, such as GZIPOutputStream.
| *
| * @see		Deflater
| * @version 	1.23, 09/21/98
| * @author 	David Connelly
| 
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF009F"
						supplier   	"Logical View::java::io::FilterOutputStream"))
					operations 	(list Operations
					    (object Operation "DeflaterOutputStream"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF00B4"
						documentation 	
|
|     * Creates a new output stream with the specified compressor and
|     * buffer size.
|     * @param out the output stream
|     * @param def the compressor ("deflater")
|     * @param len the output buffer size
|     * @exception IllegalArgumentException if size is <= 0
|     
						
						parameters 	(list Parameters
						    (object Parameter "out"
							type       	"OutputStream")
						    (object Parameter "def"
							type       	"Deflater")
						    (object Parameter "size"
							type       	"int"))
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "DeflaterOutputStream"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF00B8"
						documentation 	
|
|     * Creates a new output stream with the specified compressor and
|     * a default buffer size.
|     * @param out the output stream
|     * @param def the compressor ("deflater")
|     
						
						parameters 	(list Parameters
						    (object Parameter "out"
							type       	"OutputStream")
						    (object Parameter "def"
							type       	"Deflater"))
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "DeflaterOutputStream"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF00BB"
						documentation 	
|
|     * Creates a new output stream with a defaul compressor and buffer size.
|     
						
						parameters 	(list Parameters
						    (object Parameter "out"
							type       	"OutputStream"))
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "write"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF00BD"
						documentation 	
|
|     * Writes a byte to the compressed output stream. This method will
|     * block until the byte can be written.
|     * @param b the byte to be written
|     * @exception IOException if an I/O error has occurred
|     
						
						parameters 	(list Parameters
						    (object Parameter "b"
							type       	"int"))
						result     	"void"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "write"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF00BF"
						documentation 	
|
|     * Writes an array of bytes to the compressed output stream. This
|     * method will block until all the bytes are written.
|     * @param buf the data to be written
|     * @param off the start offset of the data
|     * @param len the length of the data
|     * @exception IOException if an I/O error has occurred
|     
						
						parameters 	(list Parameters
						    (object Parameter "b"
							type       	"byte[]")
						    (object Parameter "off"
							type       	"int")
						    (object Parameter "len"
							type       	"int"))
						result     	"void"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "finish"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF00C3"
						documentation 	
|
|     * Finishes writing compressed data to the output stream without closing
|     * the underlying stream. Use this method when applying multiple filters
|     * in succession to the same output stream.
|     * @exception IOException if an I/O error has occurred
|     
						
						result     	"void"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "close"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF00C4"
						documentation 	
|
|     * Writes remaining compressed data to the output stream and closes the
|     * underlying stream.
|     * @exception IOException if an I/O error has occurred
|     
						
						result     	"void"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "deflate"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF00C5"
						documentation 	
|
|     * Writes next block of compressed data to the output stream.
|     
						
						result     	"void"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Protected"
						uid        	0))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "buf[]"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF00B3"
						documentation 	
|
|     * Output buffer for writing compressed data.
|     
						
						type       	"byte"
						exportControl 	"Protected"))
					module     	"Component View::java::util::zip::DeflaterOutputStream"
					quidu      	"3968B5FF0081"
					language   	"Java")
				    (object Class "InflaterInputStream"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"GenerateFinalizer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateStaticInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateInstanceInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateDefaultConstructor"
						value      	FALSE))
					quid       	"3968B5FF0118"
					documentation 	
|
| * This class implements a stream filter for uncompressing data in the
| * "deflate" compression format. It is also used as the basis for other
| * decompression filters, such as GZIPInputStream.
| *
| * @see		Inflater
| * @version 	1.23, 07/28/98
| * @author 	David Connelly
| 
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF012B"
						supplier   	"Logical View::java::io::FilterInputStream"))
					operations 	(list Operations
					    (object Operation "ensureOpen"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0146"
						documentation 	
|
|     * Check to make sure that this stream has not been closed
|     
						
						result     	"void"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Private"
						uid        	0)
					    (object Operation "InflaterInputStream"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0147"
						documentation 	
|
|     * Creates a new input stream with the specified decompressor and
|     * buffer size.
|     * @param in the input stream
|     * @param inf the decompressor ("inflater")
|     * @param size the input buffer size
|     * @exception IllegalArgumentException if size is <= 0
|     
						
						parameters 	(list Parameters
						    (object Parameter "in"
							type       	"InputStream")
						    (object Parameter "inf"
							type       	"Inflater")
						    (object Parameter "size"
							type       	"int"))
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "InflaterInputStream"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF014B"
						documentation 	
|
|     * Creates a new input stream with the specified decompressor and a
|     * default buffer size.
|     * @param in the input stream
|     * @param inf the decompressor ("inflater")
|     
						
						parameters 	(list Parameters
						    (object Parameter "in"
							type       	"InputStream")
						    (object Parameter "inf"
							type       	"Inflater"))
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "InflaterInputStream"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF014E"
						documentation 	
|
|     * Creates a new input stream with a default decompressor and buffer size.
|     
						
						parameters 	(list Parameters
						    (object Parameter "in"
							type       	"InputStream"))
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "read"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0150"
						documentation 	
|
|     * Reads a byte of uncompressed data. This method will block until
|     * enough input is available for decompression.
|     * @return the byte read, or -1 if end of compressed input is reached
|     * @exception IOException if an I/O error has occurred
|     
						
						result     	"int"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "read"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0151"
						documentation 	
|
|     * Reads uncompressed data into an array of bytes. This method will
|     * block until some input can be decompressed.
|     * @param b the buffer into which the data is read
|     * @param off the start offset of the data
|     * @param len the maximum number of bytes read
|     * @return the actual number of bytes read, or -1 if the end of the
|     *         compressed input is reached or a preset dictionary is needed
|     * @exception ZipException if a ZIP format error has occurred
|     * @exception IOException if an I/O error has occurred
|     
						
						parameters 	(list Parameters
						    (object Parameter "b"
							type       	"byte[]")
						    (object Parameter "off"
							type       	"int")
						    (object Parameter "len"
							type       	"int"))
						result     	"int"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "available"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0155"
						documentation 	
|
|     * Returns 0 after EOF has reached, otherwise always return 1.
|     * <p>
|     * Programs should not count on this method to return the actual number
|     * of bytes that could be read without blocking.
|     *
|     * @return     1 before EOF and 0 after EOF.
|     * @exception  IOException  if an I/O error occurs.
|     * 
|     
						
						result     	"int"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "skip"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0156"
						documentation 	
|
|     * Skips specified number of bytes of uncompressed data.
|     * @param n the number of bytes to skip
|     * @return the actual number of bytes skipped.
|     * @exception IOException if an I/O error has occurred
|     * @exception IllegalArgumentException if n < 0
|     
						
						parameters 	(list Parameters
						    (object Parameter "n"
							type       	"long"))
						result     	"long"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "close"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0158"
						documentation 	
|
|     * Closes the input stream.
|     * @exception IOException if an I/O error has occurred
|     
						
						result     	"void"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
