						value      	FALSE))
					quid       	"3968B5FF0348"
					documentation 	
|
| * This class implements an input stream filter for reading files in the
| * ZIP file format. Includes support for both compressed and uncompressed
| * entries.
| *
| * @author	David Connelly
| * @version	1.23, 04/22/99
| 
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF035C"
						supplier   	"Logical View::java::util::zip::InflaterInputStream"))
					realized_interfaces 	(list realize_rel_list
					    (object Realize_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0366"
						supplier   	"Logical View::java::util::zip::ZipConstants"))
					operations 	(list Operations
					    (object Operation "ensureOpen"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0391"
						documentation 	
|
|     * Check to make sure that this stream has not been closed
|     
						
						result     	"void"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Private"
						uid        	0)
					    (object Operation "ZipInputStream"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0392"
						documentation 	
|
|     * Creates a new ZIP input stream.
|     * @param in the actual input stream
|     
						
						parameters 	(list Parameters
						    (object Parameter "in"
							type       	"InputStream"))
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getNextEntry"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0394"
						documentation 	
|
|     * Reads the next ZIP file entry and positions stream at the beginning
|     * of the entry data.
|     * @exception ZipException if a ZIP file error has occurred
|     * @exception IOException if an I/O error has occurred
|     
						
						result     	"ZipEntry"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "closeEntry"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0395"
						documentation 	
|
|     * Closes the current ZIP entry and positions the stream for reading the
|     * next entry.
|     * @exception ZipException if a ZIP file error has occurred
|     * @exception IOException if an I/O error has occurred
|     
						
						result     	"void"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "available"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0398"
						documentation 	
|
|     * Returns 0 after EOF has reached for the current entry data,
|     * otherwise always return 1.
|     * <p>
|     * Programs should not count on this method to return the actual number
|     * of bytes that could be read without blocking.
|     *
|     * @return     1 before EOF and 0 after EOF has reached for current entry.
|     * @exception  IOException  if an I/O error occurs.
|     * 
|     
						
						result     	"int"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "read"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF0399"
						documentation 	
|
|     * Reads from the current ZIP entry into an array of bytes. Blocks until
|     * some input is available.
|     * @param b the buffer into which the data is read
|     * @param off the start offset of the data
|     * @param len the maximum number of bytes read
|     * @return the actual number of bytes read, or -1 if the end of the
|     *         entry is reached
|     * @exception ZipException if a ZIP file error has occurred
|     * @exception IOException if an I/O error has occurred
|     
						
						parameters 	(list Parameters
						    (object Parameter "b"
							type       	"byte[]")
						    (object Parameter "off"
							type       	"int")
						    (object Parameter "len"
							type       	"int"))
						result     	"int"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "skip"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF039D"
						documentation 	
|
|     * Skips specified number of bytes in the current ZIP entry.
|     * @param n the number of bytes to skip
|     * @return the actual number of bytes skipped
|     * @exception ZipException if a ZIP file error has occurred
|     * @exception IOException if an I/O error has occurred
|     * @exception IllegalArgumentException if n < 0
|     
						
						parameters 	(list Parameters
						    (object Parameter "n"
							type       	"long"))
						result     	"long"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "close"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF039F"
						documentation 	
|
|     * Closes the ZIP input stream.
|     * @exception IOException if an I/O error has occurred
|     
						
						result     	"void"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "readLOC"
						attributes 	(list Attribute_Set)
						quid       	"3968B5FF03A0"
						result     	"ZipEntry"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Private"
						uid        	0)
					    (object Operation "getUTF8String"
