				quid       	"3968B57400BF"
				documentation 	
|
| * The <code>Transparency</code> interface defines the common transparency
| * modes for implementing classes.
| * @version 10 Feb 1997
| 
				
				stereotype 	"Interface"
				operations 	(list Operations
				    (object Operation "getTransparency"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B57902BC"
					documentation 	
|
|     * Returns the type of this <code>Transparency</code>.
|     * @return the field type of this <code>Transparency</code>, which is
|     *		either OPAQUE, BITMASK or TRANSLUCENT. 
|     
					
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "OPAQUE"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B57902B9"
					documentation 	
|
|     * Represents image data that is guaranteed to be completely opaque,
|     * meaning that all pixels have an alpha value of 1.0.
|     
					
					type       	"int"
					initv      	"1"
					exportControl 	"Public"
					static     	TRUE)
				    (object ClassAttribute "BITMASK"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B57902BA"
					documentation 	
|
|     * Represents image data that is guaranteed to be either completely
|     * opaque, with an alpha value of 1.0, or completely transparent,
|     * with an alpha value of 0.0.
|     
					
					type       	"int"
					initv      	"2"
					exportControl 	"Public"
					static     	TRUE)
				    (object ClassAttribute "TRANSLUCENT"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B57902BB"
					documentation 	
|
|     * Represents image data that contains or might contain arbitrary
|     * alpha values between and including 0.0 and 1.0.
|     
					
					type       	"int"
					initv      	"3"
					exportControl 	"Public"
					static     	TRUE))
