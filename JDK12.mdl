							value      	TRUE))
						quid       	"3968B58202D3"
						documentation 	
|
|     * Returns the mask indicating which bits in an int pixel representation
|     * contain the blue color component.
|     
						
						result     	"int"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getAlphaMask"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B58202D4"
						documentation 	
|
|     * Returns the mask indicating which bits in an int pixel representation
|     * contain the alpha component.
|     
						
						result     	"int"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getRed"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B58202D5"
						documentation 	
|
|     * Returns the red color component for the specified pixel, scaled
|     * from 0 to 255 in the default RGB ColorSpace, sRGB.  A color conversion
|     * is done if necessary.  The pixel value is specified as an int.
|     * The returned value will be a non pre-multiplied value, i.e. if the
|     * alpha is premultiplied, this method will divide it out before returning
|     * the value (if the alpha value is 0, the red value will be 0).
|     
						
						parameters 	(list Parameters
						    (object Parameter "pixel"
							type       	"int"))
						result     	"int"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getGreen"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B58202D7"
						documentation 	
|
|     * Returns the green color component for the specified pixel, scaled
|     * from 0 to 255 in the default RGB ColorSpace, sRGB.  A color conversion
|     * is done if necessary.  The pixel value is specified as an int.
|     * The returned value will be a non pre-multiplied value, i.e. if the
|     * alpha is premultiplied, this method will divide it out before returning
|     * the value (if the alpha value is 0, the green value will be 0).
|     
						
						parameters 	(list Parameters
						    (object Parameter "pixel"
							type       	"int"))
						result     	"int"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getBlue"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B58202D9"
						documentation 	
|
|     * Returns the blue color component for the specified pixel, scaled
|     * from 0 to 255 in the default RGB ColorSpace, sRGB.  A color conversion
|     * is done if necessary.  The pixel value is specified as an int.
|     * The returned value will be a non pre-multiplied value, i.e. if the
|     * alpha is premultiplied, this method will divide it out before returning
