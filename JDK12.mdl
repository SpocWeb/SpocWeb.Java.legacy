						quid       	"3968B58700C5"
						documentation 	" Returns the height in pixels. "
						result     	"int"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getNumBands"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B58700C6"
