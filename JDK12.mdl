						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "componentAdded"
						attributes 	(list Attribute_Set)
						quid       	"3968B57200E7"
						documentation 	
|
|	 * Invoked when a component has been added to a lightweight
|	 * parent.  This doesn't effect the native component.
|	 
						
						parameters 	(list Parameters
						    (object Parameter "e"
							type       	"ContainerEvent"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "componentRemoved"
						attributes 	(list Attribute_Set)
						quid       	"3968B57200E9"
						documentation 	
|
|	 * Invoked when a lightweight parent has been removed.
|	 * This means the services of this listener are no longer
|	 * required and it should remove all references (ie
|	 * registered listeners).
|	 
						
						parameters 	(list Parameters
						    (object Parameter "e"
							type       	"ContainerEvent"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "removeReferences"
						attributes 	(list Attribute_Set)
						quid       	"3968B57200EB"
						documentation 	
|
|	 * Remove references to this object so it can be
