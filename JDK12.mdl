						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B5D501CF"
						documentation 	
|
|     * Gets the serial number from this X509CRLEntry,
|     * the <em>userCertificate</em>.
