							name       	"Final"
							value      	TRUE))
						quid       	"3968B58F0277"
						documentation 	
|
|     * The window closed event. This event is delivered after
|     * the window has been closed as the result of a call to dispose.
|     
						
						type       	"int"
						initv      	"2 + WINDOW_FIRST"
						exportControl 	"Public"
						static     	TRUE)
