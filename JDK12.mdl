					uid        	0))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "READ"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5FC0019"
					documentation 	
|
