					    (object Parameter "withWhiteSpace"
						type       	"boolean"))
					result     	"String"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "findLastWithNoExtension"
					attributes 	(list Attribute_Set
					    (object Attribute
