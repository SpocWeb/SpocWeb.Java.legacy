					    (object Attribute
						tool       	"Java"
						name       	"Synchronized"
						value      	TRUE))
					quid       	"3968B56E02FB"
					documentation 	
|
|     * Returns the an array (length 1) containing the checkbox menu item
|     * label or null if the checkbox is not selected.
|     * @see ItemSelectable
|     
					
					result     	"Object[]"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
