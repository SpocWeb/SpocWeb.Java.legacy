					quid       	"3968B600000A"
					documentation 	
|
| * This class implements a stream filter for writing compressed data in
| * the GZIP file format.
| * @version 	1.15, 09/21/98
| * @author 	David Connelly
| *
| 
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3968B600001E"
						supplier   	"Logical View::java::util::zip::DeflaterOutputStream"))
					operations 	(list Operations
					    (object Operation "GZIPOutputStream"
						attributes 	(list Attribute_Set)
						quid       	"3968B600002C"
						documentation 	
|
|     * Creates a new output stream with the specified buffer size.
|     * @param out the output stream
|     * @param size the output buffer size
|     * @exception IOException If an I/O error has occurred.
|     * @exception IllegalArgumentException if size is <= 0
|     
						
						parameters 	(list Parameters
						    (object Parameter "out"
							type       	"OutputStream")
						    (object Parameter "size"
							type       	"int"))
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "GZIPOutputStream"
						attributes 	(list Attribute_Set)
						quid       	"3968B600002F"
						documentation 	
|
|     * Creates a new output stream with a default buffer size.
|     * @param out the output stream
|     * @exception IOException If an I/O error has occurred.
|     
						
						parameters 	(list Parameters
						    (object Parameter "out"
							type       	"OutputStream"))
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "write"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Synchronized"
							value      	TRUE))
						quid       	"3968B6000031"
						documentation 	
|
|     * Writes array of bytes to the compressed output stream. This method
|     * will block until all the bytes are written.
|     * @param buf the data to be written
|     * @param off the start offset of the data
|     * @param len the length of the data
|     * @exception IOException If an I/O error has occurred.
|     
						
						parameters 	(list Parameters
						    (object Parameter "buf"
							type       	"byte[]")
						    (object Parameter "off"
							type       	"int")
						    (object Parameter "len"
							type       	"int"))
						result     	"void"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "finish"
						attributes 	(list Attribute_Set)
						quid       	"3968B6000035"
						documentation 	
|
|     * Finishes writing compressed data to the output stream without closing
|     * the underlying stream. Use this method when applying multiple filters
|     * in succession to the same output stream.
|     * @exception IOException if an I/O error has occurred
|     
						
						result     	"void"
						exceptions 	"IOException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "close"
						attributes 	(list Attribute_Set)
						quid       	"3968B6000036"
						documentation 	
|
|     * Writes remaining compressed data to the output stream and closes the
|     * underlying stream.
