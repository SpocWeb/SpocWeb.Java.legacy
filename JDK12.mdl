					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B59401DC"
					documentation 	
|
| * The <code>TransformAttribute</code> class provides an immutable
| * wrapper for a transform so that it is safe to use as an attribute.
| 
					
					realized_interfaces 	(list realize_rel_list
					    (object Realize_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3968B59401E5"
						supplier   	"Logical View::java::io::Serializable"))
					operations 	(list Operations
					    (object Operation "TransformAttribute"
						attributes 	(list Attribute_Set)
						quid       	"3968B59401E9"
						documentation 	
|
|   * Wraps the specified transform.  The transform is cloned and a
|   * reference to the clone is kept.  The original transform is unchanged.
|   * @param transform the specified {@link AffineTransform} to be wrapped
|     
						
						parameters 	(list Parameters
						    (object Parameter "transform"
							type       	"AffineTransform"))
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getTransform"
						attributes 	(list Attribute_Set)
						quid       	"3968B59401F0"
						documentation 	
|
|     * Returns a copy of the wrapped transform.
|     * @return a <code>AffineTransform</code> that is a copy of the wrapped
|     * transform of this <code>TransformAttribute</code>.
|     
						
						result     	"AffineTransform"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0))
					module     	"Component View::java::awt::font::TransformAttribute"
					quidu      	"3968B59401DB"
					language   	"Java")
				    (object Class "GraphicAttribute"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"GenerateFinalizer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateStaticInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateInstanceInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateDefaultConstructor"
						value      	FALSE))
					quid       	"3968B5940273"
					documentation 	
|
| * This class is used with the CHAR_REPLACEMENT attribute.
| * <p>
| * The <code>GraphicAttribute</code> class represents a graphic embedded
| * in text. Clients subclass this class to implement their own char
| * replacement graphics.  Clients wishing to embed shapes and images in
| * text need not subclass this class.  Instead, clients can use the
| * {@link ShapeGraphicAttribute} and {@link ImageGraphicAttribute} 
| * classes.
| * <p>
| * Subclasses must ensure that their objects are immutable once they
| * are constructed.  Mutating a <code>GraphicAttribute</code> that
| * is used in a {@link TextLayout} results in undefined behavior from the
| * <code>TextLayout</code>.
| 
					
					operations 	(list Operations
					    (object Operation "GraphicAttribute"
						attributes 	(list Attribute_Set)
						quid       	"3968B5940280"
						documentation 	
|
|     * Constructs a <code>GraphicAttribute</code>.
|     * Subclasses use this to define the alignment of the graphic.
|     
						
						parameters 	(list Parameters
						    (object Parameter "alignment"
							type       	"int"))
						concurrency 	"Sequential"
						opExportControl 	"Protected"
						uid        	0)
					    (object Operation "getAscent"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B5940282"
						documentation 	
|
|     * Returns the ascent of this <code>GraphicAttribute</code>.  A
|     * graphic can be rendered above its ascent.
|     * @return the ascent of this <code>GraphicAttribute</code>.
|     * @see #getBounds()
|     
						
						result     	"float"
						concurrency 	"Sequential"
