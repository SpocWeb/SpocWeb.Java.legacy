					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5C602A6"
					documentation 	
|
|     * Returns this identity's name.
|     *
|     * @return the name of this identity.
|     
					
					result     	"String"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
