					documentation 	
|
|     * Constructs a key pair from the given public key and private key.
|     *
|     * <p>Note that this constructor only stores references to the public
|     * and private key components in the generated key pair. This is safe,
|     * because <code>Key</code> objects are immutable.
|     *
|     * @param publicKey the public key.
|     *
|     * @param privateKey the private key.
|     
					
					parameters 	(list Parameters
					    (object Parameter "publicKey"
						type       	"PublicKey")
					    (object Parameter "privateKey"
						type       	"PrivateKey"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getPublic"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CA006C"
					documentation 	
|
|     * Returns a reference to the public key component of this key pair.
|     *
|     * @return a reference to the public key.
|     
					
					result     	"PublicKey"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getPrivate"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CA006D"
					documentation 	
|
|     * Returns a reference to the private key component of this key pair.
|     *
|     * @return a reference to the private key.
|     
					
					result     	"PrivateKey"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0))
