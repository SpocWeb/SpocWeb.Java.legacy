					value      	FALSE))
				quid       	"3968B56E00C9"
				documentation 	
|
| * The <code>GridLayout</code> class is a layout manager that 
| * lays out a container's components in a rectangular grid. 
| * <p>
| * The container is divided into equal-sized rectangles, 
| * and one component is placed in each rectangle. 
| * <p>
| * For example, the following is an applet that lays out six buttons 
| * into three rows and two columns: 
| * <p>
| * <hr><blockquote><pre>
| * import java.awt.*;
| * import java.applet.Applet;
| * public class ButtonGrid extends Applet {
| *     public void init() {
| *         setLayout(new GridLayout(3,2));
| *         add(new Button("1"));
| *         add(new Button("2"));
| *         add(new Button("3"));
| *         add(new Button("4"));
| *         add(new Button("5"));
| *         add(new Button("6"));
| *     }
| * }
| * </pre></blockquote><hr>     
| * <p>
| * It produces the following output:
| * <p>
| * <img src="doc-files/GridLayout-1.gif" 
| * ALIGN=center HSPACE=10 VSPACE=7>
| * <p>
| * When both the number of rows and the number of columns have 
| * been set to non-zero values, either by a constructor or 
| * by the <tt>setRows</tt> and <tt>setColumns</tt> methods, the number of 
| * columns specified is ignored.  Instead, the number of 
| * columns is determined from the specified number or rows 
| * and the total number of components in the layout. So, for 
| * example, if three rows and two columns have been specified 
| * and nine components are added to the layout, then they will 
| * be displayed as three rows of three columns.  Specifying 
| * the number of columns affects the layout only when the 
| * number of rows is set to zero.
| *
| * @version 1.25, 04/22/99
| * @author 
| * @since   JDK1.0
| 
				
				realized_interfaces 	(list realize_rel_list
				    (object Realize_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B56E00CA"
					supplier   	"Logical View::java::awt::LayoutManager")
				    (object Realize_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B56E00D2"
					supplier   	"Logical View::java::io::Serializable"))
				operations 	(list Operations
				    (object Operation "GridLayout"
					attributes 	(list Attribute_Set)
					quid       	"3968B56E00D7"
					documentation 	
|
|     * Creates a grid layout with a default of one column per component,
|     * in a single row.
|     * @since JDK1.1
|     
					
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "GridLayout"
					attributes 	(list Attribute_Set)
					quid       	"3968B56E00D8"
					documentation 	
|
|     * Creates a grid layout with the specified number of rows and 
|     * columns. All components in the layout are given equal size. 
|     * <p>
|     * One, but not both, of <code>rows</code> and <code>cols</code> can 
|     * be zero, which means that any number of objects can be placed in a 
|     * row or in a column. 
|     * @param     rows   the rows, with the value zero meaning 
|     *                   any number of rows.
|     * @param     cols   the columns, with the value zero meaning 
|     *                   any number of columns.
|     
					
					parameters 	(list Parameters
					    (object Parameter "rows"
						type       	"int")
					    (object Parameter "cols"
						type       	"int"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "GridLayout"
					attributes 	(list Attribute_Set)
					quid       	"3968B56E00DB"
					documentation 	
|
|     * Creates a grid layout with the specified number of rows and 
|     * columns. All components in the layout are given equal size. 
|     * <p>
|     * In addition, the horizontal and vertical gaps are set to the 
|     * specified values. Horizontal gaps are placed at the left and 
|     * right edges, and between each of the columns. Vertical gaps are 
|     * placed at the top and bottom edges, and between each of the rows. 
|     * <p>
|     * One, but not both, of <code>rows</code> and <code>cols</code> can 
|     * be zero, which means that any number of objects can be placed in a 
|     * row or in a column. 
|     * @param     rows   the rows, with the value zero meaning 
|     *                   any number of rows.
|     * @param     cols   the columns, with the value zero meaning 
|     *                   any number of columns.
|     * @param     hgap   the horizontal gap. 
|     * @param     vgap   the vertical gap. 
|     * @exception   IllegalArgumentException  if the of <code>rows</code> 
|     *                   or <code>cols</code> is invalid.
|     
					
					parameters 	(list Parameters
					    (object Parameter "rows"
						type       	"int")
					    (object Parameter "cols"
						type       	"int")
					    (object Parameter "hgap"
						type       	"int")
					    (object Parameter "vgap"
						type       	"int"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getRows"
					attributes 	(list Attribute_Set)
					quid       	"3968B56E00E0"
					documentation 	
|
|     * Gets the number of rows in this layout.
|     * @return    the number of rows in this layout.
|     * @since     JDK1.1
|     
					
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setRows"
					attributes 	(list Attribute_Set)
					quid       	"3968B56E00E1"
					documentation 	
|
|     * Sets the number of rows in this layout to the specified value.
|     * @param        rows   the number of rows in this layout.
|     * @exception    IllegalArgumentException  if the value of both 
|     *               <code>rows</code> and <code>cols</code> is set to zero.
|     * @since        JDK1.1
|     
					
					parameters 	(list Parameters
					    (object Parameter "rows"
						type       	"int"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getColumns"
					attributes 	(list Attribute_Set)
					quid       	"3968B56E00E3"
					documentation 	
|
|     * Gets the number of columns in this layout.
|     * @return     the number of columns in this layout.
|     * @since      JDK1.1
|     
					
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setColumns"
					attributes 	(list Attribute_Set)
					quid       	"3968B56E00E4"
					documentation 	
|
|     * Sets the number of columns in this layout to the specified value. 
|     * Setting the number of columns has no affect on the layout 
|     * if the number of rows specified by a constructor or by 
|     * the <tt>setRows</tt> method is non-zero. In that case, the number 
|     * of columns displayed in the layout is determined by the total 
|     * number of components and the number of rows specified.
|     * @param        cols   the number of columns in this layout.
|     * @exception    IllegalArgumentException  if the value of both 
|     *               <code>rows</code> and <code>cols</code> is set to zero.
|     * @since        JDK1.1
|     
					
					parameters 	(list Parameters
					    (object Parameter "cols"
						type       	"int"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getHgap"
					attributes 	(list Attribute_Set)
					quid       	"3968B56E00E6"
					documentation 	
|
|     * Gets the horizontal gap between components.
|     * @return       the horizontal gap between components.
|     * @since        JDK1.1
|     
					
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setHgap"
					attributes 	(list Attribute_Set)
					quid       	"3968B56E00E7"
					documentation 	
|
|     * Sets the horizontal gap between components to the specified value.
|     * @param        hgap   the horizontal gap between components.
|     * @since        JDK1.1
|     
					
					parameters 	(list Parameters
					    (object Parameter "hgap"
						type       	"int"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getVgap"
