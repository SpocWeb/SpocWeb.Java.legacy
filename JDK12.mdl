|     * will have the same hashcode if they are equal with respect to their
|     * content.
|     *
|     * @return the hashcode
|     * @see java.util.Hashtable
|     * @since JDK1.1
|     
						
						result     	"int"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
