							value      	TRUE))
						quid       	"3968B58F0205"
						documentation 	
|
|     * Invoked when a window is changed from a minimized
|     * to a normal state.
|     
						
						parameters 	(list Parameters
						    (object Parameter "e"
							type       	"WindowEvent"))
						result     	"void"
