				quid       	"3968B5CC0069"
				documentation 	
|
| * <p> This class defines the <i>Service Provider Interface</i> (<b>SPI</b>)
| * for the <code>KeyPairGenerator</code> class, which is used to generate
| * pairs of public and private keys.
| *
| * <p> All the abstract methods in this class must be implemented by each
| * cryptographic service provider who wishes to supply the implementation
| * of a key pair generator for a particular algorithm.
| * 
| * <p> In case the client does not explicitly initialize the KeyPairGenerator
| * (via a call to an <code>initialize</code> method), each provider must
| * supply (and document) a default initialization.
| * For example, the <i>Sun</i> provider uses a default modulus size (keysize)
| * of 1024 bits.
| *
| * @author Benjamin Renaud
| *
| * @version 1.5 98/12/03
| *
| * @see KeyPairGenerator
| * @see java.security.spec.AlgorithmParameterSpec
| 
				
				operations 	(list Operations
				    (object Operation "initialize"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B5D20054"
					documentation 	
|
|     * Initializes the key pair generator for a certain keysize, using
|     * the default parameter set.
|     *
|     * @param keysize the keysize. This is an
|     * algorithm-specific metric, such as modulus length, specified in
|     * number of bits.
|     *
|     * @param random the source of randomness for this generator.
|     
					
					parameters 	(list Parameters
					    (object Parameter "keysize"
						type       	"int")
					    (object Parameter "random"
						type       	"SecureRandom"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "initialize"
					attributes 	(list Attribute_Set)
					quid       	"3968B5D20057"
					documentation 	
|
|     * Initializes the key pair generator using the specified parameter
|     * set and user-provided source of randomness.
|     *
|     * <p>This concrete method has been added to this previously-defined
|     * abstract class. (For backwards compatibility, it cannot be abstract.)
|     * It may be overridden by a provider to initialize the key pair 
|     * generator. Such an override
|     * is expected to throw an InvalidAlgorithmParameterException if
|     * a parameter is inappropriate for this key pair generator.
|     * If this method is not overridden, it always throws an
|     * UnsupportedOperationException.
|     *
|     * @param params the parameter set used to generate the keys.
|     *
|     * @param random the source of randomness for this generator.
|     *
|     * @exception InvalidAlgorithmParameterException if the given parameters
|     * are inappropriate for this key pair generator.
|     *
|     * @since JDK1.2
|     
					
					parameters 	(list Parameters
					    (object Parameter "params"
						type       	"AlgorithmParameterSpec")
					    (object Parameter "random"
						type       	"SecureRandom"))
					result     	"void"
					exceptions 	"InvalidAlgorithmParameterException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "generateKeyPair"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
