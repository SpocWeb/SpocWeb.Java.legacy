|     * will be used to hold the return value.
|     
						
						parameters 	(list Parameters
						    (object Parameter "srcPt"
							type       	"Point2D")
						    (object Parameter "dstPt"
							type       	"Point2D"))
						result     	"Point2D"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
