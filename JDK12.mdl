					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "serialVersionUID"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B5C400ED"
						documentation 	" indicate compatibility with JDK 1.2 version of class "
						type       	"long"
						initv      	"- 4320118837291406071L"
