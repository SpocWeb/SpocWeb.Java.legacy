				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "serialVersionUID"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5F0036F"
