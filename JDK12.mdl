				quid       	"3968B56400E7"
				documentation 	
|
| * The <code>AudioClip</code> interface is a simple abstraction for
| * playing a sound clip. Multiple <code>AudioClip</code> items can be
| * playing at the same time, and the resulting sound is mixed
| * together to produce a composite.
| *
| * @author 	Arthur van Hoff
| * @version     1.13, 09/21/98
| * @since       JDK1.0
| 
				
				stereotype 	"Interface"
				operations 	(list Operations
				    (object Operation "play"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B56400E8"
					documentation 	
|
|     * Starts playing this audio clip. Each time this method is called,
|     * the clip is restarted from the beginning.
|     
					
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Implementation"
					uid        	0)
				    (object Operation "loop"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B56400E9"
					documentation 	
|
|     * Starts playing this audio clip in a loop.
|     
					
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Implementation"
					uid        	0)
				    (object Operation "stop"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B56400EA"
					documentation 	
|
|     * Stops playing this audio clip.
|     
					
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Implementation"
					uid        	0))
