					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"Final"
					value      	TRUE))
				quid       	"3968B5CF0113"
				documentation 	
|
| * A BasicPermissionCollection stores a collection
| * of BasicPermission permissions. BasicPermission objects
| * must be stored in a manner that allows them to be inserted in any
| * order, but enable the implies function to evaluate the implies
| * method in an efficient (and consistent) manner.
| *
| * A BasicPermissionCollection handles comparing a permission like "a.b.c.d.e"
| * with a Permission such as "a.b.*", or "*".
| *
| * @see java.security.Permission
| * @see java.security.Permissions
| * @see java.security.PermissionsImpl
| *
| * @version 1.18 99/10/21
| *
| * @author Roland Schemers
| 
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B5CF0122"
					supplier   	"Logical View::java::security::PermissionCollection"))
				realized_interfaces 	(list realize_rel_list
				    (object Realize_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B5CF012C"
					supplier   	"Logical View::java::io::Serializable"))
				exportControl 	"Implementation"
				operations 	(list Operations
				    (object Operation "BasicPermissionCollection"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CF013A"
					documentation 	
|
|     * Create an empty BasicPermissions object.
