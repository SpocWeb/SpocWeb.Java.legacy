						quid       	"3968B5B603CB"
						documentation 	
|
|     * Returns the name of the method represented by this <code>Method</code> 
|     * object, as a <code>String</code>.
|     
						
						result     	"String"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
