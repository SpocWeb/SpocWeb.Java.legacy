				documentation 	
|
| * This class defines the <i>Service Provider Interface</i> (<b>SPI</b>)
| * for the <code>KeyStore</code> class.
| * All the abstract methods in this class must be implemented by each
| * cryptographic service provider who wishes to supply the implementation
| * of a keystore for a particular keystore type.
| *
| * @author Jan Luehe
| *
| * @version 1.4, 06/29/98
| *
| * @see KeyStore
| *
| * @since JDK1.2
| 
				
				operations 	(list Operations
				    (object Operation "engineGetKey"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B5D4004E"
					documentation 	
|
|     * Returns the key associated with the given alias, using the given
|     * password to recover it.
|     *
|     * @param alias the alias name
|     * @param password the password for recovering the key
|     *
|     * @return the requested key, or null if the given alias does not exist
|     * or does not identify a <i>key entry</i>.
|     *
|     * @exception NoSuchAlgorithmException if the algorithm for recovering the
|     * key cannot be found
|     * @exception UnrecoverableKeyException if the key cannot be recovered
|     * (e.g., the given password is wrong).
|     
					
					parameters 	(list Parameters
					    (object Parameter "alias"
						type       	"String")
					    (object Parameter "password"
						type       	"char[]"))
					result     	"Key"
					exceptions 	"NoSuchAlgorithmException,UnrecoverableKeyException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "engineGetCertificateChain"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B5D40051"
					documentation 	
|
|     * Returns the certificate chain associated with the given alias.
|     *
|     * @param alias the alias name
|     *
|     * @return the certificate chain (ordered with the user's certificate first
|     * and the root certificate authority last), or null if the given alias
|     * does not exist or does not contain a certificate chain (i.e., the given
|     * alias identifies either a <i>trusted certificate entry</i> or a
|     * <i>key entry</i> without a certificate chain).
|     
					
					parameters 	(list Parameters
					    (object Parameter "alias"
						type       	"String"))
					result     	"Certificate[]"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "engineGetCertificate"
