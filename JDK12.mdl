|    
						
						parameters 	(list Parameters
						    (object Parameter "glyphIndex"
							type       	"int"))
						result     	"GlyphJustificationInfo"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "equals"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B59302DD"
						documentation 	
|
|    *   Tests if the specified <code>GlyphVector</code> exactly
|    *	equals this <code>GlyphVector</code>.
|    *	@param set the specified <code>GlyphVector</code> to test
|    *	@return <code>true</code> if the specified
|    *	<code>GlyphVector</code> equals this <code>GlyphVector</code>;
|    *	<code>false</code> otherwise.
|    
						
						parameters 	(list Parameters
						    (object Parameter "set"
							type       	"GlyphVector"))
						result     	"boolean"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0))
					module     	"Component View::java::awt::font::GlyphVector"
					quidu      	"3968B57803B4"
					language   	"Java"
					abstract   	TRUE)
				    (object Class "TextJustifier"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"GenerateFinalizer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateStaticInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateInstanceInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateDefaultConstructor"
						value      	FALSE))
					quid       	"3968B593032E"
					exportControl 	"Implementation"
					operations 	(list Operations
					    (object Operation "TextJustifier"
						attributes 	(list Attribute_Set)
						quid       	"3968B593033C"
						documentation 	
|
|     * Initialize the justifier with an array of infos corresponding to each
|     * glyph. Start and limit indicate the range of the array to examine.
|     
						
						parameters 	(list Parameters
						    (object Parameter "info"
							type       	"GlyphJustificationInfo[]")
						    (object Parameter "start"
							type       	"int")
						    (object Parameter "limit"
							type       	"int"))
						concurrency 	"Sequential"
						opExportControl 	"Implementation"
						uid        	0)
					    (object Operation "justify"
						attributes 	(list Attribute_Set)
						quid       	"3968B5930340"
						documentation 	
|
|     * Return an array of deltas twice as long as the original info array,
|     * indicating the amount by which each side of each glyph should grow
|     * or shrink.
|     *
|     * Delta should be positive to expand the line, and negative to compress it.
|     
						
						parameters 	(list Parameters
						    (object Parameter "delta"
							type       	"float"))
						result     	"float[]"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "start"
						attributes 	(list Attribute_Set)
						quid       	"3968B5930338"
						type       	"int")
					    (object ClassAttribute "limit"
						attributes 	(list Attribute_Set)
						quid       	"3968B5930339"
						type       	"int")
					    (object ClassAttribute "DEBUG"
						attributes 	(list Attribute_Set)
						quid       	"3968B593033A"
						type       	"boolean"
						initv      	"false"
						exportControl 	"Implementation"
						static     	TRUE)
					    (object ClassAttribute "MAX_PRIORITY"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B593033B"
						type       	"int"
						initv      	"3"
						exportControl 	"Public"
						static     	TRUE))
					module     	"Component View::java::awt::font::TextJustifier"
					quidu      	"3968B5930324"
					language   	"Java")
				    (object Class "GlyphJustificationInfo"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"GenerateFinalizer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateStaticInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateInstanceInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateDefaultConstructor"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B593032F"
					documentation 	
|
| * The <code>GlyphJustificationInfo</code> class represents information
| * about the justification properties of a glyph.  A glyph is the visual 
| * representation of one or more characters.  Many different glyphs can
| * be used to represent a single character or combination of characters.
| * The four justification properties represented by
| * <code>GlyphJustificationInfo</code> are weight, priority, absorb and
| * limit.
| * <p>
| * Weight is the overall 'weight' of the glyph in the line.  Generally it is
| * proportional to the size of the font.  Glyphs with larger weight are
| * allocated a correspondingly larger amount of the change in space.
| * <p>
| * Priority determines the justification phase in which this glyph is used.
| * All glyphs of the same priority are examined before glyphs of the next
| * priority.  If all the change in space can be allocated to these glyphs
| * without exceeding their limits, then glyphs of the next priority are not
| * examined. There are four priorities, kashida, whitespace, interchar,
| * and none.  KASHIDA is the first priority examined. NONE is the last
| * priority examined.
| * <p>
| * Absorb determines whether a glyph absorbs all change in space.  Within a
| * given priority, some glyphs may absorb all the change in space.  If any of
| * these glyphs are present, no glyphs of later priority are examined.
| * <p>
| * Limit determines the maximum or minimum amount by which the glyph can
| * change. Left and right sides of the glyph can have different limits.
| * <p>
| * Each <code>GlyphJustificationInfo</code> represents two sets of
| * metrics, which are <i>growing</i> and <i>shrinking</i>.  Growing
| * metrics are used when the glyphs on a line are to be
| * spread apart to fit a larger width.  Shrinking metrics are used when
| * the glyphs are to be moved together to fit a smaller width.
| 
					
					operations 	(list Operations
					    (object Operation "GlyphJustificationInfo"
						attributes 	(list Attribute_Set)
						quid       	"3968B5940228"
						documentation 	
|
|     * Constructs information about the justification properties of a
|     * glyph.
|     * @param weight the weight of this glyph when allocating space
|     * @param growAbsorb if <code>true</code> this glyph absorbs
|     * all extra space at this priority and lower priority levels when it
|     * grows
|     * @param growPriority the priority level of this glyph when it
|     * grows
|     * @param growLeftLimit the maximum amount by which the left side of this
|     * glyph can grow
|     * @param growRightLimit the maximum amount by which the right side of this
|     * glyph can grow
|     * @param shrinkAbsorb if <code>true</code>, this glyph absorbs all
|     * remaining shrinkage at this and lower priority levels when it
|     * shrinks
|     * @param shrinkPriority the priority level of this glyph when
|     * it shrinks
|     * @param shrinkLeftLimit the maximum amount by which the left side of this
|     * glyph can shrink (a positive number)
|     * @param shrinkRightLimit the maximum amount by which the right side
|     * of this glyph can shrink (a postive number)
|     
						
						parameters 	(list Parameters
						    (object Parameter "weight"
							type       	"float")
						    (object Parameter "growAbsorb"
							type       	"boolean")
						    (object Parameter "growPriority"
							type       	"int")
						    (object Parameter "growLeftLimit"
							type       	"float")
						    (object Parameter "growRightLimit"
							type       	"float")
						    (object Parameter "shrinkAbsorb"
							type       	"boolean")
						    (object Parameter "shrinkPriority"
							type       	"int")
						    (object Parameter "shrinkLeftLimit"
							type       	"float")
						    (object Parameter "shrinkRightLimit"
							type       	"float"))
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "PRIORITY_KASHIDA"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B5940217"
						documentation 	" The highest justification priority. "
						type       	"int"
						initv      	"0"
						exportControl 	"Public"
						static     	TRUE)
					    (object ClassAttribute "PRIORITY_WHITESPACE"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B5940218"
						documentation 	" The second highest justification priority. "
						type       	"int"
						initv      	"1"
						exportControl 	"Public"
						static     	TRUE)
					    (object ClassAttribute "PRIORITY_INTERCHAR"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B5940219"
						documentation 	" The second lowest justification priority. "
						type       	"int"
						initv      	"2"
						exportControl 	"Public"
						static     	TRUE)
					    (object ClassAttribute "PRIORITY_NONE"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B594021A"
						documentation 	" The lowest justification priority. "
						type       	"int"
						initv      	"3"
						exportControl 	"Public"
						static     	TRUE)
					    (object ClassAttribute "weight"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B594021B"
						documentation 	
|
|     * The weight of this glyph.
|     
						
						type       	"float"
						exportControl 	"Public")
					    (object ClassAttribute "growPriority"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B594021C"
						documentation 	
|
|     * The priority level of this glyph as it is growing.
|     
						
						type       	"int"
						exportControl 	"Public")
					    (object ClassAttribute "growAbsorb"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B5940221"
						documentation 	
|
|     * If <code>true</code>, this glyph absorbs all extra
|     * space at this and lower priority levels when it grows.
|     
						
						type       	"boolean"
						exportControl 	"Public")
					    (object ClassAttribute "growLeftLimit"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B5940222"
						documentation 	
|
|     * The maximum amount by which the left side of this glyph can grow.
|     
						
						type       	"float"
						exportControl 	"Public")
					    (object ClassAttribute "growRightLimit"
						attributes 	(list Attribute_Set
						    (object Attribute
