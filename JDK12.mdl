						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B5990069"
						type       	"int"
						initv      	"3"
						static     	TRUE)
					    (object ClassAttribute "HI_IDENTITY"
