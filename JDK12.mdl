|
| * A PropertyDescriptor describes one property that a Java Bean
| * exports via a pair of accessor methods.
| 
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B59E0027"
					supplier   	"Logical View::java::beans::FeatureDescriptor"))
				operations 	(list Operations
				    (object Operation "PropertyDescriptor"
					attributes 	(list Attribute_Set)
					quid       	"3968B59E0052"
					documentation 	
|
|     * Constructs a PropertyDescriptor for a property that follows
|     * the standard Java convention by having getFoo and setFoo 
|     * accessor methods.  Thus if the argument name is "fred", it will
|     * assume that the writer method is "setFred" and the writer method 
|     * is "getFred" (or "isFred" for a boolean property).  Note that the
|     * property name should start with a lower case character, which will
|     * be capitalized in the method names.
|     *
|     * @param propertyName The programmatic name of the property.
|     * @param beanClass The Class object for the target bean.  For
|     *		example sun.beans.OurButton.class.
|     * @exception IntrospectionException if an exception occurs during
|     *              introspection.
|     
					
					parameters 	(list Parameters
					    (object Parameter "propertyName"
						type       	"String")
					    (object Parameter "beanClass"
						type       	"Class"))
					exceptions 	"IntrospectionException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "PropertyDescriptor"
					attributes 	(list Attribute_Set)
					quid       	"3968B59E0055"
					documentation 	
|
|     * This constructor takes the name of a simple property, and method
|     * names for reading and writing the property.
|     *
|     * @param propertyName The programmatic name of the property.
|     * @param beanClass The Class object for the target bean.  For
|     *		example sun.beans.OurButton.class.
|     * @param getterName The name of the method used for reading the property
|     *		 value.  May be null if the property is write-only.
|     * @param setterName The name of the method used for writing the property
|     *		 value.  May be null if the property is read-only.
|     * @exception IntrospectionException if an exception occurs during
|     *              introspection.
|     
					
					parameters 	(list Parameters
					    (object Parameter "propertyName"
						type       	"String")
					    (object Parameter "beanClass"
						type       	"Class")
					    (object Parameter "getterName"
						type       	"String")
					    (object Parameter "setterName"
						type       	"String"))
					exceptions 	"IntrospectionException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "PropertyDescriptor"
					attributes 	(list Attribute_Set)
					quid       	"3968B59E005A"
					documentation 	
|
|     * This constructor takes the name of a simple property, and Method
|     * objects for reading and writing the property.
|     *
|     * @param propertyName The programmatic name of the property.
|     * @param getter The method used for reading the property value.
|     *		May be null if the property is write-only.
|     * @param setter The method used for writing the property value.  
|     *		May be null if the property is read-only.
|     * @exception IntrospectionException if an exception occurs during
|     *              introspection.
|     
					
					parameters 	(list Parameters
					    (object Parameter "propertyName"
						type       	"String")
					    (object Parameter "getter"
						type       	"Method")
					    (object Parameter "setter"
						type       	"Method"))
					exceptions 	"IntrospectionException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getPropertyType"
					attributes 	(list Attribute_Set)
					quid       	"3968B59E005E"
					documentation 	
|
|     * Gets the Class object for the property.
|     *
|     * @return The Java type info for the property.  Note that
|     * the "Class" object may describe a built-in Java type such as "int".
|     * The result may be "null" if this is an indexed property that
|     * does not support non-indexed access.
|     * <p>
|     * This is the type that will be returned by the ReadMethod.
|     
					
					result     	"Class"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getReadMethod"
					attributes 	(list Attribute_Set)
					quid       	"3968B59E005F"
					documentation 	
|
|     * Gets the method that should be used to read the property value.
|     *
|     * @return The method that should be used to read the property value.
|     * May return null if the property can't be read.
|     
					
					result     	"Method"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setReadMethod"
					attributes 	(list Attribute_Set)
					quid       	"3968B59E0060"
					documentation 	
|
|     * Sets the method that should be used to read the property value.
|     *
|     * @param getter The new getter method.
|     
					
					parameters 	(list Parameters
					    (object Parameter "getter"
						type       	"Method"))
					result     	"void"
					exceptions 	"IntrospectionException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getWriteMethod"
					attributes 	(list Attribute_Set)
					quid       	"3968B59E0062"
					documentation 	
|
|     * Gets the method that should be used to write the property value.
|     * 
|     * @return The method that should be used to write the property value.
|     * May return null if the property can't be written.
|     
					
					result     	"Method"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setWriteMethod"
					attributes 	(list Attribute_Set)
					quid       	"3968B59E0063"
					documentation 	
|
|     * Sets the method that should be used to write the property value.
|     *
|     * @param setter The new setter method.
|     
					
					parameters 	(list Parameters
					    (object Parameter "setter"
						type       	"Method"))
					result     	"void"
					exceptions 	"IntrospectionException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
