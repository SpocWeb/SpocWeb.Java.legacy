					    (object Realize_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3968B58F02C5"
						supplier   	"Logical View::java::awt::event::WindowListener"))
					operations 	(list Operations
					    (object Operation "windowOpened"
						attributes 	(list Attribute_Set)
						quid       	"3968B58F02C6"
						documentation 	
|
|     * Invoked when a window has been opened.
