						concurrency 	"Sequential"
						opExportControl 	"Private"
						uid        	0)
					    (object Operation "poll"
						attributes 	(list Attribute_Set)
						quid       	"3968B5B60260"
						documentation 	
|
|     * Polls this queue to see if a reference object is available,
|     * returning one immediately if so.  If the queue is empty, this
|     * method immediately returns <code>null</code>.
|     *
|     * @return  A reference object, if one was immediately available,
|     *          otherwise <code>null</code>
|     
						
						result     	"Reference"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "remove"
						attributes 	(list Attribute_Set)
						quid       	"3968B5B60261"
						documentation 	
|
|     * Removes the next reference object in this queue, blocking until either
|     * one becomes available or the given timeout period expires.
|     *
|     * @param  timeout  If positive, block for up <code>timeout</code>
|     *                  milliseconds while waiting for a reference to be
|     *                  added to this queue.  If zero, block indefinitely.
|     *
|     * @return  A reference object, if one was available within the specified
|     *          timeout period, otherwise <code>null</code>
|     *
|     * @throws  IllegalArgumentException
|     *          If the value of the timeout argument is negative
|     *
|     * @throws  InterruptedException
|     *          If the timeout wait is interrupted
|     
						
						parameters 	(list Parameters
						    (object Parameter "timeout"
							type       	"long"))
						result     	"Reference"
						exceptions 	"IllegalArgumentException,InterruptedException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "remove"
						attributes 	(list Attribute_Set)
						quid       	"3968B5B60263"
						documentation 	
|
|     * Removes the next reference object in this queue, blocking until one
|     * becomes available.
|     *
|     * @throws  InterruptedException  If the wait is interrupted
|     
						
						result     	"Reference"
						exceptions 	"InterruptedException"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0))
