					    (object Attribute
						tool       	"Java"
						name       	"Synchronized"
						value      	TRUE))
					quid       	"3968B56D03D4"
					documentation 	
|
|     * @deprecated As of JDK version 1.1,
|     * replaced by <code>setSelectedCheckbox(Checkbox)</code>.
|     
					
					parameters 	(list Parameters
					    (object Parameter "box"
						type       	"Checkbox"))
