						type       	"int")
					    (object Parameter "endDay"
						type       	"int")
					    (object Parameter "endDayOfWeek"
						type       	"int")
					    (object Parameter "endTime"
						type       	"int")
					    (object Parameter "dstSavings"
						type       	"int"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setStartYear"
					attributes 	(list Attribute_Set)
					quid       	"3968B5FA0124"
					documentation 	
|
|     * Sets the daylight savings starting year.
|     *
|     * @param year  The daylight savings starting year.
|     
					
					parameters 	(list Parameters
					    (object Parameter "year"
						type       	"int"))
