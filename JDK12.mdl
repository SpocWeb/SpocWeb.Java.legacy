		    (object Class_Category "security"
			quid       	"3968B574015F"
			exportControl 	"Public"
			logical_models 	(list unit_reference_list
			    (object Class "BasicPermission"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"GenerateFinalizer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateStaticInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateInstanceInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateDefaultConstructor"
					value      	FALSE))
				quid       	"3968B5740160"
				documentation 	
|
| * The BasicPermission class extends the Permission class, and
| * can be used as the base class for permissions that want to
| * follow the same naming convention as BasicPermission.
| * <P>
| * The name for a BasicPermission is the name of the given permission
| * (for example, "exit",
| * "setFactory", "print.queueJob", etc). The naming
| * convention follows the  hierarchical property naming convention.
| * An asterisk
| * may appear at the end of the name, following a ".", or by itself, to
| * signify a wildcard match. For example: "java.*" or "*" is valid,
| * "*java" or "a*b" is not valid.
| * <P>
| * The action string (inherited from Permission) is unused.
| * Thus, BasicPermission is commonly used as the base class for
| * "named" permissions
| * (ones that contain a name but no actions list; you either have the
| * named permission or you don't.)
| * Subclasses may implement actions on top of BasicPermission,
| * if desired.
| * <p>
| * <P>
| * @see java.security.Permission
| * @see java.security.Permissions
| * @see java.security.PermissionCollection
| * @see java.lang.RuntimePermission
| * @see java.security.SecurityPermission
| * @see java.util.PropertyPermission
| * @see java.awt.AWTPermission
| * @see java.net.NetPermission
| * @see java.lang.SecurityManager
| *
| * @version 1.18 98/12/11
| *
| * @author Marianne Mueller
| * @author Roland Schemers
| 
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B5CF00E6"
					supplier   	"Logical View::java::security::Permission"))
				realized_interfaces 	(list realize_rel_list
				    (object Realize_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B5CF00F0"
					supplier   	"Logical View::java::io::Serializable"))
				operations 	(list Operations
				    (object Operation "init"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CF00FD"
					documentation 	
|
|     * initialize a BasicPermission object. Common to all constructors.
|     *
|     
					
					parameters 	(list Parameters
					    (object Parameter "name"
						type       	"String"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Private"
					uid        	0)
				    (object Operation "BasicPermission"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CF0105"
					documentation 	
|
|     * Creates a new BasicPermission with the specified name.
|     * Name is the symbolic name of the permission, such as
|     * "setFactory",
|     * "print.queueJob", or "topLevelWindow", etc. An asterisk
|     * may appear at the end of the name, following a ".", or by itself, to
|     * signify a wildcard match.
|     *
|     * @param name the name of the BasicPermission.
|     
					
					parameters 	(list Parameters
					    (object Parameter "name"
						type       	"String"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "BasicPermission"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CF0107"
					documentation 	
|
|     * Creates a new BasicPermission object with the specified name.
|     * The name is the symbolic name of the BasicPermission, and the
|     * actions String is currently unused. This
|     * constructor exists for use by the <code>Policy</code> object
|     * to instantiate new Permission objects.
|     *
|     * @param name the name of the BasicPermission.
|     * @param actions ignored.
|     
					
					parameters 	(list Parameters
					    (object Parameter "name"
						type       	"String")
					    (object Parameter "actions"
						type       	"String"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "implies"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CF010A"
					documentation 	
|
|     * Checks if the specified permission is "implied" by
|     * this object.
|     * <P>
|     * More specifically, this method returns true if:<p>
|     * <ul>
|     * <li> <i>p</i>'s class is the same as this object's class, and<p>
|     * <li> <i>p</i>'s name equals or (in the case of wildcards)
|     *      is implied by this object's
|     *      name. For example, "a.b.*" implies "a.b.c".
|     * </ul>
|     *
|     * @param p the permission to check against.
|     *
|     * @return true if the passed permission is equal to or
|     * implied by this permission, false otherwise.
|     
					
					parameters 	(list Parameters
					    (object Parameter "p"
						type       	"Permission"))
					result     	"boolean"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "equals"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CF010C"
					documentation 	
|
|     * Checks two BasicPermission objects for equality.
|     * Checks that <i>obj</i>'s class is the same as this object's class
|     * and has the same name as this object.
|     * <P>
|     * @param obj the object we are testing for equality with this object.
|     * @return true if <i>obj</i> is a BasicPermission, and has the same name
|     *  as this BasicPermission object, false otherwise.
|     
					
					parameters 	(list Parameters
					    (object Parameter "obj"
						type       	"Object"))
					result     	"boolean"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "hashCode"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CF010E"
					documentation 	
|
|     * Returns the hash code value for this object.
|     * The hash code used is the hash code of the name, that is,
|     * <code>getName().hashCode()</code>, where <code>getName</code> is
|     * from the Permission superclass.
|     *
|     * @return a hash code value for this object.
|     
					
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getActions"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CF010F"
					documentation 	
|
|     * Returns the canonical string representation of the actions,
|     * which currently is the empty string "", since there are no actions for
|     * a BasicPermission.
|     *
|     * @return the empty string "".
|     
					
					result     	"String"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "newPermissionCollection"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CF0110"
					documentation 	
|
|     * Returns a new PermissionCollection object for storing BasicPermission
|     * objects.
|     * <p>
|     * A BasicPermissionCollection stores a collection of
|     * BasicPermission permissions.
|     *
|     * <p>BasicPermission objects must be stored in a manner that allows them
|     * to be inserted in any order, but that also enables the
|     * PermissionCollection <code>implies</code> method
|     * to be implemented in an efficient (and consistent) manner.
|     *
|     * @return a new PermissionCollection object suitable for
|     * storing BasicPermissions.
|     
					
					result     	"PermissionCollection"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "readObject"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Synchronized"
						value      	TRUE))
					quid       	"3968B5CF0111"
					documentation 	
|
|     * readObject is called to restore the state of the BasicPermission from
|     * a stream. 
|     
					
					parameters 	(list Parameters
					    (object Parameter "s"
						type       	"java.io.ObjectInputStream"))
					result     	"void"
					exceptions 	"IOException,ClassNotFoundException"
					concurrency 	"Sequential"
					opExportControl 	"Private"
					uid        	0))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "wildcard"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Transient"
						value      	TRUE))
					quid       	"3968B5CF00F1"
					type       	"boolean"))
				module     	"Component View::java::security::BasicPermission"
				quidu      	"3968B574015E"
				language   	"Java"
				abstract   	TRUE)
			    (object Class "ProtectionDomain"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"GenerateFinalizer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateStaticInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateInstanceInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateDefaultConstructor"
					value      	FALSE))
				quid       	"3968B5AB030C"
				documentation 	
| 
| *
| * <p> This ProtectionDomain class encapulates the characteristics of
| * a domain, which encloses a set of classes whose instances
| * are granted the same set of permissions.
| * 
| * <p>In addition to a set of permissions, a domain is comprised of a 
| * CodeSource, which is a set of PublicKeys together with a codebase (in 
| * the form of a URL). Thus, classes signed by the same keys and
| * from the same URL are placed in the same domain.
| * Classes that have the same permissions but are from different code
| * sources belong to different domains.
| *
| * <p> A class belongs to one and only one ProtectionDomain.
| * 
| * @version 	1.24, 05/11/98
| * @author Li Gong 
| * @author Roland Schemers
| 
				
				operations 	(list Operations
				    (object Operation "ProtectionDomain"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CE00FB"
					documentation 	
|
|     * Creates a new ProtectionDomain with the given CodeSource and
|     * Permissions. If the permissions object is not null, then
|     * <code>setReadOnly()</code> will be called on the passed in 
|     * Permissions object.
|     *
|     * @param codesource the codesource associated with this domain
|     * @param permissions the permissions granted to this domain
|     
					
					parameters 	(list Parameters
					    (object Parameter "codesource"
						type       	"CodeSource")
					    (object Parameter "permissions"
						type       	"PermissionCollection"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getCodeSource"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5CE0104"
					documentation 	
|
|     * Returns the CodeSource of this domain.
|     * @return the CodeSource of this domain.
|     
					
					result     	"CodeSource"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getPermissions"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5CE0105"
					documentation 	
| 
|     * Returns the permissions of this domain.
|     * @return the permissions of this domain.
|     
					
					result     	"PermissionCollection"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "implies"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CE0106"
					documentation 	
|
|     * Check and see if this ProtectionDomain implies the permissions 
|     * expressed in the Permission object.
|     *
|     * @param permission the Permission object to check.
|     *
|     * @return true if "permission" is a proper subset of a permission in 
|     * this ProtectionDomain, false if not.
|     
					
					parameters 	(list Parameters
					    (object Parameter "permission"
						type       	"Permission"))
					result     	"boolean"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "toString"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CE0108"
					documentation 	
|
|     * Convert a ProtectionDomain to a String.
|     
					
					result     	"String"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0))
				module     	"Component View::java::security::ProtectionDomain"
				quidu      	"3968B5AB030B"
				language   	"Java")
			    (object Class "AllPermission"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"GenerateFinalizer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateStaticInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateInstanceInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateDefaultConstructor"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"Final"
					value      	TRUE))
				quid       	"3968B5B00145"
				documentation 	
|
| * The AllPermission is a permission that implies all other permissions.
| * <p>
| * <b>Note:</b> Granting AllPermission should be done with extreme care,
| * as it implies all other permissions. Thus, it grants code the ability 
| * to run with security
| * disabled.  Extreme caution should be taken before granting such
| * a permission to code.  This permission should be used only during testing,
| * or in extremely rare cases where an application or applet is
| * completely trusted and adding the necessary permissions to the policy 
| * is prohibitively cumbersome.
| * 
| * @see java.security.Permission
| * @see java.security.AccessController
| * @see java.security.Permissions
| * @see java.security.PermissionCollection
| * @see java.lang.SecurityManager
| *
| * @version 1.5 98/12/03
| *
| * @author Roland Schemers
| 
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B5C803A3"
					supplier   	"Logical View::java::security::Permission"))
				operations 	(list Operations
				    (object Operation "AllPermission"
					attributes 	(list Attribute_Set)
					quid       	"3968B5C803A4"
					documentation 	
|
|     * Creates a new AllPermission object.
|     
					
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "AllPermission"
					attributes 	(list Attribute_Set)
					quid       	"3968B5C803A5"
					documentation 	
|
|     * Creates a new AllPermission object. This
|     * constructor exists for use by the <code>Policy</code> object
|     * to instantiate new Permission objects.
