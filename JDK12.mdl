			    (object Class "GraphicsConfiguration"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"GenerateFinalizer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateStaticInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateInstanceInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateDefaultConstructor"
					value      	FALSE))
				quid       	"3968B56A019E"
				documentation 	
|
| * The <code>GraphicsConfiguration</code> class describes the
| * characteristics of a graphics destination such as a printer or monitor.
| * There can be many <code>GraphicsConfiguration</code> objects associated
| * with a single graphics device.  For example, on X11 windowing systems,
| * each visual is a different <code>GraphicsConfiguration</code>.  On PCs
| * and Macintoshes, the different screen resolution/color resolution
| * combinations would be different <code>GraphicsConfiguration</code>
| * objects.
| * @see GraphicsEnvironment
| * @see GraphicsDevice
| 
				
				operations 	(list Operations
				    (object Operation "GraphicsConfiguration"
					attributes 	(list Attribute_Set)
					quid       	"3968B5790150"
					documentation 	
|
|     * This is an abstract class that cannot be instantiated directly.
|     * Instances must be obtained from a suitable factory or query method.
|     *
|     * @see GraphicsDevice#getConfigurations
|     * @see GraphicsDevice#getDefaultConfiguration
|     * @see GraphicsDevice#getBestConfiguration
|     * @see Graphics2D#getDeviceConfiguration
|     
					
					concurrency 	"Sequential"
					opExportControl 	"Protected"
					uid        	0)
				    (object Operation "getDevice"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B5790151"
					documentation 	
|
|     * Returns the {@link GraphicsDevice} associated with this
|     * <code>GraphicsConfiguration</code>.
|     * @return a <code>GraphicsDevice</code> object that is 
|     * associated with this <code>GraphicsConfiguration</code>.
|     
					
					result     	"GraphicsDevice"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "createCompatibleImage"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B5790152"
					documentation 	
|
|     * Returns a {@link BufferedImage} with a data layout and color model
|     * compatible with this <code>GraphicsConfiguration</code>.  This
|     * method has nothing to do with memory-mapping
|     * a device.  The returned <code>BufferedImage</code> has
|     * a layout and color model that is closest to this native device
|     * configuration and can therefore be optimally blitted to this
|     * device.
|     * @param width the width of the returned <code>BufferedImage</code>
|     * @param height the height of the returned <code>BufferedImage</code>
|     * @return a <code>BufferedImage</code> whose data layout and color
|     * model is compatible with this <code>GraphicsConfiguration</code>.
|     
					
					parameters 	(list Parameters
					    (object Parameter "width"
						type       	"int")
					    (object Parameter "height"
						type       	"int"))
					result     	"BufferedImage"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "createCompatibleImage"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B579015C"
					documentation 	
|
|     * Returns a <code>BufferedImage</code> that supports the specified
|     * transparency and has a data layout and color model
|     * compatible with this <code>GraphicsConfiguration</code>.  This
|     * method has nothing to do with memory-mapping
|     * a device. The returned <code>BufferedImage</code> has a layout and
|     * color model that can be optimally blitted to a device
|     * with this <code>GraphicsConfiguration</code>.
|     * @param width the width of the returned <code>BufferedImage</code>
|     * @param height the height of the returned <code>BufferedImage</code>
|     * @param transparency the specified transparency mode
|     * @return a <code>BufferedImage</code> whose data layout and color  
|     * model is compatible with this <code>GraphicsConfiguration</code>
|     * and also supports the specified transparency.
|     * @see Transparency#OPAQUE
|     * @see Transparency#BITMASK
|     * @see Transparency#TRANSLUCENT
|     
					
					parameters 	(list Parameters
					    (object Parameter "width"
						type       	"int")
					    (object Parameter "height"
						type       	"int")
					    (object Parameter "transparency"
						type       	"int"))
					result     	"BufferedImage"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getColorModel"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B5790160"
					documentation 	
|
|     * Returns the {@link ColorModel} associated with this 
|     * <code>GraphicsConfiguration</code>.
|     * @return a <code>ColorModel</code> object that is associated with
|     * this <code>GraphicsConfiguration</code>.
|     
					
					result     	"ColorModel"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getColorModel"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B5790161"
					documentation 	
|
|     * Returns the <code>ColorModel</code> associated with this
|     * <code>GraphicsConfiguration</code> that supports the specified
|     * transparency.
|     * @param transparency the specified transparency mode
|     * @return a <code>ColorModel</code> object that is associated with
|     * this <code>GraphicsConfiguration</code> and supports the 
|     * specified transparency.
|     
					
					parameters 	(list Parameters
					    (object Parameter "transparency"
						type       	"int"))
					result     	"ColorModel"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getDefaultTransform"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B5790163"
					documentation 	
|
|     * Returns the default {@link AffineTransform} for this 
|     * <code>GraphicsConfiguration</code>. This
|     * <code>AffineTransform</code> is typically the Identity transform
|     * for most normal screens.  The default <code>AffineTransform</code>
|     * maps coordinates onto the device such that 72 user space
|     * coordinate units measure approximately 1 inch in device
|     * space.  The normalizing transform can be used to make
|     * this mapping more exact.  Coordinates in the coordinate space
|     * defined by the default <code>AffineTransform</code> for screen and
|     * printer devices have the origin in the upper left-hand corner of
|     * the target region of the device, with X coordinates
|     * increasing to the right and Y coordinates increasing downwards.
|     * For image buffers not associated with a device, such as those not
|     * created by <code>createCompatibleImage</code>,
|     * this <code>AffineTransform</code> is the Identity transform.
|     * @return the default <code>AffineTransform</code> for this
|     * <code>GraphicsConfiguration</code>.
|     
					
					result     	"AffineTransform"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getNormalizingTransform"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3968B5790164"
					documentation 	
|
|     *
|     * Returns a <code>AffineTransform</code> that can be concatenated
|     * with the default <code>AffineTransform</code>
|     * of a <code>GraphicsConfiguration</code> so that 72 units in user
|     * space equals 1 inch in device space.  
|     * <p>
|     * For a particular {@link Graphics2D}, g, one
|     * can reset the transformation to create
|     * such a mapping by using the following pseudocode:
|     * <pre>
|     *      GraphicsConfiguration gc = g.getGraphicsConfiguration();
|     *
|     *      g.setTransform(gc.getDefaultTransform());
|     *      g.transform(gc.getNormalizingTransform());
|     * </pre>
|     * Note that sometimes this <code>AffineTransform</code> is identity,
|     * such as for printers or metafile output, and that this 
|     * <code>AffineTransform</code> is only as accurate as the information
|     * supplied by the underlying system.  For image buffers not
|     * associated with a device, such as those not created by
|     * <code>createCompatibleImage</code>, this
|     * <code>AffineTransform</code> is the Identity transform
|     * since there is no valid distance measurement.
|     * @return an <code>AffineTransform</code> to concatenate to the
|     * default <code>AffineTransform</code> so that 72 units in user
|     * space is mapped to 1 inch in device space.
|     
					
					result     	"AffineTransform"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0))
				module     	"Component View::java::awt::GraphicsConfiguration"
				quidu      	"3968B56A019D"
				language   	"Java"
				abstract   	TRUE)
			    (object Class "Label"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"GenerateFinalizer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateStaticInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateInstanceInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateDefaultConstructor"
					value      	FALSE))
				quid       	"3968B56A01AE"
				documentation 	
|
| * A <code>Label</code> object is a component for placing text in a
| * container. A label displays a single line of read-only text.
| * The text can be changed by the application, but a user cannot edit it
| * directly.
| * <p>
| * For example, the code&nbsp;.&nbsp;.&nbsp;.
| * <p>
| * <hr><blockquote><pre>
| * setLayout(new FlowLayout(FlowLayout.CENTER, 10, 10));
| * add(new Label("Hi There!"));
| * add(new Label("Another Label"));
| * </pre></blockquote><hr>
| * <p>
| * produces the following label:
| * <p>
| * <img src="doc-files/Label-1.gif"
| * ALIGN=center HSPACE=10 VSPACE=7>
| *
| * @version	1.41, 08/31/98
| * @author 	Sami Shaio
| * @since       JDK1.0
| 
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B56A01AF"
					supplier   	"Logical View::java::awt::Component"))
				operations 	(list Operations
				    (object Operation "Label"
					attributes 	(list Attribute_Set)
					quid       	"3968B56A01BC"
					documentation 	
|
|     * Constructs an empty label.
|     * The text of the label is the empty string <code>""</code>.
|     
					
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "Label"
					attributes 	(list Attribute_Set)
					quid       	"3968B56A01BD"
					documentation 	
|
|     * Constructs a new label with the specified string of text,
|     * left justified.
|     * @param text the string that the label presents.
|     *        A <code>null</code> value
|     *        will be accepted without causing a NullPointerException
|     *        to be thrown.
|     
					
					parameters 	(list Parameters
					    (object Parameter "text"
						type       	"String"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "Label"
					attributes 	(list Attribute_Set)
					quid       	"3968B56A01BF"
					documentation 	
|
|     * Constructs a new label that presents the specified string of
|     * text with the specified alignment.
|     * Possible values for <code>alignment</code> are <code>Label.LEFT</code>,
|     * <code>Label.RIGHT</code>, and <code>Label.CENTER</code>.
|     * @param text the string that the label presents.
|     *        A <code>null</code> value
|     *        will be accepted without causing a NullPointerException
|     *        to be thrown.
|     * @param     alignment   the alignment value.
|     
					
					parameters 	(list Parameters
					    (object Parameter "text"
						type       	"String")
					    (object Parameter "alignment"
						type       	"int"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "constructComponentName"
					attributes 	(list Attribute_Set)
					quid       	"3968B56A01C2"
					documentation 	
|
|     * Construct a name for this component.  Called by getName() when the
|     * name is <code>null</code>.
|     
					
					result     	"String"
					concurrency 	"Sequential"
					opExportControl 	"Implementation"
					uid        	0)
				    (object Operation "addNotify"
					attributes 	(list Attribute_Set)
					quid       	"3968B56A01C3"
					documentation 	
|
|     * Creates the peer for this label.  The peer allows us to
|     * modify the appearance of the label without changing its
|     * functionality.
|     
					
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getAlignment"
					attributes 	(list Attribute_Set)
					quid       	"3968B56A01C4"
					documentation 	
|
|     * Gets the current alignment of this label. Possible values are
|     * <code>Label.LEFT</code>, <code>Label.RIGHT</code>, and
|     * <code>Label.CENTER</code>.
|     * @see        java.awt.Label#setAlignment
|     
					
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setAlignment"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Synchronized"
						value      	TRUE))
					quid       	"3968B56A01C5"
					documentation 	
|
|     * Sets the alignment for this label to the specified alignment.
|     * Possible values are <code>Label.LEFT</code>,
|     * <code>Label.RIGHT</code>, and <code>Label.CENTER</code>.
|     * @param      alignment    the alignment to be set.
|     * @exception  IllegalArgumentException if an improper value for
|     *                          <code>alignment</code> is given.
|     * @see        java.awt.Label#getAlignment
|     
					
					parameters 	(list Parameters
					    (object Parameter "alignment"
						type       	"int"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getText"
					attributes 	(list Attribute_Set)
					quid       	"3968B56A01C7"
					documentation 	
| 
|     * Gets the text of this label. 
|     * @return     the text of this label, or <code>null</code> if 
|     *             the text has been set to <code>null</code>.
|     * @see        java.awt.Label#setText
|     
					
					result     	"String"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setText"
					attributes 	(list Attribute_Set)
					quid       	"3968B56A01C8"
					documentation 	
|
|     * Sets the text for this label to the specified text.
|     * @param      text the text that this label displays. If 
|     *             <code>text</code> is <code>null</code>, it is 
|     *             treated for display purposes like an empty 
|     *             string <code>""</code>.
|     * @see        java.awt.Label#getText
|     
					
					parameters 	(list Parameters
					    (object Parameter "text"
						type       	"String"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "paramString"
					attributes 	(list Attribute_Set)
					quid       	"3968B56A01CA"
					documentation 	
|
|     * Returns the parameter string representing the state of this
|     * label. This string is useful for debugging.
|     * @return     the parameter string of this label.
|     
					
					result     	"String"
					concurrency 	"Sequential"
					opExportControl 	"Protected"
					uid        	0)
