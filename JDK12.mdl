|     *                    the output buffer
|     *
|     * @see java.io.OutputStreamWriter#OutputStreamWriter(java.io.OutputStream)
|     
					
					parameters 	(list Parameters
					    (object Parameter "out"
						type       	"OutputStream")
					    (object Parameter "autoFlush"
						type       	"boolean"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
