		    (object Class_Category "beans"
			quid       	"3968B5710343"
			exportControl 	"Public"
			logical_models 	(list unit_reference_list
			    (object Class "PropertyChangeSupport"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"GenerateFinalizer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateStaticInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateInstanceInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateDefaultConstructor"
					value      	FALSE))
				quid       	"3968B5710344"
				documentation 	
|
| * This is a utility class that can be used by beans that support bound
| * properties.  You can use an instance of this class as a member field
| * of your bean and delegate various work to it.
| *
| * This class is serializable.  When it is serialized it will save
| * (and restore) any listeners that are themselves serializable.  Any
| * non-serializable listeners will be skipped during serialization.
| *
| 
				
				realized_interfaces 	(list realize_rel_list
				    (object Realize_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B59F00A1"
					supplier   	"Logical View::java::io::Serializable"))
				operations 	(list Operations
				    (object Operation "PropertyChangeSupport"
					attributes 	(list Attribute_Set)
					quid       	"3968B59F00C4"
					documentation 	
|
|     * Constructs a <code>PropertyChangeSupport</code> object.
|     *
|     * @param sourceBean  The bean to be given as the source for any events.
|     
					
					parameters 	(list Parameters
					    (object Parameter "sourceBean"
						type       	"Object"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "addPropertyChangeListener"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Synchronized"
						value      	TRUE))
					quid       	"3968B59F00C6"
					documentation 	
|
|     * Add a PropertyChangeListener to the listener list.
|     * The listener is registered for all properties.
|     *
|     * @param listener  The PropertyChangeListener to be added
|     
					
					parameters 	(list Parameters
					    (object Parameter "listener"
						type       	"PropertyChangeListener"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "removePropertyChangeListener"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Synchronized"
						value      	TRUE))
					quid       	"3968B59F00C8"
					documentation 	
|
|     * Remove a PropertyChangeListener from the listener list.
|     * This removes a PropertyChangeListener that was registered
|     * for all properties.
|     *
|     * @param listener  The PropertyChangeListener to be removed
|     
					
					parameters 	(list Parameters
					    (object Parameter "listener"
						type       	"PropertyChangeListener"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "addPropertyChangeListener"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Synchronized"
						value      	TRUE))
					quid       	"3968B59F00CA"
					documentation 	
|
|     * Add a PropertyChangeListener for a specific property.  The listener
|     * will be invoked only when a call on firePropertyChange names that
|     * specific property.
|     *
|     * @param propertyName  The name of the property to listen on.
|     * @param listener  The PropertyChangeListener to be added
|     
					
					parameters 	(list Parameters
					    (object Parameter "propertyName"
						type       	"String")
					    (object Parameter "listener"
						type       	"PropertyChangeListener"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "removePropertyChangeListener"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Synchronized"
						value      	TRUE))
					quid       	"3968B59F00CD"
					documentation 	
|
|     * Remove a PropertyChangeListener for a specific property.
|     *
|     * @param propertyName  The name of the property that was listened on.
|     * @param listener  The PropertyChangeListener to be removed
|     
					
					parameters 	(list Parameters
					    (object Parameter "propertyName"
						type       	"String")
					    (object Parameter "listener"
						type       	"PropertyChangeListener"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "firePropertyChange"
					attributes 	(list Attribute_Set)
					quid       	"3968B59F00D0"
					documentation 	
|
|     * Report a bound property update to any registered listeners.
|     * No event is fired if old and new are equal and non-null.
|     *
|     * @param propertyName  The programmatic name of the property
|     *		that was changed.
|     * @param oldValue  The old value of the property.
|     * @param newValue  The new value of the property.
|     
					
					parameters 	(list Parameters
					    (object Parameter "propertyName"
						type       	"String")
					    (object Parameter "oldValue"
						type       	"Object")
					    (object Parameter "newValue"
						type       	"Object"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "firePropertyChange"
					attributes 	(list Attribute_Set)
					quid       	"3968B59F00D4"
					documentation 	
|
|     * Report an int bound property update to any registered listeners.
|     * No event is fired if old and new are equal and non-null.
|     * <p>
|     * This is merely a convenience wrapper around the more general
|     * firePropertyChange method that takes Object values.
|     *
|     * @param propertyName  The programmatic name of the property
|     *		that was changed.
|     * @param oldValue  The old value of the property.
|     * @param newValue  The new value of the property.
|     
					
					parameters 	(list Parameters
					    (object Parameter "propertyName"
						type       	"String")
					    (object Parameter "oldValue"
						type       	"int")
					    (object Parameter "newValue"
						type       	"int"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "firePropertyChange"
					attributes 	(list Attribute_Set)
					quid       	"3968B59F00D8"
					documentation 	
|
|     * Report a boolean bound property update to any registered listeners.
|     * No event is fired if old and new are equal and non-null.
|     * <p>
|     * This is merely a convenience wrapper around the more general
|     * firePropertyChange method that takes Object values.
|     *
|     * @param propertyName  The programmatic name of the property
|     *		that was changed.
|     * @param oldValue  The old value of the property.
|     * @param newValue  The new value of the property.
|     
					
					parameters 	(list Parameters
					    (object Parameter "propertyName"
						type       	"String")
					    (object Parameter "oldValue"
						type       	"boolean")
					    (object Parameter "newValue"
						type       	"boolean"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "firePropertyChange"
					attributes 	(list Attribute_Set)
					quid       	"3968B59F00DC"
					documentation 	
|
|     * Fire an existing PropertyChangeEvent to any registered listeners.
|     * No event is fired if the given event's old and new values are
|     * equal and non-null.
|     * @param evt  The PropertyChangeEvent object.
|     
					
					parameters 	(list Parameters
					    (object Parameter "evt"
						type       	"PropertyChangeEvent"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "hasListeners"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Synchronized"
						value      	TRUE))
					quid       	"3968B59F00DE"
					documentation 	
|
|     * Check if there are any listeners for a specific property.
|     *
|     * @param propertyName  the property name.
|     * @return true if there are ore or more listeners for the given property
|     
					
					parameters 	(list Parameters
					    (object Parameter "propertyName"
						type       	"String"))
					result     	"boolean"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "writeObject"
					attributes 	(list Attribute_Set)
					quid       	"3968B59F00E0"
					documentation 	
|
|     * @serialData Null terminated list of <code>PropertyChangeListeners</code>.
|     * <p>
|     * At serialization time we skip non-serializable listeners and
|     * only serialize the serializable listeners.
|     *
|     
					
					parameters 	(list Parameters
					    (object Parameter "s"
						type       	"ObjectOutputStream"))
					result     	"void"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Private"
					uid        	0)
				    (object Operation "readObject"
					attributes 	(list Attribute_Set)
					quid       	"3968B59F00E2"
					parameters 	(list Parameters
					    (object Parameter "s"
						type       	"ObjectInputStream"))
					result     	"void"
					exceptions 	"ClassNotFoundException,IOException"
					concurrency 	"Sequential"
					opExportControl 	"Private"
					uid        	0))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "propertyChangeSupportSerializedDataVersion"
					attributes 	(list Attribute_Set)
					quid       	"3968B59F00C2"
					documentation 	
|
|     * Internal version number
