				    (object Inheritance_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B5CE0026"
					supplier   	"Logical View::java::security::BasicPermission"))
				operations 	(list Operations
				    (object Operation "SecurityPermission"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CE0027"
					documentation 	
|
|     * Creates a new SecurityPermission with the specified name.
|     * The name is the symbolic name of the SecurityPermission. An asterisk
|     * may appear at the end of the name, following a ".", or by itself, to
|     * signify a wildcard match.
|     *
|     * @param name the name of the SecurityPermission
|     
					
					parameters 	(list Parameters
					    (object Parameter "name"
						type       	"String"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "SecurityPermission"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CE0029"
					documentation 	
|
|     * Creates a new SecurityPermission object with the specified name.
|     * The name is the symbolic name of the SecurityPermission, and the
|     * actions String is currently unused and should be null.  This
|     * constructor exists for use by the <code>Policy</code> object
|     * to instantiate new Permission objects.
|     *
|     * @param name the name of the SecurityPermission
|     * @param actions should be null.
|     
					
					parameters 	(list Parameters
					    (object Parameter "name"
						type       	"String")
					    (object Parameter "actions"
						type       	"String"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0))
				module     	"Component View::java::security::SecurityPermission"
				quidu      	"3968B5CE0012"
				language   	"Java")
			    (object Class "AlgorithmParameterGenerator"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"GenerateFinalizer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateStaticInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateInstanceInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateDefaultConstructor"
					value      	FALSE))
				quid       	"3968B5CE008A"
				documentation 	
|
| * The <code>AlgorithmParameterGenerator</code> class is used to generate a
| * set of
| * parameters to be used with a certain algorithm. Parameter generators
| * are constructed using the <code>getInstance</code> factory methods
| * (static methods that return instances of a given class).
| * 
| * <P>The object that will generate the parameters can be initialized
| * in two different ways: in an algorithm-independent manner, or in an
| * algorithm-specific manner:
| *
| * <ul>
| * <li>The algorithm-independent approach uses the fact that all parameter
| * generators share the concept of a "size" and a
| * source of randomness. The measure of size is universally shared 
| * by all algorithm parameters, though it is interpreted differently
| * for different algorithms. For example, in the case of parameters for
| * the <i>DSA</i> algorithm, "size" corresponds to the size
| * of the prime modulus (in bits).
| * When using this approach, algorithm-specific parameter generation
| * values - if any - default to some standard values, unless they can be
| * derived from the specified size.<P>
| *
| * <li>The other approach initializes a parameter generator object
| * using algorithm-specific semantics, which are represented by a set of
| * algorithm-specific parameter generation values. To generate
| * Diffie-Hellman system parameters, for example, the parameter generation
| * values usually
| * consist of the size of the prime modulus and the size of the
| * random exponent, both specified in number of bits.
| * </ul>
| *
| * <P>In case the client does not explicitly initialize the
| * AlgorithmParameterGenerator
| * (via a call to an <code>init</code> method), each provider must supply (and
| * document) a default initialization. For example, the Sun provider uses a
| * default modulus prime size of 1024 bits for the generation of DSA
| * parameters.
| *
| * @author Jan Luehe
| *
| * @version 1.31 98/12/03
| *
| * @see AlgorithmParameters
| * @see java.security.spec.AlgorithmParameterSpec
| *
| * @since JDK1.2
| 
				
				operations 	(list Operations
				    (object Operation "AlgorithmParameterGenerator"
					attributes 	(list Attribute_Set)
					quid       	"3968B5CE00B5"
					documentation 	
|
|     * Creates an AlgorithmParameterGenerator object.
|     *
|     * @param keyFacSpi the delegate
|     * @param provider the provider
|     * @param algorithm the algorithm
|     
					
					parameters 	(list Parameters
					    (object Parameter "paramGenSpi"
						type       	"AlgorithmParameterGeneratorSpi")
					    (object Parameter "provider"
						type       	"Provider")
					    (object Parameter "algorithm"
						type       	"String"))
					concurrency 	"Sequential"
					opExportControl 	"Protected"
					uid        	0)
				    (object Operation "getAlgorithm"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5CE00B9"
					documentation 	
|
|     * Returns the standard name of the algorithm this parameter
|     * generator is associated with.
|     * 
|     * @return the string name of the algorithm. 
|     
					
					result     	"String"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getInstance"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE))
					quid       	"3968B5CE00BC"
					documentation 	
|
|     * Generates an AlgorithmParameterGenerator object that implements the 
|     * specified digest algorithm. If the default provider package
|     * provides an implementation of the requested digest algorithm,
|     * an instance of AlgorithmParameterGenerator containing that
|     * implementation 
|     * is returned. If the algorithm is not available in the default 
|     * package, other packages are searched.
|     *
|     * @param algorithm the string name of the algorithm this
|     * parameter generator is associated with.
|     *
|     * @return the new AlgorithmParameterGenerator object.
|     *
|     * @exception NoSuchAlgorithmException if the algorithm is
|     * not available in the environment.  
|     
					
					parameters 	(list Parameters
					    (object Parameter "algorithm"
						type       	"String"))
					result     	"AlgorithmParameterGenerator"
					exceptions 	"NoSuchAlgorithmException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getInstance"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE))
					quid       	"3968B5CE00BE"
					documentation 	
| 
|     * Generates an AlgorithmParameterGenerator object for the requested
|     * algorithm, as supplied from the specified provider, 
|     * if such a parameter generator is available from the provider.
|     *
|     * @param algorithm the string name of the algorithm.
|     *
|     * @param provider the string name of the provider.
|     *
|     * @return the new AlgorithmParameterGenerator object.
|     *
|     * @exception NoSuchAlgorithmException if the algorithm is
|     * not available from the provider.
|     *
|     * @exception NoSuchProviderException if the provider is not
|     * available in the environment. 
|     * 
|     * @see Provider 
|     
					
					parameters 	(list Parameters
					    (object Parameter "algorithm"
						type       	"String")
					    (object Parameter "provider"
						type       	"String"))
					result     	"AlgorithmParameterGenerator"
					exceptions 	"NoSuchAlgorithmException,NoSuchProviderException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getProvider"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5CE00C1"
					documentation 	
| 
|     * Returns the provider of this algorithm parameter generator object.
|     * 
|     * @return the provider of this algorithm parameter generator object
|     
					
					result     	"Provider"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "init"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5CE00C2"
					documentation 	
|
|     * Initializes this parameter generator for a certain size.
|     * To create the parameters, the <code>SecureRandom</code>
|     * implementation of the highest-priority installed provider is used as
|     * the source of randomness.
|     * (If none of the installed providers supply an implementation of
|     * <code>SecureRandom</code>, a system-provided source of randomness is
|     * used.)
|     *
|     * @param size the size (number of bits).
|     
					
					parameters 	(list Parameters
					    (object Parameter "size"
						type       	"int"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "init"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5CE00C4"
					documentation 	
|
|     * Initializes this parameter generator for a certain size and source
|     * of randomness.
|     *
|     * @param size the size (number of bits).
|     * @param random the source of randomness.
|     
					
					parameters 	(list Parameters
					    (object Parameter "size"
						type       	"int")
					    (object Parameter "random"
						type       	"SecureRandom"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "init"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5CE00C7"
					documentation 	
|
|     * Initializes this parameter generator with a set of algorithm-specific
|     * parameter generation values.
|     * To generate the parameters, the <code>SecureRandom</code>
|     * implementation of the highest-priority installed provider is used as
|     * the source of randomness.
|     * (If none of the installed providers supply an implementation of
|     * <code>SecureRandom</code>, a system-provided source of randomness is
|     * used.)
|     *
|     * @param params the set of algorithm-specific parameter generation values.
|     *
|     * @exception InvalidAlgorithmParameterException if the given parameter
|     * generation values are inappropriate for this parameter generator.
|     
					
					parameters 	(list Parameters
					    (object Parameter "genParamSpec"
						type       	"AlgorithmParameterSpec"))
					result     	"void"
					exceptions 	"InvalidAlgorithmParameterException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "init"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5CE00C9"
					documentation 	
|
|     * Initializes this parameter generator with a set of algorithm-specific
|     * parameter generation values.
|     *
|     * @param params the set of algorithm-specific parameter generation values.
|     * @param random the source of randomness.
|     *
|     * @exception InvalidAlgorithmParameterException if the given parameter
|     * generation values are inappropriate for this parameter generator.
|     
					
					parameters 	(list Parameters
					    (object Parameter "genParamSpec"
						type       	"AlgorithmParameterSpec")
					    (object Parameter "random"
						type       	"SecureRandom"))
					result     	"void"
					exceptions 	"InvalidAlgorithmParameterException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "generateParameters"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5CE00CC"
					documentation 	
|
|     * Generates the parameters.
|     *
|     * @return the new AlgorithmParameters object.
|     
					
					result     	"AlgorithmParameters"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0))
				module     	"Component View::java::security::AlgorithmParameterGenerator"
