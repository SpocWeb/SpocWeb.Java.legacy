						value      	TRUE))
					quid       	"3968B5AE022D"
					documentation 	
|
|     * Compiles the specified class.
|     *
|     * @param   clazz   a class.
|     * @return  <code>true</code> if the compilation succeeded;
|     *          <code>false</code> if the compilation failed or no compiler
|     *          is available.
|     
					
					parameters 	(list Parameters
					    (object Parameter "clazz"
						type       	"Class"))
					result     	"boolean"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "compileClasses"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE)
					    (object Attribute
						tool       	"Java"
						name       	"Native"
						value      	TRUE))
					quid       	"3968B5AE0233"
					documentation 	
|
|     * Compiles all classes whose name matches the specified string.
|     *
|     * @param   string   the name of the classes to compile.
|     * @return  <code>true</code> if the compilation succeeded;
|     *          <code>false</code> if the compilation failed or no compiler
|     *          is available.
|     
					
					parameters 	(list Parameters
					    (object Parameter "string"
						type       	"String"))
					result     	"boolean"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
