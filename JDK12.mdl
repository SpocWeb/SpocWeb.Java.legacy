					module     	"Component View::java::lang::reflect::Modifier"
					quidu      	"3968B5A70040"
					language   	"Java")
				    (object Class "AccessibleObject"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"GenerateFinalizer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateStaticInitializer"
						value      	FALSE)
					    (object Attribute
