					documentation 	
|
|     * Transform a string into an expanded form, with all
|     * precomposed characters expanded into combining character sequences
|     * where possible.
|     
					
					parameters 	(list Parameters
					    (object Parameter "input"
						type       	"String"))
					result     	"String"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "decompose"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE))
					quid       	"3968B5EF016A"
					documentation 	
|
|     * Transform a string into an expanded form, with all
|     * precomposed characters expanded into combining character sequences
|     * where possible.
|     
					
					parameters 	(list Parameters
					    (object Parameter "buffer"
						type       	"StringBuffer"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "compose"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE))
					quid       	"3968B5EF016C"
					documentation 	
|
|     * Converts both normalized or unnormalized canonical decompositions into
|     * corresponding precomposed characters where possible.<br>
|     * Used for creating normalized precomposed forms, such as for file names,
|     * class names, etc.<br>
|     * Example: "la\u0300zy" => "l\u00e0zy" ("l&agrave;zy")
|     * @param input string to convert
|     * @return string with composed sequences.
|     
					
					parameters 	(list Parameters
					    (object Parameter "input"
						type       	"String"))
					result     	"String"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "compose"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE))
					quid       	"3968B5EF016E"
					documentation 	
|
|     * Converts both normalized or unnormalized canonical decompositions into
|     * corresponding precomposed characters where possible.<br>
|     * Used for creating normalized precomposed forms, such as for file names,
|     * class names, etc.<br>
|     * Example: "la\u0300zy" => "l\u00e0zy" ("l&agrave;zy")
|     * @param buffer string to convert. On output the length will be shorter if characters
|     * were combined.
|     
					
					parameters 	(list Parameters
					    (object Parameter "buffer"
						type       	"StringBuffer"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "decompose"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE))
					quid       	"3968B5EF0170"
					documentation 	
|
|     * Decomposes a StringBuffer in place
|     * @param source the string to be decomposed
|     * @param mode the decomposition mode
|     * @see java.text.Collator
|     * @see java.text.Collator#getDecomposition
|     * @see java.text.Collator#setDecomposition
|     
					
					parameters 	(list Parameters
					    (object Parameter "source"
						type       	"StringBuffer")
					    (object Parameter "mode"
						type       	"int"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Implementation"
					uid        	0)
				    (object Operation "decompose"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE))
					quid       	"3968B5EF0173"
					documentation 	
|
|     * Decomposes string into string
|     * If the source can't be decomposed, return "".
|     * @param source the string to be decomposed with
|     * @param mode the decomposition mode
|     * @return the decomposed string
|     * @see java.text.Collator
|     * @see java.text.Collator#getDecomposition
|     * @see java.text.Collator#setDecomposition
|     
					
					parameters 	(list Parameters
					    (object Parameter "source"
						type       	"String")
					    (object Parameter "mode"
						type       	"int"))
					result     	"String"
					concurrency 	"Sequential"
					opExportControl 	"Implementation"
					uid        	0)
				    (object Operation "getMaximumDecomposition"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE))
					quid       	"3968B5EF0176"
					documentation 	
|
|     * Use to allocate array for using decompose in a tight loop.
|     * @return the maximum decomposition result characters for output
|     
					
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Implementation"
					uid        	0)
				    (object Operation "fixCanonical"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE))
					quid       	"3968B5EF0177"
					documentation 	
|
|     * Fixes the sorting sequence of non-spacing characters according to
|     * their combining class.  The algorithm is listed on p.3-11 in the
|     * Unicode Standard 2.0.  The table of combining classes is on p.4-2
|     * in the Unicode Standard 2.0.
|     * @param result the string to fix.
|     
					
					parameters 	(list Parameters
					    (object Parameter "result"
						type       	"StringBuffer"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Private"
					uid        	0)
				    (object Operation "hangulToJamo"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE))
					quid       	"3968B5EF0179"
					parameters 	(list Parameters
					    (object Parameter "ch"
						type       	"char")
					    (object Parameter "result"
						type       	"StringBuffer"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Private"
					uid        	0)
