						name       	"GenerateInstanceInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateDefaultConstructor"
						value      	FALSE))
					quid       	"3968B5D50008"
					documentation 	
|
| * This class is an abstraction of certificate revocation lists (CRLs) that
| * have different formats but important common uses. For example, all CRLs
| * share the functionality of listing revoked certificates, and can be queried
| * on whether or not they list a given certificate.
| * <p>
| * Specialized CRL types can be defined by subclassing off of this abstract
| * class.
| *
| * @author Hemma Prafullchandra
| *
| * @version 1.5 98/12/03
| *
| * @see X509CRL
| * @see CertificateFactory
| *
| * @since JDK1.2
| 
					
					operations 	(list Operations
					    (object Operation "CRL"
						attributes 	(list Attribute_Set)
						quid       	"3968B5D50015"
						documentation 	
|
|     * Creates a CRL of the specified type.
|     *
|     * @param type the standard name of the CRL type.
|     * See Appendix A in the <a href=
|     * "../../../../guide/security/CryptoSpec.html#AppA">
|     * Java Cryptography Architecture API Specification &amp; Reference </a>
|     * for information about standard CRL types.
|     
						
						parameters 	(list Parameters
						    (object Parameter "type"
							type       	"String"))
						concurrency 	"Sequential"
						opExportControl 	"Protected"
						uid        	0)
					    (object Operation "getType"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B5D5001D"
						documentation 	
|
|     * Returns the type of this CRL.
|     *
|     * @return the type of this CRL.
|     
						
						result     	"String"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "toString"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B5D5001E"
						documentation 	
|
|     * Returns a string representation of this CRL.
|     *
|     * @return a string representation of this CRL.
|     
						
						result     	"String"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
