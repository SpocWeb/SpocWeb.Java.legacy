				    (object Class "ImageProducer"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"GenerateFinalizer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateStaticInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateInstanceInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateDefaultConstructor"
						value      	FALSE))
					quid       	"3968B5810089"
					documentation 	
|
| * The interface for objects which can produce the image data for Images.
| * Each image contains an ImageProducer which is used to reconstruct
| * the image whenever it is needed, for example, when a new size of the
| * Image is scaled, or when the width or height of the Image is being
| * requested.
| *
| * @see ImageConsumer
| *
| * @version	1.14 09/21/98
| * @author 	Jim Graham
| 
					
					stereotype 	"Interface"
					operations 	(list Operations
					    (object Operation "addConsumer"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B5810093"
						documentation 	
|
|     * This method is used to register an ImageConsumer with the
|     * ImageProducer for access to the image data during a later
|     * reconstruction of the Image.  The ImageProducer may, at its
|     * discretion, start delivering the image data to the consumer
|     * using the ImageConsumer interface immediately, or when the
|     * next available image reconstruction is triggered by a call
|     * to the startProduction method.
|     * @see #startProduction
|     
						
						parameters 	(list Parameters
						    (object Parameter "ic"
							type       	"ImageConsumer"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "isConsumer"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B5810095"
						documentation 	
|
|     * This method determines if a given ImageConsumer object
|     * is currently registered with this ImageProducer as one
|     * of its consumers.
|     
						
						parameters 	(list Parameters
						    (object Parameter "ic"
							type       	"ImageConsumer"))
						result     	"boolean"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "removeConsumer"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B5810097"
						documentation 	
|
|     * This method removes the given ImageConsumer object
|     * from the list of consumers currently registered to
|     * receive image data.  It is not considered an error
|     * to remove a consumer that is not currently registered.
|     * The ImageProducer should stop sending data to this
|     * consumer as soon as is feasible.
|     
						
						parameters 	(list Parameters
						    (object Parameter "ic"
							type       	"ImageConsumer"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "startProduction"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B5810099"
						documentation 	
|
|     * This method both registers the given ImageConsumer object
|     * as a consumer and starts an immediate reconstruction of
|     * the image data which will then be delivered to this
|     * consumer and any other consumer which may have already
|     * been registered with the producer.  This method differs
|     * from the addConsumer method in that a reproduction of
|     * the image data should be triggered as soon as possible.
|     * @see #addConsumer
|     
						
						parameters 	(list Parameters
						    (object Parameter "ic"
							type       	"ImageConsumer"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "requestTopDownLeftRightResend"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B581009B"
						documentation 	
|
|     * This method is used by an ImageConsumer to request that
|     * the ImageProducer attempt to resend the image data one
|     * more time in TOPDOWNLEFTRIGHT order so that higher
|     * quality conversion algorithms which depend on receiving
|     * pixels in order can be used to produce a better output
|     * version of the image.  The ImageProducer is free to
|     * ignore this call if it cannot resend the data in that
|     * order.  If the data can be resent, then the ImageProducer
|     * should respond by executing the following minimum set of
|     * ImageConsumer method calls:
|     * <pre>
|     *	ic.setHints(TOPDOWNLEFTRIGHT | < otherhints >);
|     *	ic.setPixels(...);	// As many times as needed
|     *	ic.imageComplete();
|     * </pre>
|     * @see ImageConsumer#setHints
|     
						
						parameters 	(list Parameters
						    (object Parameter "ic"
							type       	"ImageConsumer"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0))
					module     	"Component View::java::awt::image::ImageProducer"
					quidu      	"3968B56602B3"
					language   	"Java")
				    (object Class "ImageConsumer"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"GenerateFinalizer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateStaticInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateInstanceInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateDefaultConstructor"
						value      	FALSE))
					quid       	"3968B58100C7"
					documentation 	
|
| * The interface for objects expressing interest in image data through
| * the ImageProducer interfaces.  When a consumer is added to an image
| * producer, the producer delivers all of the data about the image
| * using the method calls defined in this interface.
| *
| * @see ImageProducer
| *
| * @version	1.15 09/21/98
| * @author 	Jim Graham
| 
					
					stereotype 	"Interface"
					operations 	(list Operations
					    (object Operation "setDimensions"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B58100D6"
						documentation 	
|
|     * The dimensions of the source image are reported using the
|     * setDimensions method call.
|     
						
						parameters 	(list Parameters
						    (object Parameter "width"
							type       	"int")
						    (object Parameter "height"
							type       	"int"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Implementation"
						uid        	0)
					    (object Operation "setProperties"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B58100D9"
						documentation 	
|
|     * Sets the extensible list of properties associated with this image.
|     
						
						parameters 	(list Parameters
						    (object Parameter "props"
							type       	"Hashtable"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Implementation"
						uid        	0)
					    (object Operation "setColorModel"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B58100DB"
						documentation 	
|
|     * The ColorModel object used for the majority of
|     * the pixels reported using the setPixels method
|     * calls.  Note that each set of pixels delivered using setPixels
|     * contains its own ColorModel object, so no assumption should
|     * be made that this model will be the only one used in delivering
|     * pixel values.  A notable case where multiple ColorModel objects
|     * may be seen is a filtered image when for each set of pixels
|     * that it filters, the filter
|     * determines  whether the
|     * pixels can be sent on untouched, using the original ColorModel,
|     * or whether the pixels should be modified (filtered) and passed
|     * on using a ColorModel more convenient for the filtering process.
|     * @see ColorModel
|     
						
						parameters 	(list Parameters
						    (object Parameter "model"
							type       	"ColorModel"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Implementation"
						uid        	0)
					    (object Operation "setHints"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B58100DD"
						documentation 	
|
|     * The ImageProducer can deliver the pixels in any order, but
|     * the ImageConsumer may be able to scale or convert the pixels
|     * to the destination ColorModel more efficiently or with higher
|     * quality if it knows some information about how the pixels will
|     * be delivered up front.  The setHints method should be called
|     * before any calls to any of the setPixels methods with a bit mask
|     * of hints about the manner in which the pixels will be delivered.
|     * If the ImageProducer does not follow the guidelines for the
|     * indicated hint, the results are undefined.
|     
						
						parameters 	(list Parameters
						    (object Parameter "hintflags"
							type       	"int"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Implementation"
						uid        	0)
					    (object Operation "setPixels"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B58100DF"
						documentation 	
|
|     * The pixels of the image are delivered using one or more calls
|     * to the setPixels method.  Each call specifies the location and
|     * size of the rectangle of source pixels that are contained in
|     * the array of pixels.  The specified ColorModel object should
|     * be used to convert the pixels into their corresponding color
|     * and alpha components.  Pixel (m,n) is stored in the pixels array
|     * at index (n * scansize + m + off).  The pixels delivered using
|     * this method are all stored as bytes.
|     * @see ColorModel
|     
						
						parameters 	(list Parameters
						    (object Parameter "x"
							type       	"int")
						    (object Parameter "y"
							type       	"int")
						    (object Parameter "w"
							type       	"int")
						    (object Parameter "h"
							type       	"int")
						    (object Parameter "model"
							type       	"ColorModel")
						    (object Parameter "pixels[]"
							type       	"byte")
						    (object Parameter "off"
							type       	"int")
						    (object Parameter "scansize"
							type       	"int"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Implementation"
						uid        	0)
					    (object Operation "setPixels"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B58100E8"
						documentation 	
|
|     * The pixels of the image are delivered using one or more calls
|     * to the setPixels method.  Each call specifies the location and
|     * size of the rectangle of source pixels that are contained in
|     * the array of pixels.  The specified ColorModel object should
|     * be used to convert the pixels into their corresponding color
|     * and alpha components.  Pixel (m,n) is stored in the pixels array
|     * at index (n * scansize + m + off).  The pixels delivered using
|     * this method are all stored as ints.
|     * @see ColorModel
|     
						
						parameters 	(list Parameters
						    (object Parameter "x"
							type       	"int")
						    (object Parameter "y"
							type       	"int")
						    (object Parameter "w"
							type       	"int")
						    (object Parameter "h"
							type       	"int")
						    (object Parameter "model"
							type       	"ColorModel")
						    (object Parameter "pixels[]"
							type       	"int")
						    (object Parameter "off"
							type       	"int")
						    (object Parameter "scansize"
							type       	"int"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Implementation"
						uid        	0)
					    (object Operation "imageComplete"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3968B58100F1"
						documentation 	
|
|     * The imageComplete method is called when the ImageProducer is
|     * finished delivering all of the pixels that the source image
|     * contains, or when a single frame of a multi-frame animation has
|     * been completed, or when an error in loading or producing the
|     * image has occured.  The ImageConsumer should remove itself from the
|     * list of consumers registered with the ImageProducer at this time,
|     * unless it is interested in successive frames.
|     * @see ImageProducer#removeConsumer
|     
						
						parameters 	(list Parameters
						    (object Parameter "status"
							type       	"int"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Implementation"
						uid        	0))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "RANDOMPIXELORDER"
						attributes 	(list Attribute_Set)
						quid       	"3968B58100C8"
						documentation 	
|
|     * The pixels will be delivered in a random order.  This tells the
|     * ImageConsumer not to use any optimizations that depend on the
|     * order of pixel delivery, which should be the default assumption
|     * in the absence of any call to the setHints method.
|     * @see #setHints
|     
						
						type       	"int"
						initv      	"1"
						exportControl 	"Implementation")
					    (object ClassAttribute "TOPDOWNLEFTRIGHT"
						attributes 	(list Attribute_Set)
						quid       	"3968B58100C9"
						documentation 	
|
|     * The pixels will be delivered in top-down, left-to-right order.
|     * @see #setHints
|     
						
						type       	"int"
						initv      	"2"
						exportControl 	"Implementation")
					    (object ClassAttribute "COMPLETESCANLINES"
						attributes 	(list Attribute_Set)
						quid       	"3968B58100CA"
						documentation 	
|
|     * The pixels will be delivered in (multiples of) complete scanlines
|     * at a time.
|     * @see #setHints
|     
						
						type       	"int"
						initv      	"4"
						exportControl 	"Implementation")
					    (object ClassAttribute "SINGLEPASS"
						attributes 	(list Attribute_Set)
						quid       	"3968B58100D0"
						documentation 	
|
|     * The pixels will be delivered in a single pass.  Each pixel will
|     * appear in only one call to any of the setPixels methods.  An
|     * example of an image format which does not meet this criterion
|     * is a progressive JPEG image which defines pixels in multiple
|     * passes, each more refined than the previous.
|     * @see #setHints
|     
						
						type       	"int"
						initv      	"8"
						exportControl 	"Implementation")
					    (object ClassAttribute "SINGLEFRAME"
						attributes 	(list Attribute_Set)
						quid       	"3968B58100D1"
						documentation 	
|
|     * The image contain a single static image.  The pixels will be defined
|     * in calls to the setPixels methods and then the imageComplete method
|     * will be called with the STATICIMAGEDONE flag after which no more
|     * image data will be delivered.  An example of an image type which
|     * would not meet these criteria would be the output of a video feed,
|     * or the representation of a 3D rendering being manipulated
|     * by the user.  The end of each frame in those types of images will
|     * be indicated by calling imageComplete with the SINGLEFRAMEDONE flag.
|     * @see #setHints
|     * @see #imageComplete
|     
						
						type       	"int"
						initv      	"16"
						exportControl 	"Implementation")
					    (object ClassAttribute "IMAGEERROR"
						attributes 	(list Attribute_Set)
						quid       	"3968B58100D2"
						documentation 	
|
|     * An error was encountered while producing the image.
|     * @see #imageComplete
|     
						
						type       	"int"
						initv      	"1"
						exportControl 	"Implementation")
					    (object ClassAttribute "SINGLEFRAMEDONE"
						attributes 	(list Attribute_Set)
						quid       	"3968B58100D3"
						documentation 	
|
|     * One frame of the image is complete but there are more frames
|     * to be delivered.
|     * @see #imageComplete
|     
						
						type       	"int"
						initv      	"2"
						exportControl 	"Implementation")
					    (object ClassAttribute "STATICIMAGEDONE"
						attributes 	(list Attribute_Set)
						quid       	"3968B58100D4"
						documentation 	
|
|     * The image is complete and there are no more pixels or frames
|     * to be delivered.
|     * @see #imageComplete
|     
						
						type       	"int"
						initv      	"3"
						exportControl 	"Implementation")
					    (object ClassAttribute "IMAGEABORTED"
						attributes 	(list Attribute_Set)
						quid       	"3968B58100D5"
						documentation 	
|
|     * The image creation process was deliberately aborted.
|     * @see #imageComplete
|     
						
						type       	"int"
						initv      	"4"
						exportControl 	"Implementation"))
					module     	"Component View::java::awt::image::ImageConsumer"
					quidu      	"3968B58100C6"
					language   	"Java")
				    (object Class "ImageFilter"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"GenerateFinalizer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateStaticInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateInstanceInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateDefaultConstructor"
						value      	FALSE))
					quid       	"3968B5810102"
					documentation 	
|
| * This class implements a filter for the set of interface methods that
| * are used to deliver data from an ImageProducer to an ImageConsumer.
| * It is meant to be used in conjunction with a FilteredImageSource
| * object to produce filtered versions of existing images.  It is a
| * base class that provides the calls needed to implement a "Null filter"
| * which has no effect on the data being passed through.  Filters should
| * subclass this class and override the methods which deal with the
| * data that needs to be filtered and modify it as necessary.
| *
| * @see FilteredImageSource
| * @see ImageConsumer
| *
| * @version	1.20 09/21/98
| * @author 	Jim Graham
| 
					
					realized_interfaces 	(list realize_rel_list
					    (object Realize_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3968B581010C"
						supplier   	"Logical View::java::awt::image::ImageConsumer")
					    (object Realize_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3968B581010D"
						supplier   	"Logical View::java::lang::Cloneable"))
					operations 	(list Operations
					    (object Operation "getFilterInstance"
						attributes 	(list Attribute_Set)
						quid       	"3968B5810111"
						documentation 	
|
|     * Returns a unique instance of an ImageFilter object which will
|     * actually perform the filtering for the specified ImageConsumer.
|     * The default implementation just clones this object.
|     
						
						parameters 	(list Parameters
						    (object Parameter "ic"
							type       	"ImageConsumer"))
						result     	"ImageFilter"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "setDimensions"
						attributes 	(list Attribute_Set)
						quid       	"3968B5810117"
						documentation 	
|
|     * Filters the information provided in the setDimensions method
|     * of the ImageConsumer interface.
|     * @see ImageConsumer#setDimensions
|     
						
						parameters 	(list Parameters
						    (object Parameter "width"
							type       	"int")
						    (object Parameter "height"
							type       	"int"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "setProperties"
						attributes 	(list Attribute_Set)
						quid       	"3968B581011A"
						documentation 	
|
|     * Passes the properties from the source object along after adding a
|     * property indicating the stream of filters it has been run through.
|     
						
						parameters 	(list Parameters
						    (object Parameter "props"
							type       	"Hashtable"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "setColorModel"
						attributes 	(list Attribute_Set)
						quid       	"3968B581011C"
						documentation 	
|
|     * Filter the information provided in the setColorModel method
|     * of the ImageConsumer interface.
|     * @see ImageConsumer#setColorModel
|     
						
						parameters 	(list Parameters
						    (object Parameter "model"
							type       	"ColorModel"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "setHints"
						attributes 	(list Attribute_Set)
						quid       	"3968B581011E"
						documentation 	
|
|     * Filters the information provided in the setHints method
|     * of the ImageConsumer interface.
|     * @see ImageConsumer#setHints
|     
						
						parameters 	(list Parameters
						    (object Parameter "hints"
							type       	"int"))
						result     	"void"
