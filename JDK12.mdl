					documentation 	
|
|     * Utility routine to set the value of the digit list from a long
|     
					
					parameters 	(list Parameters
					    (object Parameter "source"
						type       	"long"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
