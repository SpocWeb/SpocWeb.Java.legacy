				quid       	"3968B5A20182"
				documentation 	
|
| * Write text to a character-output stream, buffering characters so as to
| * provide for the efficient writing of single characters, arrays, and strings.
| *
| * <p> The buffer size may be specified, or the default size may be accepted.
| * The default is large enough for most purposes.
| *
| * <p> A newLine() method is provided, which uses the platform's own notion of
| * line separator as defined by the system property <tt>line.separator</tt>.
| * Not all platforms use the newline character ('\n') to terminate lines.
| * Calling this method to terminate each output line is therefore preferred to
| * writing a newline character directly.
| *
| * <p> In general, a Writer sends its output immediately to the underlying
| * character or byte stream.  Unless prompt output is required, it is advisable
| * to wrap a BufferedWriter around any Writer whose write() operations may be
| * costly, such as FileWriters and OutputStreamWriters.  For example,
| *
| * <pre>
| * PrintWriter out
| *   = new PrintWriter(new BufferedWriter(new FileWriter("foo.out")));
| * </pre>
| *
| * will buffer the PrintWriter's output to the file.  Without buffering, each
| * invocation of a print() method would cause characters to be converted into
| * bytes that would then be written immediately to the file, which can be very
| * inefficient.
| *
| * @see PrintWriter
| * @see FileWriter
| * @see OutputStreamWriter
| *
| * @version 	1.20, 98/08/03
| * @author	Mark Reinhold
| * @since	JDK1.1
| 
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B5A603BA"
					supplier   	"Logical View::java::io::Writer"))
				operations 	(list Operations
				    (object Operation "BufferedWriter"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A603D6"
					documentation 	
|
|     * Create a buffered character-output stream that uses a default-sized
|     * output buffer.
|     *
|     * @param  out  A Writer
|     
					
					parameters 	(list Parameters
					    (object Parameter "out"
						type       	"Writer"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "BufferedWriter"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A603D8"
					documentation 	
|
|     * Create a new buffered character-output stream that uses an output
|     * buffer of the given size.
|     *
|     * @param  out  A Writer
|     * @param  sz   Output-buffer size, a positive integer
|     *
|     * @exception  IllegalArgumentException  If sz is <= 0
|     
					
					parameters 	(list Parameters
					    (object Parameter "out"
						type       	"Writer")
					    (object Parameter "sz"
						type       	"int"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "ensureOpen"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A603DB"
					documentation 	" Check to make sure that the stream has not been closed "
					result     	"void"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Private"
					uid        	0)
				    (object Operation "flushBuffer"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A603DC"
					documentation 	
|
|     * Flush the output buffer to the underlying character stream, without
|     * flushing the stream itself.  This method is non-private only so that it
|     * may be invoked by PrintStream.
|     
					
					result     	"void"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Implementation"
					uid        	0)
				    (object Operation "write"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A603DD"
					documentation 	
|
|     * Write a single character.
|     *
|     * @exception  IOException  If an I/O error occurs
|     
					
					parameters 	(list Parameters
					    (object Parameter "c"
						type       	"int"))
					result     	"void"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "min"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A603DF"
					documentation 	
|
|     * Our own little min method, to avoid loading java.lang.Math if we've run
|     * out of file descriptors and we're trying to print a stack trace.
|     
					
					parameters 	(list Parameters
					    (object Parameter "a"
						type       	"int")
					    (object Parameter "b"
						type       	"int"))
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Private"
					uid        	0)
				    (object Operation "write"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A603E2"
					documentation 	
|
|     * Write a portion of an array of characters.
|     *
|     * <p> Ordinarily this method stores characters from the given array into
|     * this stream's buffer, flushing the buffer to the underlying stream as
|     * needed.  If the requested length is at least as large as the buffer,
|     * however, then this method will flush the buffer and write the characters
|     * directly to the underlying stream.  Thus redundant
|     * <code>BufferedWriter</code>s will not copy data unnecessarily.
|     *
|     * @param  cbuf  A character array
|     * @param  off   Offset from which to start reading characters
|     * @param  len   Number of characters to write
|     *
|     * @exception  IOException  If an I/O error occurs
|     
					
					parameters 	(list Parameters
					    (object Parameter "cbuf[]"
						type       	"char")
					    (object Parameter "off"
						type       	"int")
					    (object Parameter "len"
						type       	"int"))
					result     	"void"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "write"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A603E6"
					documentation 	
|
|     * Write a portion of a String.
|     *
|     * @param  s     String to be written
|     * @param  off   Offset from which to start reading characters
|     * @param  len   Number of characters to be written
|     *
|     * @exception  IOException  If an I/O error occurs
|     
					
					parameters 	(list Parameters
					    (object Parameter "s"
						type       	"String")
					    (object Parameter "off"
						type       	"int")
					    (object Parameter "len"
						type       	"int"))
					result     	"void"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "newLine"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A603EA"
					documentation 	
|
|     * Write a line separator.  The line separator string is defined by the
|     * system property <tt>line.separator</tt>, and is not necessarily a single
|     * newline ('\n') character.
|     *
|     * @exception  IOException  If an I/O error occurs
|     
					
					result     	"void"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "flush"
