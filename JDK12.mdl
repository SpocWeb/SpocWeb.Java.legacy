						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateDefaultConstructor"
						value      	FALSE))
					quid       	"3968B5840214"
					documentation 	
|
| * This class subclasses an ImageFilter to provide a simple means of
| * using a single-source/single-destination image operator
| * (BufferedImageOp) to filter
| * a BufferedImage in the Image Producer/Consumer/Observer
| * paradigm. Examples of these image operators are: ConvolveOp,
| * AffineTransformOp and LookupOp.
| *
| * @see ImageFilter
| * @see BufferedImage
| * @see BufferedImageOp
| * @version 10 Feb 1997
| 
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3968B5840215"
						supplier   	"Logical View::java::awt::image::ImageFilter"))
					realized_interfaces 	(list realize_rel_list
					    (object Realize_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3968B584021E"
						supplier   	"Logical View::java::lang::Cloneable"))
					operations 	(list Operations
					    (object Operation "BufferedImageFilter"
						attributes 	(list Attribute_Set)
						quid       	"3968B584022F"
						documentation 	
|
|     * Constructs a BufferedImageFilter with the
|     * specified single-source/single-destination operator.
|     
						
						parameters 	(list Parameters
						    (object Parameter "op"
							type       	"BufferedImageOp"))
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getBufferedImageOp"
						attributes 	(list Attribute_Set)
						quid       	"3968B5840231"
						documentation 	
|
|     * Returns the BufferedImageOp.
|     
						
						result     	"BufferedImageOp"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "setDimensions"
						attributes 	(list Attribute_Set)
						quid       	"3968B5840232"
						documentation 	
|
|     * Filters the information provided in the setDimensions method
|     * of the ImageConsumer interface.
|     * <p>
|     * Note: This method is intended to be called by the ImageProducer
|     * of the Image whose pixels are being filtered.  Developers using
|     * this class to retrieve pixels from an image should avoid calling
|     * this method directly since that operation could result in problems
|     * with retrieving the requested pixels.
|     * @see ImageConsumer#setDimensions
|     
						
						parameters 	(list Parameters
						    (object Parameter "width"
							type       	"int")
						    (object Parameter "height"
							type       	"int"))
						result     	"void"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "setColorModel"
						attributes 	(list Attribute_Set)
						quid       	"3968B5840235"
						documentation 	
|
|     * Filters the information provided in the setColorModel method
|     * of the ImageConsumer interface.
