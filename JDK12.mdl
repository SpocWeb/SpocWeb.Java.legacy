|     * @see		java.util.Hashtable
|     * @since JDK1.1
|     
						
						parameters 	(list Parameters
						    (object Parameter "obj"
							type       	"RemoteRef"))
						result     	"boolean"
						concurrency 	"Sequential"
						opExportControl 	"Implementation"
						uid        	0)
