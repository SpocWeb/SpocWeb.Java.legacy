				documentation 	
|
| * A buffered character-input stream that keeps track of line numbers.  A line
| * is considered to be terminated by any one of a line feed ('\n'), a carriage
| * return ('\r'), or a carriage return followed immediately by a linefeed.
| *
| * @version 	1.9, 98/03/18
| * @author	Mark Reinhold
| * @since	JDK1.1
| 
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3968B5A803E3"
					supplier   	"Logical View::java::io::BufferedReader"))
				operations 	(list Operations
				    (object Operation "LineNumberReader"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A90008"
					documentation 	
|
|     * Create a new line-numbering reader, using the default input-buffer
|     * size.
|     
					
					parameters 	(list Parameters
					    (object Parameter "in"
						type       	"Reader"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "LineNumberReader"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A9000A"
					documentation 	
|
|     * Create a new line-numbering reader, reading characters into a buffer of
|     * the given size.
|     
					
					parameters 	(list Parameters
					    (object Parameter "in"
						type       	"Reader")
					    (object Parameter "sz"
						type       	"int"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setLineNumber"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A9000D"
					documentation 	
|
|     * Set the current line number.
|     
					
					parameters 	(list Parameters
					    (object Parameter "lineNumber"
						type       	"int"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getLineNumber"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A9000F"
					documentation 	
|
|     * Get the current line number.
|     
					
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "read"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A90010"
					documentation 	
|
|     * Read a single character.  Line terminators are compressed into single
|     * newline ('\n') characters.
|     *
|     * @return     The character read, or -1 if the end of the stream has been
|     *             reached
|     *
|     * @exception  IOException  If an I/O error occurs
|     
					
					result     	"int"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "read"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A90011"
					documentation 	
|
|     * Read characters into a portion of an array.
|     *
|     * @param      cbuf  Destination buffer
|     * @param      off   Offset at which to start storing characters
|     * @param      len   Maximum number of characters to read
|     *
|     * @return     The number of bytes read, or -1 if the end of the stream has
|     *             already been reached
|     *
|     * @exception  IOException  If an I/O error occurs
|     
					
					parameters 	(list Parameters
					    (object Parameter "cbuf[]"
						type       	"char")
					    (object Parameter "off"
						type       	"int")
					    (object Parameter "len"
						type       	"int"))
					result     	"int"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "readLine"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A90015"
					documentation 	
|
|     * Read a line of text.  A line is considered to be terminated by any one
|     * of a line feed ('\n'), a carriage return ('\r'), or a carriage return
|     * followed immediately by a linefeed.
|     *
|     * @return     A String containing the contents of the line, not including
|     *             any line-termination characters, or null if the end of the
|     *             stream has been reached
|     *
|     * @exception  IOException  If an I/O error occurs
|     
					
					result     	"String"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "skip"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A90016"
					documentation 	
|
|     * Skip characters.
|     *
|     * @param  n  The number of characters to skip
|     *
|     * @return    The number of characters actually skipped
|     *
|     * @exception  IOException  If an I/O error occurs
|     
					
					parameters 	(list Parameters
					    (object Parameter "n"
						type       	"long"))
					result     	"long"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "mark"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A90018"
					documentation 	
|
|     * Mark the present position in the stream.  Subsequent calls to reset()
|     * will attempt to reposition the stream to this point, and will also reset
|     * the line number appropriately.
|     *
|     * @param  readAheadLimit  Limit on the number of characters that may be
|     *                         read while still preserving the mark.  After
|     *                         reading this many characters, attempting to
|     *                         reset the stream may fail.
|     *
|     * @exception  IOException  If an I/O error occurs
|     
					
					parameters 	(list Parameters
					    (object Parameter "readAheadLimit"
						type       	"int"))
					result     	"void"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "reset"
					attributes 	(list Attribute_Set)
					quid       	"3968B5A9001A"
					documentation 	
|
|     * Reset the stream to the most recent mark.
|     *
|     * @exception  IOException  If the stream has not been marked,
|     *                          or if the mark has been invalidated
|     
					
					result     	"void"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0))
