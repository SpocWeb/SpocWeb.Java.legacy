					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5EF0161"
					documentation 	
|
|     * Move the iterator to the specified offset within the source text
|     *  @param newOffset the new offset
|     
					
					parameters 	(list Parameters
					    (object Parameter "newOffset"
						type       	"int"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Implementation"
					uid        	0)
