						attributes 	(list Attribute_Set)
						quid       	"3968B58601D3"
						documentation 	
|
|     *  Constructs a Raster with the given SampleModel.  The Raster's
|     *  upper left corner is origin and it is the same size as the
|     *  SampleModel.  A DataBuffer large enough to describe the
|     *  Raster is automatically created.
|     *  @param sampleModel     The SampleModel that specifies the layout.
|     *  @param origin          The Point that specified the origin.
|     
						
						parameters 	(list Parameters
						    (object Parameter "sampleModel"
							type       	"SampleModel")
						    (object Parameter "origin"
							type       	"Point"))
						concurrency 	"Sequential"
						opExportControl 	"Protected"
						uid        	0)
					    (object Operation "Raster"
						attributes 	(list Attribute_Set)
						quid       	"3968B58601D6"
						documentation 	
|
|     *  Constructs a Raster with the given SampleModel and DataBuffer.
|     *  The Raster's upper left corner is origin and it is the same size
|     *  as the SampleModel.  The DataBuffer is not initialized and must
|     *  be compatible with SampleModel.
|     *  @param sampleModel     The SampleModel that specifies the layout.
|     *  @param dataBuffer      The DataBuffer that contains the image data.
|     *  @param origin          The Point that specifies the origin.
|     
						
						parameters 	(list Parameters
						    (object Parameter "sampleModel"
							type       	"SampleModel")
						    (object Parameter "dataBuffer"
							type       	"DataBuffer")
						    (object Parameter "origin"
							type       	"Point"))
						concurrency 	"Sequential"
						opExportControl 	"Protected"
						uid        	0)
					    (object Operation "Raster"
						attributes 	(list Attribute_Set)
						quid       	"3968B58601DA"
						documentation 	
|
|     * Constructs a Raster with the given SampleModel, DataBuffer, and
|     * parent.  aRegion specifies the bounding rectangle of the new
|     * Raster.  When translated into the base Raster's coordinate
|     * system, aRegion must be contained by the base Raster.
|     * (The base Raster is the Raster's ancestor which has no parent.)
|     * sampleModelTranslate specifies the sampleModelTranslateX and
|     * sampleModelTranslateY values of the new Raster.
|     *
|     * Note that this constructor should generally be called by other
|     * constructors or create methods, it should not be used directly.
|     * @param sampleModel     The SampleModel that specifies the layout.
|     * @param dataBuffer      The DataBuffer that contains the image data.
|     * @param aRegion         The Rectangle that specifies the image area.     
|     * @param sampleModelTranslate  The Point that specifies the translation
|     *                        from SampleModel to Raster coordinates.
|     * @param parent          The parent (if any) of this raster.
|     
						
						parameters 	(list Parameters
						    (object Parameter "sampleModel"
							type       	"SampleModel")
						    (object Parameter "dataBuffer"
							type       	"DataBuffer")
						    (object Parameter "aRegion"
							type       	"Rectangle")
						    (object Parameter "sampleModelTranslate"
							type       	"Point")
						    (object Parameter "parent"
							type       	"Raster"))
						concurrency 	"Sequential"
						opExportControl 	"Protected"
						uid        	0)
					    (object Operation "getParent"
						attributes 	(list Attribute_Set)
						quid       	"3968B58601E0"
						documentation 	" Returns the parent Raster (if any) of this Raster, or else null. "
						result     	"Raster"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getSampleModelTranslateX"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B58601E1"
						documentation 	
|
|     * Returns the X translation from the coordinate system of the
|     * SampleModel to that of the Raster.  To convert a pixel's X
|     * coordinate from the Raster coordinate system to the SampleModel
|     * coordinate system, this value must be subtracted.
|     
						
						result     	"int"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "getSampleModelTranslateY"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Final"
							value      	TRUE))
						quid       	"3968B58601E2"
						documentation 	
|
|     * Returns the Y translation from the coordinate system of the
|     * SampleModel to that of the Raster.  To convert a pixel's Y
|     * coordinate from the Raster coordinate system to the SampleModel
|     * coordinate system, this value must be subtracted.
|     
						
						result     	"int"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "createCompatibleWritableRaster"
						attributes 	(list Attribute_Set)
						quid       	"3968B58601E3"
						documentation 	
|
|     * Create a compatible WritableRaster the same size as this Raster with
|     * the same SampleModel and a new initialized DataBuffer.
|     
						
						result     	"WritableRaster"
						concurrency 	"Sequential"
						opExportControl 	"Public"
