							name       	"Synchronized"
							value      	TRUE))
						quid       	"3968B5960094"
						documentation 	
|
|     * Adds a point to the path by drawing a straight line from the
|     * current coordinates to the new specified coordinates.
|     * @param x,&nbsp;y the specified coordinates
|     
						
						parameters 	(list Parameters
						    (object Parameter "x"
							type       	"float")
						    (object Parameter "y"
