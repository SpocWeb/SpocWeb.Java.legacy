					    (object Attribute
						tool       	"Java"
						name       	"Transient"
						value      	TRUE))
					quid       	"3968B5F101EB"
					documentation 	
|
|     * The number of units in the logical size of this BitSet.
|     * INVARIANT: unitsInUse is nonnegative.
|     * INVARIANT: bits[unitsInUse-1] is nonzero unless unitsInUse is zero.
|     
					
					type       	"int"
					initv      	"0")
