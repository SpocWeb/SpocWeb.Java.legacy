					result     	"String"
					concurrency 	"Sequential"
					opExportControl 	"Protected"
					uid        	0)
				    (object Operation "getRequestingScheme"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3968B5BC0272"
					documentation 	
|
|     * @return the scheme of the requestor (the HTTP scheme
