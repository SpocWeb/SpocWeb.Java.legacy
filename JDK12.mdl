				quid       	"3968B5EA02B2"
				documentation 	
|
| * <code>FieldPosition</code> is a simple class used by <code>Format</code>
| * and its subclasses to identify fields in formatted output. Fields are
| * identified by constants, whose names typically end with <code>_FIELD</code>,
| * defined in the various subclasses of <code>Format</code>. See
| * <code>ERA_FIELD</code> and its friends in <code>DateFormat</code> for
| * an example.
| *
| * <p>
| * <code>FieldPosition</code> keeps track of the position of the
| * field within the formatted output with two indices: the index
| * of the first character of the field and the index of the last
| * character of the field.
| *
| * <p>
| * One version of the <code>format</code> method in the various
| * <code>Format</code> classes requires a <code>FieldPosition</code>
| * object as an argument. You use this <code>format</code> method
| * to perform partial formatting or to get information about the
| * formatted output (such as the position of a field).
| *
| * @version     1.15 07/24/98
| * @author      Mark Davis
| * @see         java.text.Format
| 
				
				operations 	(list Operations
				    (object Operation "FieldPosition"
					attributes 	(list Attribute_Set)
					quid       	"3968B5EA02BE"
					documentation 	
|
|     * Creates a FieldPosition object for the given field.  Fields are
|     * identified by constants, whose names typically end with _FIELD,
|     * in the various subclasses of Format.
|     *
|     * @see java.text.NumberFormat#INTEGER_FIELD
|     * @see java.text.NumberFormat#FRACTION_FIELD
|     * @see java.text.DateFormat#YEAR_FIELD
|     * @see java.text.DateFormat#MONTH_FIELD
|     
					
					parameters 	(list Parameters
					    (object Parameter "field"
						type       	"int"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getField"
					attributes 	(list Attribute_Set)
					quid       	"3968B5EA02C0"
					documentation 	
|
|     * Retrieves the field identifier.
|     
					
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getBeginIndex"
					attributes 	(list Attribute_Set)
					quid       	"3968B5EA02C1"
					documentation 	
|
|     * Retrieves the index of the first character in the requested field.
|     
					
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "getEndIndex"
					attributes 	(list Attribute_Set)
					quid       	"3968B5EA02C2"
					documentation 	
|
|     * Retrieves the index of the character following the last character in the
|     * requested field.
|     
					
					result     	"int"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setBeginIndex"
					attributes 	(list Attribute_Set)
					quid       	"3968B5EA02C3"
					documentation 	
|
|     * Sets the begin index.  For use by subclasses of Format.
|     
					
					parameters 	(list Parameters
					    (object Parameter "bi"
						type       	"int"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "setEndIndex"
