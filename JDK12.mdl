					quid       	"3968B5A90116"
					documentation 	
|
|     * List the available filesystem roots.
|     
					
					result     	"File[]"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "compare"
					attributes 	(list Attribute_Set
					    (object Attribute
