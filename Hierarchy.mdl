		    (object Class_Category "Copy"
			quid       	"3B2371EB0045"
			exportControl 	"Public"
			logical_models 	(list unit_reference_list
			    (object Class "testCopy"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"GenerateFinalizer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateStaticInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateInstanceInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateDefaultConstructor"
					value      	FALSE))
				quid       	"3B2371EB0047"
				operations 	(list Operations
				    (object Operation "main"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE))
					quid       	"3B2371EB0048"
					documentation 	
|The main entry point for the application.
|	 * @param args Array of command line parameters passed to the application.
|	 * Here I can test the static Methods of the Classes
|	 * and call the testIt() Methods.	 
					
					parameters 	(list Parameters
					    (object Parameter "args"
						type       	"String[]"))
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0))
				module     	"Component View::Stream::Copy::testCopy"
				quidu      	"3B2371EB0046"
				language   	"Java")
			    (object Class "ICopyAble"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"GenerateFinalizer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateStaticInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateInstanceInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateDefaultConstructor"
					value      	FALSE))
				quid       	"3B2371EB0063"
				documentation 	
|Basic Interface for classes with an empty constructor
| * and copying of Values in a later state.
| * This is somewhat against the Paradigm of a stable Object,
| * because also the HashValue etc. are no longer constant
| * so the Location in a Container could be falsified!
| * The Advantage with numerical Calculations is
| * that not with every operation a new Object has to be instantiated.
| * Additionally optimizations are possible to save creation and termination.
| *
| * It also creates the opportunity to define Methods that
| * 1. don't have an overhead to create a new instance
| * 2. can replace the inner contents of an object.
| *
| * Because in Java any Field Variable is automatically initialized,
| * this doesn't really save time for simple Classes, but for Containers.
| *
| * Design Decisions:
| * toString and fromString could use the Class name
| * to automatically determine the Class to be created.
| *
| 
				
				stereotype 	"Interface"
				operations 	(list Operations
				    (object Operation "copyAt"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3B2371EB0064"
					documentation 	
|Integrates deepCopyAt() and shallopCopyAt().
|	 * Does a Copy to a certain Level
|	 * i.e. also inner Components are copied up to the Depth.
|	 * Returns the itself for further use.
|	 * Depth is only valid >= 0, for 0 only copy() is valid and returns itself. 
					
					parameters 	(list Parameters
					    (object Parameter "arg"
						type       	"Object")
					    (object Parameter "Depth"
						type       	"int"))
					result     	"CopyAble"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "newInstance"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3B2371EB0067"
					documentation 	
|Creates an uninitalized new Instance of it's class.
|	 * When overriding, use newInstance on all Components.	 
					
					result     	"CopyAble"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "fromStreamAt"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3B2371EB0068"
					documentation 	
|Fills this Instance with the Contents read from the Stream.	 
					
					parameters 	(list Parameters
					    (object Parameter "ST"
						type       	"ParserIn"))
					result     	"CopyAble"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "toStream"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Abstract"
						value      	TRUE))
					quid       	"3B2371EB006A"
					documentation 	
|Writes the Contents of this Object into the Stream.	 
					
					parameters 	(list Parameters
					    (object Parameter "ST"
						type       	"FormatterOut"))
					result     	"void"
					exceptions 	"IOException"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0))
				module     	"Component View::Stream::Copy::ICopyAble"
				quidu      	"3B2371EB005A"
