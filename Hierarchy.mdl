						quidu      	"3B2371EC007F")
					    (object Inheritance_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC00CC"
						supplier   	"Logical View::Stream::Copy::CopyAble"
						quidu      	"3B2371EB00A0"))
					operations 	(list Operations
					    (object Operation "AND"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3B2371EC00CD"
						documentation 	
|Boolean AND Operation: &, && for single Bit
|	 * For Sets: Intersection	
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Bond"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "OR"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3B2371EC00CF"
						documentation 	
|Boolean OR Operation: |, || for single Bit
|	 * For Sets: Union
|	 * Compare this to the '+' Operation unifying disjoint Sets.	
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Bond"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "DIFF"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3B2371EC00D2"
						documentation 	
|Boolean DIFF Operation: -
|	 * a - b <=> (a AND NOT b) <=> NOT IMP
|	 * For Sets:	Difference Set ; can also be defined without NOT!  
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Bond"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "XOR"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3B2371EC00D4"
						documentation 	
|Boolean XOR Operation: ^
|	 * a XOR b = true <=> (a AND ~b) OR (~a AND b) <=> NOT(a EQV b) <=> (a-b) OR (b-a)
|	 * For Sets: Gives Set of all Elements, that are either in one or
|	 * (exclusively) in the other	
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Bond"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "XORat"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3B2371EC00D6"
						documentation 	
|Boolean XOR Operation in Place: ^=
|	 * a XOR b <=> (a AND NOT b) OR (NOT a AND b)
|	 * For Sets: Gives Set of all Elements, that are either in one or the other 	
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Bond"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "SubEq"
