				name       	"GenerateDefaultConstructor"
				value      	FALSE))
			quid       	"3B2371EA030F"
			documentation 	
|
|  * StreamOut.java
|  * Interface defined for a Store analogous to an OutputStream
|  * Not used 'HalfGroup', because that carries too much Overhead
|  * and you have to distinguish between addAt() and addItem() anyway,
|  * because addAt() unwraps Containers and Iterators.
|  *
|  * Any StreamOut can also be used as a DeMultiplexer (on a Get Request Basis)
|  * by just connecting several Processes, Threads etc. to it
|  *
|  * Created on 26. Mai 2001, 21:28
|  *
|  * @author  Matthias Heuer
|  * @version
|  
			
			stereotype 	"Interface"
			operations 	(list Operations
			    (object Operation "addItem"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"Abstract"
					value      	TRUE))
				quid       	"3B23996C017D"
				documentation 	
| Adds this Item to the Store in Place: +=
|	  * The Type of Item is not analyzed, i.e. Containers are added as is.
|	  * The Position of the Item is undefined either.
|	  * When IO Processes are bound to this Stream, IOException is wrapped into an IOError.
|	  
				
				parameters 	(list Parameters
				    (object Parameter "arg"
					type       	"Object"))
				result     	"StreamOut"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "add"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"Abstract"
					value      	TRUE))
				quid       	"3B23996C01EB"
				documentation 	
| adds these Items to the Store in Place: +=
|	  * The Type of Item is not analyzed, i.e. Containers are added as is.	  
				
				parameters 	(list Parameters
				    (object Parameter "arg"
					type       	"Object[]"))
				result     	"StreamOut"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "add"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"Abstract"
					value      	TRUE))
				quid       	"3B23996C024F"
				documentation 	
| adds all Items from the Enumerator to the Store in Place: +=
