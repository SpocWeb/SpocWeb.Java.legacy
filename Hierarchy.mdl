						name       	"Static"
						value      	TRUE))
					quid       	"3B2371EA0340"
					documentation 	
|Tests all Methods of this Class	 
					
					result     	"void"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0))
