						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3B2371EC00D8"
						documentation 	
|Determines, whether 'this' is less than or a SubSet of arg
|	 * This is a real Order Relation and could also be called 'less'	
						
						parameters 	(list Parameters
						    (object Parameter "arg"
