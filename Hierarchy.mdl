			module     	"Component View::Function::MeasurAble"
			quidu      	"3B2371E90092"
			language   	"Java")
		    (object Class "OrderAble"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"Java"
				name       	"GenerateFinalizer"
				value      	FALSE)
			    (object Attribute
				tool       	"Java"
				name       	"GenerateStaticInitializer"
				value      	FALSE)
			    (object Attribute
				tool       	"Java"
				name       	"GenerateInstanceInitializer"
				value      	FALSE)
			    (object Attribute
				tool       	"Java"
				name       	"GenerateDefaultConstructor"
				value      	FALSE))
			quid       	"3B2371E9009E"
			documentation 	
|OrderAble:
| * Interface for a Class whose Objects have a strict Order Relation ">" resp. "<".
| * Complements the pure virtual Interface 'intOrderable'.
| * If a Set is not ordered completely, these Relations are not defined
| * for any two Elements. In this Case, both >= and <= give False.
| * When the Element is the same or equivalent, both >= and <= give True.
| * When the Element is comparable, only one gives True.
| *
| * Absolute Value is only important because of the Metric defined by "<".
| * A Default Implementation is done in 'absOrderable'.
| 
			
			stereotype 	"Interface"
			superclasses 	(list inheritance_relationship_list
			    (object Inheritance_Relationship
				attributes 	(list Attribute_Set)
				quid       	"3B2371E900AB"
				supplier   	"Logical View::Function::IOrderAble"
				quidu      	"3B2371E90067"))
			operations 	(list Operations
			    (object Operation "between"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"Abstract"
					value      	TRUE))
				quid       	"3B2371E900AC"
				documentation 	
| Sloppy (on Equality) but fast 'between' Implementation
|	  * @param arg1 : first  Border to compare to <CODE>this</CODE>
|	  * @param arg2 : second Border to compare to <CODE>this</CODE>
|	  * @return True, when 'Self' is between arg1 and arg2
|	  
				
				parameters 	(list Parameters
				    (object Parameter "arg1"
					type       	"Object")
				    (object Parameter "arg2"
					type       	"Object"))
				result     	"boolean"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "grtr"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"Abstract"
					value      	TRUE))
				quid       	"3B2371E900AF"
				documentation 	
| greater: '>' Returns True, when 'Self' > arg
|	 * @param arg  : Object to compare to <CODE>this</CODE>
|	 * @return
|	 
				
				parameters 	(list Parameters
				    (object Parameter "arg"
					type       	"Object"))
				result     	"boolean"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "grtrEq"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"Abstract"
					value      	TRUE))
				quid       	"3B2371E900B1"
				documentation 	
| greater or equal: '>=' Returns True, when 'Self' >= arg
|	 * @param arg  : Object to compare to <CODE>this</CODE>
|	 * @return
|	 
				
				parameters 	(list Parameters
				    (object Parameter "arg"
					type       	"Object"))
				result     	"boolean"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "lessEq"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"Abstract"
					value      	TRUE))
				quid       	"3B2371E900B3"
				documentation 	
| less or equal: '<=' Returns True, when 'Self' <= arg
|	 * @param arg  : Object to compare to <CODE>this</CODE>
|	 * @return
|	 
				
				parameters 	(list Parameters
				    (object Parameter "arg"
					type       	"Object"))
				result     	"boolean"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "Position"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"Abstract"
					value      	TRUE))
				quid       	"3B2371E900B5"
				documentation 	
| Returns the Position of this Object relative to arg:
|	 * -1 for smaller, otherwise +1
|	 * This Operation is leaner than compareTo.
|	 * @param arg  : Object to compare to <CODE>this</CODE>
|	 * @return
|	 
				
				parameters 	(list Parameters
				    (object Parameter "arg"
					type       	"Object"))
				result     	"int"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "compareTo"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"Abstract"
					value      	TRUE))
				quid       	"3B2371E900B7"
				documentation 	
| Returns the exact Position of this Object relative to arg:
|	 * The Java 1.2 Interface 'Comparable' calls this 'compareTo'
|	 * The Java 1.2 Interface 'Comparable' ^defines an Operator with 'compare'
|	 * -1 for smaller, 0 for equal, otherwise +1
|	 * @param arg  : Object to compare to <CODE>this</CODE>
|	 * @return
|	 
				
				parameters 	(list Parameters
				    (object Parameter "arg"
					type       	"Object"))
				result     	"int"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0))
