				quid       	"3B2371E803B5"
				supplier   	"Logical View::Function::AFunction"
				quidu      	"3B2371E803A9"))
			realized_interfaces 	(list realize_rel_list
			    (object Realize_Relationship
				attributes 	(list Attribute_Set)
				quid       	"3B2371E803B6"
				supplier   	"Logical View::Function::InvertAble"
				quidu      	"3B2371E80395"))
			operations 	(list Operations
			    (object Operation "setInverse"
				attributes 	(list Attribute_Set)
				quid       	"3B2371E803BA"
				documentation 	
| Sets the Inverse from outside.
|     * This can be done only once, after that an IllegalStateException is thrown.     
				
				parameters 	(list Parameters
				    (object Parameter "Inverse"
					type       	"InvertAble"))
				result     	"void"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "Inverse"
				attributes 	(list Attribute_Set)
				quid       	"3B2371E803BD"
