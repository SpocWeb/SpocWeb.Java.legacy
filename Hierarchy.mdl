				operations 	(list Operations
				    (object Operation "APipe"
					attributes 	(list Attribute_Set)
					quid       	"3B2371ED02DF"
					documentation 	
|Constructor setting the current Version of the Container
| * This "Version" must be checked on any nextItem() Operation.
| * The currItem() Operation does not go back to the Container.
| 
					
					parameters 	(list Parameters
					    (object Parameter "Cont"
						type       	"AlterAble"))
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "APipe"
					attributes 	(list Attribute_Set)
					quid       	"3B2371ED02E1"
					documentation 	
|Empty Constructor TODO: should be removed to enforce Version Check!	 
					
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "add"
					attributes 	(list Attribute_Set)
					quid       	"3B2371ED02E2"
					documentation 	
| adds these Items to the Store in Place: +=
|  * The Type of Item is not analyzed, i.e. Containers are added as is.	  
					
					parameters 	(list Parameters
					    (object Parameter "arg"
						type       	"Object[]"))
					result     	"StreamOut"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "add"
					attributes 	(list Attribute_Set)
					quid       	"3B2371ED02E4"
					documentation 	
| adds all Items from the Enumerator to the Store in Place: +=
| * The Type of Item is not analyzed, i.e. Containers are added as is.	   
					
					parameters 	(list Parameters
					    (object Parameter "Iter"
						type       	"IStreamIn"))
					result     	"StreamOut"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "replaceCurr"
					attributes 	(list Attribute_Set)
					quid       	"3B2371ED02E6"
					documentation 	
|Replaces the current Object in the Container with the given Item.
| * One Problem is other Enumerators that concurrently work through this Container.
| * Another Problem is that removing the Item may not be possible at all.
| * In this Case the Exception is thrown.
| * That is why this Method should throw an Exception if replacing is not allowed.
| * It should also update the Minor Version (or let the Container update it)
| * to announce the Change to other Iterators.
| 
					
					parameters 	(list Parameters
					    (object Parameter "Item"
						type       	"Object"))
					result     	"Object"
					exceptions 	"OperationNotSupported"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
				    (object Operation "replaceNext"
					attributes 	(list Attribute_Set)
					quid       	"3B2371ED02E8"
					documentation 	
|Replaces the next Object from the Stream with this Item.
| * It should also update the Minor Version (or let the Container update it)
| * to announce the Change to other Iterators.
| * This Operation can be used to e.g. influence Parsers concurrently.
| 
					
					parameters 	(list Parameters
					    (object Parameter "Item"
						type       	"Object"))
					result     	"Object"
					exceptions 	"OperationNotSupported"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "Major"
					attributes 	(list Attribute_Set)
					quid       	"3B2371ED02DE"
					documentation 	
|Minor Version of the Container. At Creation a fast-fail Iterator should read this.
| * and throw a ConcurrentModificationException instead of synchronizing
| * all the Container Methods and thus blocking the Iterators.
| * Can also be used to keep the Version if this is a Container.
| * Counts the Number of simple Data Changes of this Container
| 
					
					type       	"int"
					exportControl 	"Protected"))
				module     	"Component View::Stream::Object::APipe"
				quidu      	"3B2371ED02A3"
				language   	"Java"
				abstract   	TRUE)
			    (object Class "Pipe"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"GenerateFinalizer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateStaticInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateInstanceInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateDefaultConstructor"
					value      	FALSE))
				quid       	"3B2371ED02AE"
				documentation 	
|This Class models a Pipe which implements both Interfaces: StreamIn and StreamOut.
| * This allows flexible Communication between two Objects and Threads
| * To facilitate continuous Operation on both Sides you have to add caching
| * To avoid Memory Overload, you should introduce a MaxCapacity.
| * Synchronization between Sender and Receiver can be done by blocking.
| * To avoid DeadLocks, introduce a Timeout for the Blocking.
| *
| * To communicate Changes in Structure, Major should be incremented with each Item.
| * This should be done automatically by addItem() and additionally,
| * when a contained Object changes it's State.
| *
| 
				
				stereotype 	"Interface"
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3B2371ED02C0"
					supplier   	"Logical View::Stream::Object::ModStreamIn"
					quidu      	"3B2371ED02BF")
				    (object Inheritance_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3B2371ED02C1"
					supplier   	"Logical View::Stream::StreamOut"
					quidu      	"3B2371EA030F")
				    (object Inheritance_Relationship
