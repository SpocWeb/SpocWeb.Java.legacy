					module     	"Component View::Stream::Copy::Boole::Bond"
					quidu      	"3B2371EC000B"
					language   	"Java")
				    (object Class "ABoole"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"GenerateFinalizer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateStaticInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateInstanceInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateDefaultConstructor"
						value      	FALSE))
					quid       	"3B2371EC0035"
					documentation 	
|This Class defines the full Interface for a Boolean Algebra.
| * The two basic Operations AND and OR are intertwined
| * in that both use the same inverse: NOT,
| * but it leads only to the other operation's neutral Element,
| * instead of to this operations's neutral Element.
| *
| * The Definition can be extended to Vectors of Boolean Elements,
| * which allows for operations on large sets of Elements,
| * in which each one acts independently (Vector, not Polynom).
| * In a binary Representation AND and OR can be defined by MUL and ADD,
| * but without Carry Bit.
| *
| * Direct SubClasses:
| *		Container.absSet(concrete, no Delegator anymore!)
| *		SetInteger.absSetInteger
| *		Boole.Boolean	(final)
| * Delegations (via absSetInteger):
| *		Vector.Binary
| *		Vector.BitVector
| *
| * This Class has been created for Delegation,
| * by having all Methods work with self,
| * because the SubClass absSetInteger is used by Binary and BitVector.
| * ArrStruct cannot use it directly, because Bits are not defined there!	 
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC0036"
						supplier   	"Logical View::Stream::Copy::Boole::ABond"
						quidu      	"3B2371EC0003"))
					realized_interfaces 	(list realize_rel_list
					    (object Realize_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC0039"
						supplier   	"Logical View::Stream::Copy::Boole::Boole"
						quidu      	"3B2371EC0038"))
					operations 	(list Operations
					    (object Operation "ABoole"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC003A"
						documentation 	"Empty Constructor for Inheritance. 'self' is set to this. "
						concurrency 	"Sequential"
						opExportControl 	"Protected"
						uid        	0)
					    (object Operation "ABoole"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC003B"
						documentation 	
|Constructor to pass over 'this' for Delegation.	 
						
						parameters 	(list Parameters
						    (object Parameter "self"
							type       	"Boole"))
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "XOR"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC003D"
						documentation 	
|Boolean XOR Operation: ^
|	 * a ^ b = (a & ~b) | (~a & b) = (a-b) + (b-a)	 
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Bond"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "DIFF"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC003F"
						documentation 	
|Boolean DIFF Operation: -
|	 * a - b <=> (a AND NOT b) <=> NOT IMP
|	 * For Sets:	Difference Set, can also be defined as a fundamental Operation! 
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Bond"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "IMP"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC0041"
						documentation 	
| Boolean IMP Operation: =>
|	  * a => b == ~a | (a & b) == ~a | b
|	  * This is equivalent to the Bond.SubEq Test. 	
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Boole"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "EQV"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC0043"
						documentation 	
|Boolean EQV Operation: <=>
|	 * a <=> b == ~(a ^ b) 
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Boole"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "False"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC0045"
						documentation 	
|Boolean Constant for the Representation of 'false' = 0	
						
						result     	"Boole"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "True"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC0046"
						documentation 	
|Boolean Constant for the Representation of 'true': 1		
						
						result     	"Boole"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "NOT"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC0047"
						documentation 	
| Boolean NOT Operation: ~, ! for single Bit
|	  * NOT a <=> TRUE - a  	
						
						result     	"Boole"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "DIFFat"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC0048"
						documentation 	
|Boolean DIFF Operation in Place: -=
|	 * a - b <=> (a AND NOT b) <=> NOT IMP
|	 * For Sets:	Difference Set
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Bond"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "IMPat"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC004A"
						documentation 	
|Boolean IMP Operation in Place: =>
|	 * a IMP b = true <=> (a = true) => (b = true)
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Boole"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "EQVat"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC004C"
						documentation 	
|Boolean EQV Operation in Place: <=>
|	 * a EQV b = true <=> (a = b)
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Boole"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "TrueAt"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC004E"
						documentation 	
|Boolean Constant for the Representation of 'true': 1	
						
						result     	"Boole"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "NOTat"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC004F"
						documentation 	
|Boolean NOT Operation in Place: ~=, != for single Bit	
						
						result     	"Boole"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "FalseAt"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC0050"
						documentation 	
|Boolean Constant for the Representation of 'false' = 0
|	 *  i.e. not 'true'.	 
						
						result     	"Boole"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "isFalse"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC0051"
						documentation 	
|Returns true, when 'this' is False, or an empty Set	 
						
						result     	"boolean"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "isTrue"
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC0052"
						documentation 	
|Returns true, when 'this' is True, or a full Set	 
						
						result     	"boolean"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0))
					module     	"Component View::Stream::Copy::Boole::ABoole"
					quidu      	"3B2371EC0034"
					language   	"Java")
				    (object Class "Boole"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"GenerateFinalizer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateStaticInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateInstanceInitializer"
						value      	FALSE)
					    (object Attribute
						tool       	"Java"
						name       	"GenerateDefaultConstructor"
						value      	FALSE))
					quid       	"3B2371EC0038"
					documentation 	
|This Class defines the full Interface for a Boolean Algebra.
| * The two basic Operations AND and OR are intertwined
| * in that both use the same inverse: NOT
| * but it leads only to the other operation's neutral Element,
| * instead of to this operations's neutral Element.
| *
| * These Operations and their Negation cover the full Range
| * of ALL 16 possible binary Operations,
| * except for '<=', which has no simple name, because not being used,
| * and can easily be replaced by '=>' and swapping the Arguments.
| *
| * The Definition can be extended to Vectors of Boolean Elements,
| * which allows for operations on large sets of Elements,
| * in which each one acts independently (Vector, not Polynom).
| *
| * This allows for a Representation of Sets, where each Boole
| * Item indicates the Existence of this Element in the Set.
| *
| * In a binary Representation AND and OR can be defined by MUL and ADD,
| * but without Carry Bit.
| 
					
					stereotype 	"Interface"
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC0056"
						supplier   	"Logical View::Stream::Copy::Boole::IBoole"
						quidu      	"3B2371EC0055")
					    (object Inheritance_Relationship
						attributes 	(list Attribute_Set)
						quid       	"3B2371EC0057"
						supplier   	"Logical View::Stream::Copy::Boole::Bond"
						quidu      	"3B2371EC000C"))
					operations 	(list Operations
					    (object Operation "NOT"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3B2371EC0058"
						documentation 	
|Boolean NOT Operation: ~, ! for single Bit
|	 * For Sets: Returns the Complement Set	
						
						result     	"Boole"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "IMP"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3B2371EC0059"
						documentation 	
|Boolean IMP Operation: =>
|	 * a IMP b <=> (b OR NOT a ) <=> NOT (b-a)
|	 * For Sets: Gives Set of all Elements, that exist in b when they exist in a
|	 * This is a real Order Relation and could also be called 'grtr'	
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Boole"
						concurrency 	"Sequential"
						opExportControl 	"Public"
						uid        	0)
					    (object Operation "EQV"
						attributes 	(list Attribute_Set
						    (object Attribute
							tool       	"Java"
							name       	"Abstract"
							value      	TRUE))
						quid       	"3B2371EC005B"
						documentation 	
|Boolean EQV Operation: <=>
|	 * a EQV b <=> NOT(a XOR b) <=>
|	 * For Sets: Gives Set of all Elements, that are either in both or in none	
						
						parameters 	(list Parameters
						    (object Parameter "arg"
							type       	"Object"))
						result     	"Boole"
						concurrency 	"Sequential"
