						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3B2371ED030B"
					documentation 	
| Returns a Stream that returns the correct Set Union from Streams without Duplicates.
|	  * For not disjoint Streams use the Fact that:
|	  * A || B = A-B + B-A + B && A
|	  
					
					parameters 	(list Parameters
					    (object Parameter "A"
						type       	"StreamIn")
					    (object Parameter "B"
						type       	"StreamIn"))
					result     	"StreamIn"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
