					name       	"GenerateDefaultConstructor"
					value      	FALSE))
				quid       	"3B2371ED02FC"
				documentation 	
| This Class creates a Union of all Input Streams given by an Enumerator.
|  * This can be used to implement the "OR" Operation, if both Streams are disjoint,
|  * otherwise you have to use a Container to filter out Duplicates.
|  * To create an XOR Union you can also use this Union, but instead of just adding the Items,
|  * use the flip() Method to add/remove the Items.
|  * This is the Object Analogon of Stream.Byte.LimitedSizeOutputStream
|  * Instead of interleaving a fixed Number of (possibly infinite) Input Streams
|  * like in  'MultiplexerIn' , this appends a (possibly infinite) Number of finite Input Streams.
|  
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					attributes 	(list Attribute_Set)
					quid       	"3B2371ED02FD"
					supplier   	"Logical View::Stream::Object::FilterIn"
					quidu      	"3B2371ED0143"))
				operations 	(list Operations
				    (object Operation "XOR"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Java"
						name       	"Static"
						value      	TRUE)
					    (object Attribute
						tool       	"Java"
						name       	"Final"
						value      	TRUE))
					quid       	"3B2371ED0308"
					documentation 	
| Returns a Stream that returns the XOR of the two Streams without Duplicates.
|	  * For not disjoint Streams use the Fact that:
|	  * A ^ B = A-B + B-A
|	  
					
					parameters 	(list Parameters
					    (object Parameter "A"
						type       	"StreamIn")
					    (object Parameter "B"
						type       	"StreamIn"))
					result     	"StreamIn"
					concurrency 	"Sequential"
					opExportControl 	"Public"
					uid        	0)
