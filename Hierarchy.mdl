			quid       	"3B2371EA0103"
			documentation 	
|Class that parameterizes an Automaton,
| * so it can search for Patterns described by regular Expressions
| * in a String.
| * The Grammer is defined by the following Rules:
| * Concatenation:	AB is the concatenation of A and B
| * Or:				A+B	means that either A or B can follow
| * Closure:			B* means that B is repeated 0..n times.
| * Brackets:		Expressions in Brackets are treated a Atoms
| *
| * Creates a non-deterministic Automaton (with next1 and next2 as Alternatives).
| * The Automaton is parameterized by the Parser.
| * It is realized using a DeQueue where the Alternatives for the currently
| * tested Character are added at the Head, so they are tested next,
| * before moving to the next Character,
| * and the Alternatives for the next Character are added at the Tail
| * (after a Scan Mark to indicate the Move to the next Character).	 
			
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "BASE64_PAD"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"?_Touched_?"
					value      	"?_Touched_?")
				    (object Attribute
					tool       	"Java"
					name       	"Final"
					value      	TRUE))
				quid       	"3B2371EA0104"
				documentation 	
|Padding Character.	 
				
				type       	"char"
				initv      	"'='"
				exportControl 	"Public"
				static     	TRUE)
			    (object ClassAttribute "BASE64_MAXBINSIZE"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"?_Touched_?"
					value      	"?_Touched_?")
				    (object Attribute
					tool       	"Java"
					name       	"Final"
					value      	TRUE))
				quid       	"3B2371EA0105"
				documentation 	
|Maximum Size of a Bin	 
				
				type       	"int"
				initv      	"57"
				exportControl 	"Public"
				static     	TRUE))
			module     	"Component View::String::RegExp"
			quidu      	"3B2371EA0102"
			language   	"Java")
		    (object Class "Scanner"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"Java"
				name       	"?_Touched_?"
				value      	"?_Touched_?")
			    (object Attribute
				tool       	"Java"
