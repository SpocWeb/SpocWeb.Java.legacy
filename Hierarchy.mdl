					tool       	"Java"
					name       	"GenerateStaticInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateInstanceInitializer"
					value      	FALSE)
				    (object Attribute
					tool       	"Java"
					name       	"GenerateDefaultConstructor"
					value      	FALSE))
				quid       	"3B2371EA0322"
				documentation 	
| Interface of an Automaton State Change Function Lambda: a[x][q] -> q
|  * The States Q are general Objects.
|  * The Value of the Coefficients a[x,q] represents the next State.
|  
				
