				name       	"GenerateInstanceInitializer"
				value      	FALSE)
			    (object Attribute
				tool       	"Java"
				name       	"GenerateDefaultConstructor"
				value      	FALSE))
			quid       	"3B2371EA015C"
			documentation 	
|Implementation of a DeQueue using an Array.
| * When the Capacity is depleted, it automatically allocates new Space.
| * It also does a Wrap-around on the Beginning and End.	 
			
			operations 	(list Operations
			    (object Operation "setStack"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA0161"
				documentation 	
|Sets the Flag that determines, whether the Store Operations
|	 * work in LIFO (Stack) Fashion (true )
|	 * or	in FIFO (Queue) Fashion (false)	 
				
				parameters 	(list Parameters
				    (object Parameter "Stack"
					type       	"boolean"))
				result     	"void"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "getStack"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA0163"
				documentation 	
|Returns the Flag that indicates, whether the Operations above
|	 * work in LIFO (Stack) Fashion (true )
|	 * or	in FIFO (Queue) Fashion (false)	 
				
				result     	"boolean"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "clear"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA0164"
				documentation 	
|Clears the Queue	 
				
				result     	"void"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "XDeQueueInt"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA0165"
				documentation 	
|Constructor allocating the Space	 
				
				parameters 	(list Parameters
				    (object Parameter "Capacity"
					type       	"int")
				    (object Parameter "Stack"
					type       	"boolean"))
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "ensureCapacity"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA0168"
				documentation 	
|Increases the Space for the DeQueue.
|	 * Only possible, if no wrap-around has taken place	 
				
				parameters 	(list Parameters
				    (object Parameter "N"
					type       	"int"))
				result     	"int"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "put"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA016A"
				documentation 	
|Puts an Item into the Store	 
				
				parameters 	(list Parameters
				    (object Parameter "Item"
					type       	"int"))
				result     	"void"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "get"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA016C"
				documentation 	
|Gets an Item from the Store	 
				
				result     	"int"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "peek"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA016D"
				documentation 	
|Returns the next Item of the Store without removing it.	 
				
				result     	"int"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "isZero"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA016E"
				documentation 	
|Returns true, if the Store is empty.	 
				
				result     	"boolean"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "isFull"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA016F"
				documentation 	
|Returns true, if the Store is full.	 
				
				result     	"boolean"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "putHead"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA0170"
				documentation 	
|Puts an Item at the Head of the Queue, i.e. the Bottom of the Stack	 
				
				parameters 	(list Parameters
				    (object Parameter "Item"
					type       	"int"))
				result     	"void"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "toString"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA0172"
				result     	"String"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "testIt"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"Static"
					value      	TRUE))
				quid       	"3B2371EA0173"
				documentation 	
|Tests all Methods of this Class	 
				
				result     	"void"
				exceptions 	"java.io.IOException"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0))
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "IFO[]"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA015D"
				documentation 	
|Stack (LIFO) or Queue (FIFO) for the current Operation,
|	 * since the Space is limited to the Number of Vertices.	 
				
				type       	"int"
				exportControl 	"Implementation")
			    (object ClassAttribute "SP"
				attributes 	(list Attribute_Set)
