	    (object Class_Category "String"
		quid       	"3B2371EA00B2"
		exportControl 	"Public"
		logical_models 	(list unit_reference_list
		    (object Class "DeQueueInt"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"Java"
				name       	"GenerateFinalizer"
				value      	FALSE)
			    (object Attribute
				tool       	"Java"
				name       	"GenerateStaticInitializer"
				value      	FALSE)
			    (object Attribute
				tool       	"Java"
				name       	"GenerateInstanceInitializer"
				value      	FALSE)
			    (object Attribute
				tool       	"Java"
				name       	"GenerateDefaultConstructor"
				value      	FALSE))
			quid       	"3B2371EA00BD"
			documentation 	
|Implementation of a DeQueue with Integers using an Array.
| * When the Capacity is depleted, an Error occurs.
| * It can only run once through it's Store,
| * so only N put() and get() Operations in Queue Style are possible.	 
			
			operations 	(list Operations
			    (object Operation "setStack"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA00C2"
				documentation 	
|Sets the Flag that determines, whether the Store Operations
|	 * work in LIFO (Stack) Fashion (true )
|	 * or	in FIFO (Queue) Fashion (false)	 
				
				parameters 	(list Parameters
				    (object Parameter "Stack"
					type       	"boolean"))
				result     	"void"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "isStack"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA00C4"
				documentation 	
|Returns the Flag that indicates, whether the Operations above
|	 * work in LIFO (Stack) Fashion (true )
|	 * or	in FIFO (Queue) Fashion (false)	 
				
				result     	"boolean"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "DeQueueInt"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA00C5"
				documentation 	
|Constructor allocating the Space	 
				
				parameters 	(list Parameters
				    (object Parameter "Capacity"
					type       	"int")
				    (object Parameter "Stack"
					type       	"boolean"))
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "ensureCapacity"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA00C8"
				documentation 	
|Increases the Space for the DeQueue.
|	 * Only possible, if no wrap-around has taken place	 
				
				parameters 	(list Parameters
				    (object Parameter "N"
					type       	"int"))
				result     	"int"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "put"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA00CA"
				documentation 	
|Puts an Item into the Store	 
				
				parameters 	(list Parameters
				    (object Parameter "Item"
					type       	"int"))
				result     	"void"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "get"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA00CC"
				documentation 	
|Gets an Item from the Store	 
				
				result     	"int"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "peek"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA00CD"
				documentation 	
|Returns the next Item of the Store without removing it.	 
				
				result     	"int"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "isZero"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA00CE"
				documentation 	
|Returns true, if the Store is empty.	 
				
				result     	"boolean"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "putHead"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA00CF"
				documentation 	
|Puts an Item at the Head of the Queue, i.e. the Bottom of the Stack	 
				
				parameters 	(list Parameters
				    (object Parameter "Item"
					type       	"int"))
				result     	"void"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0))
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "IFO[]"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA00BE"
				documentation 	
|Stack (LIFO) or Queue (FIFO) for the current Operation,
|	 * since the Space is limited to the Number of Vertices.	 
				
				type       	"int"
				exportControl 	"Implementation")
			    (object ClassAttribute "SP"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA00BF"
				documentation 	
|StackPointer,  last Element (Tail) of IFO	 
				
				type       	"int"
				initv      	"- 1"
				exportControl 	"Implementation")
			    (object ClassAttribute "QP"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA00C0"
				documentation 	
|QueuePointer, first Element (Head) of IFO	 
				
				type       	"int"
				initv      	"- 1"
				exportControl 	"Implementation")
			    (object ClassAttribute "Stack"
				attributes 	(list Attribute_Set)
				quid       	"3B2371EA00C1"
				documentation 	
|Flag that determines, whether the Store Operations
|	 * work in LIFO (Stack) Fashion (true )
|	 * or	in FIFO (Queue) Fashion (false)	 
				
				type       	"boolean"
				initv      	"false"
				exportControl 	"Protected"))
			module     	"Component View::String::DeQueueInt"
			quidu      	"3B2371EA00BC"
			language   	"Java")
		    (object Class "Parser"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"Java"
				name       	"?_Touched_?"
				value      	"?_Touched_?")
			    (object Attribute
				tool       	"Java"
				name       	"GenerateFinalizer"
				value      	FALSE)
			    (object Attribute
				tool       	"Java"
				name       	"GenerateStaticInitializer"
				value      	FALSE)
			    (object Attribute
				tool       	"Java"
				name       	"GenerateInstanceInitializer"
				value      	FALSE)
			    (object Attribute
				tool       	"Java"
				name       	"GenerateDefaultConstructor"
				value      	FALSE))
			quid       	"3B2371EA00DB"
			documentation 	
|Implements a simple Parser for an LL(1) Grammar with the following Operators:
| * +,-,*,/,\,%,>,<,&,|,!,^
| * Variables have a single Character (otherwise there must be a declaration Section,
| * which feeds the Scanner)
| * and the Multiplication Sign can be skipped in favor of faster notation. 
| * The consequence is that only single Character Variables are allowed. 
| * Takes a String as Input and gets the next Character. 
| * No Backtracking necessary, because of LL(1). 
| * Top-Down Implementation. 
| * Uses the Scanner Class to read simple Objects. 	 
			
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "CHR_BRACKET_OPEN"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"?_Touched_?"
					value      	"?_Touched_?")
				    (object Attribute
					tool       	"Java"
					name       	"Final"
					value      	TRUE))
				quid       	"3B2371EA00DC"
				documentation 	
|Constant for the opening Bracket Character	 
				
				type       	"char"
				initv      	"'('"
				exportControl 	"Public"
				static     	TRUE)
			    (object ClassAttribute "CHR_BRACKET_CLOSE"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"?_Touched_?"
					value      	"?_Touched_?")
				    (object Attribute
					tool       	"Java"
					name       	"Final"
					value      	TRUE))
				quid       	"3B2371EA00DD"
				documentation 	
|Constant for the closing Bracket Character	 
				
				type       	"char"
				initv      	"')'"
				exportControl 	"Public"
				static     	TRUE)
			    (object ClassAttribute "CHR_SIGN_MINUS"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"?_Touched_?"
					value      	"?_Touched_?")
				    (object Attribute
					tool       	"Java"
					name       	"Final"
					value      	TRUE))
				quid       	"3B2371EA00DE"
				documentation 	
|Constant for the Minus Sign Character	 
				
				type       	"char"
				initv      	"'-'"
				exportControl 	"Public"
				static     	TRUE)
			    (object ClassAttribute "CHR_SIGN_PLUS"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"?_Touched_?"
					value      	"?_Touched_?")
				    (object Attribute
					tool       	"Java"
					name       	"Final"
					value      	TRUE))
				quid       	"3B2371EA00DF"
				documentation 	
|Constant for the Minus Sign Character	 
				
				type       	"char"
				initv      	"'+'"
				exportControl 	"Public"
				static     	TRUE)
			    (object ClassAttribute "CHR_MULTIPLY"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"?_Touched_?"
					value      	"?_Touched_?")
				    (object Attribute
					tool       	"Java"
					name       	"Final"
					value      	TRUE))
				quid       	"3B2371EA00E0"
				documentation 	
|Constant for the Multiplication Character	 
				
				type       	"char"
				initv      	"'*'"
				exportControl 	"Public"
				static     	TRUE)
			    (object ClassAttribute "CHR_DIVIDE"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"?_Touched_?"
					value      	"?_Touched_?")
				    (object Attribute
					tool       	"Java"
					name       	"Final"
					value      	TRUE))
				quid       	"3B2371EA00E1"
				documentation 	
|Constant for the Division Character	 
				
				type       	"char"
				initv      	"'/'"
				exportControl 	"Public"
				static     	TRUE)
			    (object ClassAttribute "CHR_MODULUS"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"?_Touched_?"
					value      	"?_Touched_?")
				    (object Attribute
					tool       	"Java"
					name       	"Final"
					value      	TRUE))
				quid       	"3B2371EA00E2"
				documentation 	
|Constant for the Division Character	 
				
				type       	"char"
				initv      	"'%'"
				exportControl 	"Public"
				static     	TRUE)
			    (object ClassAttribute "CHR_GREATER"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
					name       	"?_Touched_?"
					value      	"?_Touched_?")
				    (object Attribute
					tool       	"Java"
					name       	"Final"
					value      	TRUE))
