	(object Class "PlotODE"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BC91A902F3"
	    documentation 	
|Integrates the ODE from the given Starting Points on.
| * Works for arbitrary Dimensions.
| * Implements intDraw to be called from Rastering Routines.
| * 
| * Design Decisions: 
| * Most Variables kept in package, so they can be accessed by PlotOde2 and PlotOdeRect 
	    
	    superclasses 	(list inheritance_relationship_list
		(object Inheritance_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BC91A902FC"
		    supplier   	"Logical View::MathGraph3::absDraw"
		    quidu      	"37BC91A600D1")
		(object Inheritance_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD209F023B"
		    supplier   	"Logical View::MathGraph3::absDraw"
		    quidu      	"37BC91A600D1")
		(object Inheritance_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3883037F"
		    supplier   	"Logical View::MathGraph3::absDraw"
		    quidu      	"37BC91A600D1"))
	    operations 	(list Operations
		(object Operation "PlotODE"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD388700CB"
		    documentation 	
|Initializing Constructor, works for both 2D and 3D Vectors, 
|	 * because it uses a generic Coordinate Mapping Routine
|	 * The Rectangle can be null, it won't be checked then.	 
		    
		    parameters 	(list Parameters
			(object Parameter "g2D"
			    type       	"absGraphics2D")
			(object Parameter "CD"
			    type       	"Coordinates")
			(object Parameter "Stepper"
			    type       	"absStepper")
			(object Parameter "Rect"
			    type       	"Rectangle"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "draw"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD388700D0"
		    documentation 	
|Starts integrating the ODE from V as the Starting Point. 
|	 * S is ignored and can be null	 
		    
		    parameters 	(list Parameters
			(object Parameter "V"
			    type       	"Tensor")
			(object Parameter "S"
			    type       	"IntegrityRing"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "drawPrep"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD388700D4"
		    documentation 	
|(Re-)Sets the Coordinates	 
		    
		    parameters 	(list Parameters
			(object Parameter "StepSize"
			    type       	"IntegrityRing")
			(object Parameter "V"
			    type       	"Tensor"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "drawLoop"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD388700D7"
		    documentation 	
|Actual Loop for plotting the ODE
|	 * Separating the Loop from the draw(V,S) Routine 
|	 * saves the Step of Mapping V again 
|	 * (when starting in opposite Direction from the same Point)	 
		    
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    class_attributes 	(list class_attribute_list
		(object ClassAttribute "stop"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC91A902FD"
		    documentation 	
|External Flag to stop Integrating	 
		    
		    type       	"boolean"
		    exportControl 	"Public")
		(object ClassAttribute "bothWays"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC91A90309"
		    type       	"boolean"
		    initv      	"true"
		    exportControl 	"Public")
		(object ClassAttribute "MaxSteps"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD388602B4"
		    documentation 	
|Maximum number of Integration Steps to prevent infinite Loops 	 
		    
		    type       	"int"
		    initv      	"20"
		    exportControl 	"Public"))
	    module     	"Component View::MathGraph3::PlotODE"
	    quidu      	"37BC91A902F2"
	    language   	"Java")
