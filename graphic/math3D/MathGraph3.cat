		    attributes 	(list Attribute_Set)
		    quid       	"37BC91B203D9"
		    documentation 	
|X-Dimension along which the ODE is integrated along	 
		    
		    type       	"int"
		    exportControl 	"Public")
		(object ClassAttribute "dimY"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC91B203DB"
		    documentation 	
|Y-Dimension which the ODE is integrated in.	 
		    
		    type       	"int"
		    exportControl 	"Public"))
