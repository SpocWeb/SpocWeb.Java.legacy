		(object Operation "PlotHyperPlane"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD38800263"
		    documentation 	
|Constructor, taking a Force Field in Form of a (time dependant) ODE	 
		    
		    parameters 	(list Parameters
			(object Parameter "g2D"
			    type       	"absGraphics2D")
			(object Parameter "CD"
			    type       	"Coordinates")
			(object Parameter "Force"
			    type       	"intDGL")
			(object Parameter "Step"
			    type       	"IntegrityRing"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "PlotHyperPlane"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD38800268"
		    documentation 	
|Constructor, taking a Force Field in Form of a (time independant) Field	 
		    
