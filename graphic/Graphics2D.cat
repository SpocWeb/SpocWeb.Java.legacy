		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BC8ED60158"
	    documentation 	
|This Class defines different Pens and Brushes 
| * 
| * A Pen is used to draw a Line (no matter in which Direction)
| * A Brush is used to fill an Area (where the Vectors are aligned!).  
	    
	    operations 	(list Operations
		(object Operation "DashPenPattern"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD36800271"
		    documentation 	
|Generates a periodic Pen Pattern with Dashes of Length DashLength:
|	 * DashLength = 0	gives a fine dot Pattern, 
|	 * DashLength = 16	gives the longest possible Dash Pattern.
|	 
		    
		    parameters 	(list Parameters
			(object Parameter "DashLength"
			    type       	"int"))
		    result     	"int"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "HBrushPattern"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD3680027C"
		    documentation 	
|Generates a Brush Pattern with horizontal Lines, where the Pen has Pixels:	 
		    
		    parameters 	(list Parameters
			(object Parameter "PenPattern"
			    type       	"int"))
		    result     	"int[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "VBrushPattern"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD3680027E"
		    documentation 	
|Generates a Brush Pattern with vertical Lines, where the Pen has Pixels:	 
		    
		    parameters 	(list Parameters
			(object Parameter "PenPattern"
			    type       	"int"))
		    result     	"int[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "ShiftBrushPattern"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD36800280"
		    documentation 	
|Generates a periodic Density Pattern:
|	 * with DashLength = 0	it is a fine dot Pattern, 
|	 * with DashLength = 16 it is the longest possible Dash Pattern.
|	 
		    
		    parameters 	(list Parameters
			(object Parameter "PenPattern"
			    type       	"int")
			(object Parameter "shift"
			    type       	"int")
			(object Parameter "right"
			    type       	"boolean"))
		    result     	"int[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
