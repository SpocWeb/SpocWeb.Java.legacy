	(object Class "Polygon2D"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BC8ED5037E"
	    documentation 	
|This Class adds the Extent of a Polygon to the simmple Array of Points. 
| * 
| * TODO: implement adding more Points at Runtime.
| * 
| * Design Decisions:
| * Negative Indices in the Planes convert to 'null' in the Polygon, 
| * which again results in the Breaking of the Line.
| * In the same way you could assume Lines as always closed 
| * and mark then as open by using null as the last Point. 
| * But this is the same as assuming Polygons as open 
| * and close them by adding the same Point at the End. 
| * I think the best is to leave this open and allow for a both, 
| * programmatic and data driven Solution like done here and in Polygon2D.
| 
	    
	    operations 	(list Operations
		(object Operation "Polygon2D"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369703D2"
		    documentation 	
|Initializing Constructor, 
|	 * saves calculating the Extent, because this can be calculated 
|	 * as the Mapping of the 2D original Extent 
|	 * or the Extent of the mapped 3D Extent.
|	 * Uses the Points directly, creates no copy!	 
		    
		    parameters 	(list Parameters
			(object Parameter "Points"
			    type       	"Point2D[]")
			(object Parameter "Extent"
			    type       	"Line2D"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Polygon2D"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369703D5"
		    documentation 	
|Initializing Constructor, 
|	 * calculates the Extent 
|	 * and creates a deepCopy of the Points. 	 
		    
		    parameters 	(list Parameters
			(object Parameter "Points"
			    type       	"Point2D[]"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "draw"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369703D7"
		    documentation 	
|Draws the Polygon, either closed or open.
|	 * Needs a Graphics Context for that	 
		    
		    parameters 	(list Parameters
			(object Parameter "g"
			    type       	"absGraphics2D")
			(object Parameter "closed"
			    type       	"boolean"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "mark"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369703DA"
		    documentation 	
|Marks the Points of the Polygon with the Marker from the Marker Class.
|	 * Needs a Graphics Context for that	 
		    
		    parameters 	(list Parameters
			(object Parameter "mrk"
			    type       	"Marker")
			(object Parameter "connect"
			    type       	"boolean")
			(object Parameter "closed"
			    type       	"boolean"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "getPoints"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369703DE"
		    documentation 	
|Returns a Copy of all the Points
|	 * TODO: create the Copy.	 
		    
		    result     	"Point2D[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "getExtent"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369703DF"
		    documentation 	
|Returns the Extent of the Polygon	 
		    
		    result     	"Line2D"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    module     	"Component View::Graphics2D::Polygon2D"
	    quidu      	"37BC8ED5037D"
	    language   	"Java")
	(object Class "ColorRGB"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BC8ED60018"
	    documentation 	
|Color Model Conversion, 
| * good example for Coordinate Transformation in a 3 dimensional Space
| * between 
| * 
| * All six Dimensions have a Value Space of [0,1[, i.e. excluding 1.
| 
	    
	    operations 	(list Operations
		(object Operation "getColor"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD367D0046"
		    documentation 	
|Returns the selected Color either determined by the Palette (if it is not null)
|	 * or a new generated Color.	 
		    
		    parameters 	(list Parameters
			(object Parameter "c"
			    type       	"int"))
		    result     	"Color"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "HSB2RGB"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD367D0048"
		    documentation 	
|Converts the components of a color, as specified by the HSB 
|     * model, to an equivalent set of values for the RGB model. 
|     * <p>
|     * The integer that is returned by <code>HSBtoRGB</code> encodes the 
|     * value of a color in bits 0&endash;23 of an integer value, the same 
|     * format used by the method <code>getRGB</code>. This integer can be 
|     * supplied as an argument to the <code>Color</code> constructor that 
|     * takes a single integer argument. 
|     * @param     hue   the hue component of the color.
|     * @param     saturation   the saturation of the color.
|     * @param     brightness   the brightness of the color.
|     * @return    the RGB value of the color with the indicated hue, 
|     *                            saturation, and brightness.
|     * @see       java.awt.Color#getRGB()
|     * @see       java.awt.Color#Color(int)
|     * @since     JDK1.0
|     
		    
		    parameters 	(list Parameters
			(object Parameter "hue"
			    type       	"double")
			(object Parameter "saturation"
			    type       	"double")
			(object Parameter "brightness"
			    type       	"double"))
		    result     	"double[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "RGB2HSB"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD367D004F"
		    documentation 	
|Converts the components of a color, as specified by the RGB 
|     * model, to an equivalent set of values for hue, saturation, and 
|     * brightness, the three components of the HSB model. 
|     * <p>
|     * If the <code>hsbvals</code> argument is <code>null</code>, then a 
|     * new array is allocated to return the result. Otherwise, the method 
|     * returns the array <code>hsbvals</code>, with the values put into 
|     * that array. 
|     * @param     red   the col[0] component of the color.
|     * @param     green   the col[1] component of the color.
|     * @param     blue   the col[2] component of the color.
|     * @param     hsbvals  the array to be used to return the 
|     *                     three HSB values, or <code>null</code>.
|     * @return    an array of three elements containing the hue, saturation, 
|     *                     and brightness (in that order), of the color with 
|     *                     the indicated col[0], col[1], and col[2] components.
|     * @see       java.awt.Color#getRGB()
|     * @see       java.awt.Color#Color(int)
|     * @since     JDK1.0
|     
		    
		    parameters 	(list Parameters
			(object Parameter "red"
			    type       	"int")
			(object Parameter "green"
			    type       	"int")
			(object Parameter "blue"
			    type       	"int"))
		    result     	"double[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "DarkerBrighter"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD367D0053"
		    documentation 	
|Creates a darker and a brighter version of this color.
|     * <p>
|     * This method applies an arbitrary scale factor to each of the three RGB 
|     * components of the color to create a brighter version of the same 
|     * color. Although <code>brighter</code> and <code>darker</code> are 
|     * inverse operations, the results of a series of invocations of 
|     * these two methods may be inconsistent because of rounding errors. 
|     * @return     a new <code>Color</code> object, 
|     *                            a brighter version of this color.
|     * @see        java.awt.Color#darker
|     * @since      JDK1.0
|     
		    
		    parameters 	(list Parameters
			(object Parameter "rgb"
			    type       	"int"))
		    result     	"Point2D"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "DarkerBrighter"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD367D0055"
		    documentation 	
|Creates a darker and a brighter version of this color.
|	 * A Palette is simply an Array of Colors. . 
		    
		    parameters 	(list Parameters
			(object Parameter "c"
			    type       	"Color"))
		    result     	"Color[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Palette"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD367D0057"
		    documentation 	
|Generates a Palette of Length n rotating through all Colors 
|	 * at maximum Intensity and Contrast. 
|	 * A Palette is simply an Array of Colors. . 
		    
		    parameters 	(list Parameters
			(object Parameter "n"
			    type       	"int"))
		    result     	"Color[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "roughPalette"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD367D0059"
		    documentation 	
|Generates a Palette of Length n rotating through all Colors 
|	 * at maximum Intensity and Contrast. 
|	 * This Palette is not as brilliant as the upper one, 
|	 * because of integer Errors, but it is faster to create.
|	 * A Palette is simply an Array of Colors. . 
		    
		    parameters 	(list Parameters
			(object Parameter "n"
			    type       	"int"))
		    result     	"Color[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
