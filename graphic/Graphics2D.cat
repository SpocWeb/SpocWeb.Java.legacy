		(object Operation "ScalarRow"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C0222"
		    documentation 	
|Fills a whole horizontal Row with the interpolated Value between z0 and z1. 
|	 * The y Coordinate is given by the current Draw Coordinate 'g.P.y'.
|	 * 
|	 * Design Decisions:
|	 * Instead of setting the Color each time it changes, the Changes are accumulated, 
|	 * until the x-Coordinate changes.
|	 * Also the Changes in the x-Coordinate are collected until the Color changes.
|	 
		    
		    parameters 	(list Parameters
			(object Parameter "x0"
			    type       	"int")
			(object Parameter "x1"
			    type       	"int")
			(object Parameter "z0"
			    type       	"int")
			(object Parameter "z1"
			    type       	"int"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "ScalarSquare"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C0227"
		    documentation 	
|Fills a whole Rectangle ((x0, y0), (x1, y1))with the interpolated Values 
|	 * between z00, z01, z10 and z11, which lie (TL, TR, BL, BR). 
		    
		    parameters 	(list Parameters
			(object Parameter "x0"
			    type       	"int")
			(object Parameter "x1"
			    type       	"int")
			(object Parameter "y0"
			    type       	"int")
			(object Parameter "y1"
			    type       	"int")
			(object Parameter "z00"
			    type       	"int")
			(object Parameter "z01"
			    type       	"int")
			(object Parameter "z10"
			    type       	"int")
			(object Parameter "z11"
			    type       	"int"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "ScalarGrid"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C0230"
		    documentation 	
|Paints the Scalar Values by setting the Color directly 
|	 * from the Integer Numbers or using the Palette (if it is not null).
|	 * Values between the Points are interpolated.
|	 * 
|	 * The Picture is painted columnwise.
|	 * 
|	 * Design Decisions: 
|	 * For the Interpolation, a bilinear one is chosen, 
|	 * and implemented based on the Line Drawing Algorithm for integer Numbers.
|	 
		    
		    parameters 	(list Parameters
			(object Parameter "xP"
			    type       	"int[]")
			(object Parameter "yP"
			    type       	"int[]")
			(object Parameter "zP"
			    type       	"int[][]"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "ScalarLine"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C0234"
		    documentation 	
|Draws a Line (any angle) with the interpolated Value between both Points.
|	 * This is derived from the drawTriangle Routine from 'Graphics2D.absGraphics2D' . 
		    
		    parameters 	(list Parameters
			(object Parameter "x0"
			    type       	"int")
			(object Parameter "x1"
			    type       	"int")
			(object Parameter "y0"
			    type       	"int")
			(object Parameter "y1"
			    type       	"int")
			(object Parameter "z0"
			    type       	"int")
			(object Parameter "z1"
			    type       	"int"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "ScalarTriangle"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C023B"
		    documentation 	
|Fills a whole Triangle ((x0, y0), (x1, y1), (x2,y2))
|	 * with the interpolated Values of z0, z1 and z2.
|	 * This is also sufficient for Phong shading, where the Cosines of the Normal Vectors 
|	 * at the Corners are interpolated. 
|	 * Of course you have to break up larger Polygons into Triangles, 
|	 * which only works for convex Polygons.	
|	 * This is derived from the fillTriangle Routine from 'Graphics2D.absGraphics2D'
|	 * and considerably easier to extend to Polygon Filling. 
		    
		    parameters 	(list Parameters
			(object Parameter "x0"
			    type       	"int")
			(object Parameter "x1"
			    type       	"int")
			(object Parameter "x2"
			    type       	"int")
			(object Parameter "y0"
			    type       	"int")
			(object Parameter "y1"
			    type       	"int")
			(object Parameter "y2"
			    type       	"int")
			(object Parameter "z0"
			    type       	"int")
			(object Parameter "z1"
			    type       	"int")
			(object Parameter "z2"
			    type       	"int"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "ScalarPolygon"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C0245"
		    documentation 	
|Fills a whole Polygon (x[i], y[i]) with the interpolated Values of z[i].
|	 * This is also sufficient for Phong shading, where the Cosine of the Normal Vectors 
|	 * at the Corners are interpolated. 
|	 * Of course you have to break up larger Polygons into Triangles, 
|	 * which only works for convex Polygons
		    
		    parameters 	(list Parameters
			(object Parameter "x"
			    type       	"int[]")
			(object Parameter "y"
			    type       	"int[]")
			(object Parameter "z"
			    type       	"int[]"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "ScalarMidPolygon"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C0249"
		    documentation 	
|Fills a whole Polygon (x[i], y[i]) with the interpolated Values of z[i].
|	 * By using a calculated middle Point as a Center.
|	 * This is also sufficient for Phong shading, where the Cosine of the Normal Vectors 
|	 * at the Corners are interpolated. 
|	 * Of course you have to break up larger Polygons into Triangles, 
|	 * which only works for convex Polygons
		    
		    parameters 	(list Parameters
			(object Parameter "x"
			    type       	"int[]")
			(object Parameter "y"
			    type       	"int[]")
			(object Parameter "z"
			    type       	"int[]"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "paintPicture"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C024D"
		    documentation 	
|Paints the Scalar Values translated by Offset by setting the Color directly 
|	 * from the Integer Numbers or using the Palette (if it is not null).
|	 * 
|	 * The Picture is painted columnwise.
|	 
		    
		    parameters 	(list Parameters
			(object Parameter "Offset"
			    type       	"Point2D")
			(object Parameter "zP"
			    type       	"int[][]")
			(object Parameter "Palette"
			    type       	"Color[]")
			(object Parameter "ColorOffset"
			    type       	"int"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "refinePicture"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C0252"
		    documentation 	
|Paints the Picture in Offset by setting the Color directly from the Integer Numbers
|	 * or using the Palette (if it is not null).
|	 * 
|	 * This Picture is iteratively refined by a 2 dimensional Block Routine
|	 
		    
		    parameters 	(list Parameters
			(object Parameter "Offset"
			    type       	"Point2D")
			(object Parameter "zP"
			    type       	"int[][]")
			(object Parameter "Palette"
			    type       	"Color[]")
			(object Parameter "ColorOffset"
			    type       	"int")
			(object Parameter "blockwise"
			    type       	"boolean"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "ScalarRow"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C0258"
		    documentation 	
|Fills a whole horizontal Row with the interpolated Value 
|	 * between z0 and z1 (Color) and between u0 and u1 (any other Value). 
|	 * The y Coordinate is given by the current Draw Coordinate 'g.P.y'.
|	 * 
|	 * Design Decisions:
|	 * Instead of setting the Color each time it changes, the Changes are accumulated, 
|	 * until the x-Coordinate changes.
|	 * Also the Changes in the x-Coordinate are collected until the Color changes.
|	 
		    
		    parameters 	(list Parameters
			(object Parameter "x0"
			    type       	"int")
			(object Parameter "x1"
			    type       	"int")
			(object Parameter "z0"
			    type       	"int")
			(object Parameter "z1"
			    type       	"int")
			(object Parameter "u0"
			    type       	"int")
			(object Parameter "u1"
			    type       	"int"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "ScalarTriangle"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C025F"
		    documentation 	
|Fills a whole Triangle ((x0, y0), (x1, y1), (x2,y2))
|	 * with the interpolated Values of z0, z1 and z2.
|	 * This is also sufficient for Phong shading, where the Cosines of the Normal Vectors 
|	 * at the Corners are interpolated. 
|	 * Of course you have to break up larger Polygons into Triangles, 
|	 * which only works for convex Polygons.	
|	 * This is derived from the fillTriangle Routine from 'Graphics2D.absGraphics2D'
|	 * and considerably easier to extend to Polygon Filling. 
		    
		    parameters 	(list Parameters
			(object Parameter "x0"
			    type       	"int")
			(object Parameter "x1"
			    type       	"int")
			(object Parameter "x2"
			    type       	"int")
			(object Parameter "y0"
			    type       	"int")
			(object Parameter "y1"
			    type       	"int")
			(object Parameter "y2"
			    type       	"int")
			(object Parameter "z0"
			    type       	"int")
			(object Parameter "z1"
			    type       	"int")
			(object Parameter "z2"
			    type       	"int")
			(object Parameter "u0"
			    type       	"int")
			(object Parameter "u1"
			    type       	"int")
			(object Parameter "u2"
			    type       	"int"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    class_attributes 	(list class_attribute_list
		(object ClassAttribute "ColorOffset"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C021A"
		    documentation 	
|Offset for the Colors of this Palette. 
|	 * This Offset is being added to each Ordinate giving the Index of the Color.	 
		    
		    type       	"int"
		    exportControl 	"Public")
		(object ClassAttribute "z0Old"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C021B"
		    type       	"int"
		    initv      	"Integer.MIN_VALUE")
		(object ClassAttribute "z1Old"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369C021C"
		    type       	"int"
		    initv      	"Integer.MIN_VALUE"))
	    module     	"Component View::Graphics2D::ScalarPlot"
	    quidu      	"37BC8ED702E0"
	    language   	"Java")
	(object Class "ZBuffer"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"Final"
		    value      	TRUE))
	    quid       	"37BC8ED70308"
	    documentation 	
|Implements the Z-Buffer Algorithm. 
| * Putting a Pixel also sets an integer z Coordinate. 
| * A new Pixel at the same (x,y) Position is only set, 
| * when it's z-Value is smaller than the current one.
| * 
| * This way all Surfaces and Polygons etc. can be painted in a random Order
| * and even cut through each other.
| * 
| * This Algorithm is similar to Ray- tracing, 
| * but the 'Rays' are only traced to the first surface (so no Reflexions)
| * and the 'Rays' are not generated by the Algorithm itself.
| * 
| * Design Decisions:
| * To avoid the costly indexed Array accesses, temporary Row and Column Values are kept, 
| * which are only updated when the x or y Coordinates change.
| 
	    
	    operations 	(list Operations
		(object Operation "ZBuffer"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369D007E"
		    parameters 	(list Parameters
			(object Parameter "MaxX"
			    type       	"int")
			(object Parameter "MaxY"
			    type       	"int"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "reSet"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369D0081"
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "upDate"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369D0082"
		    documentation 	
|Update the temporary Coordinate with the accumulated temporary minimum z Value
|	 * and initialize the new temporary Coordinates x and y .	 
		    
		    parameters 	(list Parameters
			(object Parameter "x"
			    type       	"int")
			(object Parameter "y"
			    type       	"int"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "setPixel"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD369D008A"
		    documentation 	
|SetPixel Routine for the Z-Buffer Algorithm.
|	 * Conditionally sets the Pixel and updates the Buffer.	 
		    
		    parameters 	(list Parameters
			(object Parameter "P0"
			    type       	"Point2D")
			(object Parameter "z"
			    type       	"int"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    class_attributes 	(list class_attribute_list
		(object ClassAttribute "XMax"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC8ED70309"
		    type       	"int"
		    exportControl 	"Protected")
		(object ClassAttribute "YMax"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC8ED7030A"
		    type       	"int"
		    exportControl 	"Protected")
		(object ClassAttribute "MinZ[][]"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC8ED7030B"
		    type       	"int"
		    exportControl 	"Protected")
		(object ClassAttribute "X[]"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC8ED7030C"
		    type       	"int"
		    exportControl 	"Protected")
		(object ClassAttribute "TmpZ"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC8ED70312"
		    type       	"int"
		    exportControl 	"Protected")
		(object ClassAttribute "TmpX"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC8ED70313"
		    type       	"int"
		    exportControl 	"Protected")
		(object ClassAttribute "TmpY"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC8ED70314"
		    type       	"int"
		    exportControl 	"Protected")
		(object ClassAttribute "ignoreBuffer"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC8ED70315"
		    documentation 	
|Switches off updating the Buffer when setting Pixels	 
		    
		    type       	"boolean"
		    initv      	"true"
		    exportControl 	"Public"))
	    module     	"Component View::Graphics2D::ZBuffer"
	    quidu      	"37BC8ED702FE"
	    language   	"Java")
	(object Class "PatternGraphics"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BD36930368"
	    documentation 	
|Pattern Class defines a Pattern derived from an Image Object 
| * as the basis for setting Pixels, drawing Lines and filling Polygons.
| * 
| * The easies way is to map the Pattern Pixels directly to Screen Pixels. 
| * Of course this is only correct for Polygons with the same Distance. 
| * 
| * A refined proposition uses an inherent Coordinate System in the Polygon 
| * to rescale the Pattern (the Factor is the same in x and y Direction ?!)
| * 
| * Design Decisions:
| * MemoryImageSource and drawImage cannot be used, 
| * because they are fitted only to map Rectangles to Rectangles 
| * and is possible slower, because it doesn't use cached Information. 
| * Using it to draw Pixels and Lines is a waste. 
| * Using it to do parketting of Polygons is too complicated. 
| 
	    
	    superclasses 	(list inheritance_relationship_list
		(object Inheritance_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD36950162"
		    supplier   	"Logical View::Graphics2D::Graphics2D"
		    quidu      	"37BC8ED6019E"))
	    operations 	(list Operations
		(object Operation "PatternGraphics"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3695035B"
		    documentation 	
|Initializing Constructor	 
		    
		    parameters 	(list Parameters
			(object Parameter "Pattern"
			    type       	"Image")
			(object Parameter "g"
			    type       	"Graphics"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "setPixel"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3695035E"
		    documentation 	
|Sets a Pixel in the current Color at the current Position. 
|	 * Clipping is done by setClipPixel()! 	 
		    
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    class_attributes 	(list class_attribute_list
		(object ClassAttribute "Pixels[]"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD36950163"
		    documentation 	
|Memory Image	 
		    
		    type       	"int"
		    exportControl 	"Protected")
		(object ClassAttribute "Height"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD36950164"
		    documentation 	
|Height of the Memory Image	 
		    
		    type       	"int"
		    exportControl 	"Protected")
		(object ClassAttribute "Width"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD36950165"
		    documentation 	
|Width of the Memory Image	 
		    
		    type       	"int"
		    exportControl 	"Protected")
		(object ClassAttribute "Scale"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3695035A"
		    documentation 	
|Scaling Factor	 
		    
		    type       	"int"
		    initv      	"64"
		    exportControl 	"Protected"))
	    module     	"Component View::Graphics2D::PatternGraphics"
	    quidu      	"37BC8ED70145"
	    language   	"Java")
