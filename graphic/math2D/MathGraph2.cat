		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BC91A502F7"
	    documentation 	
|This Class encapsulates 2 dimensional Mapping in each Dimension separately. 
| * It has Functions to comfortly create a Raster, an Origin, draw both with Axes.  
	    
	    operations 	(list Operations
		(object Operation "Coordinates2D"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD385B001B"
		    documentation 	
|Constructor that takes the x and y Ranges	 
		    
		    parameters 	(list Parameters
			(object Parameter "xMin"
			    type       	"float")
			(object Parameter "xMax"
			    type       	"float")
			(object Parameter "yMin"
			    type       	"float")
			(object Parameter "yMax"
			    type       	"float")
			(object Parameter "Target"
			    type       	"Rectangle"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "map"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD385B0028"
		    documentation 	
|Maps the Coordinates to the Target Range	 
		    
		    parameters 	(list Parameters
			(object Parameter "x"
			    type       	"float")
			(object Parameter "y"
			    type       	"float"))
		    result     	"Point2D"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "map"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD385B002B"
		    documentation 	
|Maps the Point Coordinates to the Target Range	 
		    
		    parameters 	(list Parameters
			(object Parameter "x"
			    type       	"float[]")
			(object Parameter "y"
			    type       	"float[]"))
		    result     	"Point2D[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    module     	"Component View::MathGraph2::Coordinates2D"
	    quidu      	"37BC91A502F6"
	    language   	"Java")
	(object Class "LinCoordMap"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
