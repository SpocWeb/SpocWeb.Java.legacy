(object Class_Category "MathGraph2"
    is_unit    	TRUE
    is_loaded  	TRUE
    quid       	"37BC8ED70088"
    documentation 	
|Very independent Package for affine Coordinate Translations in 2 Dimensions. 
|It uses standard Primitive Types (float, int) to reach maximum speed and flexibility. 
|Only dependent on 
|java.awt 
|Graphics2D
    
    visible_categories 	(list visibility_relationship_list
	(object Visibility_Relationship
	    quid       	"37DB8BB7033B"
	    supplier   	"Logical View::Graphics2D"
	    quidu      	"37BC8ED5008F")
	(object Visibility_Relationship
	    quid       	"37DB8BC001FD"
	    supplier   	"Logical View::java::awt"
	    quidu      	"34B0F6CD00CE"))
    exportControl 	"Public"
    logical_models 	(list unit_reference_list
	(object Class "MathGraph2"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BC8ED7008A"
	    documentation 	
|This Class defines Routines that display the Results of numerical Calculations
| * by Graphics. It therefore needs to reference both Packages Math and Graphics2D.
| * 
| * It calculates real Vectors into Polygons or Pairs of x and y Vectors. 
| * These Vectors can then be used in the actual Display Routines, 
| * so the conversion is saved. 
| * 
| * The Mapping takes place between the Clipping Area of the Graphics2D Object 
| * and the Data Area.
| 
	    
	    operations 	(list Operations
		(object Operation "proposeRaster"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD385C00AB"
		    documentation 	
|Proposes a Raster together with the starting Point. 
|	 * Criterion is the number of Raster Items that should be around NormRasterItems 
		    
		    parameters 	(list Parameters
			(object Parameter "Min"
			    type       	"float")
			(object Parameter "Max"
			    type       	"float"))
		    result     	"float[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "proposeOrigin"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD385C00AE"
		    documentation 	
|Proposes the Position of the Origin as 0 if possible, otherwise near 0	 
		    
		    parameters 	(list Parameters
			(object Parameter "Min"
			    type       	"float")
			(object Parameter "Max"
			    type       	"float"))
		    result     	"float"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "createRaster"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD385C00B4"
		    documentation 	
|Creates the Array with the Points of the Raster by the Origin and the Width	 
		    
		    parameters 	(list Parameters
			(object Parameter "start"
			    type       	"float")
			(object Parameter "Raster"
			    type       	"float")
			(object Parameter "Num"
			    type       	"int"))
		    result     	"float[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    class_attributes 	(list class_attribute_list
		(object ClassAttribute "NormRasterItems"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD385C00A8"
		    documentation 	
|Criterion for the proposed Raster to have around 10 Items	 
		    
		    type       	"int"
		    initv      	"10"
		    exportControl 	"Public"
		    static     	TRUE)
		(object ClassAttribute "Ln10"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Final"
			    value      	TRUE))
		    quid       	"37BD385C00A9"
		    documentation 	
|Natural Logarithm of 10, useful to calculate an Integer Multiple of 10	 
		    
		    type       	"double"
		    initv      	"Math.log(10.0)"
		    exportControl 	"Public"
		    static     	TRUE)
		(object ClassAttribute "Raster[]"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Final"
			    value      	TRUE))
		    quid       	"37BD385C00AA"
		    documentation 	
|Selection of Rasters.	 
		    
		    type       	"double"
		    initv      	"{0.1,0.2,0.25,0.333333333333333,0.5}"
		    exportControl 	"Public"
		    static     	TRUE))
	    module     	"Component View::MathGraph2::MathGraph2"
	    quidu      	"37BC8ED70089"
	    language   	"Java")
