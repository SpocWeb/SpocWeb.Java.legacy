		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BC91A50300"
	    documentation 	
|This Class encapsulates Conversions between two 1D Coordinate Systems
| * (affine Mapping). This is used separately for the x and y Axis of 2D Systems.
| * Here only scalar Types are used for Performance Reasons 
| * The affine Mapping is also defined coordinate-wise in 'Vector.Line'   
	    
	    operations 	(list Operations
		(object Operation "LinCoordMap"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD385B024B"
		    documentation 	
|Constructor that takes the Original Range and the Target Range	 
		    
		    parameters 	(list Parameters
			(object Parameter "Min"
			    type       	"float")
			(object Parameter "Max"
			    type       	"float")
			(object Parameter "iMin"
			    type       	"int")
			(object Parameter "iMax"
			    type       	"int"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "map"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD385B0250"
		    documentation 	
|Calculates the Map to the Target Range	 
		    
		    parameters 	(list Parameters
			(object Parameter "x"
			    type       	"float"))
		    result     	"int"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "map"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD385B0252"
		    documentation 	
|Maps the x-Coordinates to the X Target Range	 
		    
		    parameters 	(list Parameters
			(object Parameter "x"
			    type       	"float[]"))
		    result     	"int[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "invMap"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD385B0256"
		    documentation 	
|Calculates the Map to the Original Range	 
		    
		    parameters 	(list Parameters
			(object Parameter "x"
			    type       	"float"))
		    result     	"float"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "getStep"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD385B0258"
		    documentation 	"Returns the Step Size necessary to progress one Digit.  "
		    result     	"float"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "getScale"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD385B0259"
		    documentation 	
|Returns the Scale Factor: Scale == 1/Step
|	 * Useful for relative Calculations, e.g with Vectors.  
		    
		    result     	"float"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    class_attributes 	(list class_attribute_list
		(object ClassAttribute "Scale"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC91A5031F"
		    documentation 	
|Scale Factor	 
		    
		    type       	"float")
