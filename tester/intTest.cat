	    quid       	"36BC68820335"
	    documentation 	
|Interface for an unary Test Function (without Arguments) working on arg.
| * 
| * Used e.g. in Loops through a Container
| * 
| * Design Decisions:
| * The Parameters for 'Test' are left out, to keep the Interface clean.
| * They have to be set globally with the concrete Class.
| 
	    
	    stereotype 	"Interface"
	    operations 	(list Operations
		(object Operation "Test"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD383002E0"
		    documentation 	
|This is the Test working on 'arg' defined by the implementing Class.
|	 * The Class implementing this Method is the means of exchanging this Operation.
|	 
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"boolean"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    module     	"Component View::intTest::intTester"
	    quidu      	"36BC6882032B"
	    language   	"Java")
