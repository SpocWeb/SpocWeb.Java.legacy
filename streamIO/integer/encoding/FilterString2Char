	/** Tests all Methods of this Class	 */
	public static void testIt(String[] args) throws java.io.IOException {
		System.out.println("Testing " + FilterChar2String.class.getName());
		System.out.println("Careful: DOS (OEM) Output differs significantly from Windows (ANSI = Latin-1)");
		System.out.println("á=" + 'á' + "=" + (int) 'á');
		java.io.FileOutputStream stream = new java.io.FileOutputStream("C:/test.txt");
		for(int i = XML_ARR_LATIN1_ENTITY_CHARS.length; --i >= 0;) {
			stream.write(XML_ARR_LATIN1_ENTITY_CHARS[i]);
			if (XML_ARR_LATIN1_ENTITY_CHARS[i] > 255) {
				throw new java.io.IOException("Larger than 255!"); }
			System.out.println(i + ":" + (int)XML_ARR_LATIN1_ENTITY_CHARS[i] + "='"+XML_ARR_LATIN1_ENTITY_CHARS[i]+"'"); }
		String[] inverse = Inverse(XML_ARR_LATIN1_ENTITY_CHARS, XML_ARR_LATIN1_ENTITY_STRINGS);
		stream.write(13);
		stream.write(10);
		for(int i=127; ++i < 256;) {
			stream.write((byte) i);
			if (inverse[i] == null) {
				System.out.println(i + ": has no Encoding! '" + (char) i + "'"); }
		}
		stream.close();
	}

