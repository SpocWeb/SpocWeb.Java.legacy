			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD380A02DB"
		    documentation 	
|Division: /	 
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"GroupM"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "oneAt"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD380A02EF"
		    documentation 	
|Setting to 1 in Place:	 
		    
		    result     	"GroupM"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "one"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD380A02F9"
		    documentation 	
|Setting to 1:	 
		    
		    result     	"GroupM"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "isOne"
