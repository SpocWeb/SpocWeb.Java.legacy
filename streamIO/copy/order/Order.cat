		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Interval"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD395800B5"
		    documentation 	
|Defining Constructor.	 
		    
		    parameters 	(list Parameters
			(object Parameter "left"
			    type       	"orderable")
			(object Parameter "right"
			    type       	"orderable"))
