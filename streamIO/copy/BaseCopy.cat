		    attributes 	(list Attribute_Set)
		    quid       	"37BD1BE10249"
		    supplier   	"Logical View::java::lang::Cloneable"
		    quidu      	"34B0F6CF01E5")
		(object Inheritance_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD1BE200BA"
		    supplier   	"Logical View::java::io::Serializable"
		    quidu      	"34B0F6CE0293"))
