	    quid       	"36BB89C3033A"
	    documentation 	
|This Class defines the basic Interface for a Boolean Algebra.
| * The two basic Operations AND and OR are intertwined 
| * in that both use the same inverse: NOT, 
| * but it leads only to the other operation's neutral Element,
| * instead of to this operations's neutral Element.
| * 
| * The Definition can be extended to Vectors of Boolean Elements,
| * which allows for operations on large sets of Elements,
| * in which each one acts independently (Vector, not Polynom).
| * In a binary Representation AND and OR can be defined by MUL and ADD,
| * but without Carry Bit.
| 
	    
	    stereotype 	"Interface"
	    operations 	(list Operations
		(object Operation "ANDat"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD36260299"
		    documentation 	
|Boolean AND Operation in Place: &=, &&= for single Bit	
|	 * a AND b = true <=> (a = true) AND (b = true) 	 
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "ORat"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD362602AD"
		    documentation 	
|Boolean OR Operation in Place: |=, ||= for single Bit	
|	 * a OR b = true <=> (a = true) OR (b = true) 	 
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "FalseAt"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD362602CB"
		    documentation 	
|Boolean Constant for the Representation of 'false': =0 	
|	 * Sets this Object to False, i.e. not 'true';
|	 * with Vectors it sets all Elements to their respective Value of False
		    
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "NOTat"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD362602CC"
		    documentation 	
|Boolean NOT Operation in Place: ~=, != for single Bit	
|	 * NOT a = true <=> (a = false) 
|	 * This Operation cannot be implemented by infinite Sets,
|	 * Therefore you need other means to define some Operations.	 
		    
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    module     	"Component View::Boole::intBoole"
	    quidu      	"36BB89C30330"
	    language   	"Java")
	(object Class "Boole"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"36BB89C40026"
	    documentation 	
|This Class defines the full Interface for a Boolean Algebra.
| * The two basic Operations AND and OR are intertwined 
| * in that both use the same inverse: NOT, 
| * but it leads only to the other operation's neutral Element,
| * instead of to this operations's neutral Element.
| * 
| * These Operations and their Negation cover the full Range 
| * of ALL 16 possible binary Operations,
| * except for '<=', which has no simple name 
| * and can easily be replaced by => by swapping the Arguments.
| * 
| * The Definition can be extended to Vectors of Boolean Elements,
| * which allows for operations on large sets of Elements,
| * in which each one acts independently (Vector, not Polynom).
| * 
| * This allows for a Representation of Sets, where each Boole
| * Item indicates the Existence of this Element in the Set.
| * 
| * In a binary Representation AND and OR can be defined by MUL and ADD,
| * but without Carry Bit.
| 
	    
	    stereotype 	"Interface"
	    superclasses 	(list inheritance_relationship_list
		(object Inheritance_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD362300E6"
		    supplier   	"Logical View::Boole::intBoole"
		    quidu      	"36BB89C3033A")
		(object Inheritance_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD362302DB"
		    supplier   	"Logical View::BaseCopy::copyAble"
		    quidu      	"36BB22B9021D"))
	    operations 	(list Operations
		(object Operation "AND"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD362302EF"
		    documentation 	
|Boolean AND Operation: &, && for single Bit	
|	 * For Sets: Intersection	
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "OR"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD36230317"
		    documentation 	
|Boolean OR Operation: |, || for single Bit	
|	 * For Sets: Union	
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "NOT"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD36230349"
		    documentation 	
|Boolean NOT Operation: ~, ! for single Bit	
|	 * For Sets: Returns the Complement Set	
		    
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "XOR"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD36230353"
		    documentation 	
|Boolean XOR Operation: ^		
|	 * a XOR b = true <=> (a AND ~b) OR (~a AND b)
|	 * For Sets: Gives Set of all Elements, that are either in one or the other	
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "DIFF"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD3623037B"
		    documentation 	
|Boolean DIFF Operation: -
|	 * a - b <=> (a AND NOT b) <=> NOT IMP	
|	 * For Sets:	Difference Set
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "IMP"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD362303C1"
		    documentation 	
|Boolean IMP Operation: =>
|	 * a IMP b <=> (NOT a OR b)
|	 * For Sets: Gives Set of all Elements, that exist in b when they exist in a	
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "EQV"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD36240001"
		    documentation 	
|Boolean EQV Operation: <=>
|	 * a EQV b <=> NOT(a XOR b)
|	 * For Sets: Gives Set of all Elements, that are either in both ore none	
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "True"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD36240033"
		    documentation 	
|Boolean Constant for the Representation of 'true': 1
|	 * i.e. NOT 'false'.	 
