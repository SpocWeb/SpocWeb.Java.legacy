|	 * For Sets: Returns the empty Set	
		    
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "XORat"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD3624003E"
		    documentation 	
|Boolean XOR Operation in Place: ^=	
|	 * a XOR b <=> (a AND NOT b) OR (NOT a AND b)
|	 * For Sets: Gives Set of all Elements, that are either in one or the other 	
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "DIFFat"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD3624007A"
		    documentation 	
|Boolean DIFF Operation in Place: -=
|	 * a - b <=> (a AND NOT b) <=> NOT IMP	
|	 * For Sets:	Difference Set
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "IMPat"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD362400A2"
		    documentation 	
|Boolean IMP Operation in Place: =>
|	 * a IMP b <=> (NOT a OR b)
|	 * For Sets: Gives Set of all Elements, that exist in b when they exist in a	
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
