			    value      	TRUE))
		    quid       	"37BD362400D4"
		    documentation 	
|Boolean EQV Operation in Place: <=>
|	 * a EQV b <=> NOT (a XOR b)
|	 * For Sets: Gives Set of all Elements, that are either in both ore none 	
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "TrueAt"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD362400FC"
		    documentation 	
|Boolean Constant for the Representation of 'true': 1	
|	 * For Sets: Set of all Elements (only posssible for finite Sets)	
		    
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
