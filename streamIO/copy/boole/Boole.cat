		    quid       	"37BD361E014D"
		    supplier   	"Logical View::Boole::Boole"
		    quidu      	"36BB89C40026"))
	    operations 	(list Operations
		(object Operation "absBoole"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD361E0360"
		    documentation 	
|Constructor to pass over 'this' for Delegation.	 
		    
		    parameters 	(list Parameters
			(object Parameter "self_"
			    type       	"Boole"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "XOR"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD361E03CE"
		    documentation 	
|Boolean XOR Operation: ^		
|	 * a ^ b = (a & ~b) | (~a & b)
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "DIFF"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD361F0054"
		    documentation 	
|Boolean DIFF Operation: -
|	 * a - b <=> (a AND NOT b) <=> NOT IMP	
|	 * For Sets:	Difference Set
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "IMP"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD361F00C2"
		    documentation 	
|Boolean IMP Operation: =>
|	 * a => b = ~a | (a & b) == ~a | b
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "EQV"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD361F0131"
		    documentation 	
|Boolean EQV Operation: <=>
|	 * a <=> b = ~(a ^ b) 
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Boole"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
