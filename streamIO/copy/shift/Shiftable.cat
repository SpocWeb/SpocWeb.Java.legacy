	(object Class "ReverseIterator"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"36BB85DA0132"
	    documentation 	
|Interface for an iterator through a Collection
| * 
| * Design Decisions:
| * The Iterator Object is singled out from the Container Classes,
| * because it is very probable, that you have several Iterators 
| * running over the same Object at the same time!
| * Therefore the Interface is renamed from 'iterable' to 'Iterator'.
| 
	    
	    stereotype 	"Interface"
	    superclasses 	(list inheritance_relationship_list
		(object Inheritance_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3A3D00A0"
		    supplier   	"Logical View::Shiftable::Iterator"
		    quidu      	"36BB85DA01B4"))
	    operations 	(list Operations
		(object Operation "availableBefore"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD3A3D00AA"
		    documentation 	
|Returns true, when the Object has Constituents 
|	 * that are to be reached by previousItem.
|	 * 
|	 * If you mark the End by returning 'null', 
|	 * you can never have 'null' in the Collection!
|	 * But in a linked List it is possible!
|	 * Of course there is nothing you can do with a 'null' Object, 
|	 * because any Operation raises a 'nullPointerObject' exception
|	 * and it is of Type Object and has only Identity, nothing else.
|	 * The only application is as a PlaceHolder to indicate NULL in Data.
|	 * 
|	 * Nearly equivalent is currentItem != null 
|	 * (when the Container does not contain null Entries)	 
		    
		    result     	"long"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "previousItem"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD3A3D00AB"
		    documentation 	
|Returns the previous Object: --, postDecremental.	 
		    
		    parameters 	(list Parameters
			(object Parameter "available"
			    type       	"ByRefLong"))
		    result     	"Object"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "reSet"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD3A3D00BE"
		    documentation 	
|ReSet the reverse Iterator.	 
		    
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    module     	"Component View::Shiftable::ReverseIterator"
	    quidu      	"36BB85DA0128"
	    language   	"Java")
	(object Class "Iterator"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"36BB85DA01B4"
	    documentation 	
|Interface for an iterator through a Collection
| * 
| * Design Decisions:
| * The Iterator Object is singled out from the Container Classes,
| * because it is very probable, that you have several Iterators 
| * running over the same Object at the same time!
| * Therefore the Interface is renamed from 'iterable' to 'Iterator'.
| * A Container is iterable, because it can create Iterators on itself.
| * 
| * Design Decisions:
| * The Iterator has been designed to look more like the Stream. 
| * This allows for Streams and Iterators to be treated the same. 
| * Especially the following changes have been made:
| * 'boolean hasMoreItems()' has been redefined to 'int available()'
| * 'reStart()' has been redefined to 'reset()'
| * 'close()', 'skip()', 'mark()' and 'markSupported()' are new.
| * 
| * Since some Containers can contain 'null's, 
| * the End is not marked by returning 'null', but by available() <= 0.	 
	    
	    stereotype 	"Interface"
	    operations 	(list Operations
		(object Operation "available"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD3A3B03B4"
		    documentation 	
|Returns true, when the Object has more Constituents.
|	 * If you mark the End by returning 'null', 
|	 * you can never have 'null' in the Collection!
|	 * But in a Bag it has to be possible!?!
|	 * Of course there is not much you can do with a 'null' Object, 
|	 * because any Operation raises a 'nullPointerObject' exception
|	 * and it is of Type Object and has only Identity, nothing else.
|	 * The only application is as a PlaceHolder to indicate NULL in Data.
|	 * 
|	 * Nearly equivalent is currentItem != null 
|	 * (when the Container does not contain null Entries, like e.g. HashTables)
|	 *
|	 * TODO:It would be best, if currentItem, nextItem and previousItem 
|	 * had another Boolean Parameter denoting whether there are more Items.
|	 * That would be possible, since all these Routines 
|	 * check exactly this condition. It is only hard to evaluate it, 
|	 * because it is not the Function Result.	 
		    
		    result     	"long"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "close"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD3A3B03BE"
		    documentation 	
|Closes the Iterator to prevent further reading from it
|	 * and to deallocate all ressources blocked by it (especially Files).
|	 * Trying to read from a closed Iterator results in an IOException.	 
		    
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "mark"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
