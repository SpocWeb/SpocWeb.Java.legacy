	(object Class "StepTrapez"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BC91B2001A"
	    documentation 	
|Integrates the Function f(x) using the Trapez (MidPoint) Rule.
| * Uses the same Parent as StepMP, which integrates the ODE 
| * with the full MidPoint Rule, because both work the same.
| * 
| * Step() performs a single Step with fixed width and 'numSteps' middle Points.
| * Run () performs as many Steps as necessary to reach a certain x Value.
| * The Result is always in the public (x,y) Values.	
	    
	    superclasses 	(list inheritance_relationship_list
		(object Inheritance_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BDCF4E01B6"
		    supplier   	"Logical View::Ring::absStepper"
		    quidu      	"37BC91A90310"))
	    operations 	(list Operations
		(object Operation "Init"
		    attributes 	(list Attribute_Set)
		    quid       	"37BDCF510156"
		    documentation 	
|Initializes the Stepper to new Values: 
|	 * Stepsize, Start-X, Start-Y and Function f	 
		    
		    parameters 	(list Parameters
			(object Parameter "Step"
			    type       	"IntegrityRing")
			(object Parameter "x_"
			    type       	"IntegrityRing")
			(object Parameter "y_"
			    type       	"IntegrityRing")
			(object Parameter "f"
			    type       	"intFunction"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "StepTrapez"
		    attributes 	(list Attribute_Set)
		    quid       	"37BDCF510296"
		    documentation 	
|Empty Constructor, used for testing.	 
		    
		    concurrency 	"Sequential"
		    opExportControl 	"Protected"
		    uid        	0)
		(object Operation "StepTrapez"
		    attributes 	(list Attribute_Set)
		    quid       	"37BDCF510297"
		    documentation 	
| Constructor with all necessary Parameters. 
|	 * It takes a Function instead of an ODE,   
		    
		    parameters 	(list Parameters
			(object Parameter "Step"
			    type       	"IntegrityRing")
			(object Parameter "x"
			    type       	"IntegrityRing")
			(object Parameter "y"
			    type       	"IntegrityRing")
			(object Parameter "f"
			    type       	"intFunction"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Step"
		    attributes 	(list Attribute_Set)
		    quid       	"37BDCF5103CD"
		    documentation 	
|Performs numStep Midpoint Steps with given Width h. 
|	 * The starting Point (x) is modified to the new Point. 
|	 * The good Thing about the Midpoint Rule is that all changes are simply added up, 
|	 * without using complicated correction Factors or calculating new y Start Values.
|	 * Additionally you can reuse the previous Points (x,y).	 
		    
		    parameters 	(list Parameters
			(object Parameter "h"
			    type       	"IntegrityRing"))
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "testIt"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BDCF520035"
		    documentation 	
|Method to test all Implementations in this class.	 
		    
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    class_attributes 	(list class_attribute_list
		(object ClassAttribute "numSteps"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC93CE013E"
		    documentation 	
|Number of Middle Points with one MidPoint Call	 
		    
		    type       	"int"
		    initv      	"0"
		    exportControl 	"Public"))
