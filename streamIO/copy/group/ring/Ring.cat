		    value      	FALSE))
	    quid       	"37BC91A901E4"
	    documentation 	
|Interface for a Differential Equation. 
| * Contains only the single Method to calculate the first Derivatives of y.
| * Also used to define Functions with two Arguments.
| * 
| * Design Decisions:
| * Used 'IntegrityRing' instead of 'Tensor' for y, to facilitate both 
| * scalar and Vector Differntial Equations.    
	    
	    stereotype 	"Interface"
	    operations 	(list Operations
		(object Operation "Funktion"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD39DC00A0"
		    documentation 	
|Returns the 1st Derivative in x of all Coordinates of this Function at Point y	
|	 * For Time invariant Differential Equations x could be skipped.  
		    
		    parameters 	(list Parameters
			(object Parameter "x"
			    type       	"IntegrityRing")
			(object Parameter "y"
			    type       	"IntegrityRing")
			(object Parameter "D"
			    type       	"IntegrityRing"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    module     	"Component View::Ring::intDGL"
	    quidu      	"37BC91A901DB"
	    language   	"Java")
	(object Class "absStepper"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
