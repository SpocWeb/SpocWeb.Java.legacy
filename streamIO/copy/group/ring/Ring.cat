			(object Parameter "xl"
			    type       	"IntegrityRing")
			(object Parameter "xr"
			    type       	"IntegrityRing")
			(object Parameter "f_"
			    type       	"intFunction"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "refine"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD39D90385"
