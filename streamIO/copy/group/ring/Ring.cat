	    quid       	"37BC91B10100"
	    documentation 	
|Integrates the ODE in (x,y) by using the MidPoint Rule.
| * This is exactly the Trapezoidal Rule used to integrate normal Functions. 
| * 
| * Step() performs a single Step with fixed width.
| * Run () performs as many Steps as necessary to reach a certain x Value.	
	    
	    superclasses 	(list inheritance_relationship_list
		(object Inheritance_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BDCF4500D7"
		    supplier   	"Logical View::Ring::absStepper"
		    quidu      	"37BC91A90310"))
	    operations 	(list Operations
		(object Operation "Init"
		    attributes 	(list Attribute_Set)
		    quid       	"37BDCF460291"
		    parameters 	(list Parameters
			(object Parameter "Step"
			    type       	"IntegrityRing")
			(object Parameter "x_"
			    type       	"IntegrityRing")
			(object Parameter "y_"
			    type       	"IntegrityRing")
			(object Parameter "f_"
			    type       	"intDGL"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "StepMP"
		    attributes 	(list Attribute_Set)
		    quid       	"37BDCF4603A9"
		    documentation 	" Constructor with all necessary Parameters  "
		    parameters 	(list Parameters
			(object Parameter "Step"
			    type       	"IntegrityRing")
			(object Parameter "x"
			    type       	"IntegrityRing")
			(object Parameter "y"
			    type       	"IntegrityRing")
			(object Parameter "f"
			    type       	"intDGL"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Step"
		    attributes 	(list Attribute_Set)
		    quid       	"37BDCF4700D9"
		    documentation 	
|Performs numStep Midpoint Steps with given Width h. 
|	 * The starting Point (x, y) is modified to the new Point. 
|	 * The good Thing about the Midpoint Rule is that all changes are simply added up! 
|	 * The bad thing is that, unlike with normal Integration, 
|	 * you cannot reuse the previous Points. 	 
		    
		    parameters 	(list Parameters
			(object Parameter "h"
			    type       	"IntegrityRing"))
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "testIt"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BDCF47012A"
		    documentation 	
|Method to test all Implementations in this class.	 
		    
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    class_attributes 	(list class_attribute_list
		(object ClassAttribute "numSteps"
		    attributes 	(list Attribute_Set)
		    quid       	"37BC93CE0069"
		    documentation 	
|Number of Middle Points with one MidPoint Call	 
		    
		    type       	"int"
		    initv      	"1"
		    exportControl 	"Public"))
	    module     	"Component View::Ring::StepMP"
	    quidu      	"37BC91B100FF"
	    language   	"Java")
