		    documentation 	
|Returns the conjugate Complex Number:
|	 * i.e. the imaginary Part flips it's sign.	 
		    
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Variation"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD398003BF"
		    documentation 	
|Calculates the Variation(n,k) = n!/(n-k)!
|	 * This is the number of Samples with Size k from a Set of n Elements,
|	 * with considering Sequence.	 
		    
		    parameters 	(list Parameters
			(object Parameter "k"
			    type       	"IntegrityRing"))
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "VariCombi"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD398300C1"
		    documentation 	
|Recursive Calculation of the Combination kills the Stack.
|	 * Iterative Solution, gives 0! = 0, 1! = 1 for the Faculty 
|	 * and calculates the Variation and the Faculty of k.
|	 * The Combination can be calculated by dividing the Variation 
|	 * by the Faculty of k.
|	 * With VariCombi both the Variation Var (this, k) = 
|	 * and the Combination Comb (this, k) = Var(this, k)/k!
|	 * can be calculated. 
|	 * 'this' may be real, but k has to be integer. 
|	 * Otherwise you have to use the Gamma Function with Gamma(n+1) = n!. 	 
		    
		    parameters 	(list Parameters
			(object Parameter "k"
			    type       	"IntegrityRing")
			(object Parameter "fact"
			    type       	"IntegrityRing"))
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Combination"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD398502C2"
		    documentation 	
|Calculates the Combination(n,k) = n!/(k!*(n-k)!)
|	 * This is the number of Samples with Size k from a Set of n Elements,
|	 * without considering the Sequence.
|	 * It is also used with real n on calculating the Power Series 
|	 * of 'small' Disturbances: (1+-x)^m = 1 +- mx + ... + Comb(m,k)(+-x)^k
|	 * 
|	 * This Calculation is optimized only in MetricIRing, 
|	 * because Comb(n, k) == Comb (n, n-k).
|	 * The only Problem is that for large n and k 
|	 * the Division takes place after the Calculation of Vari(n, k),
|	 * which may result in an Overflow.	 
		    
		    parameters 	(list Parameters
			(object Parameter "k"
			    type       	"IntegrityRing"))
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Fact"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3986031E"
		    documentation 	
|Calculates the Faculty of this integer number.
|	 * The Definition is recursive: 
|	 * n! = Fact(n) = n * Fact(n-1); Fact(0) = 1;
|	 * 
|	 * For real Numbers use the Gamma Function: Gamma (n+1) = n!	 
		    
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "FactAt"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD39860328"
		    documentation 	
|Calculates the Faculty of this integer number in Place.
|	 * The Definition is recursive: 
|	 * n! = Fact(n) = n * Fact(n-1); Fact(0) = 1;
|	 * 
|	 * Because the Faculty can also be defined for fractions,
|	 * this is not yet defined in IntegrityRing.
|	 * 
|	 * For real Numbers use the Gamma Function: Gamma (n+1) = n!
|	 * This Funtion cannot be calculated this way, 
|	 * so I limit the Arguments to integer Numbers.	 
		    
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "dblFact"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD39860329"
		    documentation 	
|Calculates the Double Faculty of this integer number.
|	 * The Definition is recursive: 
|	 * n!! = dblFact(n) = n * dblFact(n-2); Fact(0) = Fact(1) = 1;	 
		    
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "dblFactAt"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD39860332"
		    documentation 	
|Calculates the Double Faculty of this integer number in Place.
|	 * The Definition is recursive: 
|	 * n!! = dblFact(n) = n * dblFact(n-2); Fact(0) = Fact(1) = 1;	 
		    
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "mul2PowAt"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3986033C"
		    documentation 	
|Multiplication with an Integer Power of 2 in Place:
|	 * Here implemented as a concatenated halfing.	 
		    
		    parameters 	(list Parameters
			(object Parameter "n"
			    type       	"int"))
		    result     	"HalfGroup"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "testIt"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD3987038D"
		    documentation 	
|Method to test all Implementations in this class.	 
		    
		    result     	"void"
		    exceptions 	"java.io.IOException"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    class_attributes 	(list class_attribute_list
		(object ClassAttribute "gAdic"
		    attributes 	(list Attribute_Set)
		    quid       	"36BB41DE00A5"
		    documentation 	
|Flag to indicate g-adic Representation, instead of normal Polynom.
|	 * In this Case all Coefficients are positive and modulo g.
|	 * The Sign of the whole Number is determined by the highest Coefficient.
|	 * 
|	 * Determines, if Carry is used for Operations in g-adic Representation
|	 * to keep the Arguments in the correct Range.
|	 * Instead a negative Value of Modulus could be used as an Indicator.	 
		    
		    type       	"boolean"
		    exportControl 	"Public")
		(object ClassAttribute "Signed"
		    attributes 	(list Attribute_Set)
		    quid       	"36BB41DE00AE"
		    documentation 	
|Determines, if the Number can assume negative Values in g-adic Representation, 
|	 * or a Carry is generated. Only the highest Coefficient must be signed!	 
		    
		    type       	"boolean"
		    exportControl 	"Public")
		(object ClassAttribute "Modulus"
		    attributes 	(list Attribute_Set)
		    quid       	"36BB41DE00AF"
		    documentation 	
|The Modulus, used for Operations in g-adic Representation
|	 * to keep the Arguments in the Range {0..Modulus-1}.
|	 * If Modulus == 0, the Constants HalfNumBits are used when gAdic = true!
		    
		    type       	"long"
		    exportControl 	"Public"))
