		    parameters 	(list Parameters
			(object Parameter "xl"
			    type       	"IntegrityRing")
			(object Parameter "xr"
			    type       	"IntegrityRing")
			(object Parameter "f_"
			    type       	"intFunction"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
