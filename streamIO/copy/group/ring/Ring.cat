		    parameters 	(list Parameters
			(object Parameter "Target"
			    type       	"IntegrityRing"))
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    module     	"Component View::Ring::intStepper"
	    quidu      	"37BC93C100E0"
	    language   	"Java")
