			    type       	"IntegrityRing")
			(object Parameter "x"
			    type       	"IntegrityRing")
			(object Parameter "y"
			    type       	"IntegrityRing")
			(object Parameter "f"
			    type       	"intDGL"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Init"
		    attributes 	(list Attribute_Set)
		    quid       	"37BDCF38029B"
