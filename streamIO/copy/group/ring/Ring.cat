			(object Parameter "StepSize"
			    type       	"IntegrityRing"))
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Step"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD39EB0311"
		    documentation 	
|Performs the next Step with the current Step Size (subject to change)	 
		    
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Run"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD39EB0312"
