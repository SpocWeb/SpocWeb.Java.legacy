			    value      	TRUE))
		    quid       	"37BD394003BD"
		    documentation 	
|Returns the maximum Value for this Class.	 
		    
		    result     	"wellOrder"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
