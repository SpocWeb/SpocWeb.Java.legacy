			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD394003B4"
		    documentation 	
|Returns the minimum Value for this Class.	 
		    
		    result     	"wellOrder"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
