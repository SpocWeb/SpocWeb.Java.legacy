			    type       	"Object"))
		    result     	"MetricIRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Dist"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD38A703C7"
		    documentation 	
|Euclidean Metric
|	 * Special Case of the p-Metric for p = 2
|	 * Rotation Invariant for cartesian Systems.	 
		    
