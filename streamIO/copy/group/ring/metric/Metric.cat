(object Class_Category "Metric"
    is_unit    	TRUE
    is_loaded  	TRUE
    quid       	"36BB45940015"
    documentation 	
|Adds metric Operations to the Ring Classes. 
|Defines Metrices, Norms and a scalar Metric for 1-dim connex Spaces. 
|Also defines topological Extensions to Operations already defined in Ring to control Convergence (Equation Solving, ODEs, Integration etc.). 
    
    visible_categories 	(list visibility_relationship_list
	(object Visibility_Relationship
	    quid       	"36BB4D9C0363"
	    supplier   	"Logical View::Ring"
	    quidu      	"36BB392A02D2")
	(object Visibility_Relationship
	    quid       	"36BB44290333"
	    supplier   	"Logical View::intFunction"
	    quidu      	"36BB39470389")
	(object Visibility_Relationship
	    quid       	"37630DFA039D"
	    supplier   	"Logical View::ByRef"
	    quidu      	"36BB4AA503E4")
	(object Visibility_Relationship
	    quid       	"37BFE67E029E"
	    supplier   	"Logical View::BaseCopy"
	    quidu      	"36BB22B90122")
	(object Visibility_Relationship
	    quid       	"37BFE7BD01A2"
	    supplier   	"Logical View::Order"
	    quidu      	"36BB46B601F1"))
