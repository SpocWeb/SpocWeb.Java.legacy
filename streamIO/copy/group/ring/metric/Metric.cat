		(object Operation "SqRt"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD38C100A4"
		    documentation 	
|Returns the Square Root of this: x^.5
|	 * Iterated Taylor Development at (x=1), converges fastest for 0.5 < x <=1
|	 * does it converge for complex x??? Not necessary, because there we use only
|	 * the real impl.
|	 * Does not converge very well for 0 < x < 0.5!
|	 * (x+d)^2 = x^2 + 2xd + d^2
|	 
		    
		    result     	"MetricIRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "CbcRt"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD38C100CC"
		    documentation 	
|Returns the Cubic Root of this: x^=.333333333333333
|	 * Iterated Taylor Development at (x=1), converges fastest for 0.5 < x <=1
|	 * does it converge for complex x??? Not necessary, because there we use only
|	 * the real impl.
|	 * (x+d)^3 = x^3 + 3dx^2 + 3xd^2 + d^3
|	 * does not converge very well!
|	 
		    
		    result     	"MetricIRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
