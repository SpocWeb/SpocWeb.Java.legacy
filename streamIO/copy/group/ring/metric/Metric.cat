		    attributes 	(list Attribute_Set)
		    quid       	"37BD38F003D1"
		    documentation 	
|Initializing Constructor	 
		    
		    parameters 	(list Parameters
			(object Parameter "xl"
			    type       	"MetricIRing")
			(object Parameter "xr"
			    type       	"MetricIRing")
			(object Parameter "f"
			    type       	"intFunction"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "refine"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD38F003D5"
		    documentation 	
|Performs multiple approximating Steps.
|	 * And keeps the Zero bounded by keeping yr positive!
|	 * x stays bounded anyway, because Regula Falsi	works like that.
|	 * Rotation: (x,y)->(xr, yr)->(xl,yl) 	 
		    
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "testIt"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
