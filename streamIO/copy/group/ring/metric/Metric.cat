	(object Class "BiSectStepQ"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BC91AE0282"
	    documentation 	
|Performs a Search by Bisection. 
| * The Algorithm uses only Ring Properties to half the Interval 
| * and Metric Properties to determine the next Interval. 
| * Works only on 1-dim fully ordered Sets R->R
| * It can also be used on discrete fully ordered Sets to find an Item,
| * by using the Item(Index) Funtion on x from N (integer Numbers).
| * This is equivalent to a binary Search implemented on discrete Sets.  
	    
	    superclasses 	(list inheritance_relationship_list
		(object Inheritance_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD38EB025D"
		    supplier   	"Logical View::Metric::absRefinerQ"
		    quidu      	"37BC91AD029F"))
	    operations 	(list Operations
		(object Operation "BiSectStepQ"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD38EC0240"
		    documentation 	
|Empty Constructor. 	 
		    
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "BiSectStepQ"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD38EC0241"
		    documentation 	
|Initializing Constructor. 
|	 * The Zero of the Function f must be bracketed in the Interval x!
|	 * The Stepper should keep the Zero bracketed! 
|	 * yr is kept positive!	 
		    
		    parameters 	(list Parameters
			(object Parameter "xl_"
			    type       	"MetricIRing")
			(object Parameter "xr_"
			    type       	"MetricIRing")
			(object Parameter "f_"
			    type       	"intFunction"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Init"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD38EC024D"
		    documentation 	
|Initialization of a new Stepper Search	 
		    
		    parameters 	(list Parameters
			(object Parameter "xl_"
			    type       	"IntegrityRing")
			(object Parameter "xr_"
			    type       	"IntegrityRing")
			(object Parameter "f_"
			    type       	"intFunction"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "refine"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD38EC0251"
		    documentation 	
|Performs a single approximating Step 
|	 * until the item is bounded with sufficient Accuracy.
|	 * And keeps the Zero bounded by keeping yr positive!	
|	 * Rotation: (x,y)->(xr, yr)->(xl,yl) 	 
		    
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "testIt"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD38EC0252"
		    documentation 	
|Method to test all Implementations in this class.	 
		    
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    module     	"Component View::Metric::BiSectStepQ"
	    quidu      	"37BC91AE0281"
	    language   	"Java")
	(object Class "FalsiStepQ"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
