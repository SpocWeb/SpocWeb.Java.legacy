		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BC8ECA0039"
	    documentation 	"This Class contains some Functions that appear in Fourier Transformations: "
	    operations 	(list Operations
		(object Operation "Fresnel"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD36540169"
		    documentation 	
|The complex Fresnel Function is defined by: 	
|	 * F (x)= C (x)+i*S (x):=Int[0,x] (e^it)/SqRt(t) 
|	 *		= Int[0,x] Cos(t)/SqRt(t) + i Sin(t)/SqRt(t)	 
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"MetricBody"))
		    result     	"Complex"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "FresnelPR"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD3654016B"
		    documentation 	
|The complex Fresnel Function is calculated by a Potency Sequence.
|	 * The Argument must be positive.	 
		    
		    parameters 	(list Parameters
			(object Parameter "x"
			    type       	"MetricBody"))
		    result     	"Complex"
		    concurrency 	"Sequential"
		    opExportControl 	"Private"
		    uid        	0)
		(object Operation "FresnelKB"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD3654016D"
		    documentation 	
|The complex Fresnel Function is calculated by a continued Fraction	 
		    
		    parameters 	(list Parameters
			(object Parameter "x"
			    type       	"MetricBody"))
		    result     	"Complex"
		    concurrency 	"Sequential"
		    opExportControl 	"Private"
		    uid        	0)
