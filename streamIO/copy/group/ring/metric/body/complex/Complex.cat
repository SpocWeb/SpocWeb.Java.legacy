	(object Class "Polar"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"Final"
		    value      	TRUE))
	    quid       	"37BC8ECA0179"
	    documentation 	
|Concrete final Class to define Complex Numbers of arbitrary Types 
| * in Polar Representation.
| * Complex Numbers from a Metric Body form a non-metric algebraic complete Body.
| * 
| * Design Decisions:
| * Chose absMetricIRing instead of absMetricBody as the Constituents,
| * because all basic operations are allowed on them,
| * but they can also contain basic Integer Types, and so allow for Optimizations.
| * 
| * The Behavior of Complex Numbers can be controlled by boolean static Variables:
| * -A Complex will always be checked for zero imaginary Part after any Operation.
| 
	    
	    superclasses 	(list inheritance_relationship_list
		(object Inheritance_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD365502B5"
		    supplier   	"Logical View::Body::absMetricBody"
		    quidu      	"36BB514B03C3"))
	    operations 	(list Operations
		(object Operation "cjgAt"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD365602B6"
		    documentation 	
|Returns the conjugate Complex Number in Place:
|	 * i.e. the imaginary Part flips it's sign.	 
		    
		    result     	"IntegrityRing"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "isComplex"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD365602B7"
		    documentation 	
|Overrides the false Value from the Implementation in absComplex	 
		    
		    result     	"boolean"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "copyAtPol"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD365602B8"
		    documentation 	
|Used, because the constructor can only be called as the very first command.	 
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Polar"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Private"
		    uid        	0)
		(object Operation "copyAtCmp"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD365602BA"
		    documentation 	
|Used, because the constructor can only be called as the very first command.	 
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Complex"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Private"
		    uid        	0)
		(object Operation "copyAtReal"
