		(object Operation "sqrAt"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD365300BD"
		    documentation 	
|Square in Place: x^2 == x*=x
|	 * (a+ib)^2 == a^2 + 2i ab - b^2 == (a+b)(a-b) + 2i(ab)	 
		    
		    result     	"HalfGroupM"
		    concurrency 	"Sequential"
