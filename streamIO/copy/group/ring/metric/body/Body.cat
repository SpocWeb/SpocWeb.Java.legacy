		    quidu      	"37BC8EAE00EC")
		(object Realize_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD35FF0301"
		    supplier   	"Logical View::ByRef::intMeasurable"
		    quidu      	"36BB4E3E02BC"))
