			    (object ClassAttribute "islamYearsPerCycle"
				attributes 	(list Attribute_Set)
				quid       	"37BD20790277"
				documentation 	
|Number of years for a full Cycle of the Months across the whole year, 
|		 * since Moon Months and Sun Years are out of Synch.		 
				
				type       	"byte"
				initv      	"30"
				exportControl 	"Implementation"
				static     	TRUE)
			    (object ClassAttribute "islamLeapDays"
				attributes 	(list Attribute_Set)
				quid       	"37BD2079027C"
				documentation 	
|Number of Leap Days in a single Sun Year, 
|		 * since Moon Months and Sun Years are out of Synch.		 
				
				type       	"byte"
				initv      	"11"
				exportControl 	"Implementation"
				static     	TRUE)
			    (object ClassAttribute "islamLeapFactor"
				attributes 	(list Attribute_Set)
				quid       	"37BD2079027D"
				documentation 	
|Factor to determine the Leap Years by round (i*f) 1= int (i*f)
|		 * Small Correction because of rounding errors		 
				
				type       	"float"
				initv      	"(float ) (islamLeapDays / islamYearsPerCycle - 1e-6)"
				exportControl 	"Implementation"
				static     	TRUE)
			    (object ClassAttribute "islamFullDaysPerMonth"
				attributes 	(list Attribute_Set)
				quid       	"37BD2079027E"
				documentation 	
|29.5 Days per Month		 
				
				type       	"byte"
				initv      	"29"
				exportControl 	"Implementation"
				static     	TRUE)
			    (object ClassAttribute "islamDaysPerMonth"
				attributes 	(list Attribute_Set)
				quid       	"37BD2079027F"
				documentation 	
|29.5 Days per Month		 
				
				type       	"float"
				initv      	"islamFullDaysPerMonth + 0.5f"
				exportControl 	"Implementation"
				static     	TRUE)
			    (object ClassAttribute "islamDaysPerYear"
				attributes 	(list Attribute_Set)
				quid       	"37BD20790280"
				documentation 	
| 12 * 29.5 Days = 354 Days per Year 
|		 * = 11 too few	for a solar Year. 
|		 * This lets the islamic Year roll through every 30 years
|		 * with 11 Days off. 	 
				
				type       	"float"
				initv      	"islamDaysPerMonth * December + islamLeapDays / (float ) islamYearsPerCycle"
				exportControl 	"Implementation"
				static     	TRUE)
			    (object ClassAttribute "islamDaysPerCycle"
				attributes 	(list Attribute_Set)
				quid       	"37BD20790281"
				documentation 	
|Length of a 30 year Cycle in Days =  30 Years * 12 Months * 29.5 Days per Month + 11 Days. 
|		 * Keept to integer Calculations, that's why it's so complicated. 		 
				
				type       	"int"
				initv      	"(islamYearsPerCycle * December >> 1) * (1 + (islamFullDaysPerMonth << 1)) + islamLeapDays"
				exportControl 	"Implementation"
				static     	TRUE)
			    (object ClassAttribute "DescribeJulian"
				attributes 	(list Attribute_Set)
				quid       	"37BD207B027F"
				type       	"boolean"
				exportControl 	"Public"
				static     	TRUE))
