				opExportControl 	"Public"
				uid        	0)
			    (object Operation "PyramidVolume"
				attributes 	(list Attribute_Set)
				quid       	"37BD3859006C"
				documentation 	
|Calculates the Volume of the 'Spat' = 3* Volume (Pyramid)
|	 * with the four given Corners.
|	 
				
				parameters 	(list Parameters
				    (object Parameter "v1"
					type       	"Vector3D")
				    (object Parameter "v2"
					type       	"Vector3D")
				    (object Parameter "v3"
					type       	"Vector3D"))
				result     	"double"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "DrehMatrix"
				attributes 	(list Attribute_Set)
				quid       	"37BD38590070"
				documentation 	
|This contains the turning angles (alpha, beta, gamma)
|	 * in it's coordinates.
|	 * m1, m2, m3 form the Matrix.
|	 * Directly filling the Turning Matrix is very fast.
|	 
				
				parameters 	(list Parameters
				    (object Parameter "Turn[]"
					type       	"Vector3D"))
				result     	"void"
				concurrency 	"Sequential"
				opExportControl 	"Public"
				uid        	0)
			    (object Operation "angles"
				attributes 	(list Attribute_Set)
				quid       	"37BD38590072"
				documentation 	
|Calculates the 3 Turning Angles of the Matrix 'Turn',
|	 * which describes a turning Operation in 3 Dimensions.
|	 
				
				parameters 	(list Parameters
				    (object Parameter "Turn[]"
					type       	"Vector3D"))
				result     	"Vector3D"
