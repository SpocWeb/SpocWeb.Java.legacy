				quid       	"37BD38590065"
				documentation 	
|Direct Calculation faster than using Development
|	 * Doesn't save Operations, but 3 Calls of DET2x2	 
				
				parameters 	(list Parameters
				    (object Parameter "v2"
					type       	"Vector3D")
				    (object Parameter "v3"
					type       	"Vector3D"))
