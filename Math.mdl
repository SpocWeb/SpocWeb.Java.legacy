			quid       	"37BC91A501AD"
			documentation 	
|The 3D Vector is represented by three Coordinate Systems:
| * Rectangular:	a[0] = x, a[1] = y 
| * Cylindric:	a[0] = r, a[1] = phi
| 
			
			operations 	(list Operations
			    (object Operation "Min"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"Java"
