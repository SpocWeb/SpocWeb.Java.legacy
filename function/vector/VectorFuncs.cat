	(object Class "fChargeField"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BC942E00CA"
	    documentation 	
|This Class encapsulates the the Charge Field Function, 
| * resulting from the Poisson Equation, in arbitrary Dimensions. 
| * Because except for a constant Factor this is the Green Function 
| * for the Poisson Equastion: phi(r) = 1/r => y[i] = -y[i]/r^3
| * , it returns the Force Field Vector generated by the Point Charges.
| * 
| * The given Coordinates are examples for simple MultiPoles 
| * to generate MultiPole Moments: M(Order) =  Sum (c[m]*r[m]^Order) = M[i,j,k,...]. 
| * The linear Versions of the QuadruPole and OctoPole are simply denaturated Versions
| * of their planar counterparts. 
| * To define a Multipol of higher order you need three Dimensions. 
| * All Multipoles have their center of Charge in the Origin of the Coordinate System. 
| * The MultiPole Moments of lesser Order are Zero with these Examples, i.e.
| * MultiPoles of Order > 0 (MonoPole) are electrically neutral etc. 
| * The MultiPole Moments of higher Order are not Zero with these Examples, 
| * because the MultiPoles have an extent!	
	    
	    realized_interfaces 	(list realize_rel_list
		(object Realize_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3ACD0183"
		    supplier   	"Logical View::intFunction::intFunction"
		    quidu      	"36BB39BA00B2"))
	    operations 	(list Operations
		(object Operation "fChargeField"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3AD00200"
		    documentation 	
|Constructor that takes the Charges and it's Coordinates.
|	 * The Charges are not integrated into the Vectors as n+1 Dimension, 
|	 * because the Vectors wouldn't transform correctly anymore!	 
		    
		    parameters 	(list Parameters
			(object Parameter "Points"
			    type       	"Tensor[]")
			(object Parameter "Charges"
			    type       	"IntegrityRing[]"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Function"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3AD00203"
		    documentation 	
|This Function represents the Charge Field Function.
|	 * It returns the Force Field Vector generated by the Charges.  
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Object"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    class_attributes 	(list class_attribute_list
		(object ClassAttribute "SqRtHalf"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Final"
			    value      	TRUE))
		    quid       	"37BC942E00E8"
		    documentation 	
|Square Root of 1/2 = 0.7172..., needed for the Coordinates of the MultiPoles	 
		    
		    type       	"double"
		    initv      	"Math.sqrt(0.5)"
		    exportControl 	"Public"
		    static     	TRUE)
