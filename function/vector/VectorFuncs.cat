		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BC942F02F1"
	    documentation 	
|ODE (Differentialgleichung) for the chaotic Lorentz curve, 
| * welche die Konvektionsrollen zwischen Schichten beschreibt.
| * Eine weitere 'zeitunabhängige' Differentialgleichung. 
	    
	    realized_interfaces 	(list realize_rel_list
		(object Realize_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3AD902AD"
		    supplier   	"Logical View::Ring::intDGL"
		    quidu      	"37BC91A901E4"))
	    operations 	(list Operations
		(object Operation "OdeLorentz"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3ADB00F7"
		    documentation 	
|Empty Constructor, defaults all Parameters of the Lorentz ODE	 
		    
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "OdeLorentz"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3ADB00F8"
		    documentation 	
|Constructor, taking all Parameters of the Lorentz ODE	 
		    
		    parameters 	(list Parameters
			(object Parameter "b"
			    type       	"double")
			(object Parameter "s"
			    type       	"double")
			(object Parameter "r"
			    type       	"double"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Funktion"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD3ADB00FC"
		    parameters 	(list Parameters
			(object Parameter "t"
			    type       	"IntegrityRing")
			(object Parameter "x_"
			    type       	"IntegrityRing")
			(object Parameter "y_"
			    type       	"IntegrityRing"))
		    result     	"void"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    module     	"Component View::VectorFuncs::OdeLorentz"
	    quidu      	"37BC942F02E7"
	    language   	"Java")
