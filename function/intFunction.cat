	    quid       	"36BB39BA002F"
	    documentation 	
|This Class encapsulates the Identity Function. 
| * It always returns the Argument. 
| * It is dangerous to use it, because the Original is returned!!!
| * So you cannot do any great calculations with it.
| 
	    
	    realized_interfaces 	(list realize_rel_list
		(object Realize_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD382F009A"
		    supplier   	"Logical View::intFunction::intFunction"
		    quidu      	"36BB39BA00B2"))
	    operations 	(list Operations
		(object Operation "Function"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD382F009B"
		    documentation 	
|This Function represents the Identity Function.
|	 * It always returns the Argument.  
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Object"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    module     	"Component View::intFunction::Identity"
	    quidu      	"36BB39BA0025"
	    language   	"Java")
	(object Class "functionAble"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"36BB39BA0076"
	    documentation 	
|Example Interface for an unary Function with 'this' as the only argument.
| * This interface is not very usable, because the Operation Name 'Function'
| * carries no Semantics so it is hard to read and understand.
| * Rather use specific Operations, give them an understandable Name 
| * and define a new Interface for them, modeled after this one. 
| * 
| * Design Decisions:
| * Functions are more expensive, but also more elegant than Operations,
| * because they allow for chaning the result into the next Function, 
| * similar to Pipes and Filters, but they have to transport the Result back,
| * so they are more expensive, especially on WANs.
| 
	    
	    stereotype 	"Interface"
	    operations 	(list Operations
		(object Operation "Function"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD382E00AC"
		    documentation 	
|This is the Template for an undefined Function working on an Object.
|	 * The Object implementing this Method is the means of exchanging this Operation.
|	 
		    
		    result     	"Object"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    module     	"Component View::intFunction::functionAble"
	    quidu      	"36BB39BA0075"
	    language   	"Java")
	(object Class "intFunction"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"36BB39BA00B2"
	    documentation 	
|Interface for an unary Function (without Arguments) working on arg.
| * 
| * Design Decisions:
| * The additional Parameters for 'Funktion' are left out, to keep the Interface clean.
| * They have to be set globally with the concrete Class.
| * 
| * Since most Functions don't have a State, they also don't have local Variables 
| * and could as well be implemented using static Methods. 
| * Even those static Methods could be parameterized using static Variables, 
| * but unfortunately you cannot declare Interface Methods to be static, 
| * native, syncronized or final!
| * 
| * Functions are more expensive, but also more elegant than Operations,
| * because they allow for chaning the result into the next Function, 
| * similar to Pipes and Filters, but have to transport the Result back.
| 
	    
	    stereotype 	"Interface"
	    operations 	(list Operations
		(object Operation "Function"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Abstract"
			    value      	TRUE))
		    quid       	"37BD382F028E"
		    documentation 	
|This is the Function working on 'arg' defined by the implementing Class.
|	 * The Class implementing this Method is the means of exchanging this Operation.	 
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Object"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    module     	"Component View::intFunction::intFunction"
	    quidu      	"36BB39BA00B1"
	    language   	"Java")
	(object Class "absFunction"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateFinalizer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateStaticInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateInstanceInitializer"
		    value      	FALSE)
		(object Attribute
		    tool       	"Java"
		    name       	"GenerateDefaultConstructor"
		    value      	FALSE))
	    quid       	"37BC8EB901F7"
	    documentation 	
|Implementation of an unary Function (without Arguments) working on arg.
| * This abstract Function can be concatenated with other absFunctions 
| * by giving these in the Constructor. 
| * The Function Method recursively calls the Funktion Methods of the Parents!
| * For this to happen the super.Function has to be called each time!
| * 
| * This Class makes it very clear, how to concatenate Mappings by 
| * implementing the Mapping and singling out the specific Function,
| * for the cost of one additional Call to myFunction().
| * This corresponds to Filters and other recursively calling Objects.  
	    
	    realized_interfaces 	(list realize_rel_list
		(object Realize_Relationship
		    attributes 	(list Attribute_Set)
		    quid       	"37BD382C00D1"
		    supplier   	"Logical View::intFunction::Function"
		    quidu      	"37BC919D03E5"))
	    operations 	(list Operations
		(object Operation "absFunction"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD382C02B2"
		    documentation 	
|Constructor for a concatenated Function	 
		    
		    parameters 	(list Parameters
			(object Parameter "inner"
			    type       	"intFunction"))
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "absFunction"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD382C02B4"
		    documentation 	
|Empty Constructor	 
		    
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Function"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Final"
			    value      	TRUE))
		    quid       	"37BD382C02B5"
		    documentation 	
|This is the Function working on 'arg' defined by the implementing Class.
|	 * The Class implementing this Method is the means of exchanging this Operation.	 
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"Object"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "Function"
		    attributes 	(list Attribute_Set)
		    quid       	"37BD382C02BC"
		    documentation 	
|This applies the Function to each Item of an Array of Objects	 
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object[]"))
		    result     	"Object[]"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0))
	    module     	"Component View::intFunction::absFunction"
	    quidu      	"37BC8EB901EF"
	    language   	"Java"
	    abstract   	TRUE)
	(object Class "Function"
	    attributes 	(list Attribute_Set
