    documentation 	"Defines Interfaces and (abstract) Classes for (InvertAble) mapping Objects to Objects as well as Real Numbers to Real Numbers. "
    exportControl 	"Public"
    logical_models 	(list unit_reference_list
	(object Class "Identity"
	    attributes 	(list Attribute_Set
		(object Attribute
		    tool       	"Java"
