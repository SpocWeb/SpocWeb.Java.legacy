		    value      	TRUE))
	    quid       	"36BB4E3D030A"
	    documentation 	
|Interface for Number Classes:
| * All measurable Classes can be converted to these Float Types,
| * and also (with Rounding Errors) to the Integer Types in 'countable'.
| * 
| * The extended Type (from Delphi) is not supported. 
| * It allows saving intermediate Result with full accuracy.
| * It consists of an IEEE Number with 64 Bit (10 Byte):
| * 64 Bit Mantissa, 15 Bit Exponent, 1 Bit Sign 
	    
	    operations 	(list Operations
		(object Operation "equals"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD363A0356"
		    documentation 	"Compares this object to the specified byte Value.     "
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object")
			(object Parameter "Value"
			    type       	"double"))
		    result     	"boolean"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
		(object Operation "floatValue"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"Static"
			    value      	TRUE))
		    quid       	"37BD363A0361"
		    documentation 	
|This class does not extend Number, because not every Group maps to numeric Values.
|	 * Instead it presents the conversion Routine to convert from Number Types.	 
		    
		    parameters 	(list Parameters
			(object Parameter "arg"
			    type       	"Object"))
		    result     	"float"
		    concurrency 	"Sequential"
		    opExportControl 	"Public"
		    uid        	0)
