				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getName"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F815011E"
				    documentation 	
|
|     * Returns the name of this constructor, as a string.  This is
|     * always the same as the name of the constructor's declaring
|     * class.
|     
				    
				    result     	"String"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getModifiers"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Native"
					    value      	TRUE))
				    quid       	"34B0F815011F"
				    documentation 	
|
|     * Returns the Java language modifiers for the constructor
|     * represented by this Constructor object, as an integer. The
|     * Modifier class should be used to decode the modifiers.
|     *
|     * @see Modifier
|     
				    
				    result     	"int"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
