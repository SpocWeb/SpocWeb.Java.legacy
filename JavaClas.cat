		(object Class "TimeZone"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CE0264"
		    documentation 	
|
| * <code>TimeZone</code> represents a time zone offset, and also figures out daylight
| * savings.
| *
| * <p>
| * Typically, you get a <code>TimeZone</code> using <code>getDefault</code>
| * which creates a <code>TimeZone</code> based on the time zone where the program
| * is running. For example, for a program running in Japan, <code>getDefault</code>
| * creates a <code>TimeZone</code> object based on Japanese Standard Time.
| *
| * <p>
| * You can also get a <code>TimeZone</code> using <code>getTimeZone</code> along
| * with a time zone ID. For instance, the time zone ID for the Pacific
| * Standard Time zone is "PST". So, you can get a PST <code>TimeZone</code> object
| * with:
| * <blockquote>
| * <pre>
| * TimeZone tz = TimeZone.getTimeZone("PST");
| * </pre>
| * </blockquote>
| * You can use <code>getAvailableIDs</code> method to iterate through
| * all the supported time zone IDs. You can then choose a
| * supported ID to get a favorite <code>TimeZone</code>.
| *
| * @see          Calendar
| * @see          GregorianCalendar
| * @see          SimpleTimeZone
| * @version      1.19 07/24/97
| * @author       Mark Davis, David Goldsmith, Chen-Lieh Huang
| 
		    
		    realized_interfaces 	(list realize_rel_list
			(object Realize_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F8BB0399"
			    supplier   	"Logical View::java::io::Serializable"
			    quidu      	"34B0F6CE0293")
			(object Realize_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F8BB03A9"
			    supplier   	"Logical View::java::lang::Cloneable"
			    quidu      	"34B0F6CF01E5"))
		    operations 	(list Operations
			(object Operation "getOffset"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F8BC0022"
			    documentation 	
|
|     * Gets the time zone offset, for current date, modified in case of
|     * daylight savings. This is the offset to add *to* UTC to get local time.
|     * @param era the era of the given date.
|     * @param year the year in the given date.
|     * @param month the month in the given date.
|     * Month is 0-based. e.g., 0 for January.
|     * @param day the day-in-month of the given date.
|     * @param dayOfWeek the day-of-week of the given date.
|     * @param milliseconds the millis in day in <em>standard</em> local time.
|     * @return the offset to add *to* GMT to get local time.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "era"
				    type       	"int")
				(object Parameter "year"
				    type       	"int")
				(object Parameter "month"
				    type       	"int")
				(object Parameter "day"
				    type       	"int")
				(object Parameter "dayOfWeek"
				    type       	"int")
				(object Parameter "milliseconds"
				    type       	"int"))
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "setRawOffset"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F8BC0029"
			    documentation 	
|
|     * Sets the base time zone offset to GMT.
|     * This is the offset to add *to* UTC to get local time.
|     * @param offsetMillis the given base time zone offset to GMT.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "offsetMillis"
				    type       	"int"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getRawOffset"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F8BC002B"
			    documentation 	
|
|     * Gets unmodified offset, NOT modified in case of daylight savings.
|     * This is the offset to add *to* UTC to get local time.
|     * @return the unmodified offset to add *to* UTC to get local time.
|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getID"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F8BC002C"
			    documentation 	
|
|     * Gets the ID of this time zone.
|     * @return the ID of this time zone.
|     
			    
			    result     	"String"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "setID"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F8BC002D"
			    documentation 	
|
|     * Sets the time zone ID. This does not change any other data in
|     * the time zone object.
|     * @param ID the new time zone ID.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "ID"
				    type       	"String"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "useDaylightTime"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F8BC002F"
			    documentation 	
|
|     * Queries if this time zone uses Daylight Savings Time.
|     * @return true if this time zone uses Daylight Savings Time,
|     * false, otherwise.
|     
			    
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "inDaylightTime"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F8BC0030"
			    documentation 	
|
|     * Queries if the given date is in Daylight Savings Time in
|     * this time zone.
|     * @param date the given Date.
|     * @return true if the given date is in Daylight Savings Time,
|     * false, otherwise.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "date"
				    type       	"Date"))
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getTimeZone"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE)
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F8BC0032"
			    documentation 	
|
|     * Gets the TimeZone for the given ID.
|     * @param ID the given ID.
|     * @return a TimeZone.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "ID"
				    type       	"String"))
			    result     	"TimeZone"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getAvailableIDs"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE)
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F8BC0034"
			    documentation 	
|
|     * Gets the available IDs according to the given time zone offset.
|     * @param rawOffset the given time zone GMT offset.
|     * @return an array of IDs, where the time zone for that ID has
|     * the specified GMT offset. For example, {"Phoenix", "Denver"},
|     * since both have GMT-07:00, but differ in daylight savings behavior.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "rawOffset"
				    type       	"int"))
			    result     	"String[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getAvailableIDs"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE)
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F8BC0036"
			    documentation 	
|
|     * Gets all the available IDs supported.
|     * @return an array of IDs.
|     
			    
			    result     	"String[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getDefault"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE)
