			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CD0291"
		    documentation 	
|
| * Class to manage the dispatching of events to the lightweight
| * components contained by a native container.
| * 
| * @author Timothy Prinzing
| 
		    
		    realized_interfaces 	(list realize_rel_list
			(object Realize_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B002BF"
			    supplier   	"Logical View::java::io::Serializable"
			    quidu      	"34B0F6CE0293"))
		    exportControl 	"Implementation"
		    operations 	(list Operations
			(object Operation "LightweightDispatcher"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B0031C"
			    parameters 	(list Parameters
				(object Parameter "nativeContainer"
				    type       	"Container"))
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "enableEvents"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B0031E"
			    documentation 	
|
|     * Enables events to lightweight components.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "events"
				    type       	"long"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "setFocusRequest"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B00320"
			    documentation 	
|
|     * This is called by the hosting native container on behalf of lightweight 
|     * components that have requested focus.  The focus request is propagated 
|     * upward from the requesting lightweight component until a windowed host 
|     * is found, at which point the windowed host calls this method.  This method 
|     * returns whether or not the peer associated with the native component needs 
|     * to request focus from the native window system. 
|     *
|     * If a lightweight component already has focus the focus events are synthesized 
|     * since there will be no native events to drive the focus.  If the native host 
|     * already has focus, the focus gained is synthesized for the lightweight component 
|     * requesting focus since it will receive no native focus requests.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "c"
				    type       	"Component"))
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "dispatchEvent"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B00322"
			    documentation 	
|
|     * Dispatches an event to a lightweight sub-component if necessary, and
|     * returns whether or not the event was forwarded to a lightweight
|     * sub-component.
|     *
|     * @param e the event
|     
			    
			    parameters 	(list Parameters
				(object Parameter "e"
				    type       	"AWTEvent"))
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "processKeyEvent"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B00324"
			    parameters 	(list Parameters
				(object Parameter "e"
				    type       	"KeyEvent"))
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "processFocusEvent"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B00326"
			    parameters 	(list Parameters
				(object Parameter "e"
				    type       	"FocusEvent"))
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "processMouseEvent"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B00328"
			    documentation 	
|
|     * This method attempts to distribute a mouse event to a lightweight
|     * component.  It tries to avoid doing any unnecessary probes down
|     * into the component tree to minimize the overhead of determining
|     * where to route the event, since mouse movement events tend to
|     * come in large and frequent amounts.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "e"
				    type       	"MouseEvent"))
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "setMouseTarget"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B0032A"
			    documentation 	
|
|     * Change the current target of mouse events.  This sends 
|     * the appropriate MOUSE_EXITED and MOUSE_ENTERED events.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "target"
				    type       	"Component")
				(object Parameter "e"
				    type       	"MouseEvent"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "retargetMouseEvent"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B0032D"
			    documentation 	
|
|     * Sends a mouse event to the current mouse event recipient using
|     * the given event (sent to the windowed host) as a prototype.  If
|     * the mouse event target is still in the component tree, the 
|     * coordinates of the event are translated to those of the target.
|     * If the target has been removed, we don't bother to send the
|     * message.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "id"
				    type       	"int")
				(object Parameter "e"
				    type       	"MouseEvent"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0))
		    class_attributes 	(list class_attribute_list
			(object ClassAttribute "serialVersionUID"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F7B002C0"
			    type       	"long"
			    initv      	"5184291520170872969L"
			    static     	TRUE)
			(object ClassAttribute "dragging"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F7B00300"
			    documentation 	
|
|     * Indicates if the mouse pointer is currently being dragged...
|     * this is needed because we may receive exit events while dragging
|     * and need to keep the current mouse target in this case.
|     
			    
			    type       	"boolean")
			(object ClassAttribute "eventMask"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F7B00310"
			    documentation 	
|
|     * The event mask for contained lightweight components.  Lightweight
|     * components need a windowed container to host window-related 
|     * events.  This seperate mask indicates events that have been 
|     * requested by contained lightweight components without effecting
|     * the mask of the windowed component itself.
|     
			    
			    type       	"long")
			(object ClassAttribute "PROXY_EVENT_MASK"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F7B00311"
			    documentation 	
|
|     * The kind of events routed to lightweight components from windowed
|     * hosts.
|     
			    
			    type       	"long"
			    initv      	"AWTEvent.FOCUS_EVENT_MASK | AWTEvent.KEY_EVENT_MASK | AWTEvent.MOUSE_EVENT_MASK | AWTEvent.MOUSE_MOTION_EVENT_MASK"
			    static     	TRUE)
			(object ClassAttribute "MOUSE_MASK"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F7B00312"
			    type       	"long"
			    initv      	"AWTEvent.MOUSE_EVENT_MASK | AWTEvent.MOUSE_MOTION_EVENT_MASK"
			    static     	TRUE))
		    module     	"Component View::java::awt::Container (subprog spec)"
		    quidu      	"34B0F6CD0290"
		    language   	"Java")
		(object Class "Container"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CD0292"
		    documentation 	
|
| * A generic Abstract Window Toolkit(AWT) container object is a component 
| * that can contain other AWT components.
| * <p>
| * Components added to a container are tracked in a list.  The order
| * of the list will define the components' front-to-back stacking order 
| * within the container.  If no index is specified when adding a
| * component to a container, it will be added to the end of the list
| * (and hence to the bottom of the stacking order).
| * @version 	1.115, 08/15/97
| * @author 	Arthur van Hoff
| * @author 	Sami Shaio
| * @see       java.awt.Container#add(java.awt.Component, int)
| * @see       java.awt.Container#getComponent(int)
| * @see       java.awt.LayoutManager
| * @since     JDK1.0
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B001B5"
			    supplier   	"Logical View::java::awt::Component"
			    quidu      	"34B0F6CD0271"))
		    operations 	(list Operations
			(object Operation "Container"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B00227"
			    documentation 	
|
|     * Constructs a new Container. Containers can be extended directly, 
|     * but are lightweight in this case and must be contained by a parent
|     * somewhere higher up in the component tree that is native.
|     * (such as Frame for example).
|     
			    
			    concurrency 	"Sequential"
			    opExportControl 	"Protected"
			    uid        	0)
			(object Operation "getComponentCount"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B00228"
			    documentation 	
| 
|     * Gets the number of components in this panel.
|     * @return    the number of components in this panel.
|     * @see       java.awt.Container#getComponent
|     * @since     JDK1.1
|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "countComponents"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B00229"
			    documentation 	
| 
|     * @deprecated As of JDK version 1.1,
|     * replaced by getComponentCount().
|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getComponent"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B0022A"
			    documentation 	
| 
|     * Gets the nth component in this container.
|     * @param      n   the index of the component to get.
|     * @return     the n<sup>th</sup> component in this container.
|     * @exception  ArrayIndexOutOfBoundsException  
|     *                 if the n<sup>th</sup> value does not exist.     
|     * @since      JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "n"
				    type       	"int"))
			    result     	"Component"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getComponents"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B0022C"
			    documentation 	
|
|     * Gets all the components in this container.
|     * @return    an array of all the components in this container.     
|     * @since     JDK1.0
|     
			    
			    result     	"Component[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getInsets"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B0022D"
			    documentation 	
|
|     * Determines the insets of this container, which indicate the size 
|     * of the container's border. 
|     * <p>
|     * A <code>Frame</code> object, for example, has a top inset that 
|     * corresponds to the height of the frame's title bar. 
|     * @return    the insets of this container.
|     * @see       java.awt.Insets
|     * @see       java.awt.LayoutManager
|     * @since     JDK1.1
|     
			    
			    result     	"Insets"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "insets"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B0022E"
			    documentation 	
|
|     * @deprecated As of JDK version 1.1,
|     * replaced by <code>getInsets()</code>.
|     
			    
			    result     	"Insets"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "add"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B0022F"
			    documentation 	
| 
|     * Adds the specified component to the end of this container. 
|     * @param     comp   the component to be added.
|     * @return    the component argument.     
|     * @since     JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "comp"
				    type       	"Component"))
			    result     	"Component"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "add"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B00231"
			    documentation 	
|
|     * Adds the specified component to this container.
|     * It is strongly advised to use the 1.1 method, add(Component, Object),
|     * in place of this method.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "name"
				    type       	"String")
				(object Parameter "comp"
				    type       	"Component"))
			    result     	"Component"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "add"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B00234"
			    documentation 	
| 
|     * Adds the specified component to this container at the given 
|     * position. 
|     * @param     comp   the component to be added.
|     * @param     index    the position at which to insert the component, 
|     *                   or <code>-1</code> to insert the component at the end.
|     * @return    the component <code>comp</code>
|     * @see	  #remove
|     * @since     JDK1.0
|     
			    
