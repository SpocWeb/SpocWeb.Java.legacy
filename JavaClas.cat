				(object Parameter "bi"
				    type       	"int"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "setEndIndex"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F85F0009"
