| 
| * The <code>exec</code> methods return an 
| * instance of a subclass of <code>Process</code> that can be used to 
| * control the process and obtain information about it. 
| * <p>
| * The subprocess is not killed when there are no more references to 
| * the <code>Process</code> object, but rather the subprocess 
| * continues executing asynchronously. 
| *
| * @author  unascribed
| * @version 1.10, 01/22/97
| * @see     java.lang.Runtime#exec(java.lang.String)
| * @see     java.lang.Runtime#exec(java.lang.String, java.lang.String[])
| * @see     java.lang.Runtime#exec(java.lang.String[])
| * @see     java.lang.Runtime#exec(java.lang.String[], java.lang.String[])
| * @since   JDK1.0
| 
		    
		    operations 	(list Operations
			(object Operation "getOutputStream"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F80E00FA"
			    documentation 	
|
|     * Gets the output stream of the subprocess.
|     * This stream is usually buffered.
|     *
|     * @return  the output stream connected to the normal input of the
|     *          subprocess.
|     * @since   JDK1.0
|     
			    
			    result     	"OutputStream"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getInputStream"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F80E00FB"
			    documentation 	
| 
|     * Gets the input stream of the subprocess.
|     * This stream is usually buffered.
|     *
|     * @return  the input stream connected to the normal output of the
|     *          subprocess.
|     * @since   JDK1.0
|     
			    
			    result     	"InputStream"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getErrorStream"
