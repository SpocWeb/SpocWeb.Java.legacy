			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CD00BC"
		    documentation 	
|
| * When an applet is first created, an applet stub is attached to it 
| * using the applet's <code>setStub</code> method. This stub 
| * serves as the interface between the applet and the browser 
| * environment or applet viewer environment in which the application 
| * is running. 
| *
| * @author 	Arthur van Hoff
| * @version     1.12, 01/16/97
| * @see         java.applet.Applet#setStub(java.applet.AppletStub)
| * @since       JDK1.0
| 
		    
		    stereotype 	"Interface"
		    operations 	(list Operations
			(object Operation "isActive"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7A30119"
			    documentation 	
|
|     * Determines if the applet is active. An applet is active just 
|     * before its <code>start</code> method is called. It becomes 
|     * inactive immediately after its <code>stop</code> method is called. 
|     *
|     * @return  <code>true</code> if the applet is active;
|     *          <code>false</code> otherwise.
|     * @since   JDK1.0
|     
			    
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "getDocumentBase"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7A3011A"
			    documentation 	
|
|     * Gets the document URL.
|     *
|     * @return  the <code>URL</code> of the document containing the applet.
|     * @since   JDK1.0
|     
			    
			    result     	"URL"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "getCodeBase"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7A3011B"
			    documentation 	
|
|     * Gets the base URL.
|     *
|     * @return  the <code>URL</code> of the applet.
|     * @since   JDK1.0
|     
			    
			    result     	"URL"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "getParameter"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7A3011C"
			    documentation 	
|
|     * Returns the value of the named parameter in the HTML tag. For 
|     * example, if an applet is specified as 
|     * <ul><code>
|     *	&lt;applet code="Clock" width=50 height=50&gt;<br>
|     *  &lt;param name=Color value="blue"&gt;<br>
|     *  &lt;/applet&gt;
|     * </code></ul>
|     * <p>
|     * then a call to <code>getParameter("Color")</code> returns the 
|     * value <code>"blue"</code>. 
|     *
|     * @param   name   a parameter name.
|     * @return  the value of the named parameter.
|     * @since   JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "name"
				    type       	"String"))
			    result     	"String"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "getAppletContext"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7A3011E"
			    documentation 	
|
|     * Gets a handler to the applet's context.
|     *
|     * @return  the applet's context.
|     * @since   JDK1.0
|     
			    
			    result     	"AppletContext"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "appletResize"
