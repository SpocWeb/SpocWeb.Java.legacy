			(object Operation "getWarnings"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F83D0316"
			    documentation 	
|
|     * The first warning reported by calls on this Statement is
|     * returned.  A Statment's execute methods clear its SQLWarning
|     * chain. Subsequent Statement warnings will be chained to this
|     * SQLWarning.
|     *
|     * <p>The warning chain is automatically cleared each time
|     * a statement is (re)executed.
|     *
|     * <P><B>Note:</B> If you are processing a ResultSet then any
|     * warnings associated with ResultSet reads will be chained on the
|     * ResultSet object.
|     *
|     * @return the first SQLWarning or null 
|     * @exception SQLException if a database-access error occurs.
|     
			    
			    result     	"SQLWarning"
			    exceptions 	"SQLException"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
