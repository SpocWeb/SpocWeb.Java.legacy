				    quidu      	"34B0F6CE015A"))
			    operations 	(list Operations
				(object Operation "ZipInputStream"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF03AD"
				    documentation 	
|
|     * Creates a new ZIP input stream.
|     * @param in the actual input stream
|     
				    
				    parameters 	(list Parameters
					(object Parameter "in"
					    type       	"InputStream"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getNextEntry"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF03AF"
				    documentation 	
|
|     * Reads the next ZIP file entry and positions stream at the beginning
|     * of the entry data.
|     * @exception ZipException if a ZIP file error has occurred
|     * @exception IOException if an I/O error has occurred
|     
				    
				    result     	"ZipEntry"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "closeEntry"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF03B0"
				    documentation 	
|
|     * Closes the current ZIP entry and positions the stream for reading the
|     * next entry.
|     * @exception ZipException if a ZIP file error has occurred
|     * @exception IOException if an I/O error has occurred
|     
				    
				    result     	"void"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "read"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF03B1"
				    documentation 	
|
|     * Reads from the current ZIP entry into an array of bytes. Blocks until
|     * some input is available.
|     * @param b the buffer into which the data is read
|     * @param off the start offset of the data
|     * @param len the maximum number of bytes read
|     * @return the actual number of bytes read, or -1 if the end of the
|     *         entry is reached
|     * @exception ZipException if a ZIP file error has occurred
|     * @exception IOException if an I/O error has occurred
|     
				    
				    parameters 	(list Parameters
					(object Parameter "b"
					    type       	"byte[]")
					(object Parameter "off"
					    type       	"int")
					(object Parameter "len"
					    type       	"int"))
				    result     	"int"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "skip"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF03B5"
				    documentation 	
|
|     * Skips specified number of bytes in the current ZIP entry.
|     * @param n the number of bytes to skip
|     * @return the actual number of bytes skipped
|     * @exception ZipException if a ZIP file error has occurred
|     * @exception IOException if an I/O error has occurred
|     
				    
				    parameters 	(list Parameters
					(object Parameter "n"
					    type       	"long"))
				    result     	"long"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
