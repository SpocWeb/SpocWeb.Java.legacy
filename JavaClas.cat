				(object Operation "KeyEvent"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C700BC"
				    documentation 	
|
|     * Constructs a KeyEvent object with the specified source component,
|     * type, modifiers, and key.
|     * @param source the object where the event originated
|     * @id the event type
|     * @when the time the event occurred
|     * @modifiers the modifier keys down during event
|     * @keyCode the integer code representing the key of the event 
|     * @keyChar the Unicode character generated by this event, or NUL
|     
				    
				    parameters 	(list Parameters
					(object Parameter "source"
					    type       	"Component")
					(object Parameter "id"
					    type       	"int")
					(object Parameter "when"
					    type       	"long")
					(object Parameter "modifiers"
					    type       	"int")
					(object Parameter "keyCode"
					    type       	"int")
					(object Parameter "keyChar"
					    type       	"char"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "KeyEvent"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C700C3"
				    parameters 	(list Parameters
					(object Parameter "source"
					    type       	"Component")
					(object Parameter "id"
					    type       	"int")
					(object Parameter "when"
					    type       	"long")
					(object Parameter "modifiers"
					    type       	"int")
					(object Parameter "keyCode"
					    type       	"int"))
