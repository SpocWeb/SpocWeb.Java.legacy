		    module     	"Component View::java::text::TextBoundaryData (subprog spec)"
		    quidu      	"34B0F6D103A9"
		    language   	"Java"
		    abstract   	TRUE)
		(object Class "WordBreakTable"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"Final"
			    value      	TRUE))
		    quid       	"34B0F6D103BA"
		    documentation 	
|
| * This class implements a state transition table.
| * After each transition, using the get method, the
| * new state is returned along with information about
| * the state change (ex. was it a "marked" transition").
| * This class is internal only.
| 
		    
		    exportControl 	"Implementation"
		    operations 	(list Operations
			(object Operation "WordBreakTable"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F867036D"
			    documentation 	
|
|     * Construct a table using existing data.  See SentenceBreakBoundary and
|     * the other SimpleTextBoundary subclasses for examples.
|     * @param cols number of columns in the table
|     * @param data an encoded byte array containing state and transition data
|     
			    
			    parameters 	(list Parameters
				(object Parameter "cols"
				    type       	"int")
				(object Parameter "data[]"
				    type       	"byte"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "get"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F8670370"
			    documentation 	
|
|     * Get the resulting state moving from oldState accepting input
|     * @param oldState current state
|     * @param input input
|     * @return int resulting state and transition data
|     
			    
			    parameters 	(list Parameters
				(object Parameter "oldState"
				    type       	"int")
				(object Parameter "input"
				    type       	"int"))
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "isMarkState"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F8670373"
			    documentation 	
|
|     * Checks to see if the transition into the specified state was "marked"
|     * @param state the state as returned by get, initialState, or endState
|     * @return true if transition into state was marked.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "state"
				    type       	"int"))
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "isEndState"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F8670375"
			    documentation 	
|
|     * Check is a state is the end state
|     * @param state the state to check
|     * @return true if state is an end state
|     
			    
			    parameters 	(list Parameters
				(object Parameter "state"
				    type       	"int"))
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "initialState"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F8670377"
			    documentation 	
|
|     * Get the start state
|     * @return the initial state
|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
		    class_attributes 	(list class_attribute_list
			(object ClassAttribute "MARK_MASK"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F867035B"
			    type       	"byte"
			    initv      	"(byte ) 0x80"
			    exportControl 	"Implementation"
			    static     	TRUE)
			(object ClassAttribute "INDEX_MASK"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
