			    quid       	"34B0F6CE0179"
			    documentation 	
|
| * This class can be used to read the contents of a ZIP file. It uses
| * RandomAccessFile for quick access to ZIP file entries, and supports
| * both compressed and uncompressed entries.
|
| * @version	1.18, 01/24/97
| * @author	David Connelly
| 
			    
			    realized_interfaces 	(list realize_rel_list
				(object Realize_Relationship
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF0196"
				    supplier   	"Logical View::java::util::zip::ZipConstants"
				    quidu      	"34B0F6CE015A"))
			    operations 	(list Operations
				(object Operation "ZipFile"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF01DD"
				    documentation 	
|
|     * Opens a ZIP file for reading given the specified file name.
|     * @param name the name of the zip file
|     * @exception ZipException if a ZIP format error has occurred
|     * @exception IOException if an I/O error has occurred
|     
				    
				    parameters 	(list Parameters
					(object Parameter "name"
					    type       	"String"))
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "ZipFile"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF01E5"
				    documentation 	
|
|     * Opens a ZIP file for reading given the specified File object.
|     * @param file the ZIP file to be opened for reading
|     * @exception ZipException if a ZIP error has occurred
|     * @exception IOException if an I/O error has occurred
|     
				    
				    parameters 	(list Parameters
					(object Parameter "file"
					    type       	"File"))
				    exceptions 	"ZipException,IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getEntry"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF01E7"
				    documentation 	
|
|     * Returns the ZIP file entry for the given path name. Returns null if
|     * there is no entry corresponding to the given name.
|     * @param name the name of the entry
|     * @return the ZIP file entry
|     
				    
				    parameters 	(list Parameters
					(object Parameter "name"
					    type       	"String"))
				    result     	"ZipEntry"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getInputStream"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF01E9"
				    documentation 	
|
|     * Returns an input stream for reading the contents of the specified
|     * ZIP file entry.
|     * @param ze the zip file entry
|     * @exception ZipException if a ZIP format error has occurred
|     * @exception IOException if an I/O error has occurred
|     
				    
				    parameters 	(list Parameters
					(object Parameter "ze"
					    type       	"ZipEntry"))
				    result     	"InputStream"
