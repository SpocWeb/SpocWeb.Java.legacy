			    module     	"Component View::java::util::zip::ZipConstants (subprog spec)"
			    quidu      	"34B0F6CE0159"
			    language   	"Java")
			(object Class "ZipEntry"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateFinalizer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateStaticInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateInstanceInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateDefaultConstructor"
				    value      	FALSE))
			    quid       	"34B0F6CE0168"
			    documentation 	
|
| * This class is used to represent a ZIP file entry.
| *
| * @version	1.18, 01/24/97
| * @author	David Connelly
| 
			    
			    realized_interfaces 	(list realize_rel_list
				(object Realize_Relationship
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE0399"
				    supplier   	"Logical View::java::util::zip::ZipConstants"
				    quidu      	"34B0F6CE015A"))
			    operations 	(list Operations
				(object Operation "ZipEntry"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE03DE"
				    documentation 	
|
|     * Creates a new ZIP file entry with the specified name.
|     * @param name the entry name
|     * @exception NullPointerException if the entry name is null
|     * @exception IllegalArgumentException if the entry name is longer than
|     *		  0xFFFF bytes
|     
				    
				    parameters 	(list Parameters
					(object Parameter "name"
					    type       	"String"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "ZipEntry"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE03E0"
				    concurrency 	"Sequential"
				    opExportControl 	"Implementation"
				    uid        	0)
				(object Operation "getName"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE03E1"
				    documentation 	
|
|     * Returns the name of the entry.
|     
				    
				    result     	"String"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setTime"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE03E2"
				    documentation 	
|
|     * Sets the modification time of the entry.
|     * @param time the entry modification time in number of milliseconds
|     *		   since the epoch
|     
				    
				    parameters 	(list Parameters
					(object Parameter "time"
					    type       	"long"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getTime"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE03E4"
				    documentation 	
|
|     * Returns the modification time of the entry, or -1 if not specified.
|     
				    
				    result     	"long"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setSize"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF0000"
				    documentation 	
|
|     * Sets the uncompressed size of the entry data.
|     * @param size the uncompressed size in bytes
|     * @exception IllegalArgumentException if the specified size is less
|     *		  than 0 or greater than 0xFFFFFFFF bytes
|     
				    
				    parameters 	(list Parameters
					(object Parameter "size"
					    type       	"long"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getSize"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF0002"
				    documentation 	
|
|     * Returns the uncompressed size of the entry data, or -1 if not known.
|     
				    
				    result     	"long"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setCrc"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF0003"
				    documentation 	
|
|     * Sets the CRC-32 checksum of the uncompressed entry data.
|     * @param crc the CRC-32 value
|     * @exception IllegalArgumentException if the specified CRC-32 value is
|     *		  less than 0 or greater than 0xFFFFFFFF
|     
				    
				    parameters 	(list Parameters
					(object Parameter "crc"
					    type       	"long"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getCrc"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BF0005"
				    documentation 	
|
|     * Returns the CRC-32 checksum of the uncompressed entry data, or -1 if
|     * not known.
|     
				    
				    result     	"long"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
