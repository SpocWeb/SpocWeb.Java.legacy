|     * @exception CloneNotSupportedException if clone failed due to
|     * a RemoteException.
|     * @return the new remote object
|     
				    
				    result     	"Object"
				    exceptions 	"CloneNotSupportedException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
