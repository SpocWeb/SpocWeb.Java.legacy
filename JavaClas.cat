		(object Class "ServerSocket"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CE004E"
		    documentation 	
|
| * This class implements server sockets. A server socket waits for 
| * requests to come in over the network. It performs some operation 
| * based on that request, and then possibly returns a result to the requester.
| * <p>
| * The actual work of the server socket is performed by an instance 
| * of the <code>SocketImpl</code> class. An application can 
| * change the socket factory that creates the socket 
| * implementation to configure itself to create sockets 
| * appropriate to the local firewall. 
| *
| * @author  unascribed
| * @version 1.27, 02/10/97
| * @see     java.net.SocketImpl
| * @see     java.net.ServerSocket#setSocketFactory(java.net.SocketImplFactory)
| * @since   JDK1.0
| 
		    
		    operations 	(list Operations
			(object Operation "ServerSocket"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81B0020"
			    documentation 	
|
|     * Creates an unconnected server socket. Note: this method
|     * should not be public.
|     * @exception IOException IO error when opening the socket.
|     
			    
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "ServerSocket"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81B0021"
			    documentation 	
|
|     * Creates a server socket on a specified port. A port of 
|     * <code>0</code> creates a socket on any free port. 
|     * <p>
|     * The maximum queue length for incoming connection indications (a 
|     * request to connect) is set to <code>50</code>. If a connection 
|     * indication arrives when the queue is full, the connection is refused.
|     * <p>
|     * If the application has specified a server socket factory, that 
|     * factory's <code>createSocketImpl</code> method is called to create 
|     * the actual socket implementation. Otherwise a "plain" socket is created.
|     *
|     * @param      port  the port number, or <code>0</code> to use any
|     *                   free port.
|     * @exception  IOException  if an I/O error occurs when opening the socket.
|     * @see        java.net.SocketImpl
|     * @see        java.net.SocketImplFactory#createSocketImpl()
|     * @see        java.net.ServerSocket#setSocketFactory(java.net.SocketImplFactory)
|     * @since      JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "port"
				    type       	"int"))
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "ServerSocket"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81B0023"
			    documentation 	
|
|     * Creates a server socket and binds it to the specified local port 
|     * number. A port number of <code>0</code> creates a socket on any 
|     * free port. 
|     * <p>
|     * The maximum queue length for incoming connection indications (a 
|     * request to connect) is set to the <code>count</code> parameter. If 
|     * a connection indication arrives when the queue is full, the 
|     * connection is refused. 
|     * <p>
|     * If the application has specified a server socket factory, that 
|     * factory's <code>createSocketImpl</code> method is called to create 
|     * the actual socket implementation. Otherwise a "plain" socket is created.
|     *
|     * @param      port     the specified port, or <code>0</code> to use
|     *                      any free port.
|     * @param      backlog  the maximum length of the queue.
|     * @exception  IOException  if an I/O error occurs when opening the socket.
|     * @see        java.net.SocketImpl
|     * @see        java.net.SocketImplFactory#createSocketImpl()
|     * @see        java.net.ServerSocket#setSocketFactory(java.net.SocketImplFactory)
|     * @since      JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "port"
				    type       	"int")
				(object Parameter "backlog"
				    type       	"int"))
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "ServerSocket"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81B0026"
			    documentation 	
| 
|     * Create a server with the specified port, listen backlog, and 
|     * local IP address to bind to.  The <i>bindAddr</i> argument
|     * can be used on a multi-homed host for a ServerSocket that
|     * will only accept connect requests to one of its addresses.
|     * If <i>bindAddr</i> is null, it will default accepting
|     * connections on any/all local addresses.
|     * The port must be between 0 and 65535, inclusive.
|     * <P>
|     * @param port the local TCP port
|     * @param backlog the listen backlog
|     * @param bindAddr the local InetAddress the server will bind to
|     * @see SocketConstants
|     * @see SocketOption
|     * @see SocketImpl
|     * @see   JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "port"
				    type       	"int")
				(object Parameter "backlog"
				    type       	"int")
				(object Parameter "bindAddr"
				    type       	"InetAddress"))
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getInetAddress"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81B002A"
			    documentation 	
|
|     * Returns the local address of this server socket.
|     *
|     * @return  the address to which this socket is connected,
|     *          or <code>null</code> if the socket is not yet connected.
|     * @since   JDK1.0
|     
			    
			    result     	"InetAddress"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getLocalPort"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81B002B"
			    documentation 	
|
|     * Returns the port on which this socket is listening.
|     *
|     * @return  the port number to which this socket is listening.
|     * @since   JDK1.0
|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "accept"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81B002C"
			    documentation 	
|
|     * Listens for a connection to be made to this socket and accepts 
|     * it. The method blocks until a connection is made. 
|     *
|     * @exception  IOException  if an I/O error occurs when waiting for a
|     *               connection.
|     * @since      JDK1.0
|     
			    
			    result     	"Socket"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "implAccept"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE))
			    quid       	"34B0F81B002D"
			    documentation 	
|
|     * Subclasses of ServerSocket use this method to override accept()
|     * to return their own subclass of socket.  So a FooServerSocket
|     * will typically hand this method an <i>empty</i> FooSocket().  On
|     * return from implAccept the FooSocket will be connected to a client.
|     *
|     * @since   JDk1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "s"
				    type       	"Socket"))
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Protected"
			    uid        	0)
			(object Operation "close"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81B002F"
			    documentation 	
|
|     * Closes this socket. 
|     *
|     * @exception  IOException  if an I/O error occurs when closing the socket.
|     * @since      JDK1.0
|     
			    
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "setSoTimeout"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F81B0030"
			    documentation 	
| Enable/disable SO_TIMEOUT with the specified timeout, in
|     *  milliseconds.  With this option set to a non-zero timeout,
|     *  a call to accept() for this ServerSocket
|     *  will block for only this amount of time.  If the timeout expires,
|     *  a <B>java.io.InterruptedIOException</B> is raised, though the
|     *  ServerSocket is still valid.  The option <B>must</B> be enabled
|     *  prior to entering the blocking operation to have effect.  The 
|     *  timeout must be > 0.
|     *  A timeout of zero is interpreted as an infinite timeout.  
|     *
|     * @since   JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "timeout"
				    type       	"int"))
			    result     	"void"
			    exceptions 	"SocketException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getSoTimeout"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F81B0032"
			    documentation 	
| Retrive setting for SO_TIMEOUT.  0 returns implies that the
|     *  option is disabled (i.e., timeout of infinity).
|     *
|     * @since   JDK1.1
|     
			    
			    result     	"int"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "toString"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81B0033"
			    documentation 	
|
|     * Returns the implementation address and implementation port of 
|     * this socket as a <code>String</code>.
|     *
|     * @return  a string representation of this socket.
|     * @since   JDK1.0
|     
			    
			    result     	"String"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "setSocketFactory"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE)
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F81B0034"
			    documentation 	
|
|     * Sets the server socket implementation factory for the 
|     * application. The factory can be specified only once. 
|     * <p>
|     * When an application creates a new server socket, the socket 
|     * implementation factory's <code>createSocketImpl</code> method is 
|     * called to create the actual socket implementation. 
|     *
|     * @param      fac   the desired factory.
|     * @exception  IOException  if an I/O error occurs when setting the
|     *               socket factory.
|     * @exception  SocketException  if the factory has already been defined.
|     * @see        java.net.SocketImplFactory#createSocketImpl()
|     * @since      JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "fac"
				    type       	"SocketImplFactory"))
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
		    module     	"Component View::java::net::ServerSocket (subprog spec)"
		    quidu      	"34B0F6CE0042"
		    language   	"Java")
		(object Class "SocketImplFactory"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CE0050"
		    documentation 	
|
| * This interface defines a factory for socket implementations. It 
| * is used by the classes <code>Socket</code> and 
| * <code>ServerSocket</code> to create actual socket 
| * implementations. 
| *
| * @author  Arthur van Hoff
| * @version 1.8, 01/25/97
| * @see     java.net.Socket
| * @see     java.net.ServerSocket
| * @since   JDK1.0
| 
		    
		    stereotype 	"Interface"
		    operations 	(list Operations
			(object Operation "createSocketImpl"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F81B02AF"
			    documentation 	
|
|     * Creates a new <code>SocketImpl</code> instance.
|     *
|     * @return  a new instance of <code>SocketImpl</code>.
|     * @see     java.io.SocketImpl
|     * @since   JDK1.0
|     
			    
			    result     	"SocketImpl"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0))
		    module     	"Component View::java::net::SocketImplFactory (subprog spec)"
		    quidu      	"34B0F6CE004F"
		    language   	"Java")
		(object Class "Socket"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CE0052"
		    documentation 	
|
| * This class implements client sockets (also called just 
| * "sockets"). A socket is an endpoint for communication 
| * between two machines. 
| * <p>
| * The actual work of the socket is performed by an instance of the 
| * <code>SocketImpl</code> class. An application, by changing 
| * the socket factory that creates the socket implementation, 
| * can configure itself to create sockets appropriate to the local 
| * firewall. 
| *
| * @author  unascribed
| * @version 1.29, 02/10/97
| * @see     java.net.Socket#setSocketImplFactory(java.net.SocketImplFactory)
| * @see     java.net.SocketImpl
| * @since   JDK1.0
| 
		    
		    operations 	(list Operations
			(object Operation "Socket"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81B010C"
			    documentation 	
|
|     * Creates an unconnected socket, with the
|     * system-default type of SocketImpl.
|     *
|     * @since   JDK1.1
|     
			    
			    concurrency 	"Sequential"
			    opExportControl 	"Protected"
			    uid        	0)
			(object Operation "Socket"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81B010D"
			    documentation 	
|
|     * Creates an unconnected Socket with a user-specified
|     * SocketImpl.
|     * <P>
|     * The <i>impl</i> parameter is an instance of a <B>SocketImpl</B> 
|     * the subclass wishes to use on the Socket. 
|     *
|     * @since   JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "impl"
				    type       	"SocketImpl"))
			    exceptions 	"SocketException"
			    concurrency 	"Sequential"
			    opExportControl 	"Protected"
			    uid        	0)
			(object Operation "Socket"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81B010F"
			    documentation 	
| 
|     * Creates a stream socket and connects it to the specified port 
|     * number on the named host. 
|     * <p>
|     * If the application has specified a server socket factory, that 
|     * factory's <code>createSocketImpl</code> method is called to create 
|     * the actual socket implementation. Otherwise a "plain" socket is created.
|     *
|     * @param      host   the host name.
|     * @param      port   the port number.
|     * @exception  IOException  if an I/O error occurs when creating the socket.
|     * @see        java.net.Socket#setSocketImplFactory(java.net.SocketImplFactory)
|     * @see        java.net.SocketImpl
|     * @see        java.net.SocketImplFactory#createSocketImpl()
|     * @since      JDK1.0
|     
			    
			    parameters 	(list Parameters
