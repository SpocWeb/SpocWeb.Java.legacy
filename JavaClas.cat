			    quid       	"34B0F7BB0253"
			    documentation 	
|
|     * Creates the menu bar's peer.  The peer allows us to change the 
|     * appearance of the menu bar without changing any of the menu bar's 
|     * functionality.
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
