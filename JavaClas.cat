				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7B6026B"
			    documentation 	
|
|     * Gets this graphics context's current color.
|     * @return    this graphics context's current color.
|     * @see       java.awt.Color
|     * @see       java.awt.Graphics#setColor
|     * @since     JDK1.0
|     
			    
			    result     	"Color"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
