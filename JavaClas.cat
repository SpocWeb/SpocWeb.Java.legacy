			(object ClassAttribute "ROUND_UP"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8160242"
			    documentation 	
|
|     * Always increment the digit prior to a non-zero discarded fraction.
|     * Note that this rounding mode never decreases the magnitude.
|     * (Rounds away from zero.)
|     
			    
			    type       	"int"
			    initv      	"0"
			    exportControl 	"Public"
			    static     	TRUE)
			(object ClassAttribute "ROUND_DOWN"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8160243"
			    documentation 	
|
|     * Never increment the digit prior to a discarded fraction (i.e.,
|     * truncate).  Note that this rounding mode never increases the magnitude.
|     * (Rounds towards zero.)
|     
			    
			    type       	"int"
			    initv      	"1"
			    exportControl 	"Public"
			    static     	TRUE)
			(object ClassAttribute "ROUND_CEILING"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8160244"
			    documentation 	
|
|     * If the BigDecimal is positive, behave as for ROUND_UP; if negative,
|     * behave as for ROUND_DOWN.  Note that this rounding mode never decreases
|     * the value.  (Rounds towards positive infinity.)
|     
			    
			    type       	"int"
			    initv      	"2"
			    exportControl 	"Public"
			    static     	TRUE)
			(object ClassAttribute "ROUND_FLOOR"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8160245"
			    documentation 	
|
|     * If the BigDecimal is positive, behave as for ROUND_DOWN; if negative
|     * behave as for ROUND_UP.  Note that this rounding mode never increases
|     * the value.  (Rounds towards negative infinity.)
|     
			    
			    type       	"int"
			    initv      	"3"
			    exportControl 	"Public"
			    static     	TRUE)
			(object ClassAttribute "ROUND_HALF_UP"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8160246"
			    documentation 	
|
|     * Behave as for ROUND_UP if the discarded fraction is >= .5; otherwise,
|     * behave as for ROUND_DOWN.  (Rounds towards "nearest neighbor" unless
|     * both neighbors are equidistant, in which case rounds up.)
|     
			    
			    type       	"int"
			    initv      	"4"
			    exportControl 	"Public"
			    static     	TRUE)
			(object ClassAttribute "ROUND_HALF_DOWN"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8160247"
			    documentation 	
|
|     * Behave as for ROUND_UP if the discarded fraction is > .5; otherwise,
|     * behave as for ROUND_DOWN.   (Rounds towards "nearest neighbor" unless
|     * both neighbors are equidistant, in which case rounds down.)
|     
			    
			    type       	"int"
			    initv      	"5"
			    exportControl 	"Public"
			    static     	TRUE)
			(object ClassAttribute "ROUND_HALF_EVEN"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8160248"
			    documentation 	
|
|     * Behave as for ROUND_HALF_UP if the digit to the left of the discarded
|     * fraction is odd; behave as for ROUND_HALF_DOWN if it's even.  (Rounds
|     * towards the "nearest neighbor" unless both neighbors are equidistant,
|     * in which case, rounds towards the even neighbor.)
|     
			    
			    type       	"int"
			    initv      	"6"
			    exportControl 	"Public"
			    static     	TRUE)
			(object ClassAttribute "ROUND_UNNECESSARY"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8160249"
			    documentation 	
|
|     * This "pseudo-rounding-mode" is actually an assertion that the requested
|     * operation has an exact result, hence no rounding is necessary.  If this
|     * rounding mode is specified on an operation that yields an inexact result,
|     * an arithmetic exception is thrown.
|     
			    
			    type       	"int"
			    initv      	"7"
			    exportControl 	"Public"
			    static     	TRUE))
		    module     	"Component View::java::math::BigDecimal (subprog spec)"
		    quidu      	"34B0F6D2034D"
		    language   	"Java")
		(object Class "BigInteger"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D2035C"
		    documentation 	
|
| * Immutable arbitrary-precision integers.  All operations behave as if
| * BigIntegers were represented in two's-complement notation (like Java's
| * primitive integer types).  BigIntegers provide analogues to all of Java's
| * primitive integer operators, and all relevant static methods from
| * java.lang.Math.  Additionally, BigIntegers provide operations for modular
| * arithmetic, GCD calculation, primality testing, prime generation,
| * single-bit manipulation, and a few other odds and ends.
| *
| * <P>Semantics of arithmetic operations exactly mimic those of java's integer
| * arithmetic operators, as defined in The Java Language Specification.  For
| * example, division by zero throws an ArithmeticException, and division of
| * a negative by a positive yields a negative (or zero) remainder.  All of
| * the details in the Spec concerning overflow are ignored, as BigIntegers
| * are made as large as necessary to accommodate the results of an operation.
| *
| * <P>Semantics of shift operations extend those of Java's shift operators
| * to allow for negative shift distances.  A right-shift with a negative
| * shift distance results in a left shift, and vice-versa.  The unsigned
| * right shift operator (>>>) is omitted, as this operation makes little
| * sense in combination with the "infinite word size" abstraction provided
| * by this class.
| *
| * <P>Semantics of bitwise logical operations are are exactly mimic those of
| * Java's bitwise integer operators.  The Binary operators (and, or, xor)
| * implicitly perform sign extension on the shorter of the two operands
| * prior to performing the operation.
| *
| * <P>Comparison operations perform signed integer comparisons, analogous to
| * those performed by java's relational and equality operators.
| *
| * <P>Modular arithmetic operations are provided to compute residues, perform
| * exponentiation, and compute multiplicative inverses.  These methods always
| * return a non-negative result, between 0 and (modulus - 1), inclusive.
| *
| * <P>Single-bit operations operate on a single bit of the two's-complement
| * representation of their operand.  If necessary, the operand is sign
| * extended so that it contains the designated bit.  None of the single-bit
| * operations can produce a number with a different sign from the the
| * BigInteger being operated on, as they affect only a single bit, and the
| * "infinite word size" abstraction provided by this class ensures that there
| * are infinitely many "virtual sign bits" preceding each BigInteger.
| *
| *
| * @see BigDecimal
| * @version 	1.7, 97/08/30
| * @author      Josh Bloch
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F8170128"
			    supplier   	"Logical View::java::lang::Number"
			    quidu      	"34B0F6CF0293"))
		    operations 	(list Operations
			(object Operation "BigInteger"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81701C8"
			    documentation 	
|
|     * Translates a byte array containing the two's-complement representation
|     * of a (signed) integer into a BigInteger.  The input array is assumed to
|     * be big-endian (i.e., the most significant byte is in the [0] position).
|     * (The most significant bit of the most significant byte is the sign bit.)
|     * The array must contain at least one byte or a NumberFormatException
|     * will be thrown.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "val"
				    type       	"byte[]"))
			    exceptions 	"NumberFormatException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "BigInteger"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81701CA"
			    documentation 	
|
|     * Translates the sign-magnitude representation of an integer into a
|     * BigInteger.  The sign is represented as an integer signum value (-1 for
|     * negative, 0 for zero, 1 for positive).  The magnitude is represented
|     * as a big-endian byte array (i.e., the most significant byte is in the
|     * [0] position).  An invalid signum value or a 0 signum value coupled
|     * with a nonzero magnitude will result in a NumberFormatException.
|     * A zero length magnitude array is permissible, and will result in
|     * in a value of 0 (irrespective of the given signum value).
|     
			    
			    parameters 	(list Parameters
				(object Parameter "signum"
				    type       	"int")
				(object Parameter "magnitude"
				    type       	"byte[]"))
			    exceptions 	"NumberFormatException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "BigInteger"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81701CD"
			    documentation 	
|
|     * Translates a string containing an optional minus sign followed by a
|     * sequence of one or more digits in the specified radix into a BigInteger.
|     * The character-to-digit mapping is provided by Character.digit.
|     * Any extraneous characters (including whitespace), or a radix outside
|     * the range from Character.MIN_RADIX(2) to Character.MAX_RADIX(36),
|     * inclusive, will result in a NumberFormatException.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "val"
				    type       	"String")
				(object Parameter "radix"
				    type       	"int"))
			    exceptions 	"NumberFormatException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "BigInteger"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81701D4"
			    documentation 	
|
|     * Translates a string containing an optional minus sign followed by a
|     * sequence of one or more decimal digits into a BigInteger.  The
|     * character-to-digit mapping is provided by Character.digit.
|     * Any extraneous characters (including whitespace) will result in a
|     * NumberFormatException. 
|     
			    
			    parameters 	(list Parameters
				(object Parameter "val"
				    type       	"String"))
			    exceptions 	"NumberFormatException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "BigInteger"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81701D6"
			    documentation 	
|
|     * Returns a random number uniformly distributed on [0, 2**numBits - 1]
|     * (assuming a fair source of random bits is provided in rndSrc).
|     * Note that this constructor always returns a non-negative BigInteger.
|     * Throws an IllegalArgumentException if numBits < 0.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "numBits"
				    type       	"int")
				(object Parameter "rndSrc"
				    type       	"Random"))
			    exceptions 	"IllegalArgumentException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "randomBits"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F81701D9"
			    parameters 	(list Parameters
				(object Parameter "numBits"
				    type       	"int")
				(object Parameter "rndSrc"
				    type       	"Random"))
			    result     	"byte[]"
			    exceptions 	"IllegalArgumentException"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "BigInteger"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81701DC"
			    documentation 	
|
|     * Returns a randomly selected BigInteger with the specified bitLength
|     * that is probably prime.  The certainty parameter is a measure of
|     * the uncertainty that the caller is willing to tolerate: the probability
|     * that the number is prime will exceed 1 - 1/2**certainty.  The execution
|     * time is proportional to the value of the certainty parameter.  The
|     * given random number generator is used to select candidates to be
|     * tested for primality.  Throws an ArithmeticException if bitLength < 2.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "bitLength"
				    type       	"int")
				(object Parameter "certainty"
				    type       	"int")
				(object Parameter "rnd"
				    type       	"Random"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "BigInteger"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81701E0"
			    documentation 	
|
|     * This private constructor differs from its public cousin
|     * with the arguments reversed in two ways: it assumes that its
|     * arguments are correct, and it doesn't copy the magnitude array.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "magnitude"
				    type       	"byte[]")
				(object Parameter "signum"
				    type       	"int"))
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "valueOf"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F81701E3"
			    documentation 	
|
|     * Returns a BigInteger with the specified value.  This factory is provided
|     * in preference to a (long) constructor because it allows for reuse
|     * of frequently used BigIntegers (like 0 and 1), obviating the need for
|     * exported constants.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "val"
				    type       	"long"))
			    result     	"BigInteger"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "valueOf"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F81701E5"
			    documentation 	
|
|     * Returns a BigInteger with the given two's complement representation.
|     * Assumes that the input array will not be modified (the returned
|     * BigInteger will reference the input array if feasible).
|     
			    
			    parameters 	(list Parameters
				(object Parameter "val[]"
				    type       	"byte"))
			    result     	"BigInteger"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
