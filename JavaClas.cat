				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F81B031C"
			    type       	"boolean")
			(object ClassAttribute "temp[]"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F81B032F"
			    type       	"byte"
			    initv      	"new byte [1]"))
