			(object Operation "minimumLayoutSize"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A700A1"
			    documentation 	
|
|     * Determines the minimum size of the <code>target</code> container 
|     * using this layout manager. 
|     * <p>
|     * This method is called when a container calls its 
|     * <code>getMinimumSize</code> method. Most applications do not call 
|     * this method directly. 
|     * @param   target   the container in which to do the layout.
|     * @return  the minimum dimensions needed to lay out the subcomponents 
|     *          of the specified container.
|     * @see     java.awt.Container  
|     * @see     java.awt.BorderLayout#preferredLayoutSize
|     * @see     java.awt.Container#getMinimumSize()
|     * @since   JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "target"
				    type       	"Container"))
			    result     	"Dimension"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "preferredLayoutSize"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A700A3"
			    documentation 	
|
|     * Determines the preferred size of the <code>target</code> 
|     * container using this layout manager, based on the components
|     * in the container. 
|     * <p>
|     * Most applications do not call this method directly. This method
|     * is called when a container calls its <code>getPreferredSize</code> 
|     * method.
|     * @param   target   the container in which to do the layout.
|     * @return  the preferred dimensions to lay out the subcomponents 
|     *          of the specified container.
|     * @see     java.awt.Container  
|     * @see     java.awt.BorderLayout#minimumLayoutSize  
|     * @see     java.awt.Container#getPreferredSize()
|     * @since   JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "target"
				    type       	"Container"))
			    result     	"Dimension"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "maximumLayoutSize"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A700A5"
			    documentation 	
|
|     * Returns the maximum dimensions for this layout given the components
|     * in the specified target container.
|     * @param target the component which needs to be laid out
|     * @see Container
|     * @see #minimumLayoutSize
|     * @see #preferredLayoutSize
|     
			    
			    parameters 	(list Parameters
				(object Parameter "target"
				    type       	"Container"))
			    result     	"Dimension"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getLayoutAlignmentX"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A700A7"
			    documentation 	
|
|     * Returns the alignment along the x axis.  This specifies how
|     * the component would like to be aligned relative to other 
|     * components.  The value should be a number between 0 and 1
|     * where 0 represents alignment along the origin, 1 is aligned
|     * the furthest away from the origin, 0.5 is centered, etc.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "parent"
				    type       	"Container"))
			    result     	"float"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getLayoutAlignmentY"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A700A9"
			    documentation 	
|
|     * Returns the alignment along the y axis.  This specifies how
|     * the component would like to be aligned relative to other 
|     * components.  The value should be a number between 0 and 1
|     * where 0 represents alignment along the origin, 1 is aligned
|     * the furthest away from the origin, 0.5 is centered, etc.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "parent"
				    type       	"Container"))
			    result     	"float"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
