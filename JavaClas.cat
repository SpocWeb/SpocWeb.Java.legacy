		    language   	"Java")
		(object Class "BeanInfo"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D40252"
		    documentation 	
|
| * A bean implementor who wishes to provide explicit information about
| * their bean may provide a BeanInfo class that implements this BeanInfo
| * interface and provides explicit information about the methods,
| * properties, events, etc, of their  bean.
| * <p>
| * A bean implementor doesn't need to provide a complete set of
| * explicit information.  You can pick and choose which information
| * you want to provide and the rest will be obtained by automatic
| * analysis using low-level reflection of the bean classes' methods
| * and applying standard design patterns.
| * <p>
| * You get the opportunity to provide lots and lots of different
| * information as part of the various XyZDescriptor classes.  But
| * don't panic, you only really need to provide the minimal core
| * information required by the various constructors.
| * <P>
| * See also the SimpleBeanInfo class which provides a convenient
| * "noop" base class for BeanInfo classes, which you can override
| * for those specific places where you want to return explicit info.
| * <P>
| * To learn about all the behaviour of a bean see the Introspector class.
| 
		    
		    stereotype 	"Interface"
		    operations 	(list Operations
			(object Operation "getBeanDescriptor"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7DE0061"
			    documentation 	
|
|     * @return  A BeanDescriptor providing overall information about
|     * the bean, such as its displayName, its customizer, etc.  May
|     * return null if the information should be obtained by automatic
|     * analysis.
|     
			    
			    result     	"BeanDescriptor"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "getEventSetDescriptors"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7DE0062"
			    documentation 	
|
|     * @return  An array of EventSetDescriptors describing the kinds of 
|     * events fired by this bean.  May return null if the information
|     * should be obtained by automatic analysis.
|     
			    
			    result     	"EventSetDescriptor[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "getDefaultEventIndex"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7DE0063"
			    documentation 	
|
|     * A bean may have a "default" event that is the event that will
|     * mostly commonly be used by human's when using the bean. 
|     * @return Index of default event in the EventSetDescriptor array
|     *		returned by getEventSetDescriptors.
|     * <P>	Returns -1 if there is no default event.
|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "getPropertyDescriptors"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7DE0064"
			    documentation 	
|
|     * @return An array of PropertyDescriptors describing the editable
|     * properties supported by this bean.  May return null if the
|     * information should be obtained by automatic analysis.
|     * <p>
|     * If a property is indexed, then its entry in the result array will
|     * belong to the IndexedPropertyDescriptor subclass of PropertyDescriptor.
|     * A client of getPropertyDescriptors can use "instanceof" to check
|     * if a given PropertyDescriptor is an IndexedPropertyDescriptor.
|     
			    
			    result     	"PropertyDescriptor[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "getDefaultPropertyIndex"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7DE0065"
			    documentation 	
|
|     * A bean may have a "default" property that is the property that will
|     * mostly commonly be initially chosen for update by human's who are 
|     * customizing the bean.
|     * @return  Index of default property in the PropertyDescriptor array
|     * 		returned by getPropertyDescriptors.
|     * <P>	Returns -1 if there is no default property.
|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "getMethodDescriptors"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7DE006D"
			    documentation 	
|
|     * @return An array of MethodDescriptors describing the externally
|     * visible methods supported by this bean.  May return null if
|     * the information should be obtained by automatic analysis.
|     
			    
			    result     	"MethodDescriptor[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "getAdditionalBeanInfo"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7DE006E"
			    documentation 	
|
|     * This method allows a BeanInfo object to return an arbitrary collection
|     * of other BeanInfo objects that provide additional information on the
|     * current bean.
|     * <P>
|     * If there are conflicts or overlaps between the information provided
|     * by different BeanInfo objects, then the current BeanInfo takes precedence
|     * over the getAdditionalBeanInfo objects, and later elements in the array
|     * take precedence over earlier ones.
|     *
|     * @return an array of BeanInfo objects.  May return null.
|     
			    
			    result     	"BeanInfo[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "getIcon"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7DE006F"
			    documentation 	
|
|     * This method returns an image object that can be used to
|     * represent the bean in toolboxes, toolbars, etc.   Icon images
|     * will typically be GIFs, but may in future include other formats.
|     * <p>
|     * Beans aren't required to provide icons and may return null from
|     * this method.
|     * <p>
|     * There are four possible flavors of icons (16x16 color,
|     * 32x32 color, 16x16 mono, 32x32 mono).  If a bean choses to only
|     * support a single icon we recommend supporting 16x16 color.
|     * <p>
|     * We recommend that icons have a "transparent" background
|     * so they can be rendered onto an existing background.
|     *
|     * @param  iconKind  The kind of icon requested.  This should be
|     *    one of the constant values ICON_COLOR_16x16, ICON_COLOR_32x32, 
|     *    ICON_MONO_16x16, or ICON_MONO_32x32.
|     * @return  An image object representing the requested icon.  May
|     *    return null if no suitable icon is available.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "iconKind"
				    type       	"int"))
			    result     	"java.awt.Image"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0))
		    class_attributes 	(list class_attribute_list
			(object ClassAttribute "ICON_COLOR_16x16"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F7DE005D"
			    documentation 	
|
|     * Constant to indicate a 16 x 16 color icon.
|     
			    
			    type       	"int"
			    initv      	"1"
			    exportControl 	"Implementation"
			    static     	TRUE)
			(object ClassAttribute "ICON_COLOR_32x32"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F7DE005E"
			    documentation 	
|
|     * Constant to indicate a 32 x 32 color icon.
|     
			    
			    type       	"int"
			    initv      	"2"
			    exportControl 	"Implementation"
			    static     	TRUE)
			(object ClassAttribute "ICON_MONO_16x16"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F7DE005F"
			    documentation 	
|
|     * Constant to indicate a 16 x 16 monochrome icon.
|     
			    
			    type       	"int"
			    initv      	"3"
			    exportControl 	"Implementation"
			    static     	TRUE)
			(object ClassAttribute "ICON_MONO_32x32"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F7DE0060"
			    documentation 	
|
|     * Constant to indicate a 32 x 32 monochrome icon.
|     
			    
			    type       	"int"
			    initv      	"4"
			    exportControl 	"Implementation"
			    static     	TRUE))
		    module     	"Component View::java::beans::BeanInfo (subprog spec)"
		    quidu      	"34B0F6D40251"
		    language   	"Java")
		(object Class "SimpleBeanInfo"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D40262"
		    documentation 	
|
| * This is a support class to make it easier for people to provide
| * BeanInfo classes.
| * <p>
| * It defaults to providing "noop" information, and can be selectively
| * overriden to provide more explicit information on chosen topics.
| * When the introspector sees the "noop" values, it will apply low
| * level introspection and design patterns to automatically analyze
| * the target bean.
| 
		    
		    realized_interfaces 	(list realize_rel_list
			(object Realize_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7E4007D"
			    supplier   	"Logical View::java::beans::BeanInfo"
			    quidu      	"34B0F6D40252"))
		    operations 	(list Operations
			(object Operation "getBeanDescriptor"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7E4007E"
			    documentation 	
|
|     * Deny knowledge about the class and customizer of the bean.
|     * You can override this if you wish to provide explicit info.
|     
			    
			    result     	"BeanDescriptor"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getPropertyDescriptors"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7E4007F"
			    documentation 	
|
|     * Deny knowledge of properties. You can override this
|     * if you wish to provide explicit property info.
|     
			    
			    result     	"PropertyDescriptor[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getDefaultPropertyIndex"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7E40080"
			    documentation 	
|
|     * Deny knowledge of a default property. You can override this
|     * if you wish to define a default property for the bean.
|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getEventSetDescriptors"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7E40081"
			    documentation 	
|
|     * Deny knowledge of event sets. You can override this
|     * if you wish to provide explicit event set info.
|     
			    
			    result     	"EventSetDescriptor[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getDefaultEventIndex"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7E40082"
			    documentation 	
|
|     * Deny knowledge of a default event. You can override this
|     * if you wish to define a default event for the bean.
|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getMethodDescriptors"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7E40083"
			    documentation 	
|
|     * Deny knowledge of methods. You can override this
|     * if you wish to provide explicit method info.
|     
			    
			    result     	"MethodDescriptor[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getAdditionalBeanInfo"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7E40084"
			    documentation 	
|
|     * Claim there are no other relevant BeanInfo objects.  You
|     * may override this if you want to (for example) return a
|     * BeanInfo for a base class.
|     
			    
			    result     	"BeanInfo[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getIcon"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7E40085"
			    documentation 	
|
|     * Claim there are no icons available.  You can override
|     * this if you want to provide icons for your bean.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "iconKind"
				    type       	"int"))
			    result     	"java.awt.Image"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "loadImage"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7E40087"
			    documentation 	
|
|     * This is a utility method to help in loading icon images.
|     * It takes the name of a resource file associated with the
|     * current object's class file and loads an image object
|     * from that file.  Typically images will be GIFs.
|     * <p>
|     * @param resourceName  A pathname relative to the directory
|     *		holding the class file of the current class.  For example,
|     *		"wombat.gif".
|     * @return  an image object.  May be null if the load failed.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "resourceName"
				    type       	"String"))
			    result     	"java.awt.Image"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
		    module     	"Component View::java::beans::SimpleBeanInfo (subprog spec)"
		    quidu      	"34B0F6D40261"
		    language   	"Java")
		(object Class "BeanDescriptor"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D40280"
		    documentation 	
|
| * A BeanDescriptor provides global information about a "bean",
| * including its Java class, its displayName, etc.
| * <p>
| * This is one of the kinds of descriptor returned by a BeanInfo object,
| * which also returns descriptors for properties, method, and events.
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7DE0000"
			    supplier   	"Logical View::java::beans::FeatureDescriptor"
			    quidu      	"34B0F6D402DF"))
		    operations 	(list Operations
			(object Operation "BeanDescriptor"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7DE0022"
			    documentation 	
|
|     * Create a BeanDescriptor for a bean that doesn't have a customizer.
|     * @param beanClass  The Class object of the Java class that implements
|     *		the bean.  For example sun.beans.OurButton.class.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "beanClass"
				    type       	"Class"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "BeanDescriptor"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7DE0024"
			    documentation 	
|
|     * Create a BeanDescriptor for a bean that has a customizer.
|     * @param beanClass  The Class object of the Java class that implements
|     *		the bean.  For example sun.beans.OurButton.class.
|     * @param customizerClass  The Class object of the Java class that implements
|     *		the bean's Customizer.  For example sun.beans.OurButtonCustomizer.class.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "beanClass"
				    type       	"Class")
				(object Parameter "customizerClass"
				    type       	"Class"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getBeanClass"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7DE0027"
			    documentation 	
|
|     * @return The Class object for the bean.
|     
			    
			    result     	"Class"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getCustomizerClass"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7DE0028"
			    documentation 	
|
|     * @return The Class object for the bean's customizer.  This may
