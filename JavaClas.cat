				    value      	TRUE))
			    quid       	"34B0F80C01FA"
			    documentation 	
|
|     * Returns the trigonometric sine of an angle.
|     *
|     * @param   a   an angle, in radians.
|     * @return  the sine of the argument.
|     * @since   JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "a"
				    type       	"double"))
			    result     	"double"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
