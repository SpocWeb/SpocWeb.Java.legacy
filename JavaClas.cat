				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F86602DE"
			    documentation 	
|
|     * The first character in exception range
|     
			    
			    type       	"char"
			    exportControl 	"Public")
