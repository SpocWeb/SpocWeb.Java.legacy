		    class_attributes 	(list class_attribute_list
			(object ClassAttribute "millisPerHour"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8BB03DB"
			    type       	"int"
			    initv      	"60 * 60 * 1000"
