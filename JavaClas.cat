				    name       	"GenerateDefaultConstructor"
				    value      	FALSE))
			    quid       	"34B0F6CE012B"
			    documentation 	
|
| * This class provides support for general purpose decompression using
| * the popular ZLIB compression library. The ZLIB compression library
| * was initially developed as part of the PNG graphics standard and is
| * not protected by patents. It is fully described in RFCs 1950, 1951,
| * and 1952, which can be found at <a href="ftp://ds.internic.net/rfc">
| * ftp://ds.internic.net/rfc</a> in the files rfc1950.txt (zlib format),
| * rfc1951.txt (deflate format) and rfc1952.txt (gzip format).
| * 
| * @see		Deflater
| * @version 	1.18, 02/14/97
| * @author 	David Connelly
| *
| 
			    
			    operations 	(list Operations
				(object Operation "Inflater"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE01A8"
				    documentation 	
|
|     * Creates a new decompressor. If the parameter 'nowrap' is true then
|     * the ZLIB header and checksum fields will not be used in order to
|     * support the compression format used by both GZIP and PKZIP.
|     * @param nowrap if true then support GZIP compatible compression
|     
				    
				    parameters 	(list Parameters
					(object Parameter "nowrap"
					    type       	"boolean"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "Inflater"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE01AA"
				    documentation 	
|
|     * Creates a new decompressor.
|     
				    
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setInput"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F8BE01AB"
				    documentation 	
|
|     * Sets input data for decompression. Should be called whenever
|     * needsInput() returns true indicating that more input data is
|     * required.
|     * @param b the input data bytes
|     * @param off the start offset of the input data
|     * @param len the length of the input data
|     * @see Inflater#needsInput
|     
				    
				    parameters 	(list Parameters
					(object Parameter "b"
					    type       	"byte[]")
					(object Parameter "off"
					    type       	"int")
					(object Parameter "len"
					    type       	"int"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setInput"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE01AF"
				    documentation 	
|
|     * Sets input data for decompression. Should be called whenever
|     * needsInput() returns true indicating that more input data is
|     * required.
|     * @param b the input data bytes
|     * @see Inflater#needsInput
|     
				    
				    parameters 	(list Parameters
					(object Parameter "b"
					    type       	"byte[]"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setDictionary"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Native"
					    value      	TRUE)
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F8BE01B1"
				    documentation 	
|
|     * Sets the preset dictionary to the given array of bytes. Should be
|     * called when inflate() returns 0 and needsDictionary() returns true
|     * indicating that a preset dictionary is required. The method getAdler()
|     * can be used to get the Adler-32 value of the dictionary needed.
|     * @param b the dictionary data bytes
|     * @param off the start offset of the data
|     * @param len the length of the data
|     * @see Inflater#needsDictionary
|     * @see Inflater#getAdler
|     
				    
				    parameters 	(list Parameters
					(object Parameter "b"
					    type       	"byte[]")
					(object Parameter "off"
					    type       	"int")
					(object Parameter "len"
					    type       	"int"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setDictionary"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE01B5"
				    documentation 	
|
|     * Sets the preset dictionary to the given array of bytes. Should be
|     * called when inflate() returns 0 and needsDictionary() returns true
|     * indicating that a preset dictionary is required. The method getAdler()
|     * can be used to get the Adler-32 value of the dictionary needed.
|     * @param b the dictionary data bytes
|     * @see Inflater#needsDictionary
|     * @see Inflater#getAdler
|     
				    
				    parameters 	(list Parameters
					(object Parameter "b"
					    type       	"byte[]"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getRemaining"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F8BE01B7"
				    documentation 	
|
|     * Returns the total number of bytes remaining in the input buffer.
|     * This can be used to find out what bytes still remain in the input
|     * buffer after decompression has finished.
|     
				    
				    result     	"int"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "needsInput"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F8BE01B8"
				    documentation 	
|
|     * Returns true if no data remains in the input buffer. This can
|     * be used to determine if #setInput should be called in order
|     * to provide more input.
|     
				    
				    result     	"boolean"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
