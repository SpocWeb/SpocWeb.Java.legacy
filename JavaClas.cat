				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F80E0109"
			    documentation 	
|
|     * Returns the exit value for the subprocess.
|     *
|     * @return  the exit value of the subprocess.
|     * @exception  IllegalThreadStateException  if the subprocess has not yet
|     *               terminated.
|     * @since      JDK1.0
|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
