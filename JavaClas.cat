|     
				    
				    parameters 	(list Parameters
					(object Parameter "obj"
					    type       	"Object"))
				    result     	"byte"
				    exceptions 	"IllegalArgumentException,IllegalAccessException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getChar"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Native"
					    value      	TRUE))
				    quid       	"34B0F81501FE"
				    documentation 	
|
