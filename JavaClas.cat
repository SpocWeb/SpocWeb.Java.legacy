			    value      	FALSE))
		    quid       	"34B0F6D50010"
		    documentation 	
|
| * This is a utility class that can be used by beans that support bound
| * properties.  You can use an instance of this class as a member field
| * of your bean and delegate various work to it.
| 
		    
		    realized_interfaces 	(list realize_rel_list
			(object Realize_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7E30196"
			    supplier   	"Logical View::java::io::Serializable"
			    quidu      	"34B0F6CE0293"))
		    operations 	(list Operations
			(object Operation "PropertyChangeSupport"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7E301B9"
			    documentation 	
|
|     * @sourceBean  The bean to be given as the source for any events.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "sourceBean"
				    type       	"Object"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "addPropertyChangeListener"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7E301C6"
			    documentation 	
|
|     * Add a PropertyChangeListener to the listener list.
|     *
|     * @param listener  The PropertyChangeListener to be added
|     
			    
			    parameters 	(list Parameters
				(object Parameter "listener"
				    type       	"PropertyChangeListener"))
			    result     	"void"
