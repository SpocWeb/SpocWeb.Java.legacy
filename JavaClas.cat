				    uid        	0)
				(object Operation "getShort"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Native"
					    value      	TRUE))
				    quid       	"34B0F8150200"
				    documentation 	
|
|     * Get the value of a field as a short on specified object.
