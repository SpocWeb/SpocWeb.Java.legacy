	(object Class_Category "security"
	    quid       	"34B0F6D2036C"
	    visible_categories 	(list visibility_relationship_list
		(object Visibility_Relationship
		    quid       	"37BFD14300CC"
		    supplier   	"Logical View::java::util"
		    quidu      	"34B0F6CE00FD"))
	    exportControl 	"Public"
	    logical_models 	(list unit_reference_list
		(object Class "Key"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D3006E"
		    documentation 	
|
| * The Key interface is the top-level interface for all keys. It
| * defines the functionality shared by all key objects. All keys
| * have three characteristics:
| * 
| * <UL>
| * 
| * <LI>An Algorithm
| * 
| * <P>This is the key algorithm for that key. The key algorithm is usually
| * an encryption or asymmetric operation algorithm (such as DSA or
| * RSA), which will work with those algorithms and with related
| * algorithms (such as MD5 with RSA, SHA-1 with RSA, Raw DSA, etc.)
| * The name of the algorithm of a key is obtained using the 
| * <a href = "#getAlgorithm">getAlgorithm</a> method.<P>
| * 
| * <LI>An Encoded Form
| * 
| * <P>This is an external encoded form for the key used when a standard
| * representation of the key is needed outside the Java Virtual Machine,
| * as when transmitting the key to some other party. The key
| * is encoded according to a standard format (such as X.509
| * or PKCS#8), and is returned using the 
| * <a href = "#getEncoded">getEncoded</a> method.<P>
| * 
| * <LI>A Format
| * 
| * <P>This is the name of the format of the encoded key. It is returned 
| * by the <a href = "#getFormat">getFormat</a> method.<P>
| * 
| * </UL>
| * 
| * Keys are generally obtained through key generators, certificates,
| * or various Identity classes used to manage keys. There are no
| * provisions in this release for the parsing of encoded keys and
| * certificates.
| *
| * @see PublicKey
| * @see PrivateKey
| * @see KeyPair
| * @see KeyPairGenerator
| * @see Identity
| * @see IdentityScope
| * @see Signer
| *
| * @version 1.28, 97/01/29
| * @author Benjamin Renaud 
| 
		    
		    stereotype 	"Interface"
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82D001F"
			    supplier   	"Logical View::java::io::Serializable"
			    quidu      	"34B0F6CE0293"))
		    operations 	(list Operations
			(object Operation "getAlgorithm"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F82D0020"
			    documentation 	
|
|     * Returns the standard algorithm name this key is for. For
|     * example, "DSA" would indicate that this key is a DSA key. 
|     * Note that this method may return null, when the
|     * algorithm this key is for is unknown.
|     * 
|     * <p>See Appendix A in the <a href=
|     * "../guide/security/CryptoSpec.html#AppA">
|     * Java Cryptography Architecture API Specification &amp; Reference </a> 
|     * for information about standard algorithm names.
|     * 
|     * @return the name of the algorithm this key is for, or null
|     * if the algorithm this key is for is unknown.  
|     
			    
			    result     	"String"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getFormat"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F82D0021"
			    documentation 	
|
|     * Returns the format used to encode the key or null if the key does not
|     * support encoding.
|     * 
|     * @return the format used to encode the key.
|     
			    
			    result     	"String"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getEncoded"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F82D0022"
			    documentation 	
|
|     * Returns the encoded key.
|     * 
|     * @return the encoded key, or null if the key does not support
|     * encoding.
|     *
|     
			    
			    result     	"byte[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
		    module     	"Component View::java::security::Key (subprog spec)"
		    quidu      	"34B0F6D3006D"
		    language   	"Java")
		(object Class "Identity"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D3007E"
		    documentation 	
|
| * <p>This class represents identities: real-world objects such as people,
| * companies or organizations whose identities can be authenticated using 
| * their public keys. Identities may also be more abstract (or concrete) 
| * constructs, such as daemon threads or smart cards.
| *
| * <p>All Identity objects have a name and a public key. Names are
| * immutable. Identities may also be scoped. That is, if an Identity is
| * specified to have a particular scope, then the name and public
| * key of the Identity are unique within that scope.
| *
| * <p>An Identity also has a set of certificates (all certifying its own
| * public key). The Principal names specified in these certificates need 
| * not be the same, only the key.
| *
| * <p>An Identity can be subclassed, to include postal and email addresses,
| * telephone numbers, images of faces and logos, and so on.
| *
| * @see IdentityScope
| * @see Signer
| * @see Principal
| *
| * @version 	1.24, 01/27/97
| * @author Benjamin Renaud 
| 
		    
		    realized_interfaces 	(list realize_rel_list
			(object Realize_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82C0203"
			    supplier   	"Logical View::java::security::Principal"
			    quidu      	"34B0F6D3008D")
			(object Realize_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82C0213"
			    supplier   	"Logical View::java::io::Serializable"
			    quidu      	"34B0F6CE0293"))
		    operations 	(list Operations
			(object Operation "Identity"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82C0274"
			    documentation 	
|
|     * Constructor for serialization only.
|     
			    
			    concurrency 	"Sequential"
			    opExportControl 	"Protected"
			    uid        	0)
			(object Operation "Identity"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82C0275"
			    documentation 	
|
|     * Constructs an identity with the specified name and scope.
|     *
|     * @param name the identity name.  
|     * @param scope the scope of the identity.
|     *
|     * @exception KeyManagementException if there is already an identity 
|     * with the same name in the scope.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "name"
				    type       	"String")
				(object Parameter "scope"
				    type       	"IdentityScope"))
			    exceptions 	"KeyManagementException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "Identity"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82C0278"
			    documentation 	
|
|     * Constructs an identity with the specified name and no scope.
|     *
|     * @param name the identity name.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "name"
				    type       	"String"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getName"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE))
			    quid       	"34B0F82C027A"
			    documentation 	
|
|     * Returns this identity's name.
|     *
|     * @return the name of this identity.
|     
			    
			    result     	"String"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getScope"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE))
			    quid       	"34B0F82C027B"
			    documentation 	
|
|     * Returns this identity's scope.
|     *
|     * @return the scope of this identity.
|     
			    
			    result     	"IdentityScope"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getPublicKey"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82C027C"
			    documentation 	
|
|     * Returns this identity's public key.
|     * 
|     * @return the public key for this identity.
|     
			    
