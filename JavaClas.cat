			    quid       	"34B0F6CE011A"
			    documentation 	
|
| * This class provides support for general purpose decompression using
| * the popular ZLIB compression library. The ZLIB compression library
| * was initially developed as part of the PNG graphics standard and is
| * not protected by patents. It is fully described in RFCs 1950, 1951,
| * and 1952, which can be found at <a href="ftp://ds.internic.net/rfc">
| * ftp://ds.internic.net/rfc</a> in the files rfc1950.txt (zlib format),
| * rfc1951.txt (deflate format) and rfc1952.txt (gzip format).
| * 
| * @see		Inflater
| * @version 	1.17, 02/14/97
| * @author 	David Connelly
| 
			    
			    operations 	(list Operations
				(object Operation "Deflater"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BD02B4"
				    documentation 	
|
|     * Creates a new compressor using the specified compression level.
|     * If 'nowrap' is true then the ZLIB header and checksum fields will
|     * not be used in order to support the compression format used in
|     * both GZIP and PKZIP.
|     * @param level the compression level (0-9)
|     * @param nowrap if true then use GZIP compatible compression
|     
				    
				    parameters 	(list Parameters
					(object Parameter "level"
					    type       	"int")
					(object Parameter "nowrap"
					    type       	"boolean"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "Deflater"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BD02B7"
				    documentation 	
| 
|     * Creates a new compressor using the specified compression level.
|     * Compressed data will be generated in ZLIB format.
|     * @param level the compression level (0-9)
|     
				    
				    parameters 	(list Parameters
					(object Parameter "level"
					    type       	"int"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "Deflater"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BD02B9"
				    documentation 	
|
|     * Creates a new compressor with the default compression level.
|     * Compressed data will be generated in ZLIB format.
|     
				    
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setInput"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F8BD02BA"
				    documentation 	
|
