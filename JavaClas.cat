				    value      	FALSE))
			    quid       	"34B0F6CD0225"
			    documentation 	
|
| * The LightweightPeer interface marks a component as depending upon 
| * a native container so window related events can be routed to the 
| * component.  Since this only applies to components and their 
| * extensions, this interface extends ComponentPeer.
| *
| * @version 1.2 12/20/96
| * @author Timothy Prinzing
| 
			    
			    stereotype 	"Interface"
			    superclasses 	(list inheritance_relationship_list
				(object Inheritance_Relationship
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7D90261"
				    supplier   	"Logical View::java::awt::peer::ComponentPeer"
				    quidu      	"34B0F6CD019B"))
			    module     	"Component View::java::awt::peer::LightweightPeer (subprog spec)"
			    quidu      	"34B0F6CD0224"
			    language   	"Java"))
		    logical_presentations 	(list unit_reference_list))
		(object Class_Category "datatransfer"
		    quid       	"34B0F6CD0233"
		    exportControl 	"Public"
		    logical_models 	(list unit_reference_list
			(object Class "Clipboard"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateFinalizer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateStaticInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateInstanceInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateDefaultConstructor"
				    value      	FALSE))
			    quid       	"34B0F6CD0235"
			    documentation 	
|
| * A class which implements a mechanism to transfer data using 
| * cut/copy/paste operations.
| *
| * @version 	1.5, 11/23/96
| * @author	Amy Fowler
| 
			    
			    operations 	(list Operations
				(object Operation "Clipboard"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C2014B"
				    documentation 	
|
|     * Creates a clipboard object.
|     
				    
				    parameters 	(list Parameters
					(object Parameter "name"
					    type       	"String"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getName"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C2014D"
				    documentation 	
|
|     * Returns the name of this clipboard object.
|     
				    
				    result     	"String"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setContents"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F7C2014E"
				    documentation 	
|
|     * Sets the current contents of the clipboard to the specified
|     * transferable object and registers the specified clipboard owner
|     * as the owner of the new contents.  If there is an existing owner 
|     * registered, that owner is notified that it no longer holds ownership
|     * of the clipboard contents.
|     * @param content the transferable object representing the clipboard content
|     * @param owner the object which owns the clipboard content
|     
				    
				    parameters 	(list Parameters
					(object Parameter "contents"
					    type       	"Transferable")
					(object Parameter "owner"
					    type       	"ClipboardOwner"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getContents"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F7C20151"
				    documentation 	
|
|     * Returns a transferable object representing the current contents
|     * of the clipboard.  If the clipboard currently has no contents,
|     * it returns null.
|     * @param requestor the object requesting the clip data
|     * @return the current transferable object on the clipboard
|     
				    
				    parameters 	(list Parameters
					(object Parameter "requestor"
					    type       	"Object"))
				    result     	"Transferable"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0))
			    module     	"Component View::java::awt::datatransfer::Clipboard (subprog spec)"
			    quidu      	"34B0F6CD0234"
			    language   	"Java")
			(object Class "ClipboardOwner"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateFinalizer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateStaticInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateInstanceInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateDefaultConstructor"
				    value      	FALSE))
			    quid       	"34B0F6CD0237"
			    documentation 	
|
| * Defines the interface for classes that will provide data to
| * a clipboard.
| * 
| * @version 	1.2, 11/23/96
| * @author	Amy Fowler
| 
			    
			    stereotype 	"Interface"
			    operations 	(list Operations
				(object Operation "lostOwnership"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F7C20167"
				    documentation 	
|
|     * Notifies this object that it is no longer the owner of
|     * the contents of the clipboard.
|     * @param clipboard the clipboard that is no longer owned
|     * @param contents the contents which this owner had placed on the clipboard
|     
				    
				    parameters 	(list Parameters
					(object Parameter "clipboard"
					    type       	"Clipboard")
					(object Parameter "contents"
					    type       	"Transferable"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0))
			    module     	"Component View::java::awt::datatransfer::ClipboardOwner (subprog spec)"
			    quidu      	"34B0F6CD0236"
			    language   	"Java")
			(object Class "Transferable"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateFinalizer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateStaticInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateInstanceInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateDefaultConstructor"
				    value      	FALSE))
			    quid       	"34B0F6CD0239"
			    documentation 	
|
| * Defines the interface for classes that can be used to provide data
| * for a transfer operation.
| *
| * @version 	1.3, 02/12/97
| * @author	Amy Fowler  
| 
			    
			    stereotype 	"Interface"
			    operations 	(list Operations
				(object Operation "getTransferDataFlavors"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F7C302BF"
				    documentation 	
|
|     * Returns an array of DataFlavor objects indicating the flavors the data 
|     * can be provided in.  The array should be ordered according to preference
|     * for providing the data (from most richly descriptive to least descriptive).
|     * @return an array of data flavors in which this data can be transferred
|     
				    
				    result     	"DataFlavor[]"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "isDataFlavorSupported"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F7C302C0"
				    documentation 	
|
|     * Returns whether or not the specified data flavor is supported for
|     * this object.
|     * @param flavor the requested flavor for the data
|     * @return boolean indicating wjether or not the data flavor is supported
|     
				    
				    parameters 	(list Parameters
					(object Parameter "flavor"
					    type       	"DataFlavor"))
				    result     	"boolean"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getTransferData"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F7C302C2"
				    documentation 	
|
|     * Returns an object which represents the data to be transferred.  The class 
|     * of the object returned is defined by the representation class of the flavor.
|     *
|     * @param flavor the requested flavor for the data
|     * @see DataFlavor#getRepresentationClass
|     * @exception IOException                if the data is no longer available
|     *              in the requested flavor.
|     * @exception UnsupportedFlavorException if the requested data flavor is
|     *              not supported.
|     
				    
				    parameters 	(list Parameters
					(object Parameter "flavor"
					    type       	"DataFlavor"))
				    result     	"Object"
				    exceptions 	"UnsupportedFlavorException,IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0))
			    module     	"Component View::java::awt::datatransfer::Transferable (subprog spec)"
			    quidu      	"34B0F6CD0238"
			    language   	"Java")
			(object Class "DataFlavor"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateFinalizer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateStaticInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateInstanceInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateDefaultConstructor"
				    value      	FALSE))
			    quid       	"34B0F6CD0243"
			    documentation 	
|
| * Each instance represents the opaque concept of a data format as would
| * appear on a clipboard, during drag and drop, or in a file system.
| *
| * @version 	1.4, 03/10/97
| * @author	Blake Sullivan
| 
			    
			    operations 	(list Operations
				(object Operation "DataFlavor"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C20235"
				    documentation 	
|
|    * Construct a DataFlavor that represents a Java class
|    * <p>
|    * The returned DataFlavor will have the following characteristics
|    * <p>
|    * representationClass = representationClass<br>
|    * mimeType            = application/x-java-serialized-object        
|    * <p>
|    * @param representationClass the class used to transfer data in this flavor
|    * @param humanPresentableName the human-readible string used to identify this flavor
|    
				    
				    parameters 	(list Parameters
					(object Parameter "representationClass"
					    type       	"Class")
					(object Parameter "humanPresentableName"
					    type       	"String"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "DataFlavor"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C20244"
				    documentation 	
|
|    * Construct a DataFlavor that represents a MimeType
|    * <p>
|    * The returned DataFlavor will have the following characteristics:
|    * <p>
|    * If the mimeType is
|    * "application/x-java-serialized-object; class=<representation class>",
|    * the result is the same as calling
|    * new DataFlavor(Class:forName(<representation class>) as above
|    * <p>
|    * otherwise:
|    * <p>
|    * representationClass = InputStream<br>
|    * mimeType            = mimeType         
|    * <p>
|    * @param mimeType the string used to identify the MIME type for this flavor
|    * @param humanPresentableName the human-readible string used to identify this flavor
|    
				    
				    parameters 	(list Parameters
					(object Parameter "mimeType"
					    type       	"String")
					(object Parameter "humanPresentableName"
					    type       	"String"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getMimeType"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C20247"
				    documentation 	
|
|    * Returns the MIME type string for this DataFlavor
|    
				    
				    result     	"String"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getRepresentationClass"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C20248"
				    documentation 	
|
|    *  Returns the Class which objects supporting this DataFlavor
|    *  will return when this DataFlavor is requested.
|    
				    
				    result     	"Class"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getHumanPresentableName"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C20249"
				    documentation 	
|
|    * Returns the human presentable name for the data foramt that this
|    * DataFlavor represents.  This name would be localized for different
|    * countries
|    
				    
				    result     	"String"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setHumanPresentableName"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C2024A"
				    documentation 	
|
|    * Sets the human presentable name for the data format that this
|    * DataFlavor represents. This name would be localized for different
|    * countries
|    
				    
				    parameters 	(list Parameters
					(object Parameter "humanPresentableName"
					    type       	"String"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "equals"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C2024C"
				    parameters 	(list Parameters
					(object Parameter "dataFlavor"
					    type       	"DataFlavor"))
				    result     	"boolean"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "isMimeTypeEqual"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C2024E"
				    documentation 	
|
|     * Is the string representation of the MIME type passed in equivalent
|     * to the MIME type of this DataFlavor.  This may involve adding default
|     * attributes for some MIME types (like adding charset=US-ASCII to
|     * text/plain MIME types that have no charset parameter specified)
|     
				    
				    parameters 	(list Parameters
					(object Parameter "mimeType"
					    type       	"String"))
				    result     	"boolean"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "isMimeTypeEqual"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Final"
					    value      	TRUE))
				    quid       	"34B0F7C20250"
				    documentation 	
|
|     * Convenience function equivalent to calling:
|     * isMimeTypeEqual(dataFlavor.getMimeType());
|     
				    
				    parameters 	(list Parameters
					(object Parameter "dataFlavor"
					    type       	"DataFlavor"))
				    result     	"boolean"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "normalizeMimeTypeParameter"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C20252"
				    documentation 	
|
|    * Called on DataFlavor for every MIME Type parameter to allow DataFlavor
|    * subclasses to handle special parameters like the text/plain charset
|    * parameters, whose values are case insensitive.  (MIME type parameter
|    * values are supposed to be case sensitive.
|    * <p>
|    * This method is called for each parameter name/value pair and should
|    * return the normalized representation of the parameterValue
|    
				    
				    parameters 	(list Parameters
					(object Parameter "parameterName"
					    type       	"String")
					(object Parameter "parameterValue"
					    type       	"String"))
				    result     	"String"
				    concurrency 	"Sequential"
				    opExportControl 	"Protected"
				    uid        	0)
				(object Operation "normalizeMimeType"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C20255"
				    documentation 	
|
|    * Called for each MIME type string to give DataFlavor subtypes the
|    * opportunity to change how the normalization of MIME types is accomplished.
|    * One possible use would be to add default parameter/value pairs in cases
|    * where none are present in the MIME type string passed in
|    
				    
				    parameters 	(list Parameters
					(object Parameter "mimeType"
					    type       	"String"))
				    result     	"String"
				    concurrency 	"Sequential"
				    opExportControl 	"Protected"
				    uid        	0))
			    class_attributes 	(list class_attribute_list
				(object ClassAttribute "atom"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"ERwin"
					    name       	"Data Type"
					    value      	("DataTypeEnum" 1)))
				    quid       	"34B0F7C20206"
				    type       	"int"
				    exportControl 	"Implementation"))
			    module     	"Component View::java::awt::datatransfer::DataFlavor (subprog spec)"
			    quidu      	"34B0F6CD0242"
			    language   	"Java")
			(object Class "StringSelection"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateFinalizer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateStaticInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateInstanceInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateDefaultConstructor"
				    value      	FALSE))
			    quid       	"34B0F6CD0245"
			    documentation 	
|
| * A class which implements the capability required to transfer a
| * simple java String in plain text format.
| 
			    
			    realized_interfaces 	(list realize_rel_list
				(object Realize_Relationship
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C30251"
				    supplier   	"Logical View::java::awt::datatransfer::Transferable"
				    quidu      	"34B0F6CD0239")
				(object Realize_Relationship
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C30261"
				    supplier   	"Logical View::java::awt::datatransfer::ClipboardOwner"
				    quidu      	"34B0F6CD0237"))
			    operations 	(list Operations
				(object Operation "StringSelection"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C30293"
				    documentation 	
|
|     * Creates a transferable object capable of transferring the
|     * specified string in plain text format.
|     
				    
				    parameters 	(list Parameters
					(object Parameter "data"
					    type       	"String"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getTransferDataFlavors"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F7C30295"
				    documentation 	
|
|     * Returns the array of flavors in which it can provide the data.
|     
				    
				    result     	"DataFlavor[]"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "isDataFlavorSupported"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C30296"
				    documentation 	
|
|     * Returns whether the requested flavor is supported by this object.
|     * @param flavor the requested flavor for the data
|     
				    
				    parameters 	(list Parameters
					(object Parameter "flavor"
					    type       	"DataFlavor"))
				    result     	"boolean"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getTransferData"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F7C30298"
				    documentation 	
|
|     * If the data was requested in the "java.lang.String" flavor, return the
|     * String representing the selection.
|     *
|     * @param flavor the requested flavor for the data
|     * @exception UnsupportedFlavorException if the requested data flavor is
|     *              not supported in the "<code>java.lang.String</code>" flavor.
|     
				    
				    parameters 	(list Parameters
					(object Parameter "flavor"
					    type       	"DataFlavor"))
				    result     	"Object"
				    exceptions 	"UnsupportedFlavorException,IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "lostOwnership"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C3029A"
				    parameters 	(list Parameters
					(object Parameter "clipboard"
					    type       	"Clipboard")
					(object Parameter "contents"
					    type       	"Transferable"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0))
			    class_attributes 	(list class_attribute_list
				(object ClassAttribute "STRING"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Final"
					    value      	TRUE)
					(object Attribute
					    tool       	"ERwin"
