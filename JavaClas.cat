		    quid       	"34B0F6CE0021"
		    documentation 	
|
| * This class represents an Internet Protocol (IP) address. 
| * <p>
| * Applications should use the methods <code>getLocalHost</code>, 
| * <code>getByName</code>, or <code>getAllByName</code> to 
| * create a new <code>InetAddress</code> instance. 
| *
| * @author  Chris Warth
| * @version 1.43, 07/16/97
| * @see     java.net.InetAddress#getAllByName(java.lang.String)
| * @see     java.net.InetAddress#getByName(java.lang.String)
| * @see     java.net.InetAddress#getLocalHost()
| * @since   JDK1.0
| 
		    
		    realized_interfaces 	(list realize_rel_list
			(object Realize_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81902FD"
			    supplier   	"Logical View::java::io::Serializable"
			    quidu      	"34B0F6CE0293"))
		    operations 	(list Operations
			(object Operation "InetAddress"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F8190399"
			    documentation 	
| 
|     * Constructor for the Socket.accept() method.
|     * This creates an empty InetAddress, which is filled in by
|     * the accept() method.  This InetAddress, however, is not
|     * put in the address cache, since it is not created by name.
|     
			    
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "InetAddress"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F819039A"
			    documentation 	
|
|     * Creates an InetAddress with the specified host name and IP address.
|     * @param hostName the specified host name
|     * @param addr the specified IP address.  The address is expected in 
|     *	      network byte order.
|     * @exception UnknownHostException If the address is unknown.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "hostName"
				    type       	"String")
				(object Parameter "addr[]"
				    type       	"byte"))
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "isMulticastAddress"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F819039D"
			    documentation 	
|
|     * Utility routine to check if the InetAddress is a 
|     * IP multicast address. IP multicast address is a Class D
|     * address i.e first four bits of the address are 1110.
|     * @since   JDK1.1
|     
			    
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getHostName"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F819039E"
			    documentation 	
|
|     * Returns the fully qualified host name for this address.
|     * If the host is equal to null, then this address refers to any
|     * of the local machine's available network addresses.
|     *
|     * @return  the fully qualified host name for this address.
|     * @since   JDK1.0
|     
			    
			    result     	"String"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getAddress"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F819039F"
			    documentation 	
|
|     * Returns the raw IP address of this <code>InetAddress</code> 
|     * object. The result is in network byte order: the highest order 
|     * byte of the address is in <code>getAddress()[0]</code>. 
|     *
|     * @return  the raw IP address of this object.
|     * @since   JDK1.0
|     
			    
			    result     	"byte[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getHostAddress"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81903A0"
			    documentation 	
|
|     * Returns the IP address string "%d.%d.%d.%d"
|     * @return raw IP address in a string format
|     * @since   JDK1.1
|     
			    
			    result     	"String"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "hashCode"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81903A1"
			    documentation 	
|
|     * Returns a hashcode for this IP address.
|     *
|     * @return  a hash code value for this IP address. 
|     * @since   JDK1.0
|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "equals"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81903A2"
			    documentation 	
|
|     * Compares this object against the specified object.
|     * The result is <code>true</code> if and only if the argument is 
|     * not <code>null</code> and it represents the same IP address as 
|     * this object. 
|     * <p>
|     * Two instances of <code>InetAddress</code> represent the same IP 
|     * address if the length of the byte arrays returned by 
|     * <code>getAddress</code> is the same for both, and each of the 
|     * array components is the same for the byte arrays. 
|     *
|     * @param   obj   the object to compare against.
|     * @return  <code>true</code> if the objects are the same;
|     *          <code>false</code> otherwise.
|     * @see     java.net.InetAddress#getAddress()
|     * @since   JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "obj"
				    type       	"Object"))
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "toString"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81903AA"
			    documentation 	
|
|     * Converts this IP address to a <code>String</code>.
|     *
|     * @return  a string representation of this IP address.
|     * @since   JDK1.0
|     
			    
			    result     	"String"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getByName"
