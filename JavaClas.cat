				(object Operation "setPixels"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C90163"
				    documentation 	
|
|     * Combine the components for the delivered byte pixels into the
|     * accumulation arrays and send on any averaged data for rows of
|     * pixels that are complete.  If the correct hints were not
|     * specified in the setHints call then relay the work to our
|     * superclass which is capable of scaling pixels regardless of
|     * the delivery hints.
|     * @see ReplicateScaleFilter
|     
				    
				    parameters 	(list Parameters
					(object Parameter "x"
					    type       	"int")
					(object Parameter "y"
					    type       	"int")
					(object Parameter "w"
					    type       	"int")
					(object Parameter "h"
					    type       	"int")
					(object Parameter "model"
					    type       	"ColorModel")
					(object Parameter "pixels[]"
					    type       	"byte")
					(object Parameter "off"
					    type       	"int")
					(object Parameter "scansize"
					    type       	"int"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
