				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F80C0111"
			    documentation 	
| 
|     * Convert the integer to an unsigned number.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "i"
				    type       	"long")
				(object Parameter "shift"
				    type       	"int"))
			    result     	"String"
