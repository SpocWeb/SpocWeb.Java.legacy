			    documentation 	
|
| * This class implements an output stream filter for writing files in the
| * ZIP file format. Includes support for both compressed and uncompressed
| * entries.
| *
| * @author	David Connelly
| * @version	1.13, 01/27/97
| 
			    
			    superclasses 	(list inheritance_relationship_list
				(object Inheritance_Relationship
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8C000EA"
				    supplier   	"Logical View::java::util::zip::DeflaterOutputStream"
				    quidu      	"34B0F6CE011C"))
			    realized_interfaces 	(list realize_rel_list
				(object Realize_Relationship
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8C00109"
				    supplier   	"Logical View::java::util::zip::ZipConstants"
				    quidu      	"34B0F6CE015A"))
			    operations 	(list Operations
				(object Operation "ZipOutputStream"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8C00178"
				    documentation 	
|
|     * Creates a new ZIP output stream.
|     * @param out the actual output stream 
|     
				    
				    parameters 	(list Parameters
					(object Parameter "out"
					    type       	"OutputStream"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setComment"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8C0017A"
				    documentation 	
|
|     * Sets the ZIP file comment.
|     * @param comment the comment string
|     * @exception IllegalArgumentException if the length of the specified
|     *		  ZIP file comment is greater than 0xFFFF bytes
|     
				    
				    parameters 	(list Parameters
					(object Parameter "comment"
					    type       	"String"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setMethod"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8C0017C"
				    documentation 	
|
|     * Sets the default compression method for subsequent entries. This
|     * default will be used whenever the compression method is not specified
|     * for an individual ZIP file entry, and is initially set to DEFLATED.
|     * @param method the default compression method
|     * @exception IllegalArgumentException if the specified compression method
|     *		  is invalid
|     
				    
				    parameters 	(list Parameters
					(object Parameter "method"
					    type       	"int"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setLevel"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8C0017E"
				    documentation 	
|
|     * Sets the compression level for subsequent entries which are DEFLATED.
|     * The default setting is DEFAULT_COMPRESSION.
|     * @param level the compression level (0-9)
|     * @exception IllegalArgumentException if the compression level is invalid
|     
				    
				    parameters 	(list Parameters
					(object Parameter "level"
					    type       	"int"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "putNextEntry"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8C00180"
				    documentation 	
|
|     * Begins writing a new ZIP file entry and positions the stream to the
|     * start of the entry data. Closes the current entry if still active.
|     * The default compression method will be used if no compression method
|     * was specified for the entry, and the current time will be used if
|     * the entry has no set modification time.
|     * @param e the ZIP entry to be written
|     * @exception ZipException if a ZIP format error has occurred
|     * @exception IOException if an I/O error has occurred
|     
				    
				    parameters 	(list Parameters
					(object Parameter "e"
					    type       	"ZipEntry"))
				    result     	"void"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "closeEntry"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8C00182"
				    documentation 	
|
|     * Closes the current ZIP entry and positions the stream for writing
|     * the next entry.
|     * @exception ZipException if a ZIP format error has occurred
|     * @exception IOException if an I/O error has occurred
|     
				    
				    result     	"void"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "write"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F8C00183"
				    documentation 	
|
|     * Writes an array of bytes to the current ZIP entry data. This method
|     * will block until all the bytes are written.
|     * @param b the data to be written
|     * @param off the start offset in the data
|     * @param len the number of bytes that are written
|     * @exception ZipException if a ZIP file error has occurred
|     * @exception IOException if an I/O error has occurred
|     
				    
				    parameters 	(list Parameters
					(object Parameter "b"
					    type       	"byte[]")
					(object Parameter "off"
					    type       	"int")
					(object Parameter "len"
					    type       	"int"))
				    result     	"void"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "finish"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8C00189"
				    documentation 	
|
|     * Finishes writing the contents of the ZIP output stream without closing
|     * the underlying stream. Use this method when applying multiple filters
|     * in succession to the same output stream.
|     * @exception ZipException if a ZIP file error has occurred
|     * @exception IOException if an I/O exception has occurred
|     
				    
				    result     	"void"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "close"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8C0018A"
				    documentation 	
|
|     * Closes the ZIP output stream as well as the stream being filtered.
|     * @exception ZipException if a ZIP file error has occurred
|     * @exception IOException if an I/O error has occurred
|     
				    
				    result     	"void"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
