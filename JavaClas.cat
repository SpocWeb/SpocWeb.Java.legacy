				    static     	TRUE)
				(object ClassAttribute "FOCUS_GAINED"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Final"
					    value      	TRUE)
					(object Attribute
					    tool       	"ERwin"
					    name       	"Data Type"
					    value      	("DataTypeEnum" 1)))
