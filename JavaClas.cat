				(object Operation "inflate"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Native"
					    value      	TRUE)
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F8BE01BB"
				    documentation 	
|
|     * Uncompresses bytes into specified buffer. Returns actual number
|     * of bytes uncompressed. A return value of 0 indicates that
|     * needsInput() or needsDictionary() should be called in order to
|     * determine if more input data or a preset dictionary is required.
|     * In the later case, getAdler() can be used to get the Adler-32
|     * value of the dictionary required.
|     * @param b the buffer for the uncompressed data
|     * @param off the start offset of the data
|     * @param len the maximum number of uncompressed bytes
|     * @return the actual number of uncompressed bytes
|     * @exception DataFormatException if the compressed data format is invalid
|     * @see Inflater#needsInput
|     * @see Inflater#needsDictionary
|     
				    
				    parameters 	(list Parameters
					(object Parameter "b"
					    type       	"byte[]")
					(object Parameter "off"
					    type       	"int")
					(object Parameter "len"
					    type       	"int"))
				    result     	"int"
				    exceptions 	"DataFormatException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "inflate"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE01BF"
				    documentation 	
|
|     * Uncompresses bytes into specified buffer. Returns actual number
|     * of bytes uncompressed. A return value of 0 indicates that
|     * needsInput() or needsDictionary() should be called in order to
|     * determine if more input data or a preset dictionary is required.
|     * In the later case, getAdler() can be used to get the Adler-32
|     * value of the dictionary required.
|     * @param b the buffer for the uncompressed data
|     * @return the actual number of uncompressed bytes
|     * @exception DataFormatException if the compressed data format is invalid
|     * @see Inflater#needsInput
|     * @see Inflater#needsDictionary
|     
				    
				    parameters 	(list Parameters
					(object Parameter "b"
					    type       	"byte[]"))
				    result     	"int"
				    exceptions 	"DataFormatException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getAdler"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Native"
					    value      	TRUE)
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F8BE01C1"
				    documentation 	
|
|     * Returns the ADLER-32 value of the uncompressed data.
|     
				    
				    result     	"int"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getTotalIn"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Native"
					    value      	TRUE)
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F8BE01C2"
				    documentation 	
|
|     * Returns the total number of bytes input so far.
