			    quid       	"34B0F7BC02D6"
			    documentation 	
|
|     * Creates the Panel's peer.  The peer allows you to modify the
|     * appearance of the panel without changing its functionality.
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
