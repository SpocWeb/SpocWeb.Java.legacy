				    value      	FALSE))
			    quid       	"34B0F6CD014B"
			    documentation 	
|
| * The mouse event.
| *
| * @version 1.12 01/27/97
| * @author Carl Quinn
| 
			    
			    superclasses 	(list inheritance_relationship_list
				(object Inheritance_Relationship
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C70280"
				    supplier   	"Logical View::java::awt::event::InputEvent"
				    quidu      	"34B0F6CD015A"))
			    operations 	(list Operations
				(object Operation "MouseEvent"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C70297"
				    documentation 	
|
|     * Constructs a MouseEvent object with the specified source component,
|     * type, modifiers, coordinates, and click count.
|     * @param source the object where the event originated
|     * @id the event type
|     * @when the time the event occurred
|     * @modifiers the modifiers down during event
|     * @x the x coordinate location of the mouse
|     * @y the y coordinate location of the mouse
|     * @clickCount the number of mouse clicks associated with event
|     * @popupTrigger whether this event is a popup-menu trigger event
|     
				    
				    parameters 	(list Parameters
					(object Parameter "source"
					    type       	"Component")
					(object Parameter "id"
					    type       	"int")
					(object Parameter "when"
					    type       	"long")
					(object Parameter "modifiers"
					    type       	"int")
					(object Parameter "x"
					    type       	"int")
					(object Parameter "y"
					    type       	"int")
					(object Parameter "clickCount"
					    type       	"int")
					(object Parameter "popupTrigger"
					    type       	"boolean"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getX"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C702A0"
				    documentation 	
|
|     * Returns the x position of the event relative to the source component.
|     
				    
				    result     	"int"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getY"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C702A1"
				    documentation 	
|
|     * Returns the y position of the event relative to the source component.
|     
				    
				    result     	"int"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getPoint"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C702A2"
				    documentation 	
|
|     * Returns the x,y position of the event relative to the source component.
|     
				    
				    result     	"Point"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "translatePoint"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Synchronized"
					    value      	TRUE))
				    quid       	"34B0F7C702A3"
				    documentation 	
|
|     * Translates the coordinate position of the event by x, y.
|     * @param x the x value added to the current x coordinate position
|     * @param y the y value added to the current y coordinate position
|     
				    
				    parameters 	(list Parameters
					(object Parameter "x"
					    type       	"int")
					(object Parameter "y"
					    type       	"int"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getClickCount"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C702A6"
				    documentation 	
|
|     * Return the number of mouse clicks associated with this event.
|     
				    
