		(object Class "KeyManagementException"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D30178"
		    documentation 	
|
| * This is the general key management exception, for all operations
| * dealing with key management. Subclasses 
| * could include:
| *
| * <ul>
| * <li>KeyIDConflict
| * <li>KeyAuthorizationFailureException
| * <li>ExpiredKeyException
| * </ul>
| *
| * @version 1.5, 97/08/30
| * @author Benjamin Renaud
| *
| * @see Key
| * @see KeyException
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82D007D"
			    supplier   	"Logical View::java::security::KeyException"
			    quidu      	"34B0F6D30139"))
		    operations 	(list Operations
			(object Operation "KeyManagementException"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82D008C"
			    documentation 	
|
|     * Constructs a KeyManagementException with no detail message. A
|     * detail message is a String that describes this particular
|     * exception.
|     
			    
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "KeyManagementException"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82D008D"
			    documentation 	
|
|     * Constructs a KeyManagementException with the specified detail
|     * message. A detail message is a String that describes this
|     * particular exception.  
|     *
|     * @param msg the detail message.  
|     
			    
			    parameters 	(list Parameters
				(object Parameter "msg"
				    type       	"String"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
		    module     	"Component View::java::security::KeyManagementException (subprog spec)"
		    quidu      	"34B0F6D30177"
		    language   	"Java")
		(object Class "DigestInputStream"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D30187"
		    documentation 	
| 
| * A transparent stream that updates the associated message digest using 
| * the bits going through the stream. 
| *
| * <p>To complete the message digest computation, call one of the 
| * <code>digest</code> methods on the associated message 
| * digest after your calls to one of this digest input stream's <a href = 
| * "#read()">read</a> methods.
| *      
| * <p>It is possible to turn this stream on or off (see <a href =
| * "#on">on</a>). When it is on, a call to <code>read</code>
| * results in an update on the message digest.  But when it is off,
| * the message digest is not updated. The default is for the stream
| * to be on.
| *
| * <p>Note that digest objects can compute only one digest (see <a
| * href="MessageDigest">MessageDigest</a>),
| * so that in order to compute intermediate digests, a caller should
| * retain a handle onto the digest object, and clone it for each
| * digest to be computed, leaving the orginal digest untouched.
| *
| * @see MessageDigest
| * 
| * @see DigestOutputStream
| *
| * @version 1.25 97/08/30
| * @author Benjamin Renaud 
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B0203"
			    supplier   	"Logical View::java::io::FilterInputStream"
			    quidu      	"34B0F6CE0310"))
		    operations 	(list Operations
			(object Operation "DigestInputStream"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B0225"
			    documentation 	
|
|     * Creates a digest input stream, using the specified input stream
|     * and message digest.
|     *
|     * @param stream the input stream.
|     *
|     * @param digest the message digest to associate with this stream.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "stream"
				    type       	"InputStream")
				(object Parameter "digest"
				    type       	"MessageDigest"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getMessageDigest"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B0228"
			    documentation 	
|
|     * Returns the message digest associated with this stream.
|     *
|     * @return the message digest associated with this stream.
|     
			    
			    result     	"MessageDigest"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "setMessageDigest"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B0229"
			    documentation 	
|
|     * Associates the specified message digest with this stream.
|     *
|     * @param digest the message digest to be associated with this stream.  
|     
			    
			    parameters 	(list Parameters
				(object Parameter "digest"
				    type       	"MessageDigest"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "read"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B022B"
			    documentation 	
|
|     * Reads a byte, and updates the message digest (if the digest
|     * function is on).  That is, this method reads a byte from the
|     * input stream, blocking until the byte is actually read. If the 
|     * digest function is on (see <a href = "#on">on</a>), this method 
|     * will then call <code>update</code> on the message digest associated
|     * with this stream, passing it the byte read. 
|     *
|     * @return the byte read.
|     *
|     * @exception IOException if an I/O error occurs.
|     * 
|     * @see MessageDigest#update(byte) 
|     
			    
			    result     	"int"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "read"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B022C"
			    documentation 	
|
|     * Reads into a byte array, and updates the message digest (if the
|     * digest function is on).  That is, this method reads up to
|     * <code>len</code> bytes from the input stream into the array 
|     * <code>b</code>, starting at offset <code>off</code>. This method 
|     * blocks until the data is actually
|     * read. If the digest function is on (see <a href =
|     * "#on">on</a>), this method will then call <code>update</code>
|     * on the message digest associated with this stream, passing it
|     * the data.
|     *
|     * @param b	the array into which the data is read.
|     *
|     * @param off the starting offset into <code>b</code> of where the 
|     * data should be placed.
|     *
|     * @param len the maximum number of bytes to be read from the input
|     * stream into b, starting at offset <code>off</code>.
|     *
|     * @return  the actual number of bytes read. This is less than 
|     * <code>len</code> if the end of the stream is reached prior to 
|     * reading <code>len</code> bytes. -1 is returned if no bytes were 
|     * read because the end of the stream had already been reached when 
|     * the call was made.
|     *
|     * @exception IOException if an I/O error occurs.
|     * 
|     * @see MessageDigest#update(byte[], int, int) 
|     
			    
			    parameters 	(list Parameters
				(object Parameter "b"
				    type       	"byte[]")
				(object Parameter "off"
				    type       	"int")
				(object Parameter "len"
				    type       	"int"))
			    result     	"int"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "on"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B0235"
			    documentation 	
|
|     * Turns the digest function on or off. The default is on.  When
|     * it is on, a call to <a href = "#read">read</a> results in an
|     * update on the message digest.  But when it is off, the message
|     * digest is not updated.
|     *   
|     * @param on true to turn the digest function on, false to turn
|     * it off.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "on"
				    type       	"boolean"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "toString"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B0237"
			    documentation 	
|
|     * Prints a string representation of this digest input stream and
|     * its associated message digest object.  
|     
			    
			    result     	"String"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
		    class_attributes 	(list class_attribute_list
			(object ClassAttribute "on"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F82B0213"
			    type       	"boolean"
			    initv      	"true"))
