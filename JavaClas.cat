			(object Operation "parse"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F861033A"
			    documentation 	
|
|     * Returns a Long if possible (e.g. within range [Long.MIN_VALUE,
|     * Long.MAX_VALUE], and with no decimals), otherwise a Double.
|     * If IntegerOnly is set, will stop at a decimal
|     * point (or equivalent; e.g. for rational numbers "1 2/3", will stop
|     * after the 1).
|     * Does not throw an exception; if no object can be parsed, index is
|     * unchanged!
|     * @see java.text.NumberFormat#isParseIntegerOnly
|     * @see java.text.Format#parseObject
|     * @return A Long or Double object with the parsed value, or
|     * null if the parse failed.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "text"
				    type       	"String")
				(object Parameter "parsePosition"
				    type       	"ParsePosition"))
			    result     	"Number"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
