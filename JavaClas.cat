			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CE02A2"
		    exportControl 	"Implementation"
		    operations 	(list Operations
			(object Operation "ValidationCallback"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EA0235"
			    parameters 	(list Parameters
				(object Parameter "cb"
				    type       	"ObjectInputValidation")
				(object Parameter "prio"
				    type       	"int"))
			    concurrency 	"Sequential"
