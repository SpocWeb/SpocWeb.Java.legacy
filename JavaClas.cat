			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CD00BE"
		    documentation 	
|
| * This interface corresponds to an applet's environment: the 
| * document containing the applet and the other applets in the same 
| * document. 
| * <p>
| * The methods in this interface can be used by an applet to obtain 
| * information about its environment. 
| *
| * @author 	Arthur van Hoff
| * @version     1.19, 01/30/97
| * @since       JDK1.0
| 
		    
		    stereotype 	"Interface"
		    operations 	(list Operations
			(object Operation "getAudioClip"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7A3008C"
			    documentation 	
|
|     * Creates an audio clip. 
|     *
|     * @param   url   an absolute URL giving the location of the audio clip.
|     * @return  the audio clip at the specified URL.
|     * @since   JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "url"
				    type       	"URL"))
			    result     	"AudioClip"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "getImage"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7A3008E"
			    documentation 	
|
|     * Returns an <code>Image</code> object that can then be painted on 
|     * the screen. The <code>url</code> argument<code> </code>that is 
|     * passed as an argument must specify an absolute URL. 
|     * <p>
|     * This method always returns immediately, whether or not the image 
|     * exists. When the applet attempts to draw the image on the screen, 
|     * the data will be loaded. The graphics primitives that draw the 
|     * image will incrementally paint on the screen. 
|     *
|     * @param   url   an absolute URL giving the location of the image.
|     * @return  the image at the specified URL.
|     * @see     java.awt.Image
|     * @since   JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "url"
				    type       	"URL"))
			    result     	"Image"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "getApplet"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7A30090"
			    documentation 	
|
|     * Finds and returns the applet in the document represented by this 
|     * applet context with the given name. The name can be set in the 
|     * HTML tag by setting the <code>name</code> attribute. 
|     *
|     * @param   name   an applet name.
|     * @return  the applet with the given name, or <code>null</code> if
|     *          not found.
