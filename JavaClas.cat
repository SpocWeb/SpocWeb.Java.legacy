					(object Attribute
					    tool       	"Java"
					    name       	"Static"
					    value      	TRUE))
				    quid       	"34B0F8290237"
				    documentation 	
| 
|     * Export the remote object to make it available to receive incoming calls.
|     * @param obj the remote object to be exported
|     * @exception RemoteException if export fails
|     
				    
				    parameters 	(list Parameters
					(object Parameter "obj"
					    type       	"Remote"))
				    result     	"RemoteStub"
				    exceptions 	"RemoteException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0))
			    module     	"Component View::java::rmi::server::UnicastRemoteObject (subprog spec)"
			    quidu      	"34B0F6D3038A"
			    language   	"Java")
			(object Class "RMISocketFactory"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateFinalizer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateStaticInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateInstanceInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateDefaultConstructor"
				    value      	FALSE))
			    quid       	"34B0F6D3039A"
			    documentation 	
|
| * The RMISocketFactory is used by the RMI runtime in order to obtain
| * client and server sockets for RMI calls. The default implementation
| * of the socket factory performs a three-tiered approach to creating
| * client sockets. First, a direct socket connection to the remote VM
| * is attempted.  If that fails (due to a firewall), the runtime uses
| * HTTP with the explicit port number of the server.  If the firewall
| * does not allow this type of communication, then HTTP to a cgi-bin
| * script on the server is used to POST the RMI call.
| *
| * An application may set the source of sockets for RMI. In this case,
| * the application is responsible for offering up sockets that will
| * penetrate a firewall.
| 
			    
			    operations 	(list Operations
				(object Operation "createSocket"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F827030D"
				    documentation 	
|
|     * Create a client socket connected to the specified host and port.
|     
				    
				    parameters 	(list Parameters
					(object Parameter "host"
					    type       	"String")
					(object Parameter "port"
					    type       	"int"))
				    result     	"Socket"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "createServerSocket"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F8270310"
				    documentation 	
|
|     * Create a server socket on the specified port (port 0 represents
|     * an anonymous port).
|     
				    
				    parameters 	(list Parameters
					(object Parameter "port"
					    type       	"int"))
				    result     	"ServerSocket"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setSocketFactory"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Static"
					    value      	TRUE))
				    quid       	"34B0F8270312"
				    documentation 	
|
|     * Set the socket factory from which RMI gets sockets. The RMI
|     * socket factory can only be set once. Note: The RMISocketFactory
|     * may only be set if the current security manager allows setting
|     * a socket factory; if disallowed, a SecurityException will be
|     * thrown.
|     
				    
				    parameters 	(list Parameters
					(object Parameter "fac"
					    type       	"RMISocketFactory"))
				    result     	"void"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getSocketFactory"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Static"
					    value      	TRUE))
				    quid       	"34B0F8270314"
				    documentation 	
|
|     * Returns the socket factory used by RMI.
|     
				    
				    result     	"RMISocketFactory"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "setFailureHandler"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Static"
					    value      	TRUE))
				    quid       	"34B0F8270315"
				    documentation 	
|
|     * Set the failure handler to be called by the RMI runtime if
|     * socket creation fails.  The default implementation of this
|     * handler returns false (thus recreation of sockets is not
|     * attempted by the runtime).
|     
				    
				    parameters 	(list Parameters
					(object Parameter "fh"
					    type       	"RMIFailureHandler"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getFailureHandler"
				    attributes 	(list Attribute_Set
