			    uid        	0)
			(object Operation "readFloat"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7E602A6"
			    documentation 	
|
|     * Reads a <code>float</code> value from the input stream. 
|     *
|     * @return     the <code>float</code> value read.
