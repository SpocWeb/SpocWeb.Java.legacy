		(object Class "Window"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CD02B3"
		    documentation 	
|
| * A <code>Window</code> object is a top-level window with no borders and no
| * menubar. It could be used to implement a pop-up menu.
| * The default layout for a window is <code>BorderLayout</code>.
| * A <code>Window</code> object blocks input to other application 
| * windows when it is shown.
| * <p>
| * Windows are capable of generating the following window events:
| * WindowOpened, WindowClosed.
| *
| * @version 	1.64, 06/27/97
| * @author 	Sami Shaio
| * @author 	Arthur van Hoff
| * @see WindowEvent
| * @see #addWindowListener
| * @see java.awt.BorderLayout
| * @since       JDK1.0
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7C1031C"
			    supplier   	"Logical View::java::awt::Container"
			    quidu      	"34B0F6CD0292"))
		    operations 	(list Operations
			(object Operation "Window"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7C10371"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "Window"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7C10372"
			    documentation 	
|
|     * Constructs a new invisible window.
|     * <p>
|     * The window is not initially visible. Call the <code>show</code> 
|     * method to cause the window to become visible.
|     * @param     parent   the main application frame.
|     * @see       java.awt.Window#show
|     * @see       java.awt.Component#setSize
|     * @since     JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "parent"
				    type       	"Frame"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "addNotify"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7C10374"
			    documentation 	
|
|     * Creates the Window's peer.  The peer allows us to modify the
|     * appearance of the Window without changing its functionality.
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "pack"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7C10375"
			    documentation 	
|
|     * Causes subcomponents of this window to be laid out at their
|     * preferred size.
|     * @since     JDK1.0
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "show"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7C1037A"
			    documentation 	
|
|     * Shows this window, and brings it to the front.
|     * <p>
|     * If this window is not yet visible, <code>show</code> 
|     * makes it visible. If this window is already visible, 
|     * then this method brings it to the front. 
|     * @see       java.awt.Window#toFront
|     * @see       java.awt.Component#setVisible
|     * @since     JDK1.0
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "postWindowEvent"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7C1037B"
			    parameters 	(list Parameters
				(object Parameter "id"
				    type       	"int"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "dispose"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7C1037D"
			    documentation 	
|
|     * Disposes of this window. This method must
|     * be called to release the resources that
|     * are used for the window.
|     * @since JDK1.0
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "toFront"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7C1037E"
			    documentation 	
|
|     * Brings this window to the front.
|     * Places this window at the top of the stacking order and
|     * shows it in front of any other windows.
|     * @see       java.awt.Window#toBack
|     * @since     JDK1.0
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "toBack"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7C1037F"
			    documentation 	
|
|     * Sends this window to the back.
|     * Places this window at the bottom of the stacking order and
|     * makes the corresponding adjustment to other visible windows.
|     * @see       java.awt.Window#toFront
|     * @since     JDK1.0
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getToolkit"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7C10380"
			    documentation 	
|
|     * Returns the toolkit of this frame.
|     * @return    the toolkit of this window.
|     * @see       java.awt.Toolkit
|     * @see       java.awt.Toolkit#getDefaultToolkit()
|     * @see       java.awt.Component#getToolkit()
|     * @since     JDK1.0
|     
			    
			    result     	"Toolkit"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getWarningString"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE))
			    quid       	"34B0F7C10381"
			    documentation 	
|
|     * Gets the warning string that is displayed with this window. 
|     * If this window is insecure, the warning string is displayed 
|     * somewhere in the visible area of the window. A window is 
|     * insecure if there is a security manager, and the security 
|     * manager's <code>checkTopLevelWindow</code> method returns 
|     * <code>false</code> when this window is passed to it as an
|     * argument.
|     * <p>
|     * If the window is secure, then <code>getWarningString</code>
|     * returns <code>null</code>. If the window is insecure, this
|     * methods checks for the system property 
|     * <code>awt.appletWarning</code> 
|     * and returns the string value of that property. 
|     * @return    the warning string for this window.
|     * @see       java.lang.SecurityManager#checkTopLevelWindow(java.lang.Object)
|     * @since     JDK1.0
|     
			    
			    result     	"String"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getLocale"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7C10382"
			    documentation 	
| 
|     * Gets the <code>Locale</code> object that is associated 
|     * with this window, if the locale has been set.
|     * If no locale has been set, then the default locale 
|     * is returned.
|     * @return    the locale that is set for this window.
|     * @see       java.util.Locale
|     * @since     JDK1.1
|     
			    
			    result     	"Locale"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "addWindowListener"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7C10383"
			    documentation 	
|
|     * Adds the specified window listener to receive window events from
|     * this window.
|     * @param l the window listener
|     
			    
			    parameters 	(list Parameters
				(object Parameter "l"
				    type       	"WindowListener"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "removeWindowListener"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7C10385"
			    documentation 	
|
|     * Removes the specified window listener so that it no longer
|     * receives window events from this window.
|     * @param l the window listener
|     
			    
			    parameters 	(list Parameters
				(object Parameter "l"
				    type       	"WindowListener"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
