|     
			    
			    parameters 	(list Parameters
				(object Parameter "s"
				    type       	"String"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
		    module     	"Component View::java::lang::CloneNotSupportedException (subprog spec)"
		    quidu      	"34B0F6CF0290"
		    language   	"Java")
