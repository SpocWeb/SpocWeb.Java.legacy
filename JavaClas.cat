|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "mod"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81701FA"
			    documentation 	
|
|     * Returns a BigInteger whose value is this mod m. Throws an
|     * ArithmeticException if m <= 0.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "m"
				    type       	"BigInteger"))
			    result     	"BigInteger"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "modPow"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81701FC"
			    documentation 	
|
|     * Returns a BigInteger whose value is (this ** exponent) mod m.  (If
|     * exponent == 1, the returned value is (this mod m).  If exponent < 0,
|     * the returned value is the modular multiplicative inverse of
|     * (this ** -exponent).)  Throws an ArithmeticException if m <= 0.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "exponent"
				    type       	"BigInteger")
				(object Parameter "m"
				    type       	"BigInteger"))
			    result     	"BigInteger"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "modPow2"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81701FF"
			    documentation 	
|
|     * Returns (this ** exponent) mod(2**p)
|     
			    
			    parameters 	(list Parameters
				(object Parameter "exponent"
				    type       	"BigInteger")
				(object Parameter "p"
				    type       	"int"))
			    result     	"BigInteger"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "mod2"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F8170202"
			    documentation 	
|
|     * Returns this mod(2**p).  Assumes that this BigInteger >= 0 and p > 0.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "p"
				    type       	"int"))
			    result     	"BigInteger"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "modInverse"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F8170204"
			    documentation 	
|
|     * Returns modular multiplicative inverse of this, mod m.  Throws an
|     * ArithmeticException if m <= 0 or this has no multiplicative inverse
|     * mod m (i.e., gcd(this, m) != 1).
|     
			    
			    parameters 	(list Parameters
				(object Parameter "m"
				    type       	"BigInteger"))
			    result     	"BigInteger"
			    exceptions 	"ArithmeticException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
