				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F8B4006E"
			    documentation 	
|
|     * Tests if this dictionary maps no keys to value.
|     *
|     * @return  <code>true</code> if this dictionary maps no keys to values;
|     *          <code>false</code> otherwise.
|     * @since   JDK1.0
|     
			    
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
