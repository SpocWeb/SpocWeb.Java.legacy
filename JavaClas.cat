				    type       	"ObjectInputStream"))
			    result     	"void"
			    exceptions 	"ClassNotFoundException,IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0))
		    class_attributes 	(list class_attribute_list
			(object ClassAttribute "vetoableChangeSupportSerializedDataVersion"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
