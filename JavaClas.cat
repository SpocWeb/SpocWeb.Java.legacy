		    documentation 	
|
| * The <code>FileDialog</code> class displays a dialog window 
| * from which the user can select a file. 
| * <p>
| * Since it is a modal dialog, when the application calls 
| * its <code>show</code> method to display the dialog, 
| * it blocks the rest of the application until the user has 
| * chosen a file. 
| *
| * @see Window#show
| *
| * @version 	1.27, 06/12/97
| * @author 	Sami Shaio
| * @author 	Arthur van Hoff
| * @since       JDK1.0
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B301C5"
			    supplier   	"Logical View::java::awt::Dialog"
			    quidu      	"34B0F6CD035C"))
		    operations 	(list Operations
			(object Operation "FileDialog"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B30227"
			    documentation 	
|
|     * Creates a file dialog for loading a file.  The title of the
|     * file dialog is initially empty.
|     * @param parent the owner of the dialog
|     * @since JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "parent"
				    type       	"Frame"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "FileDialog"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B30233"
			    documentation 	
|
|     * Creates a file dialog window with the specified title for loading 
|     * a file. The files shown are those in the current directory. 
|     * @param     parent   the owner of the dialog.
|     * @param     title    the title of the dialog.
|     * @since     JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "parent"
				    type       	"Frame")
				(object Parameter "title"
				    type       	"String"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "FileDialog"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B30236"
			    documentation 	
|
|     * Creates a file dialog window with the specified title for loading 
|     * or saving a file. 
|     * <p>
|     * If the value of <code>mode</code> is <code>LOAD</code>, then the 
|     * file dialog is finding a file to read. If the value of 
|     * <code>mode</code> is <code>SAVE</code>, the file dialog is finding 
|     * a place to write a file. 
|     * @param     parent   the owner of the dialog.
|     * @param     title   the title of the dialog.
|     * @param     mode   the mode of the dialog.
|     * @see       java.awt.FileDialog#LOAD
|     * @see       java.awt.FileDialog#SAVE
|     * @since     JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "parent"
				    type       	"Frame")
				(object Parameter "title"
				    type       	"String")
				(object Parameter "mode"
				    type       	"int"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "addNotify"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B3023A"
			    documentation 	
|
|     * Creates the file dialog's peer.  The peer allows us to change the look
|     * of the file dialog without changing its functionality.
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getMode"
