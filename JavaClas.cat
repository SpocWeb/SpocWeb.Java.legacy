		(object Class "DigestOutputStream"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D301C6"
		    documentation 	
|
| * A transparent stream that updates the associated message digest using 
| * the bits going through the stream.
| *
| * <p>To complete the message digest computation, call one of the 
| * <code>digest</code> methods on the associated message 
| * digest after your calls to one of this digest ouput stream's <a href = 
| * "#write(int)">write</a> methods.
| *      
| * <p>It is possible to turn this stream on or off (see <a href =
| * "#on">on</a>). When it is on, a call to <code>write</code> results in
| * an update on the message digest.  But when it is off, the message 
| * digest is not updated. The default is for the stream to be on.
| *
| * @see MessageDigest
| * @see DigestInputStream
| *
| * @version 1.19 97/08/30
| * @author Benjamin Renaud 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B030D"
			    supplier   	"Logical View::java::io::FilterOutputStream"
			    quidu      	"34B0F6CE030E"))
		    operations 	(list Operations
			(object Operation "DigestOutputStream"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B031F"
			    documentation 	
|
|     * Creates a digest output stream, using the specified output stream
|     * and message digest.
|     *
|     * @param stream the output stream.
|     *
|     * @param digest the message digest to associate with this stream.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "stream"
				    type       	"OutputStream")
				(object Parameter "digest"
				    type       	"MessageDigest"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getMessageDigest"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B0322"
			    documentation 	
|
|     * Returns the message digest associated with this stream.
|     *
|     * @return the message digest associated with this stream.
|     
			    
			    result     	"MessageDigest"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "setMessageDigest"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B0323"
			    documentation 	
|
|     * Associates the specified message digest with this stream.
|     *
|     * @param digest the message digest to be associated with this stream.  
|     
			    
			    parameters 	(list Parameters
				(object Parameter "digest"
				    type       	"MessageDigest"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "write"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B0325"
			    documentation 	
|
|     * Updates the message digest (if the digest function is on) using   
|     * the specified byte, and in any case writes the byte      
|     * to the output stream. That is, if the digest function is on
|     * (see <a href = "#on">on</a>), this method calls
|     * <code>update</code> on the message digest associated with this
|     * stream, passing it the byte <code>b</code>. This method then
|     * writes the byte to the output stream, blocking until the byte 
|     * is actually written.
|     *
|     * @param b the byte to be used for updating and writing to the    
|     * output stream.    
|     *
|     * @exception IOException if an I/O error occurs.
|     * 
|     * @see MessageDigest#update(byte) 
|     
			    
			    parameters 	(list Parameters
				(object Parameter "b"
				    type       	"int"))
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "write"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B0327"
			    documentation 	
|
|     * Updates the message digest (if the digest function is on) using
|     * the specified subarray, and in any case writes the subarray to
|     * the output stream. That is, if the digest function is on (see
|     * <a href = "#on">on</a>), this method calls <code>update</code>
|     * on the message digest associated with this stream, passing it
|     * the subarray specifications. This method then writes the subarray 
|     * bytes to the output stream, blocking until the bytes are actually
|     * written.
|     *
|     * @param b the array containing the subarray to be used for updating 
|     * and writing to the output stream.
|     *
|     * @param off the offset into <code>b</code> of the first byte to 
|     * be updated and written.
|     *
|     * @param len the number of bytes of data to be updated and written 
|     * from <code>b</code>, starting at offset <code>off</code>.
|     *
|     * @exception IOException if an I/O error occurs.
|     * 
|     * @see MessageDigest#update(byte[], int, int)
|     
			    
			    parameters 	(list Parameters
				(object Parameter "b"
				    type       	"byte[]")
				(object Parameter "off"
				    type       	"int")
				(object Parameter "len"
				    type       	"int"))
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "on"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B032F"
			    documentation 	
|
|     * Turns the digest function on or off. The default is on.  When
|     * it is on, a call to <a href = "#write">write</a> results in an
|     * update on the message digest.  But when it is off, the message
|     * digest is not updated.
|     *    
|     * @param on true to turn the digest function on, false to turn it
|     * off. 
|     
			    
			    parameters 	(list Parameters
				(object Parameter "on"
				    type       	"boolean"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "toString"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82B0331"
			    documentation 	
|
|     * Prints a string representation of this digest output stream and
|     * its associated message digest object.  
|     
			    
			    result     	"String"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
		    class_attributes 	(list class_attribute_list
			(object ClassAttribute "on"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F82B030E"
			    type       	"boolean"
			    initv      	"true"))
		    module     	"Component View::java::security::DigestOutputStream (subprog spec)"
		    quidu      	"34B0F6D301C5"
		    language   	"Java")
		(object Class "SeedGenerator"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D301D5"
		    documentation 	
|
| * This class exports a single static method (genSeed) that generates
| * a seed for a cryptographically strong random number generator.  The
| * goal is to provide a seed whose least significant byte is "truly random."
| * The seed is produced by creating a "sleeper thread" that sleeps for a
| * designated time period, and spinning on Thread.yield() while waiting
| * for the sleeper thread to terminate.  The parent thread keeps track of
| * the number of times that it yields, and returns this "spin count"
| * as a seed.  Remarkably, the low order bits of this seed seem to be
| * quite random.
| *
| * @version 1.3, 97/08/30
| * @author Josh Bloch
| 
		    
		    exportControl 	"Implementation"
		    operations 	(list Operations
			(object Operation "setSleepTime"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F835006E"
			    documentation 	
|
|     * This method calculates a sleep time that results in ~55000 thread
|     * yields.  Experimentally, this seems sufficient to generate one random
|     * byte.  Note that this  method (which "performs an experiment")requires
|     * approximately one second to execute.  It is called once when the class
|     * is loaded, and again if the computed sleep time "stops doing its job."
|     * (This will happen if the load on the machine changes drastically.)
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "genSeed"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE)
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F835006F"
			    documentation 	
|
|     * genSeed() - The sole exported method from this class; generates a
|     * random seed, an integer whose last byte is intended to be "truly
|     * random".  (Higher order bits may have some randomness as well.)
|     * This method is synchronized for two reasons: 1) it has the side effect
|     * of maintaining sleepTime, which is a static variable, and 2) having
|     * multiple threads generate seeds concurrently would likely result in
|     * unnecessary (and inefficent) increases in sleepTime.
|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "genSeed"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F8350070"
			    documentation 	
|
|     * Generate a random seed by spinning on thread yield while waiting for
|     * a child thread that sleeps for the designated period of time, in
|     * milliseconds.  The returned seed is the number of times we yield
|     * whilst waiting for the child.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "sleepTime"
				    type       	"int"))
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0))
		    class_attributes 	(list class_attribute_list
			(object ClassAttribute "sleepTime"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F835005D"
			    type       	"int"
			    static     	TRUE)
			(object ClassAttribute "TARGET_SPIN_COUNT"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F835005E"
			    type       	"int"
			    initv      	"55000"
			    static     	TRUE)
			(object ClassAttribute "MIN_SPIN_COUNT"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F835005F"
			    type       	"int"
			    initv      	"/ 10"
			    static     	TRUE)
			(object ClassAttribute "MAX_SPIN_COUNT"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F835006D"
			    type       	"int"
			    initv      	"2 * TARGET_SPIN_COUNT"
			    static     	TRUE))
		    module     	"Component View::java::security::SeedGenerator (subprog spec)"
		    quidu      	"34B0F6D301D4"
		    language   	"Java")
		(object Class "Sleeper"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D301E4"
		    documentation 	
|
| * This helper class exports a "sleeper thread" that sleeps for a designated
| * period (in milliseconds) and terminates.
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F835008C"
			    supplier   	"Logical View::java::lang::Thread"
			    quidu      	"34B0F6CF0204"))
		    exportControl 	"Implementation"
		    operations 	(list Operations
			(object Operation "Sleeper"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F835008E"
			    parameters 	(list Parameters
				(object Parameter "sleepTime"
				    type       	"int"))
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "run"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE))
			    quid       	"34B0F8350090"
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
		    class_attributes 	(list class_attribute_list
			(object ClassAttribute "sleepTime"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F835008D"
