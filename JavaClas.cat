			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D300AC"
		    documentation 	
|
| * <p>A public key.  This interface contains no methods or constants.  It
| * merely serves to group (and provide type safety for) all public key 
| * interfaces. 
| * 
| * Note: The specialized public key interfaces extend this interface.
| * See, for example, the DSAPublicKey interface in
| * <code>java.security.interfaces</code>.
|
| *
| * @see Key
| * @see PublicKey
| * @see Certificate
| * @see Signature#initVerify
| * @see java.security.interfaces.DSAPublicKey
| * 
| * @version 1.16 97/01/17
| 
		    
		    stereotype 	"Interface"
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F8320203"
			    supplier   	"Logical View::java::security::Key"
			    quidu      	"34B0F6D3006E"))
		    module     	"Component View::java::security::PublicKey (subprog spec)"
		    quidu      	"34B0F6D300AB"
		    language   	"Java")
		(object Class "IdentityScope"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D300BC"
		    documentation 	
| 
| * <p>This class represents a scope for identities. It is an Identity 
| * itself, and therefore has a name and can have a scope. It can also 
| * optionally have a public key and associated certificates.
| *
| * <p>An IdentityScope can contain Identity objects of all kinds, including
| * Signers. All types of Identity objects can be retrieved, added, and 
| * removed using the same methods. Note that it is possible, and in fact
| * expected, that different types of identity scopes will
| * apply different policies for their various operations on the
| * various types of Identities.
| *
| * <p>There is a one-to-one mapping between keys and identities, and 
| * there can only be one copy of one key per scope. For example, suppose
| * <b>Acme Software, Inc</b> is a software publisher known to a user.
| * Suppose it is an Identity, that is, it has a public key, and a set of
| * associated certificates. It is named in the scope using the name 
| * "Acme Software". No other named Identity in the scope has the same 
| * public  key. Of course, none has the same name as well.
| *
| * @see Identity
| * @see Signer
| * @see Principal
| * @see Key
| *
| * @version 	1.31, 01/27/97
| * @author Benjamin Renaud 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82C031C"
			    supplier   	"Logical View::java::security::Identity"
			    quidu      	"34B0F6D3007E"))
		    operations 	(list Operations
			(object Operation "initializeSystemScope"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F82C033C"
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "IdentityScope"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82C033D"
			    documentation 	
|
|     * This constructor is used for serialization only and should not
|     * be used by subclasses.
|     
			    
			    concurrency 	"Sequential"
			    opExportControl 	"Protected"
			    uid        	0)
			(object Operation "IdentityScope"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82C033E"
			    documentation 	
|
|     * Constructs a new identity scope with the specified name.
|     *
|     * @param name the scope name.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "name"
				    type       	"String"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "IdentityScope"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82C0340"
			    documentation 	
|
|     * Constructs a new identity scope with the specified name and scope.
|     * 
|     * @param name the scope name.
|     * @param scope the scope for the new identity scope.
|     * 
|     * @exception KeyManagementException if there is already an identity 
|     * with the same name in the scope.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "name"
				    type       	"String")
				(object Parameter "scope"
				    type       	"IdentityScope"))
			    exceptions 	"KeyManagementException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getSystemScope"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F82C0343"
			    documentation 	
|
|     * Returns the system's identity scope. See the
|     * "System Identity Scope" section in the <a href=
|     * "../guide/security/CryptoSpec.html#SysIdScope">
|     * Java Cryptography Architecture API Specification &amp; Reference </a>.
|     * 
|     * @return the system's identity scope.
|     
			    
			    result     	"IdentityScope"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "setSystemScope"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F82C0344"
			    documentation 	
|
|     * Sets the system's identity scope. See the
|     * "System Identity Scope" section in the <a href=
|     * "../guide/security/CryptoSpec.html#SysIdScope">
|     * Java Cryptography Architecture API Specification &amp; Reference </a>.
|     *
|     * @param scope the scope to set.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "scope"
				    type       	"IdentityScope"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Protected"
			    uid        	0)
			(object Operation "size"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F82C0346"
			    documentation 	
|
|     * Returns the number of identities within this identity scope.
|     * 
|     * @return the number of identities within this identity scope.
|     
			    
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getIdentity"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F82C0347"
			    documentation 	
|
|     * Returns the identity in this scope with the specified name (if any).
|     * 
|     * @param name the name of the identity to be retrieved.
|     * 
|     * @return the identity named <code>name</code>, or null if there are
|     * no identities named <code>name</code> in this scope.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "name"
				    type       	"String"))
			    result     	"Identity"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getIdentity"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F82C0349"
			    documentation 	
|
|     * Retrieves the identity whose name is the same as that of the 
|     * specified principal. (Note: Identity implements Principal.)
|     *
|     * @param principal the principal corresponding to the identity
|     * to be retrieved.
|     * 
|     * @return the identity whose name is the same as that of the 
|     * principal, or null if there are no identities of the same name 
|     * in this scope.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "principal"
				    type       	"Principal"))
			    result     	"Identity"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getIdentity"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F82C034C"
			    documentation 	
|
|     * Retrieves the identity with the specified public key.
|     *
|     * @param key the public key for the identity to be returned.
|     *
|     * @return the identity with the given key, or null if there are
|     * no identities in this scope with that key.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "key"
				    type       	"PublicKey"))
			    result     	"Identity"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "addIdentity"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F82C034E"
			    documentation 	
|
|     * Adds an identity to this identity scope.
|     *
|     * @param identity the identity to be added.
|     *
|     * @exception KeyManagementException if the identity is not
|     * valid, a name conflict occurs, another identity has the same
|     * public key as the identity being added, or another exception
|     * occurs. 
			    
			    parameters 	(list Parameters
				(object Parameter "identity"
				    type       	"Identity"))
			    result     	"void"
			    exceptions 	"KeyManagementException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "removeIdentity"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F82C0350"
			    documentation 	
|
|     * Removes an identity from this identity scope.
|     *
|     * @param identity the identity to be removed.
|     *
|     * @exception KeyManagementException if the identity is missing,
|     * or another exception occurs.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "identity"
				    type       	"Identity"))
			    result     	"void"
			    exceptions 	"KeyManagementException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "identities"
