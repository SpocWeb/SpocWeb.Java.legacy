			    quid       	"34B0F817021A"
			    documentation 	
|
|     * Returns a BigInteger whose value is equivalent to this number
|     * with the designated bit flipped.  (Computes (this ^ (1<<n)).)
|     * Throws an ArithmeticException if n < 0.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "n"
				    type       	"int"))
			    result     	"BigInteger"
