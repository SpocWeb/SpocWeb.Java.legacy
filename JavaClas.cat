|     *
|     * @see #parse(String, ParsePosition)
|     
			    
			    parameters 	(list Parameters
				(object Parameter "source"
				    type       	"String")
				(object Parameter "pos"
				    type       	"ParsePosition"))
			    result     	"Object"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
