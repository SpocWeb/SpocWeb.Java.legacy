		    class_attributes 	(list class_attribute_list
			(object ClassAttribute "PRIMARY"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8460001"
			    documentation 	
|
|     * Collator strength value.  When set, only PRIMARY differences are
|     * considered significant during comparison. The assignment of strengths
|     * to language features is locale dependant. A common example is for
|     * different base letters ("a" vs "b") to be considered a PRIMARY difference.
|     * @see java.text.Collator#setStrength
|     * @see java.text.Collator#getStrength
|     
			    
			    type       	"int"
			    initv      	"0"
			    exportControl 	"Public"
			    static     	TRUE)
			(object ClassAttribute "SECONDARY"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8460002"
			    documentation 	
|
|     * Collator strength value.  When set, only SECONDARY and above differences are
|     * considered significant during comparison. The assignment of strengths
|     * to language features is locale dependant. A common example is for
|     * different accented forms of the same base letter ("a" vs "\u00E4") to be
|     * considered a SECONDARY difference.
|     * @see java.text.Collator#setStrength
|     * @see java.text.Collator#getStrength
|     
			    
			    type       	"int"
			    initv      	"1"
			    exportControl 	"Public"
			    static     	TRUE)
			(object ClassAttribute "TERTIARY"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8460003"
			    documentation 	
|
|     * Collator strength value.  When set, only TERTIARY and above differences are
|     * considered significant during comparison. The assignment of strengths
|     * to language features is locale dependant. A common example is for
|     * case differences ("a" vs "A") to be considered a TERTIARY difference.
|     * @see java.text.Collator#setStrength
|     * @see java.text.Collator#getStrength
|     
			    
			    type       	"int"
			    initv      	"2"
			    exportControl 	"Public"
			    static     	TRUE)
			(object ClassAttribute "IDENTICAL"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F846000F"
			    documentation 	
|
|     * Collator strength value.  When set, all differences are
|     * considered significant during comparison. The assignment of strengths
|     * to language features is locale dependant. A common example is for characters
|     * with equivalent Unicode spellings ("\u00E4" vs "a\u0308") to be considered IDENTICAL.
|     
			    
			    type       	"int"
			    initv      	"3"
			    exportControl 	"Public"
			    static     	TRUE)
			(object ClassAttribute "NO_DECOMPOSITION"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8460010"
			    documentation 	
|
|     * Decomposition mode value. With NO_DECOMPOSITION
|     * set, accented characters will not be decomposed for collation. This
|     * provides the fastest collation but will only produce correct results
|     * for languages that do not use accents.
|     * @see java.text.Collator#getDecomposition
|     * @see java.text.Collator#setDecomposition
|     
			    
			    type       	"int"
			    initv      	"0"
			    exportControl 	"Public"
			    static     	TRUE)
			(object ClassAttribute "CANONICAL_DECOMPOSITION"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8460011"
			    documentation 	
|
|     * Decomposition mode value. With CANONICAL_DECOMPOSITION
|     * set, characters that are canonical variants according to Unicode 2.0
|     * will be decomposed for collation. This is the default setting and
|     * should be used to get correct collation of accented characters.
|     * @see java.text.Collator#getDecomposition
|     * @see java.text.Collator#setDecomposition
|     
			    
			    type       	"int"
			    initv      	"1"
			    exportControl 	"Public"
			    static     	TRUE)
			(object ClassAttribute "FULL_DECOMPOSITION"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Final"
				    value      	TRUE)
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8460012"
			    documentation 	
|
|     * Decomposition mode value. With FULL_DECOMPOSITION
|     * set, both Unicode canonical variants and Unicode compatibility variants
|     * will be decomposed for collation.  This causes not only accented
|     * characters to be collated, but also characters that have special formats
|     * to be collated with their norminal form. For example, the half-width and
|     * full-width ASCII and Katakana characters are then collated together.
|     * FULL_DECOMPOSITION is the most complete and therefore the slowest
|     * decomposition mode.
|     * @see java.text.Collator#getDecomposition
|     * @see java.text.Collator#setDecomposition
|     
			    
			    type       	"int"
			    initv      	"2"
			    exportControl 	"Public"
			    static     	TRUE)
