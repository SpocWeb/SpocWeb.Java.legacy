			    uid        	0))
		    class_attributes 	(list class_attribute_list
			(object ClassAttribute "bytesTransferred"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F7E803AA"
			    documentation 	
