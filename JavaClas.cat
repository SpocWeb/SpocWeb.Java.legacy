				    type       	"String")
				(object Parameter "parameterTypes"
				    type       	"Class[]"))
			    result     	"Method"
			    exceptions 	"NoSuchMethodException,SecurityException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
