			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CD035C"
		    documentation 	
|
| * A class that produces a dialog - a window that takes input from the user.
| * The default layout for a dialog is BorderLayout.
| * <p>
| * Dialogs are capable of generating the following window events:
| * WindowOpened, WindowClosing, WindowClosed, WindowActivated, WindowDeactivated.
| * @see WindowEvent
| * @see Window#addWindowListener
| *
| * @version 	1.36, 06/12/97
| * @author 	Sami Shaio
| * @author 	Arthur van Hoff
| * @since       JDK1.0
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B10138"
			    supplier   	"Logical View::java::awt::Window"
			    quidu      	"34B0F6CD02B3"))
		    operations 	(list Operations
			(object Operation "Dialog"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B10169"
			    documentation 	
|
|     * Constructs an initially invisible Dialog with an empty title.
|     * @param parent the owner of the dialog
|     * @see Component#setSize
|     * @see Component#setVisible
|     * @since JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "parent"
				    type       	"Frame"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "Dialog"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B1016B"
			    documentation 	
|
|     * Constructs an initially invisible Dialog with an empty title.
|     * A modal Dialog grabs all the input to the parent frame from the user.
|     * @param parent the owner of the dialog
|     * @param modal if true, dialog blocks input to the parent window when shown
|     
			    
			    parameters 	(list Parameters
				(object Parameter "parent"
				    type       	"Frame")
				(object Parameter "modal"
				    type       	"boolean"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "Dialog"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B1016E"
			    documentation 	
|
|     * Constructs an initially invisible Dialog with a title. 
|     * @param parent the owner of the dialog
|     * @param title the title of the dialog
|     * @see Component#setSize
|     * @see Component#setVisible
|     * @since JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "parent"
				    type       	"Frame")
				(object Parameter "title"
				    type       	"String"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "Dialog"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B10171"
			    documentation 	
|
|     * Constructs an initially invisible Dialog with a title. 
|     * A modal Dialog grabs all the input to the parent frame from the user.
|     * @param parent the owner of the dialog
|     * @param title the title of the dialog
|     * @param modal if true, dialog blocks input to the parent window when shown
|     * @see Component#setSize
|     * @see Component#setVisible
|     * @since JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "parent"
				    type       	"Frame")
				(object Parameter "title"
				    type       	"String")
				(object Parameter "modal"
				    type       	"boolean"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "addNotify"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B10175"
			    documentation 	
|
|     * Creates the dialog's peer.  The peer allows us to change the appearance
|     * of the frame without changing its functionality.
|     * @since JDK1.0
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "isModal"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B10176"
			    documentation 	
|
|     * Indicates whether the dialog is modal.  
|     * A modal dialog grabs all input from the user.
|     * @return    <code>true</code> if this dialog window is modal; 
|     *            <code>false</code> otherwise. 
|     * @see       java.awt.Dialog#setModal    
|     * @since     JDK1.0
|     
			    
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "setModal"
