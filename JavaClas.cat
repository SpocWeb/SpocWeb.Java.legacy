				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getWhen"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C60069"
				    documentation 	
|
|     * Returns the timestamp of when this event occurred.
|     
				    
				    result     	"long"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
