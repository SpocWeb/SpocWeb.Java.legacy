			(object Operation "readLine"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7E602A8"
			    documentation 	
|
|     * Reads the next line of text from the input stream. 
|     *
|     * @return     if this stream reaches the end before reading all the bytes.
|     * @exception  IOException  if an I/O error occurs.
|     * @since      JDK1.0
|     
			    
			    result     	"String"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "readUTF"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7E602AF"
			    documentation 	
|
|     * Reads in a string that has been encoded using a modified UTF-8 format.
|     * <p>
|     * For an exact description of this method, see the discussion in 
|     * Gosling, Joy, and Steele, <i>The Java Language Specification</i>. 
|     *
|     * @return     a Unicode string.
|     * @exception  EOFException            if this stream reaches the end
|     *               before reading all the bytes.
|     * @exception  IOException             if an I/O error occurs.
|     * @exception  UTFDataFormatException  if the bytes do not represent a
|     *               valid UTF-8 encoding of a string.
|     * @since      JDK1.0
|     
			    
			    result     	"String"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0))
		    module     	"Component View::java::io::DataInput (subprog spec)"
		    quidu      	"34B0F6CE03C8"
		    language   	"Java")
		(object Class "Reader"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CE03D8"
		    documentation 	
|
| * Abstract class for reading character streams.  The only methods that a
| * subclass must implement are read(char[], int, int) and close().  Most
| * subclasses, however, will override some of the methods defined here in order
| * to provide higher efficiency, additional functionality, or both.
| *
| * 
| * @see BufferedReader
| * @see   LineNumberReader
| * @see CharArrayReader
| * @see InputStreamReader
| * @see   FileReader
| * @see FilterReader
| * @see   PushbackReader
| * @see PipedReader
| * @see StringReader
| * @see Writer
| *
| * @version 	1.8, 97/01/27
| * @author	Mark Reinhold
| * @since	JDK1.1
| 
		    
		    operations 	(list Operations
			(object Operation "Reader"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EE0033"
			    documentation 	
|
|     * Create a new character-stream reader whose critical sections will
|     * synchronize on the reader itself.
|     
			    
			    concurrency 	"Sequential"
			    opExportControl 	"Protected"
			    uid        	0)
			(object Operation "Reader"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EE0034"
			    documentation 	
|
|     * Create a new character-stream reader whose critical sections will
|     * synchronize on the given object.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "lock"
				    type       	"Object"))
			    concurrency 	"Sequential"
			    opExportControl 	"Protected"
			    uid        	0)
			(object Operation "read"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EE0036"
			    documentation 	
|
|     * Read a single character.  This method will block until a character is
|     * available, an I/O error occurs, or the end of the stream is reached.
|     *
|     * <p> Subclasses that intend to support efficient single-character input
|     * should override this method.
|     *
|     * @return     The character read, as an integer in the range 0 to 16383
|     *             (<tt>0x00-0xffff</tt>), or -1 if the end of the stream has
|     *             been reached
|     *
|     * @exception  IOException  If an I/O error occurs
|     
			    
			    result     	"int"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "read"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EE0037"
			    documentation 	
|
|     * Read characters into an array.  This method will block until some input
|     * is available, an I/O error occurs, or the end of the stream is reached.
|     *
|     * @param       cbuf  Destination buffer
|     *
|     * @return      The number of bytes read, or -1 if the end of the stream
|     *              has been reached
|     *
|     * @exception   IOException  If an I/O error occurs
|     
			    
			    parameters 	(list Parameters
				(object Parameter "cbuf[]"
				    type       	"char"))
			    result     	"int"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "read"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7EE0039"
			    documentation 	
|
|     * Read characters into a portion of an array.  This method will block
|     * until some input is available, an I/O error occurs, or the end of the
|     * stream is reached.
|     *
|     * @param      cbuf  Destination buffer
|     * @param      off   Offset at which to start storing characters
|     * @param      len   Maximum number of characters to read
|     *
|     * @return     The number of characters read, or -1 if the end of the
|     *             stream has been reached
|     *
|     * @exception  IOException  If an I/O error occurs
|     
			    
			    parameters 	(list Parameters
				(object Parameter "cbuf[]"
				    type       	"char")
				(object Parameter "off"
				    type       	"int")
				(object Parameter "len"
				    type       	"int"))
			    result     	"int"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "skip"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EE003E"
			    documentation 	
|
|     * Skip characters.  This method will block until some characters are
|     * available, an I/O error occurs, or the end of the stream is reached.
|     *
|     * @param  n  The number of characters to skip
|     *
|     * @return    The number of characters actually skipped
|     *
|     * @exception  IOException  If an I/O error occurs
|     
			    
			    parameters 	(list Parameters
				(object Parameter "n"
				    type       	"long"))
			    result     	"long"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "ready"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EE0040"
			    documentation 	
|
|     * Tell whether this stream is ready to be read.
|     *
|     * @return True if the next read() is guaranteed not to block for input,
|     * false otherwise.  Note that returning false does not guarantee that the
|     * next read will block.
|     *
|     * @exception  IOException  If an I/O error occurs
|     
			    
			    result     	"boolean"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "markSupported"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EE0041"
			    documentation 	
|
|     * Tell whether this stream supports the mark() operation.
|     
			    
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "mark"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EE0042"
			    documentation 	
|
|     * Mark the present position in the stream.  Subsequent calls to reset()
|     * will attempt to reposition the stream to this point.  Not all
|     * character-input streams support the mark() operation.
|     *
|     * @param  readAheadLimit  Limit on the number of characters that may be
|     *                         read while still preserving the mark.  After
|     *                         reading this many characters, attempting to
|     *                         reset the stream may fail.
|     *
|     * @exception  IOException  If the stream does not support mark(),
|     *                          or if some other I/O error occurs
|     
			    
			    parameters 	(list Parameters
				(object Parameter "readAheadLimit"
				    type       	"int"))
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "reset"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EE0044"
			    documentation 	
|
|     * Reset the stream.  If the stream has been marked, then attempt to
|     * reposition it at the mark.  If the stream has not been marked, then
|     * attempt to reset it in some way appropriate to the particular stream,
|     * for example by repositioning it to its starting point.  Not all
|     * character-input streams support the reset() operation, and some support
|     * reset() without supporting mark().
|     *
|     * @exception  IOException  If the stream has not been marked,
|     *                          or if the mark has been invalidated,
|     *                          or if the stream does not support reset(),
|     *                          or if some other I/O error occurs
|     
			    
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "close"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7EE0045"
			    documentation 	
|
|     * Close the stream.  Once a stream has been closed, further read(),
|     * ready(), mark(), or reset() invocations will throw an IOException.
|     * Closing a previously-closed stream, however, has no effect.
|     *
|     * @exception  IOException  If an I/O error occurs
|     
			    
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
