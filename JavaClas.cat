			    documentation 	
|
|     * Returns true if the specified number is the special Not-a-Number (NaN)
|     * value.
|     *
|     * @param   v   the value to be tested.
|     * @return  <code>true</code> if the value of the argument is NaN;
|     *          <code>false</code> otherwise.
|     * @since   JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "v"
				    type       	"double"))
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "isInfinite"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F80A004F"
			    documentation 	
|
|     * Returns true if the specified number is infinitely large in magnitude.
|     *
|     * @param   v   the value to be tested.
|     * @return  <code>true</code> if the value of the argument is positive
|     *          infinity or negative infinity; <code>false</code> otherwise.
|     * @since   JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "v"
				    type       	"double"))
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "Double"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F80A0051"
			    documentation 	
|
|     * Constructs a newly allocated <code>Double</code> object that 
|     * represents the primitive <code>double</code> argument. 
|     *
|     * @param   value   the value to be represented by the <code>Double</code>.
|     * @since   JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "value"
				    type       	"double"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "Double"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F80A0053"
			    documentation 	
|
|     * Constructs a newly allocated <code>Double</code> object that 
|     * represents the floating- point value of type <code>double</code> 
|     * represented by the string. The string is converted to a 
|     * <code>double</code> value as if by the <code>valueOf</code> method. 
|     *
|     * @param      s   a string to be converted to a <code>Double</code>.
|     * @exception  NumberFormatException  if the string does not contain a
|     *               parsable number.
|     * @see        java.lang.Double#valueOf(java.lang.String)
|     * @since      JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "s"
				    type       	"String"))
			    exceptions 	"NumberFormatException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "isNaN"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F80A0055"
			    documentation 	
|
|     * Returns true if this Double value is the special Not-a-Number (NaN)
|     * value.
|     *
|     * @return  <code>true</code> if the value represented by this object is
|     *          NaN; <code>false</code> otherwise.
|     * @since   JDK1.0
|     
			    
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "isInfinite"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F80A0056"
			    documentation 	
|
|     * Returns true if this Double value is infinitely large in magnitude.
|     *
|     * @return  <code>true</code> if the value represented by this object is
|     *          positive infinity or negative infinity;
|     *          <code>false</code> otherwise.
|     * @since   JDK1.0
|     
			    
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "toString"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F80A0057"
			    documentation 	
|
|     * Returns a String representation of this Double object.
|     * The primitive <code>double</code> value represented by this 
|     * object is converted to a string exactly as if by the method 
|     * <code>toString</code> of one argument. 
|     *
|     * @return  a <code>String</code> representation of this object.
|     * @see     java.lang.Double#toString(double)
|     * @since   JDK1.0
|     
			    
			    result     	"String"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "byteValue"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F80A0058"
			    documentation 	
|
|     * Returns the value of this Double as a byte (by casting to a byte).
|     *
|     * @since   JDK1.1
|     
			    
			    result     	"byte"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "shortValue"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F80A0059"
