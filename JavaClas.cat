			(object Class "RGBImageFilter"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateFinalizer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateStaticInitializer"
