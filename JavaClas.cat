			    documentation 	
|
|     * @since   JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "ibuf"
				    type       	"byte[]"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "setLength"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F81803AC"
			    documentation 	
|
|     * @since   JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "ilength"
				    type       	"int"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
		    class_attributes 	(list class_attribute_list
			(object ClassAttribute "buf[]"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F818037A"
			    type       	"byte"
			    exportControl 	"Implementation")
			(object ClassAttribute "length"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F818037B"
			    type       	"int"
			    exportControl 	"Implementation")
			(object ClassAttribute "port"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F8180399"
			    type       	"int"
			    exportControl 	"Implementation"))
		    module     	"Component View::java::net::DatagramPacket (subprog spec)"
		    quidu      	"34B0F6CE00CB"
		    language   	"Java")
		(object Class "MulticastSocket"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CE00CE"
		    documentation 	
|
| * The multicast datagram socket class is useful for sending
| * and receiving IP multicast packets.  A MulticastSocket is
| * a (UDP) DatagramSocket, with additional capabilities for
| * joining "groups" of other multicast hosts on the internet.
| * <P>
| * A multicast group is specified by a class D IP address, those
| * in the range <CODE>224.0.0.1</CODE> to <CODE>239.255.255.255</CODE>, 
| * inclusive, and by a standard UDP port number.  One would join a 
| * multicast group by first creating a MulticastSocket with the desired
| * port, then invoking the <CODE>joinGroup(InetAddress groupAddr)</CODE>
| * method:
| * <PRE>
| * // join a Multicast group and send the group salutations
| * ...
| * byte[] msg = {'H', 'e', 'l', 'l', 'o'};
| * InetAddress group = InetAddress.getByName("228.5.6.7");
| * MulticastSocket s = new MulticastSocket(6789);
| * s.joinGroup(group);
| * DatagramPacket hi = new DatagramPacket(msg, msg.length,
| *                             group, 6789);
| * s.send(hi);
| * // get their responses! 
| * byte[] buf = new byte[1000];
| * DatagramPacket recv = new DatagramPacket(buf, buf.length);
| * s.receive(recv);
| * ...
| * // OK, I'm done talking - leave the group...
| * s.leaveGroup(group);
| * </PRE>
| * 
| * When one sends a message to a multicast group, <B>all</B> subscribing
| * recipients to that host and port receive the message (within the
| * time-to-live range of the packet, see below).  The socket needn't
| * be a member of the multicast group to send messages to it.
| * <P>
| * When a socket subscribes to a multicast group/port, it receives
| * datagrams sent by other hosts to the group/port, as do all other
| * members of the group and port.  A socket relinquishes membership
| * in a group by the leaveGroup(InetAddress addr) method.  <B> 
| * Multiple MulticastSocket's</B> may subscribe to a multicast group
| * and port concurrently, and they will all receive group datagrams.
| * <P>
| * Currently applets are not allowed ot use multicast sockets.
| *
| * @author Pavani Diwanji
| * @since  JDK1.1
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81A008C"
			    supplier   	"Logical View::java::net::DatagramSocket"
			    quidu      	"34B0F6CE00BD"))
		    operations 	(list Operations
			(object Operation "MulticastSocket"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81A009C"
			    documentation 	
|
|     * Create a multicast socket.
|     * @since   JDK1.1
|     
			    
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "MulticastSocket"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81A009D"
			    documentation 	
|
|     * Create a multicast socket and bind it to a specific port.
|     * @param local port to use
|     * @since   JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "port"
				    type       	"int"))
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "create"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81A009F"
			    parameters 	(list Parameters
				(object Parameter "port"
				    type       	"int")
				(object Parameter "ignore"
				    type       	"InetAddress"))
			    result     	"void"
			    exceptions 	"SocketException"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "setTTL"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81A00A2"
			    documentation 	
|
|     * Set the default time-to-live for multicast packets sent out
|     * on this socket.  The TTL sets the IP time-to-live for
|     * <code>DatagramPackets</code> sent to a MulticastGroup, which
|     * specifies how many "hops" that the packet will be forwarded
|     * on the network before it expires.
|     * <P>
|     * The ttl is an <b>unsigned</b> 8-bit quantity, and so <B>must</B> be
|     * in the range <code> 0 < ttl <= 0xFF </code>.
|     * @param ttl the time-to-live
|     * @since   JDK1.1
|     
			    
