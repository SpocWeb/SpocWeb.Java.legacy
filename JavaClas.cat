|     * @return the private key.
|     
			    
			    result     	"PrivateKey"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
		    module     	"Component View::java::security::KeyPair (subprog spec)"
		    quidu      	"34B0F6D30196"
		    language   	"Java")
		(object Class "NoSuchAlgorithmException"
