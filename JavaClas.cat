				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F83D0317"
			    documentation 	
|
|     * After this call, getWarnings returns null until a new warning is
|     * reported for this Statement.  
|     *
|     * @exception SQLException if a database-access error occurs.
|     
			    
			    result     	"void"
			    exceptions 	"SQLException"
			    concurrency 	"Sequential"
