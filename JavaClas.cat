			(object Class "InflaterInputStream"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateFinalizer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateStaticInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateInstanceInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateDefaultConstructor"
				    value      	FALSE))
			    quid       	"34B0F6CE0139"
			    documentation 	
|
| * This class implements a stream filter for uncompressing data in the
| * "deflate" compression format. It is also used as the basis for other
| * decompression filters, such as GZIPInputStream.
| *
| * @see		Inflater
| * @version 	1.15, 01/27/97
| * @author 	David Connelly
| 
			    
			    superclasses 	(list inheritance_relationship_list
				(object Inheritance_Relationship
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE0242"
				    supplier   	"Logical View::java::io::FilterInputStream"
				    quidu      	"34B0F6CE0310"))
			    operations 	(list Operations
				(object Operation "InflaterInputStream"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE0266"
				    documentation 	
|
|     * Creates a new input stream with the specified decompressor and
|     * buffer size.
|     * @param in the input stream
|     * @param inf the decompressor ("inflater")
|     * @param len the input buffer size
|     
				    
				    parameters 	(list Parameters
					(object Parameter "in"
					    type       	"InputStream")
					(object Parameter "inf"
					    type       	"Inflater")
					(object Parameter "size"
					    type       	"int"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "InflaterInputStream"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE026A"
				    documentation 	
|
|     * Creates a new input stream with the specified decompressor and a
|     * default buffer size.
|     * @param in the input stream
|     * @param inf the decompressor ("inflater")
|     
				    
				    parameters 	(list Parameters
					(object Parameter "in"
					    type       	"InputStream")
					(object Parameter "inf"
					    type       	"Inflater"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "InflaterInputStream"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE026D"
				    documentation 	
|
|     * Creates a new input stream with a default decompressor and buffer size.
|     
				    
				    parameters 	(list Parameters
					(object Parameter "in"
					    type       	"InputStream"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "read"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE026F"
				    documentation 	
|
|     * Reads a byte of uncompressed data. This method will block until
|     * enough input is available for decompression.
|     * @return the byte read, or -1 if end of compressed input is reached
|     * @exception IOException if an I/O error has occurred
|     
				    
				    result     	"int"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "read"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE0271"
				    documentation 	
|
|     * Reads uncompressed data into an array of bytes. This method will
|     * block until some input can be decompressed.
|     * @param b the buffer into which the data is read
|     * @param off the start offset of the data
|     * @param len the maximum number of bytes read
|     * @return the actual number of bytes read, or -1 if the end of the
|     *         compressed input is reached or a preset dictionary is needed
|     * @exception ZipException if a ZIP format error has occurred
|     * @exception IOException if an I/O error has occurred
|     
				    
				    parameters 	(list Parameters
					(object Parameter "b"
					    type       	"byte[]")
					(object Parameter "off"
					    type       	"int")
					(object Parameter "len"
					    type       	"int"))
				    result     	"int"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "skip"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE0275"
				    documentation 	
|
|     * Skips specified number of bytes of uncompressed data.
|     * @param n the number of bytes to skip
|     * @return the actual number of bytes skipped.
|     * @exception IOException if an I/O error has occurred
|     
				    
				    parameters 	(list Parameters
					(object Parameter "n"
					    type       	"long"))
				    result     	"long"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "fill"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F8BE0277"
				    documentation 	
|
|     * Fills input buffer with more data to decompress.
|     * @exception IOException if an I/O error has occurred
|     
				    
				    result     	"void"
				    exceptions 	"IOException"
				    concurrency 	"Sequential"
				    opExportControl 	"Protected"
				    uid        	0))
			    class_attributes 	(list class_attribute_list
				(object ClassAttribute "buf[]"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"ERwin"
					    name       	"Data Type"
					    value      	("DataTypeEnum" 1)))
				    quid       	"34B0F8BE0264"
				    documentation 	
|
|     * Input buffer for decompression.
|     
				    
				    type       	"byte"
				    exportControl 	"Protected")
