			(object Class "InputEvent"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateFinalizer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateStaticInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateInstanceInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateDefaultConstructor"
				    value      	FALSE))
			    quid       	"34B0F6CD015A"
			    documentation 	
|
| * The root event class for all component-level input events.
| *
| * Input events are delivered to listeners before they are
| * processed normally by the source where they originated.
| * This allows listeners and component subclasses to "consume"
| * the event so that the source will not process them in their
| * default manner.  For example, consuming mousePressed events
| * on a Button component will prevent the Button from being
| * activated.
| *
| * @version 1.11 01/30/97
| * @author Carl Quinn
| 
			    
			    superclasses 	(list inheritance_relationship_list
				(object Inheritance_Relationship
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C6004E"
				    supplier   	"Logical View::java::awt::event::ComponentEvent"
				    quidu      	"34B0F6CD015C"))
			    operations 	(list Operations
				(object Operation "InputEvent"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C60060"
				    documentation 	
|
|     * Constructs an InputEvent object with the specified source component,
|     * modifiers, and type.
|     * @param source the object where the event originated
|     * @id the event type
|     * @when the time the event occurred
|     * @modifiers the modifier keys down while event occurred
|     
				    
				    parameters 	(list Parameters
					(object Parameter "source"
					    type       	"Component")
					(object Parameter "id"
					    type       	"int")
					(object Parameter "when"
					    type       	"long")
					(object Parameter "modifiers"
					    type       	"int"))
				    concurrency 	"Sequential"
				    opExportControl 	"Implementation"
				    uid        	0)
				(object Operation "isShiftDown"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C60065"
				    documentation 	
|
|     * Returns whether or not the Shift modifier is down on this event.
|     
				    
				    result     	"boolean"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "isControlDown"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C60066"
				    documentation 	
|
|     * Returns whether or not the Control modifier is down on this event.
|     
				    
				    result     	"boolean"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "isMetaDown"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C60067"
				    documentation 	
|
|     * Returns whether or not the Meta modifier is down on this event.
|     
				    
