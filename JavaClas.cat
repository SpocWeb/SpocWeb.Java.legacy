|     *
|     * @param ts the Timestamp value to compare with
|     
			    
			    parameters 	(list Parameters
				(object Parameter "ts"
				    type       	"Timestamp"))
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
