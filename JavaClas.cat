			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "EventQueue"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7B300EA"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "postEvent"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7B300EB"
			    documentation 	
|
|     * Post a 1.1-style event to the EventQueue.
|     *
|     * @param theEvent an instance of java.awt.AWTEvent, or a
|     * subclass of it.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "theEvent"
				    type       	"AWTEvent"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getNextEvent"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7B300ED"
			    documentation 	
|
|     * Remove an event from the queue and return it.  This method will
|     * block until an event has been posted by another thread.
|     * @return the next AWTEvent
|     * @exception InterruptedException 
|     *            if another thread has interrupted this thread.
|     
			    
			    result     	"AWTEvent"
			    exceptions 	"InterruptedException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "peekEvent"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7B300EE"
			    documentation 	
|
|     * Return the first event without removing it.
|     * @return the first event, which is either an instance of java.awt.Event
|     * or java.awt.AWTEvent.
|     
			    
			    result     	"AWTEvent"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
