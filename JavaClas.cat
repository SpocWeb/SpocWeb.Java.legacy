		(object Class "Visibility"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D50020"
		    documentation 	
|
| * Under some circumstances a bean may be run on servers where a GUI
| * is not available.  This interface can be used to query a bean to
| * determine whether it absolutely needs a gui, and to advise the
| * bean whether a GUI is available.
| * <p>
| * This interface is for expert developers, and is not needed
| * for normal simple beans.  To avoid confusing end-users we
| * avoid using getXXX setXXX design patterns for these methods.
| 
		    
		    stereotype 	"Interface"
		    operations 	(list Operations
			(object Operation "needsGui"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7E40213"
			    documentation 	
|
|     * @return True if the bean absolutely needs a GUI available in
|     *		order to get its work done.
|     
			    
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "dontUseGui"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7E40222"
			    documentation 	
|
|     * This method instructs the bean that it should not use the Gui.
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "okToUseGui"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7E40223"
			    documentation 	
|
|     * This method instructs the bean that it is OK to use the Gui.
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "avoidingGui"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7E40224"
			    documentation 	
|
|     * @return true if the bean is currently avoiding use of the Gui.
|     *   e.g. due to a call on dontUseGui().
|     
			    
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0))
		    module     	"Component View::java::beans::Visibility (subprog spec)"
		    quidu      	"34B0F6D5001F"
		    language   	"Java")
		(object Class "PropertyEditorManager"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6D5002F"
		    documentation 	
|
| * The PropertyEditorManager can be used to locate a property editor for
| * any given type name.  This property editor must support the
| * java.beans.PropertyEditor interface for editing a given object.
| * <P>
| * The PropertyEditorManager uses three techniques for locating an editor
| * for a given type.  First, it provides a registerEditor method to allow
| * an editor to be specifically registered for a given type.  Second it
| * tries to locate a suitable class by adding "Editor" to the full 
| * qualified classname of the given type (e.g. "foo.bah.FozEditor").
| * Finally it takes the simple classname (without the package name) adds
| * "Editor" to it and looks in a search-path of packages for a matching
| * class.
| * <P>
| * So for an input class foo.bah.Fred, the PropertyEditorManager would
| * first look in its tables to see if an editor had been registered for
| * foo.bah.Fred and if so use that.  Then it will look for a
| * foo.bah.FredEditor class.  Then it will look for (say) 
| * standardEditorsPackage.FredEditor class.
| * <p>
| * Default PropertyEditors will be provided for the Java builtin types
| * "boolean", "byte", "short", "int", "long", "float", and "double"; and
| * for the classes java.lang.String. java.awt.Color, and java.awt.Font.
| 
		    
		    operations 	(list Operations
			(object Operation "registerEditor"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F7E3038D"
			    documentation 	
|
|     * Register an editor class to be used to editor values of
|     * a given target class.
|     * @param targetType the Class object of the type to be edited
|     * @param editorClass the Class object of the editor class.  If
|     *	   this is null, then any existing definition will be removed.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "targetType"
				    type       	"Class")
				(object Parameter "editorClass"
				    type       	"Class"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "findEditor"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F7E30390"
			    documentation 	
|
|     * Locate a value editor for a given target type.
|     * @param targetType  The Class object for the type to be edited
|     * @return An editor object for the given target class. 
|     * The result is null if no suitable editor can be found.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "targetType"
				    type       	"Class"))
			    result     	"PropertyEditor"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "instantiate"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F7E30392"
			    parameters 	(list Parameters
				(object Parameter "sibling"
				    type       	"Class")
				(object Parameter "className"
				    type       	"String"))
			    result     	"PropertyEditor"
			    exceptions 	"InstantiationException,IllegalAccessException,ClassNotFoundException"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "getEditorSearchPath"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F7E30395"
			    documentation 	
|
|     * @return  The array of package names that will be searched in
|     *		order to find property editors.
|     * <p>     This is initially set to {"sun.beans.editors"}.
|     
			    
			    result     	"String[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "setEditorSearchPath"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F7E30396"
			    documentation 	
|
|     * Change the list of package names that will be used for
|     *		finding property editors.
|     * @param path  Array of package names.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "path[]"
				    type       	"String"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "load"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE))
			    quid       	"34B0F7E30398"
			    parameters 	(list Parameters
				(object Parameter "targetType"
				    type       	"Class")
				(object Parameter "name"
				    type       	"String"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "initialize"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Static"
				    value      	TRUE)
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7E3039B"
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0))
		    module     	"Component View::java::beans::PropertyEditorManager (subprog spec)"
		    quidu      	"34B0F6D5002E"
		    language   	"Java")
