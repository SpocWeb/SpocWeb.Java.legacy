			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CF0291"
		    documentation 	
|
| * Thrown to indicate that the <code>clone</code> method in class 
| * <code>Object</code> has been called to clone an object, but that 
| * the object's class does not implement the <code>Cloneable</code> 
| * interface. 
| * <p>
| * Applications that override the <code>clone</code> method can also 
| * throw this exception to indicate that an object could not or 
| * should not be cloned.
| *
| * @author  unascribed
| * @version 1.3, 01/20/97
| * @see     java.lang.Cloneable
| * @see     java.lang.Object#clone()
| * @since   JDK1.0
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F809035B"
			    supplier   	"Logical View::java::lang::Exception"
			    quidu      	"34B0F6CF01D5"))
		    operations 	(list Operations
			(object Operation "CloneNotSupportedException"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F809035C"
			    documentation 	
|
|     * Constructs a <code>CloneNotSupportedException</code> with no 
|     * detail message. 
|     *
|     * @since   JDK1.0
|     
			    
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "CloneNotSupportedException"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F809035D"
			    documentation 	
