				(object ClassAttribute "pData"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"ERwin"
					    name       	"Data Type"
					    value      	("DataTypeEnum" 1)))
				    quid       	"34B0F7C901B5"
				    type       	"int")
				(object ClassAttribute "pixel_bits"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"ERwin"
					    name       	"Data Type"
					    value      	("DataTypeEnum" 1)))
				    quid       	"34B0F7C901B6"
				    type       	"int"
				    exportControl 	"Protected"))
			    module     	"Component View::java::awt::image::ColorModel (subprog spec)"
