				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7A70267"
			    documentation 	
|
|     * Sets the button's label to be the specified string.
|     * @param     label   the new label, or <code>null</code> 
|     *                if the button has no label.
|     * @see       java.awt.Button#getLabel
