|     * be automatically followed by this class.  True by default.  Applets
|     * cannot change this variable.
|     * @since   JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "set"
				    type       	"boolean"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
