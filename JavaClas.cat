			    quid       	"34B0F6CD0139"
			    documentation 	
|
| * The listener interface for receiving adjustment events. 
| *
| * @version 1.5 11/23/96
| * @author Amy Fowler
| 
			    
			    stereotype 	"Interface"
			    superclasses 	(list inheritance_relationship_list
				(object Inheritance_Relationship
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C401F4"
				    supplier   	"Logical View::java::util::EventListener"
				    quidu      	"34B0F6CE01E5"))
			    operations 	(list Operations
				(object Operation "adjustmentValueChanged"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F7C401F5"
				    documentation 	
|
|     * Invoked when the value of the adjustable has changed.
|     
				    
				    parameters 	(list Parameters
					(object Parameter "e"
					    type       	"AdjustmentEvent"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0))
			    module     	"Component View::java::awt::event::AdjustmentListener (subprog spec)"
			    quidu      	"34B0F6CD0138"
			    language   	"Java")
