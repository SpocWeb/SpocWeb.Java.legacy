					(object Attribute
					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F7C802E2"
				    documentation 	
|
|     * Invoked when a window has been closed.
|     
				    
				    parameters 	(list Parameters
					(object Parameter "e"
