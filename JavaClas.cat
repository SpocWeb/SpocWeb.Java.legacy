			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "negate"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F81701F8"
			    documentation 	
|
|     * Returns a BigInteger whose value is (-1 * this).
|     
			    
			    result     	"BigInteger"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
