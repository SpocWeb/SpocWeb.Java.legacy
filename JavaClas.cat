			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CD032F"
		    documentation 	
|
| * A <code>TextArea</code> object is a multi-line region 
| * that displays text. It can be set to allow editing or 
| * to be read-only.
| * <p>
| * The following image shows the appearance of a text area:
| * <p>
| * <img src="images-awt/TextArea-1.gif" 
| * ALIGN=center HSPACE=10 VSPACE=7>
| * <p>
| * This text area could be created by the following line of code:
| * <p>
| * <hr><blockquote><pre>
| * new TextArea("Hello", 5, 40);
| * </pre></blockquote><hr>
| * <p>
| * @version	1.36, 06/17/97
| * @author 	Sami Shaio
| * @since       JDK1.0
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7BF0290"
			    supplier   	"Logical View::java::awt::TextComponent"
			    quidu      	"34B0F6CD0331"))
		    operations 	(list Operations
			(object Operation "TextArea"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7BF02B5"
			    documentation 	
|
|     * Constructs a new text area.
|     * This text area is created with both vertical and
|     * horizontal scroll bars.
|     * @since     JDK1.0
|     
			    
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "TextArea"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7BF02B6"
			    documentation 	
|
|     * Constructs a new text area with the specified text.
|     * This text area is created with both vertical and
|     * horizontal scroll bars.
|     * @param     text the text to be displayed. 
|     * @since     JDK1.0 
|     
			    
			    parameters 	(list Parameters
				(object Parameter "text"
				    type       	"String"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "TextArea"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7BF02B8"
			    documentation 	
|
|     * Constructs a new empty TextArea with the specified number of
|     * rows and columns.
|     * @param rows the number of rows
|     * @param columns the number of columns
|     
			    
			    parameters 	(list Parameters
				(object Parameter "rows"
				    type       	"int")
				(object Parameter "columns"
				    type       	"int"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "TextArea"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7BF02BB"
			    documentation 	
|
|     * Constructs a new text area with the specified text,
|     * and with the specified number of rows and columns.
|     * This text area is created with both vertical and
|     * horizontal scroll bars.
|     * @param     text      the text to be displayed.
|     * @param     rows      the number of rows.
|     * @param     columns   the number of columns.
|     * @since     JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "text"
				    type       	"String")
				(object Parameter "rows"
				    type       	"int")
				(object Parameter "columns"
				    type       	"int"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "TextArea"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7BF02BF"
			    documentation 	
|
|     * Constructs a new text area with the specified text, 
|     * and with the rows, columns, and scroll bar visibility
|     * as specified. 
|     * <p>
|     * The <code>TextArea</code> class defines several constants
|     * that can be supplied as values for the
|     * <code>scrollbars</code> argument: 
|     * <code>SCROLLBARS_BOTH</code>, 
|     * <code>SCROLLBARS_VERTICAL_ONLY</code>, 
|     * <code>SCROLLBARS_HORIZONTAL_ONLY</code>, 
|     * and <code>SCROLLBARS_NEITHER</code>. 
|     * @param     text the text to be displayed.
|     * @param     rows the number of rows.
|     * @param     columns the number of columns.
|     * @param     scrollbars a constant that determines what 
|     *                scrollbars are created to view the text area.
|     * @since     JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "text"
				    type       	"String")
				(object Parameter "rows"
				    type       	"int")
				(object Parameter "columns"
				    type       	"int")
				(object Parameter "scrollbars"
				    type       	"int"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "addNotify"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7BF02C4"
			    documentation 	
|
|     * Creates the TextArea's peer.  The peer allows us to modify
|     * the appearance of the TextArea without changing any of its
|     * functionality.
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
