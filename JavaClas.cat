		    documentation 	
|
| * <code>Panel</code> is the simplest container class. A panel   
| * provides space in which an application can attach any other 
| * component, including other panels. 
| * <p>
| * The default layout manager for a panel is the 
| * <code>FlowLayout</code> layout manager.
| *
| * @version 	1.16, 06/17/97
| * @author 	Sami Shaio
| * @see     java.awt.FlowLayout
| * @since   JDK1.0
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7BC029F"
			    supplier   	"Logical View::java::awt::Container"
			    quidu      	"34B0F6CD0292"))
		    operations 	(list Operations
			(object Operation "Panel"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7BC02D3"
			    documentation 	
|
|     * Creates a new panel using the default layout manager. 
|     * The default layout manager for all panels is the 
|     * <code>FlowLayout</code> class.
|     * @since       JDK1.0
|     
			    
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "Panel"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7BC02D4"
			    documentation 	
|
|     * Creates a new panel with the specified layout manager.
|     * @param layout the layout manager for this panel.
|     * @since JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "layout"
				    type       	"LayoutManager"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
