		(object Class "CheckboxMenuItem"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CD037B"
		    documentation 	
|
| * This class represents a check box that can be included in a menu. 
| * Clicking on the check box in the menu changes its state from 
| * "on" to "off" or from "off" to "on." 
| * <p>
| * The following picture depicts a menu which contains an instance
| * of <code>CheckBoxMenuItem</code>:
| * <p>
| * <img src="images-awt/MenuBar-1.gif" 
| * ALIGN=center HSPACE=10 VSPACE=7>
| * <p>
| * The item labeled <code>Check</code> shows a check box menu item 
| * in its "off" state. 
| * <p>
| * When a check box menu item is selected, AWT sends an item event to 
| * the item. Since the event is an instance of <code>ItemEvent</code>, 
| * the <code>processEvent</code> method examines the event and passes 
| * it along to <code>processItemEvent</code>. The latter method redirects 
| * the event to any <code>ItemListener</code> objects that have
| * registered an interest in item events generated by this menu item. 
| *
| * @version 1.27, 06/12/97
| * @author 	Sami Shaio
| * @see         java.awt.event.ItemEvent
| * @see         java.awt.event.ItemListener
| * @since       JDK1.0
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A8038A"
			    supplier   	"Logical View::java::awt::MenuItem"
			    quidu      	"34B0F6CD0301"))
		    realized_interfaces 	(list realize_rel_list
			(object Realize_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A803A9"
			    supplier   	"Logical View::java::awt::ItemSelectable"
			    quidu      	"34B0F6CD02D1"))
		    operations 	(list Operations
			(object Operation "CheckboxMenuItem"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A803CE"
			    documentation 	
|
|     * Create a check box menu item with an empty label.
|     * The item's state is initially set to "off." 
|     * @since   JDK1.1
|     
			    
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "CheckboxMenuItem"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A803CF"
			    documentation 	
|
|     * Create a check box menu item with the specified label. 
|     * The item's state is initially set to "off." 
|
|     * @param     label   a string label for the check box menu item, 
|     *                or <code>null</code> for an unlabeled menu item.
|     * @since     JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "label"
				    type       	"String"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "CheckboxMenuItem"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A803D1"
			    documentation 	
|
|     * Create a check box menu item with the specified label and state.
|     * @param      label   the button label.
|     * @param      state   the initial state of the menu item, where
|     *                     <code>true</code> indicates "on" and 
|     *                     <code>false</code> indicates "off."
|     * @since      JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "label"
				    type       	"String")
				(object Parameter "state"
				    type       	"boolean"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "addNotify"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A803DA"
			    documentation 	
|
|     * Creates the peer of the checkbox item.  This peer allows us to
|     * change the look of the checkbox item without changing its 
|     * functionality.
|     * Most applications do not call this method directly. 
|     * @see     java.awt.Toolkit#createCheckboxMenuItem(java.awt.CheckboxMenuItem)
|     * @see     java.awt.Component#getToolkit()
|     * @since   JDK1.0
|     
			    
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getState"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A803DB"
			    documentation 	
|
|     * Determines whether the state of this check box menu item 
|     * is "on" or "off." 
|     * @return      the state of this check box menu item, where
|     *                     <code>true</code> indicates "on" and 
|     *                     <code>false</code> indicates "off."
|     * @see        java.awt.CheckboxMenuItem#setState
|     * @since      JDK1.0
|     
			    
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "setState"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7A803DC"
			    documentation 	
|
|     * Sets this check box menu item to the specifed state.
|     * The boolean value <code>true</code> indicates "on" while 
|     * <code>false</code> indicates "off." 
|     * @param      b   the boolean state of this 
|     *                      check box menu item.
|     * @see        java.awt.CheckboxMenuItem#getState
|     * @since      JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "b"
				    type       	"boolean"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "getSelectedObjects"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7A803DE"
			    documentation 	
|
|     * Returns the an array (length 1) containing the checkbox menu item
|     * label or null if the checkbox is not selected.
|     * @see ItemSelectable
|     
			    
			    result     	"Object[]"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "addItemListener"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7A803DF"
			    documentation 	
|
|     * Adds the specified item listener to receive item events from
|     * this check box menu item.
|     * @param         l the item listener.
|     * @see           java.awt.event.ItemEvent
|     * @see           java.awt.event.ItemListener
|     * @see           java.awt.Choice#removeItemListener
|     * @since         JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "l"
				    type       	"ItemListener"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "removeItemListener"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7A803E1"
			    documentation 	
|
|     * Removes the specified item listener so that it no longer receives
|     * item events from this check box menu item.
|     * @param         l the item listener.
|     * @see           java.awt.event.ItemEvent
|     * @see           java.awt.event.ItemListener
|     * @see           java.awt.Choice#addItemListener
|     * @since         JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "l"
				    type       	"ItemListener"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "eventEnabled"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A803E3"
			    parameters 	(list Parameters
				(object Parameter "e"
				    type       	"AWTEvent"))
			    result     	"boolean"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "processEvent"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A803E5"
			    documentation 	
|
|     * Processes events on this check box menu item. 
|     * If the event is an instance of <code>ItemEvent</code>, 
|     * this method invokes the <code>processItemEvent</code> method.
|     * If the event is not an item event,
|     * it invokes <code>processEvent</code> on the superclass.
|     * <p>
|     * Check box menu items currently support only item events.
|     * @param        e the event
|     * @see          java.awt.event.ItemEvent
|     * @see          java.awt.CheckboxMenuItem#processItemEvent
|     * @since        JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "e"
				    type       	"AWTEvent"))
			    result     	"void"
			    concurrency 	"Sequential"
			    opExportControl 	"Protected"
			    uid        	0)
			(object Operation "processItemEvent"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7A803E7"
			    documentation 	
| 
|     * Processes item events occurring on this check box menu item by
|     * dispatching them to any registered <code>ItemListener</code> objects. 
|     * <p>
|     * This method is not called unless item events are 
|     * enabled for this menu item. Item events are enabled 
|     * when one of the following occurs:
|     * <p><ul>
|     * <li>An <code>ItemListener</code> object is registered 
