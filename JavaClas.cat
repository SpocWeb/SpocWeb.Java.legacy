|     *          character sequence represented by this object, or
|     *          <code>-1</code> if the character does not occur.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "ch"
				    type       	"int"))
			    result     	"int"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
