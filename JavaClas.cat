					(object Parameter "in"
					    type       	"java.io.ObjectInputStream"))
				    result     	"void"
				    exceptions 	"java.io.IOException,java.lang.ClassNotFoundException"
				    concurrency 	"Sequential"
				    opExportControl 	"Private"
				    uid        	0)
