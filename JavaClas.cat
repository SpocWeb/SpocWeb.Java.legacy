			    uid        	0)
			(object Operation "write"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7E6015D"
			    documentation 	
|
|     * Writes the specified byte to this byte array output stream. 
|     *
|     * @param   b   the byte to be written.
|     
			    
			    parameters 	(list Parameters
				(object Parameter "b"
				    type       	"int"))
			    result     	"void"
