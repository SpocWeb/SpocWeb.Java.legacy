		(object Class "Externalizable"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CE037B"
		    documentation 	
|
| * Externalization allows a class to specify the methods to be used to
| * write the object's contents to a stream and to read them back.  The
| * Externalizable interface's writeExternal and readExternal methods
| * are implemented by a class to
| * give the class complete control over the format and contents of the
| * stream for an object and its supertypes. These methods must explicitly
| * coordinate with the supertype to save its state. <br>
| *
| * Object Serialization uses the Serializable and Externalizable
| * interfaces.  Object persistence mechanisms may use them also.  Each
| * object to be stored is tested for the Externalizable interface. If
| * the object supports it, the writeExternal method is called. If the
| * object does not support Externalizable and does implement
| * Serializable the object should be saved using
| * ObjectOutputStream. <br> When an Externalizable object is to be
| * reconstructed, an instance is created using the public no-arg
| * constructor and the readExternal method called.  Serializable
| * objects are restored by reading them from an ObjectInputStream.
| *
| * @author  unascribed
| * @version 1.6, 01/22/97
| * @see java.io.ObjectOutputStream
| * @see java.io.ObjectInputStream
| * @see java.io.ObjectOutput
| * @see java.io.ObjectInput
| * @see java.io.Serializable
| * @since   JDK1.1
| 
		    
		    stereotype 	"Interface"
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7E70138"
			    supplier   	"Logical View::java::io::Serializable"
			    quidu      	"34B0F6CE0293"))
		    operations 	(list Operations
			(object Operation "writeExternal"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7E70139"
			    documentation 	
|
|     * The object implements the writeExternal method to save its contents
|     * by calling the methods of DataOutput for its primitive values or
|     * calling the writeObject method of ObjectOutput for objects, strings
|     * and arrays.
|     * @exception IOException Includes any I/O exceptions that may occur
|     * @since     JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "out"
				    type       	"ObjectOutput"))
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0)
			(object Operation "readExternal"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Abstract"
				    value      	TRUE))
			    quid       	"34B0F7E70149"
			    documentation 	
|
|     * The object implements the readExternal method to restore its
|     * contents by calling the methods of DataInput for primitive
|     * types and readObject for objects, strings and arrays.  The
|     * readExternal method must read the values in the same sequence
|     * and with the same types as were written by writeExternal.
|     * @exception ClassNotFoundException If the class for an object being
|     *              restored cannot be found.
|     * @since     JDK1.1
|     
			    
			    parameters 	(list Parameters
				(object Parameter "in"
				    type       	"ObjectInput"))
			    result     	"void"
			    exceptions 	"IOException,ClassNotFoundException"
			    concurrency 	"Sequential"
			    opExportControl 	"Implementation"
			    uid        	0))
		    module     	"Component View::java::io::Externalizable (subprog spec)"
		    quidu      	"34B0F6CE037A"
		    language   	"Java")
		(object Class "OutputStreamWriter"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
			    name       	"?_Touched_?"
			    value      	"?_Touched_?")
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateFinalizer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateStaticInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CE038A"
		    documentation 	
|
| * Write characters to an output stream, translating characters into bytes
| * according to a specified character encoding.  Each OutputStreamWriter
| * incorporates its own CharToByteConverter, and is thus a bridge from
| * character streams to byte streams.
| *
| * <p> The encoding used by an OutputStreamWriter may be specified by name, by
| * providing a CharToByteConverter, or by accepting the default encoding, which
| * is defined by the system property <tt>file.encoding</tt>.
| *
| * <p> Each invocation of a write() method causes the encoding converter to be
| * invoked on the given character(s).  The resulting bytes are accumulated in a
| * buffer before being written to the underlying output stream.  The size of
| * this buffer may be specified, but by default it is large enough for most
| * purposes.  Note that the characters passed to the write() methods are not
| * buffered.  For top efficiency, consider wrapping an OutputStreamWriter
| * within a BufferedWriter so as to avoid frequent converter invocations.  For
| * example,
| *
| * <pre>
| * Writer out
| *   = new BufferedWriter(new OutputStreamWriter(System.out));
| * </pre>
| *
| * @see BufferedWriter
| * @see OutputStream
| *
| * @version 	1.10, 97/01/27
| * @author	Mark Reinhold
| * @since	JDK1.1
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"?_Touched_?"
				    value      	"?_Touched_?"))
			    quid       	"34B0F7EC01D4"
			    supplier   	"Logical View::java::io::Writer"
			    quidu      	"34B0F6CE03DA"))
		    module     	"Component View::java::io::OutputStreamWriter (subprog spec)"
		    quidu      	"34B0F6CE037C"
		    language   	"Java")
		(object Class "InterruptedIOException"
		    attributes 	(list Attribute_Set
			(object Attribute
			    tool       	"Java"
