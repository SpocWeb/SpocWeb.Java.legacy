				(object Attribute
				    tool       	"ERwin"
				    name       	"Data Type"
				    value      	("DataTypeEnum" 1)))
			    quid       	"34B0F86602EE"
			    documentation 	
|
|     * The last character in the exception range
|     
			    
			    type       	"char"
			    exportControl 	"Public")
