			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CF014B"
		    documentation 	
|
| * A character-stream reader that allows characters to be pushed back into the
| * stream.
| *
| * @version 	1.7, 97/05/12
| * @author	Mark Reinhold
| * @since	JDK1.1
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7ED0203"
			    supplier   	"Logical View::java::io::FilterReader"
			    quidu      	"34B0F6CF00DC"))
		    operations 	(list Operations
			(object Operation "PushbackReader"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7ED0214"
			    documentation 	
|
|     * Create a new pushback reader with a pushback buffer of the given size.
|     *
|     * @param   in   The reader from which characters will be read
|     * @param	size The size of the pushback buffer
|     
			    
			    parameters 	(list Parameters
				(object Parameter "in"
				    type       	"Reader")
				(object Parameter "size"
				    type       	"int"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "PushbackReader"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7ED0217"
			    documentation 	
|
|     * Create a new pushback reader with a one-character pushback buffer.
|     *
|     * @param   in  The reader from which characters will be read
|     
			    
			    parameters 	(list Parameters
				(object Parameter "in"
				    type       	"Reader"))
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "ensureOpen"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7ED0219"
			    documentation 	" Check to make sure that the stream has not been closed. "
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Private"
			    uid        	0)
			(object Operation "read"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7ED021A"
			    documentation 	
|
|     * Read a single character.
|     *
|     * @return     The character read, or -1 if the end of the stream has been
|     *             reached
|     *
|     * @exception  IOException  If an I/O error occurs
|     
			    
			    result     	"int"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "read"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7ED021B"
			    documentation 	
|
|     * Read characters into a portion of an array.
|     *
|     * @param      cbuf  Destination buffer
|     * @param      off   Offset at which to start writing characters
|     * @param      len   Maximum number of characters to read
|     *
|     * @return     The number of characters read, or -1 if the end of the
|     *             stream has been reached
|     *
|     * @exception  IOException  If an I/O error occurs
|     
			    
			    parameters 	(list Parameters
				(object Parameter "cbuf[]"
				    type       	"char")
				(object Parameter "off"
				    type       	"int")
				(object Parameter "len"
				    type       	"int"))
			    result     	"int"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "unread"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7ED021F"
			    documentation 	
|
|     * Push back a single character.
|     *
|     * @param  c  The character to push back
|     *
|     * @exception  IOException  If the pushback buffer is full,
|     *                          or if some other I/O error occurs
|     
			    
			    parameters 	(list Parameters
				(object Parameter "c"
				    type       	"int"))
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "unread"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7ED0221"
			    documentation 	
|
|     * Push back a portion of an array of characters by copying it to the
|     * front of the pushback buffer.  After this method returns, the next
|     * character to be read will have the value <code>cbuf[off]</code>, the
|     * character after that will have the value <code>cbuf[off+1]</code>, and
|     * so forth.
|     *
|     * @param  cbuf  Character array
