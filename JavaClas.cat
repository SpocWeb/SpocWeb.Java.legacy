					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F7C801A6"
				    documentation 	
|
|     * Invoked when the value of the text has changed.
|     
				    
				    parameters 	(list Parameters
					(object Parameter "e"
					    type       	"TextEvent"))
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
