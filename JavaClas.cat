			    name       	"GenerateInstanceInitializer"
			    value      	FALSE)
			(object Attribute
			    tool       	"Java"
			    name       	"GenerateDefaultConstructor"
			    value      	FALSE))
		    quid       	"34B0F6CF0021"
		    documentation 	
|
| * A piped output stream is the sending end of a communications 
| * pipe. Two threads can communicate by having one thread send data 
| * through a piped output stream and having the other thread read the 
| * data through a piped input stream. 
| *
| * @author  James Gosling
| * @version 1.14, 02/10/97
| * @see     java.io.PipedInputStream
| * @since   JDK1.0
| 
		    
		    superclasses 	(list inheritance_relationship_list
			(object Inheritance_Relationship
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EC02BF"
			    supplier   	"Logical View::java::io::OutputStream"
			    quidu      	"34B0F6CE02FE"))
		    operations 	(list Operations
			(object Operation "PipedOutputStream"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EC02D2"
			    documentation 	
|
|     * Creates a piped output stream connected to the specified piped 
|     * input stream. 
|     *
|     * @param      snk   The piped input stream to connect to.
|     * @exception  IOException  if an I/O error occurs.
|     * @since      JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "snk"
				    type       	"PipedInputStream"))
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "PipedOutputStream"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EC02D4"
			    documentation 	
|
|     * Creates a piped output stream that is not yet connected to a 
|     * piped input stream. It must be connected to a piped input stream, 
|     * either by the receiver or the sender, before being used. 
|     *
|     * @see     java.io.PipedInputStream#connect(java.io.PipedOutputStream)
|     * @see     java.io.PipedOutputStream#connect(java.io.PipedInputStream)
|     * @since   JDK1.0
|     
			    
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "connect"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EC02D5"
			    documentation 	
|
|     * Connects this piped output stream to a receiver. 
|     *
|     * @param      snk   the piped output stream to connect to.
|     * @exception  IOException  if an I/O error occurs.
|     * @since      JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "snk"
				    type       	"PipedInputStream"))
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "write"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EC02DF"
			    documentation 	
|
|     * Writes the specified <code>byte</code> to the piped output stream.
|     *
|     * @param      b   the <code>byte</code> to be written.
|     * @exception  IOException  if an I/O error occurs.
|     * @since      JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "b"
				    type       	"int"))
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "write"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EC02E1"
			    documentation 	
|
|     * Writes <code>len</code> bytes from the specified byte array 
|     * starting at offset <code>off</code> to this piped output stream. 
|     *
|     * @param      b     the data.
|     * @param      off   the start offset in the data.
|     * @param      len   the number of bytes to write.
|     * @exception  IOException  if an I/O error occurs.
|     * @since      JDK1.0
|     
			    
			    parameters 	(list Parameters
				(object Parameter "b[]"
				    type       	"byte")
				(object Parameter "off"
				    type       	"int")
				(object Parameter "len"
				    type       	"int"))
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "flush"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Synchronized"
				    value      	TRUE))
			    quid       	"34B0F7EC02E5"
			    documentation 	
|
|     * Flushes this output stream and forces any buffered output bytes 
|     * to be written out. 
|     * This will notify any readers that bytes are waiting in the pipe.
|     *
|     * @exception IOException if an I/O error occurs.
|     * @since     JDK1.0
|     
			    
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0)
			(object Operation "close"
			    attributes 	(list Attribute_Set)
			    quid       	"34B0F7EC02E6"
			    documentation 	
|
|     * Closes this piped output stream and releases any system resources 
|     * associated with this stream. 
|     *
|     * @exception  IOException  if an I/O error occurs.
|     * @since      JDK1.0
|     
			    
			    result     	"void"
			    exceptions 	"IOException"
			    concurrency 	"Sequential"
			    opExportControl 	"Public"
			    uid        	0))
