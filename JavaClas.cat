			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"Native"
				    value      	TRUE))
			    quid       	"34B0F7E800A4"
			    documentation 	
|
|     * Opens a file, with the specified name, for writing.
|     * @param name name of file to be opened
|     
			    
			    parameters 	(list Parameters
				(object Parameter "name"
