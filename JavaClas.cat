					    tool       	"Java"
					    name       	"Static"
					    value      	TRUE))
				    quid       	"34B0F8270317"
				    documentation 	
|
|     * Returns the handler for socket creation failure.
|     
				    
				    result     	"RMIFailureHandler"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0))
			    module     	"Component View::java::rmi::server::RMISocketFactory (subprog spec)"
			    quidu      	"34B0F6D30399"
			    language   	"Java"
			    abstract   	TRUE)
			(object Class "RMIFailureHandler"
			    attributes 	(list Attribute_Set
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateFinalizer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateStaticInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateInstanceInitializer"
				    value      	FALSE)
				(object Attribute
				    tool       	"Java"
				    name       	"GenerateDefaultConstructor"
				    value      	FALSE))
			    quid       	"34B0F6D303AA"
			    documentation 	
|
| * An RMIFailureHandler can be registered via the
| * RMISocketFactory.setFailureHandler call. The "failure" method of
| * the handler is invoked when the RMI runtime is unable to create a
| * Socket or ServerSocket. The "failure" method returns a boolean
| * indicating whether the runtime should attempt to retry.
| 
			    
			    stereotype 	"Interface"
			    operations 	(list Operations
				(object Operation "failure"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F8260138"
				    documentation 	
|
|     * The "failure" callback is invoked when the RMI runtime is
|     * unable to create a Socket or ServerSocket via the
|     * RMISocketFactory. The RMIFailureHandler is registered via a
|     * call to RMISocketFacotry.setFailureHandler().  The default
|     * failure handler returns false.
|     *
|     * @param ex the exception that occurred during socket creation
|     * @return if true, the RMI runtime attempts to retry
|     
				    
				    parameters 	(list Parameters
					(object Parameter "ex"
					    type       	"Exception"))
				    result     	"boolean"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0))
			    module     	"Component View::java::rmi::server::RMIFailureHandler (subprog spec)"
			    quidu      	"34B0F6D303A9"
			    language   	"Java")
