			    quid       	"34B0F6CD00D2"
			    documentation 	
|
| * A class that encapsulates the methods for translating from pixel values
| * to alpha, red, green, and blue color components for an image.  This
| * class is abstract.
| *
| * @see IndexColorModel
| * @see DirectColorModel
| *
| * @version	1.12 11/23/96
| * @author 	Jim Graham
| 
			    
			    operations 	(list Operations
				(object Operation "getRGBdefault"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Static"
					    value      	TRUE))
				    quid       	"34B0F7C901C8"
				    documentation 	
|
|     * Return a ColorModel which describes the default format for
|     * integer RGB values used throughout the AWT image interfaces.
|     * The format for the RGB values is an integer with 8 bits
|     * each of alpha, red, green, and blue color components ordered
|     * correspondingly from the most significant byte to the least
|     * significant byte, as in:  0xAARRGGBB
|     
				    
				    result     	"ColorModel"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "ColorModel"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C901C9"
				    documentation 	
|
|     * Constructs a ColorModel which describes a pixel of the specified
|     * number of bits.
|     
				    
				    parameters 	(list Parameters
					(object Parameter "bits"
					    type       	"int"))
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getPixelSize"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C901CB"
				    documentation 	
|
|     * Returns the number of bits per pixel described by this ColorModel.
|     
				    
				    result     	"int"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getRed"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F7C901D4"
				    documentation 	
|
|     * The subclass must provide a function which provides the red
|     * color compoment for the specified pixel.
|     * @return		The red color component ranging from 0 to 255
|     
				    
				    parameters 	(list Parameters
					(object Parameter "pixel"
					    type       	"int"))
				    result     	"int"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getGreen"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F7C901D6"
				    documentation 	
|
|     * The subclass must provide a function which provides the green
|     * color compoment for the specified pixel.
|     * @return		The green color component ranging from 0 to 255
|     
				    
				    parameters 	(list Parameters
					(object Parameter "pixel"
					    type       	"int"))
				    result     	"int"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getBlue"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F7C901D8"
				    documentation 	
|
|     * The subclass must provide a function which provides the blue
|     * color compoment for the specified pixel.
|     * @return		The blue color component ranging from 0 to 255
|     
				    
				    parameters 	(list Parameters
					(object Parameter "pixel"
					    type       	"int"))
				    result     	"int"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getAlpha"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Abstract"
					    value      	TRUE))
				    quid       	"34B0F7C901DA"
				    documentation 	
|
|     * The subclass must provide a function which provides the alpha
|     * color compoment for the specified pixel.
|     * @return		The alpha transparency value ranging from 0 to 255
|     
				    
				    parameters 	(list Parameters
					(object Parameter "pixel"
					    type       	"int"))
				    result     	"int"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "getRGB"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C901DC"
				    documentation 	
|
|     * Returns the color of the pixel in the default RGB color model.
|     * @see ColorModel#getRGBdefault
|     
				    
				    parameters 	(list Parameters
					(object Parameter "pixel"
					    type       	"int"))
				    result     	"int"
				    concurrency 	"Sequential"
				    opExportControl 	"Public"
				    uid        	0)
				(object Operation "deletepData"
				    attributes 	(list Attribute_Set
					(object Attribute
					    tool       	"Java"
					    name       	"Native"
					    value      	TRUE))
				    quid       	"34B0F7C901DE"
				    result     	"void"
				    concurrency 	"Sequential"
				    opExportControl 	"Private"
				    uid        	0)
				(object Operation "finalize"
				    attributes 	(list Attribute_Set)
				    quid       	"34B0F7C901DF"
				    result     	"void"
